---
import { TOOLS, getToolPath, type ToolMeta } from '@lib/tools-data';

interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;
const relatedTools = slugs
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t): t is ToolMeta => t !== undefined);
---

{relatedTools.length > 0 && (
  <section class="mt-12 bg-primary-50 rounded-xl p-6 sm:p-8">
    <h2 class="text-2xl font-bold text-neutral-900 mb-6">Related Calculators</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {relatedTools.map((tool) => (
        <a
          href={getToolPath(tool)}
          class="bg-white border border-neutral-200 rounded-lg p-4 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-150 group"
        >
          <h3 class="text-base font-semibold text-neutral-900 group-hover:text-primary-500 transition-colors duration-150 flex items-center justify-between">
            {tool.name}
            <svg class="w-4 h-4 text-neutral-400 group-hover:text-primary-500 transition-colors duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </h3>
          <p class="text-sm text-neutral-500 mt-1">{tool.description}</p>
        </a>
      ))}
    </div>
  </section>
)}
