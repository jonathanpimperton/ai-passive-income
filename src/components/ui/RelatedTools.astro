---
import ToolIcon from './ToolIcon.astro';
import { TOOLS, getToolPath, type ToolMeta } from '@lib/tools-data';

interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;
const relatedTools = slugs
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t): t is ToolMeta => t !== undefined);
---

{relatedTools.length > 0 && (
  <section class="mt-14">
    {/* Gradient divider */}
    <div class="h-px bg-gradient-to-r from-transparent via-primary-300/30 to-transparent mb-14"></div>

    <div class="bg-gradient-to-br from-primary-50 to-primary-50/50 rounded-2xl p-6 sm:p-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-6">Related Calculators</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {relatedTools.map((tool) => (
          <a
            href={getToolPath(tool)}
            class="group relative bg-white border border-neutral-200/80 rounded-xl p-4 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-200"
          >
            <div class="flex items-start gap-3">
              <div class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-primary-50 text-primary-500 group-hover:bg-primary-500 group-hover:text-white transition-all duration-200 shrink-0">
                <ToolIcon name={tool.icon} size={18} />
              </div>
              <div>
                <h3 class="text-base font-semibold text-neutral-900 group-hover:text-primary-500 transition-colors duration-150">
                  {tool.name}
                </h3>
                <p class="text-sm text-neutral-500 mt-0.5 leading-relaxed">{tool.description}</p>
              </div>
            </div>
            {/* Bottom accent */}
            <div class="absolute bottom-0 left-3 right-3 h-0.5 bg-gradient-to-r from-primary-500 to-accent-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
