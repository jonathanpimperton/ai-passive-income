---
/**
 * Reusable wrapper for every tool page.
 * Handles: breadcrumb, H1 + subtitle, affiliate disclosure,
 * tabbed content sections, and related tools.
 *
 * Below the calculator, content is organized into tabs:
 *   - "How it works" (educational markdown content)
 *   - "Examples" (worked examples with numbered cards)
 *   - "FAQ" (frequently asked questions)
 *   - "Sources" (data sources + calculation method)
 *
 * Progressive enhancement: without JS, all sections display
 * in a stacked layout (long scroll). JS enhances with tabs.
 *
 * Slots:
 *   - default: The interactive calculator component
 *   - content: The rendered markdown educational content
 */
import Breadcrumb from './Breadcrumb.astro';
import ToolIcon from './ToolIcon.astro';
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import AffiliateLinks from './AffiliateLinks.astro';
import ScrollEmailBar from './ScrollEmailBar.tsx';
import FaqSection from './FaqSection.astro';
import ScenarioLinks from './ScenarioLinks.astro';
import RelatedTools from './RelatedTools.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, TOOLS, type CategorySlug } from '@lib/tools-data';
import { UK_TAX_YEAR, UK_RATES_LAST_CHECKED } from '@lib/uk-rates';
import { US_TAX_YEAR, US_RATES_LAST_CHECKED } from '@lib/us-rates';

/** Financial tool categories that show the scroll-triggered email bar */
const FINANCIAL_CATEGORIES = new Set<CategorySlug>(['saving-and-growth', 'debt-and-loans', 'income-and-planning', 'economic']);

interface WorkedExample {
  title: string;
  inputs: Record<string, string | number>;
  description: string;
}

interface DataSource {
  name: string;
  url: string;
}

interface ToolData {
  name: string;
  slug: string;
  category: CategorySlug;
  description: string;
  affiliateContext?: string;
  affiliatePrograms?: string[];
  faq: Array<{ question: string; answer: string }>;
  relatedTools: string[];
  workedExamples?: WorkedExample[];
  lastUpdated?: string;
  dataSources?: DataSource[];
  calculationMethod?: string;
}

interface Props {
  tool: {
    data: ToolData;
  };
}

const { tool } = Astro.props;
const { name, slug, category, description, affiliateContext, affiliatePrograms, faq, relatedTools, workedExamples, lastUpdated, dataSources, calculationMethod } = tool.data;
const categoryLabel = CATEGORIES[category]?.label ?? category;
const toolMeta = TOOLS.find((t) => t.slug === slug);

const showEmailCapture = FINANCIAL_CATEGORIES.has(category);

/**
 * Tax/rate-dependent tools show a tax-year badge DERIVED from the central rates
 * modules (never hardcode the year — it drifts). Their "last checked" date comes
 * from the rates modules too. Other tools show "Last updated" from frontmatter.
 */
const formatBadgeDate = (iso: string) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const TAX_BADGES: Record<string, { label: string; checked: string }> = {
  'salary-uk': { label: `Updated for ${UK_TAX_YEAR} tax year`, checked: UK_RATES_LAST_CHECKED },
  'salary-us': { label: `Updated for ${US_TAX_YEAR} tax year`, checked: US_RATES_LAST_CHECKED },
  'stamp-duty': { label: 'Current SDLT rates', checked: UK_RATES_LAST_CHECKED },
  'capital-gains-tax': { label: `Updated for ${UK_TAX_YEAR} (UK) / ${US_TAX_YEAR} (US)`, checked: UK_RATES_LAST_CHECKED },
};
const taxBadge = TAX_BADGES[slug] ?? null;
const formattedDate = lastUpdated ? formatBadgeDate(lastUpdated) : null;

/** Link to the methodology page when one exists for this tool */
const methodologies = await getCollection('methodologies');
const hasMethodology = methodologies.some((m) => m.data.slug === slug);

/**
 * Single quiet meta line under the H1 (replaces the old pill soup):
 * date · calculation method (truncated) · methodology link.
 * Tax-dependent tools keep one small teal badge with the tax-year claim;
 * their date comes from the rates module's "last checked" instead.
 */
const metaDate = taxBadge
  ? `Last checked ${formatBadgeDate(taxBadge.checked)}`
  : formattedDate
    ? `Last updated ${formattedDate}`
    : null;
const metaMethod = calculationMethod
  ? calculationMethod.length > 60
    ? `${calculationMethod.slice(0, 60).trimEnd()}…`
    : calculationMethod
  : null;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Calculators', url: '/tools/' },
  { name: categoryLabel, url: `/tools/#${category}` },
  { name, url: `/tools/${category}/${slug}/` },
];

const hasExamples = workedExamples && workedExamples.length > 0;
const hasFaq = faq.length > 0;
const hasSources = !!(dataSources && dataSources.length > 0) || !!calculationMethod;

/** Build tab definitions — only include tabs that have content */
const tabs: Array<{ id: string; label: string }> = [
  { id: 'guide', label: 'How it works' },
];
if (hasExamples) tabs.push({ id: 'examples', label: 'Examples' });
if (hasFaq) tabs.push({ id: 'faq', label: 'FAQ' });
if (hasSources) tabs.push({ id: 'sources', label: 'Sources' });
---

{/* Calculator section — subtle gradient header */}
{/* Mobile sticky result mini-bar — mirrors the calculator's headline figure so
    "results as you type" stays true on phones, where the results panel sits
    below the inputs. Populated + toggled by the script at the bottom of this
    layout; hidden on lg+ where the sticky results panel does the job. */}
<div
  id="mobile-result-bar"
  class="lg:hidden fixed top-16 inset-x-0 z-30 hidden bg-white/95 dark:bg-neutral-900/95 backdrop-blur-md border-b border-neutral-200/80 shadow-sm"
  aria-hidden="true"
>
  <div class="flex items-baseline justify-between gap-3 px-4 py-2">
    <span id="mobile-result-label" class="text-xs text-neutral-500 truncate"></span>
    <span id="mobile-result-value" class="tabular-nums text-base font-bold text-neutral-900"></span>
  </div>
</div>

<div class="bg-white dark:bg-neutral-900 overflow-x-hidden" data-calc-section data-tool-slug={slug}>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={breadcrumbs} />

    {/* Page header with tool icon */}
    <div class="mb-6">
      <div class="flex items-start gap-4 mb-3">
        {toolMeta && (
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary-100 dark:bg-primary-900/40 text-primary-600 dark:text-primary-400 shrink-0 shadow-sm">
            <ToolIcon name={toolMeta.icon} size={24} />
          </div>
        )}
        <div>
          <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 dark:text-neutral-100">{name}</h1>
          <p class="text-lg text-neutral-500 dark:text-neutral-500 mt-1">{description}</p>
          {/* Tax-year badge (only accent badge on the page header) */}
          {taxBadge && (
            <div class="mt-2">
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-primary-700 dark:text-primary-300 bg-primary-50 dark:bg-primary-900/30 px-2.5 py-1 rounded-full">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                {taxBadge.label}
              </span>
            </div>
          )}
          {/* Quiet meta line — no pill backgrounds */}
          {(metaDate || metaMethod || hasMethodology) && (
            <p class="mt-2 text-sm text-neutral-500">
              {metaDate && <span>{metaDate}</span>}
              {metaMethod && (
                <>
                  {metaDate && <span class="mx-1.5" aria-hidden="true">·</span>}
                  <span>{metaMethod}</span>
                </>
              )}
              {hasMethodology && (
                <>
                  {(metaDate || metaMethod) && <span class="mx-1.5" aria-hidden="true">·</span>}
                  <a href={`/how-we-calculate/${slug}/`} class="font-medium text-primary-600 hover:text-primary-700 hover:underline transition-colors duration-150">
                    How we calculate this &rarr;
                  </a>
                </>
              )}
            </p>
          )}
        </div>
      </div>
    </div>

    {/* Affiliate disclosure — only on pages with affiliate links */}
    {affiliateContext && <AffiliateDisclosure />}

    {/* Calculator component injected via default slot */}
    <div class="mb-8">
      <slot />
    </div>

    {/* Contextual affiliate recommendations — directly after calculator for max relevance */}
    {affiliateContext && affiliatePrograms && affiliatePrograms.length > 0 && (
      <AffiliateLinks context={affiliateContext} programIds={affiliatePrograms} toolSlug={slug} category={category} />
    )}

    {/* Powered-by badge — visible only in embed mode */}
    <div class="embed-badge items-center justify-center gap-1.5 pb-4 text-sm text-neutral-500">
      Powered by
      <a href={`https://www.calcrun.com/tools/${category}/${slug}/`} target="_blank" rel="noopener" class="font-semibold text-primary-600 hover:text-primary-500 transition-colors duration-150">
        CalcRun
      </a>
    </div>
  </div>
</div>

{/* ── Tab navigation + content panels ──────────────────────── */}
<div class="border-t border-neutral-200/50 dark:border-neutral-700/50 bg-neutral-50 dark:bg-neutral-800/50" id="tool-tabs-container">
  {/* Tab bar — hidden until JS enhances */}
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="tool-tab-nav flex gap-1 overflow-x-auto -mb-px pt-2" role="tablist" aria-label="Calculator information" style="display:none">
      {tabs.map((tab, i) => (
        <button
          role="tab"
          id={`tab-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${tab.id}`}
          tabindex={i === 0 ? 0 : -1}
          data-tab={tab.id}
          class:list={[
            'tool-tab-btn whitespace-nowrap px-4 py-3 text-sm font-medium border-b-2 transition-colors duration-150 rounded-t-lg',
            i === 0
              ? 'border-primary-500 text-primary-700 dark:text-primary-500 bg-white dark:bg-neutral-900'
              : 'border-transparent text-neutral-500 dark:text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 hover:border-neutral-300 dark:hover:border-neutral-600',
          ]}
        >
          {tab.label}
        </button>
      ))}
    </nav>
  </div>

  {/* ── Panel: How it works (educational content) ────────── */}
  <div
    id="panel-guide"
    role="tabpanel"
    aria-labelledby="tab-guide"
    data-tab-panel="guide"
    class="tool-tab-panel"
  >
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <h2 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-6 tool-tab-heading">How it works</h2>
      <div class="xl:grid xl:grid-cols-[minmax(0,768px)_1fr] xl:gap-12" data-toc-grid>
        <div class="prose dark:prose-invert max-w-[768px]">
          <slot name="content" />
        </div>
        {/* Right-rail "On this page" TOC — populated client-side, xl+ only */}
        <aside class="toc-rail hidden" data-toc-rail>
          <nav class="xl:sticky xl:top-24" aria-label="On this page">
            <p class="text-xs uppercase tracking-wide text-neutral-500 mb-3">On this page</p>
            <ul class="border-l border-neutral-200/80" data-toc-list></ul>
          </nav>
        </aside>
      </div>
    </div>
  </div>

  {/* ── Panel: Examples ──────────────────────────────────── */}
  {hasExamples && (
    <div
      id="panel-examples"
      role="tabpanel"
      aria-labelledby="tab-examples"
      data-tab-panel="examples"
      class="tool-tab-panel"
    >
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
        <h2 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-6 tool-tab-heading">Real-World Examples</h2>
        <div class="xl:grid xl:grid-cols-[minmax(0,768px)_1fr] xl:gap-12" data-toc-grid>
        <div class="space-y-4">
          {workedExamples.map((example, index) => (
            <div class="bg-white dark:bg-neutral-800 border border-neutral-200/80 dark:border-neutral-700 rounded-xl p-5 sm:p-6 shadow-card hover:shadow-card-hover transition-shadow duration-200">
              <div class="flex items-start gap-3 mb-3">
                <div class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-primary-100 dark:bg-primary-900/40 text-primary-700 dark:text-primary-300 text-sm font-bold shrink-0 mt-0.5">
                  {index + 1}
                </div>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">{example.title}</h3>
              </div>
              <div class="flex flex-wrap gap-2 mb-3 pl-10">
                {Object.entries(example.inputs).map(([key, value]) => (
                  <span class="inline-flex items-center gap-1 text-xs font-medium text-primary-700 dark:text-primary-300 bg-primary-50 dark:bg-primary-900/30 px-2.5 py-1 rounded-full">
                    <span class="text-primary-600 dark:text-primary-400">{key.replace(/([A-Z])/g, ' $1').replace(/^./, (s: string) => s.toUpperCase())}:</span>
                    <span class="tabular-nums">{typeof value === 'number' ? value.toLocaleString() : value}</span>
                  </span>
                ))}
              </div>
              <p class="text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed pl-10">{example.description}</p>
            </div>
          ))}
        </div>
        <aside class="toc-rail hidden" data-toc-rail>
          <nav class="xl:sticky xl:top-24" aria-label="On this page">
            <p class="text-xs uppercase tracking-wide text-neutral-500 mb-3">On this page</p>
            <ul class="border-l border-neutral-200/80" data-toc-list></ul>
          </nav>
        </aside>
        </div>
      </div>
    </div>
  )}

  {/* ── Panel: FAQ ────────────────────────────────────────── */}
  {hasFaq && (
    <div
      id="panel-faq"
      role="tabpanel"
      aria-labelledby="tab-faq"
      data-tab-panel="faq"
      class="tool-tab-panel"
    >
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
        <div class="xl:grid xl:grid-cols-[minmax(0,768px)_1fr] xl:gap-12" data-toc-grid>
          <div class="min-w-0">
            <FaqSection faqs={faq} />
          </div>
          <aside class="toc-rail hidden" data-toc-rail>
            <nav class="xl:sticky xl:top-24" aria-label="On this page">
              <p class="text-xs uppercase tracking-wide text-neutral-500 mb-3">On this page</p>
              <ul class="border-l border-neutral-200/80" data-toc-list></ul>
            </nav>
          </aside>
        </div>
      </div>
    </div>
  )}

  {/* ── Panel: Sources ───────────────────────────────────── */}
  {hasSources && (
    <div
      id="panel-sources"
      role="tabpanel"
      aria-labelledby="tab-sources"
      data-tab-panel="sources"
      class="tool-tab-panel"
    >
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
        <h2 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-6 tool-tab-heading">Sources & Methodology</h2>

        <div class="xl:grid xl:grid-cols-[minmax(0,768px)_1fr] xl:gap-12" data-toc-grid>
        <div class="min-w-0">
        {/* Calculation method accordion */}
        {calculationMethod && (
          <details class="mb-8 bg-white dark:bg-neutral-800 border border-neutral-200/80 dark:border-neutral-700 rounded-xl shadow-card group">
            <summary class="flex items-center justify-between cursor-pointer px-5 py-4 text-sm font-semibold text-neutral-900 dark:text-neutral-100 select-none list-none [&::-webkit-details-marker]:hidden">
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                How this is calculated
              </span>
              <svg class="w-4 h-4 text-neutral-500 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-5 pb-4 text-sm text-neutral-700 dark:text-neutral-300 leading-relaxed border-t border-neutral-100 dark:border-neutral-700 pt-3">
              {calculationMethod}
            </div>
          </details>
        )}

        {/* Data sources list */}
        {dataSources && dataSources.length > 0 && (
          <div class="max-w-[768px]">
            <h3 class="text-sm font-semibold text-neutral-700 dark:text-neutral-300 uppercase tracking-wide mb-3">Data Sources</h3>
            <ul class="space-y-1.5">
              {dataSources.map((source) => (
                <li class="flex items-start gap-2 text-sm text-neutral-600 dark:text-neutral-500">
                  <svg class="w-4 h-4 text-primary-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-1.102-4.243a4 4 0 015.656 0l4 4a4 4 0 01-5.656 5.656l-1.1-1.1" /></svg>
                  <a href={source.url} target="_blank" rel="noopener noreferrer" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-150 underline underline-offset-2 decoration-neutral-300 dark:decoration-neutral-600 hover:decoration-primary-400">
                    {source.name}
                  </a>
                </li>
              ))}
            </ul>
            {formattedDate && (
              <p class="text-xs text-neutral-500 mt-3">Last verified: {formattedDate}</p>
            )}
          </div>
        )}
        </div>
        <aside class="toc-rail hidden" data-toc-rail>
          <nav class="xl:sticky xl:top-24" aria-label="On this page">
            <p class="text-xs uppercase tracking-wide text-neutral-500 mb-3">On this page</p>
            <ul class="border-l border-neutral-200/80" data-toc-list></ul>
          </nav>
        </aside>
        </div>
      </div>
    </div>
  )}
</div>

{/* Scenario links + Related tools — always visible below tabs */}
<div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pb-12 sm:pb-16 scroll-reveal">
  <ScenarioLinks toolSlug={slug} />
  {relatedTools.length > 0 && <RelatedTools slugs={relatedTools} />}
</div>

{/* Scroll-triggered email bar on financial calculator pages */}
{showEmailCapture && (
  <ScrollEmailBar client:idle toolSlug={slug} />
)}

{/* Back-to-calculator floating action button */}
<button
  id="back-to-calc-btn"
  class="back-to-calc fixed bottom-16 right-6 z-50 bg-primary-600 text-white rounded-full p-3.5 shadow-lg shadow-primary-600/25 hover:bg-primary-700 hover:shadow-primary-600/30"
  aria-label="Back to calculator"
>
  <ToolIcon name="calculator" size={20} />
</button>

{/* Noscript fallback for scroll-reveal + tabs */}
<noscript>
  <style>
    .scroll-reveal { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>

{/* Client-side scripts: tabs, scroll reveal, back-to-calc, term tooltips */}
<script>
  /* ── Tab system (progressive enhancement) ───────────────── */
  const tabNav = document.querySelector('.tool-tab-nav') as HTMLElement | null;
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tool-tab-btn');
  const tabPanels = document.querySelectorAll<HTMLElement>('.tool-tab-panel');

  if (tabNav && tabBtns.length > 0 && tabPanels.length > 0) {
    // Show tab navigation
    tabNav.style.display = 'flex';

    // Hide section headings inside panels (tab label replaces them)
    document.querySelectorAll('.tool-tab-heading').forEach(h => {
      (h as HTMLElement).style.display = 'none';
    });

    // Hide all panels except the first
    tabPanels.forEach((panel, i) => {
      if (i > 0) panel.hidden = true;
    });

    function activateTab(targetId: string) {
      tabBtns.forEach(btn => {
        const isActive = btn.dataset.tab === targetId;
        btn.setAttribute('aria-selected', String(isActive));
        btn.tabIndex = isActive ? 0 : -1;
        if (isActive) {
          btn.classList.add('border-primary-500', 'text-primary-700', 'dark:text-primary-400', 'bg-white', 'dark:bg-neutral-900');
          btn.classList.remove('border-transparent', 'text-neutral-500', 'dark:text-neutral-500');
        } else {
          btn.classList.remove('border-primary-500', 'text-primary-700', 'dark:text-primary-400', 'bg-white', 'dark:bg-neutral-900');
          btn.classList.add('border-transparent', 'text-neutral-500', 'dark:text-neutral-500');
        }
      });
      tabPanels.forEach(panel => {
        panel.hidden = panel.dataset.tabPanel !== targetId;
      });
      // Re-point the "On this page" rail at the newly visible panel
      const active = Array.from(tabPanels).find(p => p.dataset.tabPanel === targetId);
      if (active) watchToc(active);
    }

    // Click handler
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.tab;
        if (id) activateTab(id);
      });
    });

    // Keyboard navigation (arrow keys between tabs)
    tabNav.addEventListener('keydown', (e: KeyboardEvent) => {
      const tabs = Array.from(tabBtns);
      const current = tabs.findIndex(b => b.getAttribute('aria-selected') === 'true');
      let next = -1;

      if (e.key === 'ArrowRight') next = (current + 1) % tabs.length;
      else if (e.key === 'ArrowLeft') next = (current - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;

      if (next >= 0) {
        e.preventDefault();
        const id = tabs[next].dataset.tab;
        if (id) {
          activateTab(id);
          tabs[next].focus();
        }
      }
    });

    /* ── "On this page" right-rail TOC (xl+) ────────────────
       Built client-side from each panel's h2 headings. Panels with
       fewer than 3 h2s get no rail — their grid wrapper is released
       so content spans naturally. The scroll-spy observer follows
       whichever panel is active. */
    const slugifyHeading = (text: string) =>
      text
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');

    const TOC_ACTIVE = ['border-primary-600', 'text-primary-700', 'font-medium'];
    const TOC_IDLE = ['border-transparent', 'text-neutral-500'];
    let tocObserver: IntersectionObserver | null = null;

    const panelHeadings = (panel: HTMLElement) =>
      Array.from(panel.querySelectorAll<HTMLElement>('h2')).filter(
        h => !h.classList.contains('tool-tab-heading')
      );

    // Build each panel's TOC list once (content is static)
    tabPanels.forEach(panel => {
      const rail = panel.querySelector<HTMLElement>('[data-toc-rail]');
      const list = panel.querySelector<HTMLElement>('[data-toc-list]');
      const grid = panel.querySelector<HTMLElement>('[data-toc-grid]');
      if (!rail || !list || !grid) return;

      const headings = panelHeadings(panel);
      if (headings.length < 3) {
        grid.classList.remove('xl:grid', 'xl:grid-cols-[minmax(0,768px)_1fr]', 'xl:gap-12');
        return;
      }

      headings.forEach(h => {
        if (!h.id) {
          const base = slugifyHeading(h.textContent || '') || 'section';
          let id = base;
          let n = 2;
          while (document.getElementById(id)) id = `${base}-${n++}`;
          h.id = id;
        }
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${h.id}`;
        link.textContent = h.textContent || '';
        link.className = 'toc-link block -ml-px border-l-2 border-transparent pl-3 py-1 text-sm text-neutral-500 hover:text-primary-700 transition-colors duration-150';
        li.appendChild(link);
        list.appendChild(li);
      });
      rail.classList.add('xl:block'); // still `hidden` below xl
    });

    function watchToc(panel: HTMLElement) {
      if (tocObserver) {
        tocObserver.disconnect();
        tocObserver = null;
      }
      const links = Array.from(panel.querySelectorAll<HTMLAnchorElement>('.toc-link'));
      if (links.length === 0) return;

      const headings = panelHeadings(panel).filter(h => h.id);
      const ids = headings.map(h => h.id);

      const setActive = (id: string) => {
        links.forEach(link => {
          const on = link.hash === `#${id}`;
          TOC_ACTIVE.forEach(c => link.classList.toggle(c, on));
          TOC_IDLE.forEach(c => link.classList.toggle(c, !on));
          if (on) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
      };

      tocObserver = new IntersectionObserver(entries => {
        for (const entry of entries) {
          const id = (entry.target as HTMLElement).id;
          if (entry.isIntersecting) {
            setActive(id);
          } else if (entry.boundingClientRect.top > 96) {
            // Heading dropped back below the tracking band — the previous
            // section is what's on screen now
            const idx = ids.indexOf(id);
            if (idx > 0) setActive(ids[idx - 1]);
          }
        }
      }, { rootMargin: '-96px 0px -60% 0px', threshold: 0 });
      headings.forEach(h => tocObserver!.observe(h));
      if (ids[0]) setActive(ids[0]);
    }

    // Watch the initially visible panel
    watchToc(tabPanels[0]);
  }

  /* ── Scroll-reveal entrance animations ─────────────────── */
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
  }

  /* ── Back-to-calculator floating button ────────────────── */
  const backBtn = document.getElementById('back-to-calc-btn');
  const calcSection = document.querySelector('[data-calc-section]');
  if (backBtn && calcSection) {
    const calcObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          backBtn.classList.remove('visible');
        } else {
          backBtn.classList.add('visible');
        }
      },
      { threshold: 0 }
    );
    calcObserver.observe(calcSection);
    backBtn.addEventListener('click', () => {
      calcSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  /* ── Financial term tooltip auto-detection ─────────────── */
  const TERMS: Record<string, string> = {
    'APR': 'Annual Percentage Rate — the yearly interest rate before compounding.',
    'APY': 'Annual Percentage Yield — the effective yearly rate including compounding.',
    'FICA': 'Federal Insurance Contributions Act — Social Security (6.2%) + Medicare (1.45%) taxes.',
    'CAGR': 'Compound Annual Growth Rate — the smoothed annual return over a time period.',
    'ROI': 'Return on Investment — the percentage gain or loss relative to the cost.',
    'Rule of 72': 'Divide 72 by your interest rate to estimate years to double your money.',
    'amortization': 'Spreading loan payments over time, with each payment covering interest and principal.',
    'compound interest': 'Interest earned on both the original deposit and previously accumulated interest.',
    '4% rule': 'Withdraw 4% of savings in year one of retirement, then adjust for inflation annually.',
    'standard deduction': 'Amount subtracted from income before tax calculation ($14,600 single, $29,200 married for 2024).',
    'PAYE': 'Pay As You Earn — the UK system where employers deduct tax before paying your salary.',
    'National Insurance': 'UK payroll tax funding state pension and benefits. Employees pay 8% on earnings £12,570–£50,270.',
    'PMI': 'Private Mortgage Insurance — required when your down payment is less than 20% of the home price.',
    'DTI': 'Debt-to-Income ratio — your monthly debt payments divided by gross monthly income.',
    'emergency fund': 'Savings covering 3–6 months of essential expenses for unexpected events.',
  };

  document.querySelectorAll('.prose strong').forEach(el => {
    const text = el.textContent?.trim();
    if (text && TERMS[text]) {
      const wrapper = document.createElement('span');
      wrapper.className = 'term-tooltip';
      wrapper.setAttribute('data-definition', TERMS[text]);
      wrapper.setAttribute('tabindex', '0');
      wrapper.setAttribute('role', 'note');
      wrapper.setAttribute('aria-label', `${text}: ${TERMS[text]}`);
      el.parentNode?.insertBefore(wrapper, el);
      wrapper.appendChild(el);
    }
  });

  /* ── GA4 Event Tracking (Sprint 36) ─────────────────── */
  const _gtag = (window as any).gtag as ((...a: unknown[]) => void) | undefined;
  const _slug = document.querySelector('[data-tool-slug]')?.getAttribute('data-tool-slug') || '';

  // Affiliate click tracking
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest?.('a.affiliate-link') as HTMLAnchorElement | null;
    if (link && _gtag) {
      _gtag('event', 'affiliate_click', {
        partner: link.dataset.affiliatePartner || '',
        placement: link.dataset.affiliatePlacement || '',
        page_type: 'tool',
      });
    }
  });

  // Calculator interaction (debounced — fires once per 5s max)
  let _calcTimer: ReturnType<typeof setTimeout> | null = null;
  const _calcEl = document.querySelector('[data-calc-section]');
  if (_calcEl) {
    _calcEl.addEventListener('input', () => {
      if (_calcTimer) return;
      _calcTimer = setTimeout(() => { _calcTimer = null; }, 5000);
      if (_gtag) _gtag('event', 'calculator_interaction', { tool_slug: _slug });
    });
  }

  // PDF export click
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest?.('[data-export-pdf]');
    if (btn && _gtag) {
      _gtag('event', 'pdf_export_click', { tool_slug: _slug });
    }
  });

  // Scroll depth milestones (50% and 90%)
  const _scrollFired = new Set<number>();
  const _pageType = _slug ? 'tool' : 'page';
  window.addEventListener('scroll', () => {
    const scrollPct = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight * 100;
    for (const depth of [50, 90]) {
      if (scrollPct >= depth && !_scrollFired.has(depth)) {
        _scrollFired.add(depth);
        if (_gtag) _gtag('event', 'scroll_depth', { depth, page_type: _pageType });
      }
    }
  }, { passive: true });

  /* ── Mobile sticky result mini-bar ─────────────────────────
     Mirrors the calculator's headline figure (element marked with
     data-headline-result + data-headline-label) into a fixed bar under the
     header, shown only while the user is inside the calculator section with
     the real headline off-screen. Keeps "results as you type" true on phones. */
  const miniBar = document.getElementById('mobile-result-bar');
  const miniLabel = document.getElementById('mobile-result-label');
  const miniValue = document.getElementById('mobile-result-value');
  if (miniBar && miniLabel && miniValue && calcSection) {
    let headlineEl: Element | null = null;
    let headlineVisible = true;
    let sectionVisible = false;

    const updateBar = () => {
      const show = sectionVisible && !headlineVisible && headlineEl !== null && window.innerWidth < 1024;
      miniBar.classList.toggle('hidden', !show);
    };

    const headlineObserver = new IntersectionObserver(([e]) => {
      headlineVisible = e.isIntersecting;
      updateBar();
    }, { rootMargin: '-64px 0px 0px 0px' });

    const sectionObserver = new IntersectionObserver(([e]) => {
      sectionVisible = e.isIntersecting;
      updateBar();
    });
    sectionObserver.observe(calcSection);

    const syncFromHeadline = () => {
      // Re-query each time: React hydration can replace the SSR node
      const h = calcSection.querySelector('[data-headline-result]');
      if (!h) return;
      if (h !== headlineEl) {
        if (headlineEl) headlineObserver.unobserve(headlineEl);
        headlineEl = h;
        headlineObserver.observe(h);
      }
      miniValue.textContent = h.textContent;
      miniLabel.textContent = h.getAttribute('data-headline-label') || '';
    };
    syncFromHeadline();
    new MutationObserver(syncFromHeadline).observe(calcSection, {
      subtree: true,
      childList: true,
      characterData: true,
    });
    window.addEventListener('resize', updateBar, { passive: true });
  }
</script>
