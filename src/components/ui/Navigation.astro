---
/**
 * Site header: logo, Tools and Guides menus, search, theme toggle, and the
 * mobile menu dialog.
 *
 * November 2026 rework (plan HO-4/HO-5/HO-9):
 * - The Tools menu is one row of columns and fits a 1280x800 screen; the panel
 *   scrolls internally if a short screen needs it (HOME-CHROME-04).
 * - A top-level Guides menu reaches the answer tables, scenarios, comparisons,
 *   methodology and author pages (HOME-CHROME-04).
 * - Search is in the header at every width (HOME-CHROME-05).
 * - Keyboard: Enter/Space opens a menu and moves focus into it, Escape closes
 *   it from the button or from inside and returns focus, and a hover-opened
 *   menu also closes on Escape (HOME-CHROME-08, WCAG 1.4.13).
 * - Mobile menu: a modal dialog with an inert background; closing it never
 *   scrolls the page (HOME-CHROME-09, F-24); categories collapse so the menu
 *   is short.
 * - Links prefetch on hover/focus, not when merely "in view" inside a hidden
 *   panel (A11Y-PERF-08).
 * - No gradient dividers, no icon chips (HOME-CHROME-17).
 */
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import SiteSearch from './SiteSearch.astro';
import { CATEGORIES, TOOLS, TOOL_COUNT, getToolPath, getToolBySlug, type ToolMeta } from '@lib/tools-data';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href;

/** Menu label: drop the redundant suffixes. */
const shortName = (t: ToolMeta) =>
  t.name.replace(/ Calculator$/, '').replace(/ Converter$/, '').replace(/ Comparison$/, '').replace(/ Generator$/, '');

const financialCategories = (['saving-and-growth', 'debt-and-loans', 'income-and-planning', 'economic'] as const).map((cat) => ({
  ...CATEGORIES[cat],
  tools: TOOLS.filter((t) => t.category === cat),
}));
const utilityTools = TOOLS.filter((t) => t.category === 'utility');
const fileTools = TOOLS.filter((t) => t.category === 'file-tools');
const otherCount = utilityTools.length + fileTools.length;

const pick = (slugs: string[]) => slugs.map((s) => getToolBySlug(s)).filter((t): t is ToolMeta => t !== undefined);
const otherPicks = pick(['pdf-compress', 'heic-to-jpg', 'image-compressor', 'pdf-merge', 'json-formatter', 'qr-code', 'password-generator']);
const mobilePopular = pick(['salary-uk', 'salary-us', 'mortgage-payment', 'mortgage-affordability', 'compound-interest', 'stamp-duty']);

const mobileGroups = [
  ...financialCategories.map((c) => ({ slug: c.slug, label: c.label, tools: c.tools })),
  { slug: 'utility', label: CATEGORIES.utility.label, tools: utilityTools },
  { slug: 'file-tools', label: CATEGORIES['file-tools'].label, tools: fileTools },
];

const guideColumns = [
  {
    heading: 'Answer tables',
    links: [
      { label: 'UK take-home pay by salary', href: '/scenarios/uk-take-home-pay/' },
      { label: 'US take-home pay by salary', href: '/scenarios/us-take-home-pay/' },
      { label: 'Mortgage payments by amount', href: '/scenarios/mortgage-payments-by-amount/' },
      { label: 'Investment growth by amount', href: '/scenarios/investment-growth/' },
    ],
    more: { label: 'All worked scenarios', href: '/scenarios/' },
  },
  {
    heading: 'Comparisons',
    links: [
      { label: 'Pension vs ISA (UK)', href: '/comparisons/pension-vs-isa-uk/' },
      { label: 'Cash ISA vs savings account (UK)', href: '/comparisons/cash-isa-vs-savings-account/' },
      { label: 'Roth vs Traditional 401(k) (US)', href: '/comparisons/roth-vs-traditional-401k/' },
      { label: '15-year vs 30-year mortgage', href: '/comparisons/15-year-vs-30-year-mortgage/' },
    ],
    more: { label: 'All comparisons', href: '/comparisons/' },
  },
  {
    heading: 'How we work',
    links: [
      { label: 'How we calculate UK take-home pay', href: '/how-we-calculate/salary-uk/' },
      { label: 'How we calculate US take-home pay', href: '/how-we-calculate/salary-us/' },
      { label: 'How we calculate mortgage payments', href: '/how-we-calculate/mortgage-payment/' },
      { label: 'How we calculate compound interest', href: '/how-we-calculate/compound-interest/' },
    ],
    more: { label: 'Who builds CalcRun', href: '/author/' },
  },
];
const mobileGuides = [
  { label: 'UK take-home pay by salary', href: '/scenarios/uk-take-home-pay/' },
  { label: 'US take-home pay by salary', href: '/scenarios/us-take-home-pay/' },
  { label: 'Worked scenarios', href: '/scenarios/' },
  { label: 'Comparisons', href: '/comparisons/' },
  { label: 'How we calculate UK take-home pay', href: '/how-we-calculate/salary-uk/' },
  { label: 'Who builds CalcRun', href: '/author/' },
];

const inGuides = /^\/(scenarios|comparisons|how-we-calculate|author)\//.test(currentPath);
const inTools = currentPath.startsWith('/tools/') && currentPath !== '/tools/';
---

<header class="site-header sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-neutral-200/80 shadow-sm" id="site-header">
  <nav class="relative max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main">
    <div class="flex items-center justify-between gap-3 h-16">
      <Logo />

      {/* Desktop menus */}
      <ul class="hidden lg:flex items-center gap-1 mr-auto ml-6">
        <li class="nav-item" data-nav-item>
          <button
            type="button"
            class:list={['nav-trigger', { 'is-section': inTools }]}
            id="nav-trigger-tools"
            aria-expanded="false"
            aria-controls="nav-panel-tools"
          >
            Tools
            <svg class="nav-chevron w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="nav-panel" id="nav-panel-tools" data-nav-panel>
            <div class="nav-panel-inner">
              <div class="nav-tools-grid">
                {financialCategories.map((cat) => (
                  <div>
                    <p class="nav-col-heading">{cat.label}</p>
                    <ul>
                      {cat.tools.map((tool) => (
                        <li>
                          <a href={getToolPath(tool)} class="nav-panel-link" aria-current={isCurrent(getToolPath(tool)) ? 'page' : undefined} data-astro-prefetch="hover">{shortName(tool)}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
                <div class="nav-col-other">
                  <p class="nav-col-heading">File &amp; developer tools</p>
                  <ul>
                    {otherPicks.map((tool) => (
                      <li>
                        <a href={getToolPath(tool)} class="nav-panel-link" aria-current={isCurrent(getToolPath(tool)) ? 'page' : undefined} data-astro-prefetch="hover">{shortName(tool)}</a>
                      </li>
                    ))}
                    <li>
                      <a href="/tools/#file-tools" class="nav-panel-link nav-more" data-astro-prefetch="hover">All {otherCount} file &amp; developer tools</a>
                    </li>
                  </ul>
                </div>
              </div>
              <div class="nav-panel-foot">
                <a href="/tools/" class="nav-more" data-astro-prefetch="hover">
                  View all {TOOL_COUNT} tools
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </a>
              </div>
            </div>
          </div>
        </li>

        <li class="nav-item" data-nav-item>
          <button
            type="button"
            class:list={['nav-trigger', { 'is-section': inGuides }]}
            id="nav-trigger-guides"
            aria-expanded="false"
            aria-controls="nav-panel-guides"
          >
            Guides
            <svg class="nav-chevron w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="nav-panel" id="nav-panel-guides" data-nav-panel>
            <div class="nav-panel-inner">
              <div class="nav-guides-grid">
                {guideColumns.map((col) => (
                  <div>
                    <p class="nav-col-heading">{col.heading}</p>
                    <ul>
                      {col.links.map((l) => (
                        <li><a href={l.href} class="nav-panel-link" aria-current={isCurrent(l.href) ? 'page' : undefined} data-astro-prefetch="hover">{l.label}</a></li>
                      ))}
                      <li><a href={col.more.href} class="nav-panel-link nav-more" aria-current={isCurrent(col.more.href) ? 'page' : undefined} data-astro-prefetch="hover">{col.more.label}</a></li>
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </li>

        <li>
          <a href="/tools/" class:list={['nav-link', { 'is-section': currentPath === '/tools/' }]} aria-current={currentPath === '/tools/' ? 'page' : undefined} data-astro-prefetch="hover">All tools</a>
        </li>
        <li>
          <a href="/about/" class:list={['nav-link', { 'is-section': currentPath === '/about/' }]} aria-current={currentPath === '/about/' ? 'page' : undefined} data-astro-prefetch="hover">About</a>
        </li>
      </ul>

      <div class="flex items-center gap-1 -mr-2 lg:mr-0">
        <SiteSearch id="site-search" variant="header" />
        <ThemeToggle />
        <button
          type="button"
          id="mobile-menu-btn"
          class="menu-btn w-11 h-11 items-center justify-center text-neutral-700 hover:text-primary-600 transition-colors duration-150 rounded-lg lg:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        {/* Without JavaScript the menu button cannot open anything: link to the full list instead */}
        <a href="/tools/" class="nojs-menu-link px-3 py-2 text-sm font-medium text-neutral-700 lg:hidden">All tools</a>
      </div>
    </div>
  </nav>
</header>

{/* Mobile menu dialog — OUTSIDE the header so the header's backdrop-filter is not its containing block (WebKit) */}
<div
  id="mobile-menu"
  class="mobile-menu fixed inset-0 z-[60] hidden lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-menu-title"
>
  <div class="mobile-backdrop absolute inset-0 bg-black/20 backdrop-blur-sm" aria-hidden="true"></div>

  <div class="mobile-panel absolute top-0 right-0 bottom-0 w-full max-w-[360px] bg-white shadow-2xl overflow-y-auto overscroll-contain">
    <div class="px-5 py-4">
      <div class="flex items-center justify-between mb-6">
        <Logo />
        <button
          type="button"
          id="mobile-menu-close"
          class="w-11 h-11 -mr-2 flex items-center justify-center text-neutral-700 hover:text-primary-600 rounded-lg hover:bg-neutral-50 transition-colors duration-150"
          aria-label="Close menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <p id="mobile-menu-title" class="sr-only">Site menu</p>

      <nav aria-label="Mobile" class="space-y-6">
        <div>
          <p class="m-heading">Popular</p>
          <ul>
            {mobilePopular.map((tool) => (
              <li><a href={getToolPath(tool)} class="m-link" aria-current={isCurrent(getToolPath(tool)) ? 'page' : undefined}>{shortName(tool)}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <p class="m-heading">All tools by category</p>
          <ul class="border-t border-neutral-200/80">
            {mobileGroups.map((g) => (
              <li class="m-group border-b border-neutral-200/80" data-m-group>
                <button type="button" class="m-group-btn" aria-expanded="false" aria-controls={`m-group-${g.slug}`}>
                  <span>{g.label}</span>
                  <span class="m-group-meta">
                    <span>{g.tools.length}</span>
                    <svg class="m-chevron w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                  </span>
                </button>
                <div class="m-group-body" id={`m-group-${g.slug}`} inert>
                  <ul class="m-group-inner">
                    {g.tools.map((tool) => (
                      <li><a href={getToolPath(tool)} class="m-link m-link-sub" aria-current={isCurrent(getToolPath(tool)) ? 'page' : undefined}>{shortName(tool)}</a></li>
                    ))}
                  </ul>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="m-heading">Guides</p>
          <ul>
            {mobileGuides.map((l) => (
              <li><a href={l.href} class="m-link" aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </div>

        <ul class="border-t border-neutral-200/80 pt-4">
          <li><a href="/" class="m-link" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a></li>
          <li><a href="/tools/" class="m-link" aria-current={currentPath === '/tools/' ? 'page' : undefined}>All {TOOL_COUNT} tools</a></li>
          <li><a href="/about/" class="m-link" aria-current={currentPath === '/about/' ? 'page' : undefined}>About</a></li>
        </ul>
      </nav>
    </div>
  </div>
</div>

<style>
  /* Focusing anything in the sticky header must never scroll the page: the
     global scroll-padding-top plus a sticky element made Chromium scroll a
     focused header control to the middle of the padded viewport (~400px jump
     on menu, search and theme buttons). A huge negative scroll margin means
     "already in view". */
  :global(.site-header),
  :global(.site-header *) { scroll-margin-block: -100vh; }

  /* ── Desktop menus ── */
  .nav-trigger,
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-neutral-700);
    transition: color 150ms ease, background-color 150ms ease;
  }
  .nav-trigger:hover,
  .nav-link:hover,
  .nav-item.is-open .nav-trigger { color: var(--color-primary-600); background: var(--color-neutral-50); }
  .nav-trigger.is-section,
  .nav-link.is-section { color: var(--color-primary-600); }
  .nav-chevron { transition: transform 200ms ease; }
  .nav-item.is-open .nav-chevron { transform: rotate(180deg); }

  .nav-panel {
    position: absolute;
    left: 1rem;
    right: 1rem;
    top: 100%;
    padding-top: 0.5rem; /* hover bridge between button and panel */
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 0s linear 180ms;
  }
  /* Visibility flips instantly on open so focus can move into the panel at once */
  .nav-item.is-open .nav-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 180ms ease, transform 180ms ease, visibility 0s;
  }
  /* No JavaScript: hover and keyboard focus still open the menus */
  :global(html:not(.js)) .nav-item:hover .nav-panel,
  :global(html:not(.js)) .nav-item:focus-within .nav-panel { opacity: 1; visibility: visible; transform: none; }
  @media (min-width: 1024px) {
    .nav-panel { left: 2rem; right: 2rem; }
  }

  .nav-panel-inner {
    max-height: calc(100vh - 5.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-surface);
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.75rem;
    box-shadow: var(--shadow-card-hover);
    padding: 1.25rem 1.25rem 0.75rem;
  }
  .nav-tools-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(0, 1.1fr);
    gap: 1rem 1.25rem;
  }
  .nav-col-other { padding-left: 1.25rem; border-left: 1px solid var(--color-neutral-200); }
  .nav-guides-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    padding-bottom: 0.5rem;
  }
  .nav-col-heading {
    margin: 0 0 0.375rem;
    padding: 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-neutral-600);
  }
  .nav-panel-link {
    display: block;
    padding: 0.375rem 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--color-neutral-800);
    transition: color 150ms ease, background-color 150ms ease;
  }
  .nav-panel-link:hover { color: var(--color-primary-600); background: var(--color-neutral-50); }
  .nav-panel-link[aria-current='page'] { color: var(--color-primary-700); background: var(--color-primary-50); font-weight: 500; }
  .nav-more { color: var(--color-primary-700); font-weight: 600; }
  .nav-panel-foot {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-neutral-200);
  }
  .nav-panel-foot .nav-more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.5rem;
    font-size: 0.875rem;
    border-radius: 0.375rem;
  }
  .nav-panel-foot .nav-more:hover { background: var(--color-primary-50); }

  /* ── Header buttons that need JavaScript ── */
  .menu-btn { display: none; }
  :global(html.js) .menu-btn { display: inline-flex; }
  :global(html.js) .nojs-menu-link { display: none; }
  @media (min-width: 1024px) {
    :global(html.js) .menu-btn,
    .nojs-menu-link { display: none; }
  }

  /* ── Mobile menu ── */
  .mobile-menu.open .mobile-backdrop { animation: fadeIn 200ms ease-out forwards; }
  .mobile-menu.open .mobile-panel { animation: slideIn 250ms ease-out forwards; }
  .mobile-menu.closing .mobile-backdrop { animation: fadeOut 200ms ease-in forwards; }
  .mobile-menu.closing .mobile-panel { animation: slideOut 200ms ease-in forwards; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
  @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
  @keyframes slideOut { from { transform: translateX(0); } to { transform: translateX(100%); } }
  :global(html.menu-open) body { overflow: hidden; }

  .m-heading {
    margin: 0 0 0.25rem;
    padding: 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-neutral-600);
  }
  .m-link {
    display: block;
    padding: 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-neutral-800);
    transition: background-color 150ms ease, color 150ms ease;
  }
  .m-link:hover { background: var(--color-neutral-50); }
  .m-link[aria-current='page'] { color: var(--color-primary-700); background: var(--color-primary-50); font-weight: 500; }
  .m-link-sub { padding-left: 1.25rem; }
  .m-group-btn {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-neutral-900);
    text-align: left;
  }
  .m-group-meta { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; color: var(--color-neutral-600); }
  .m-chevron { transition: transform 200ms ease; }
  .m-group.is-open .m-chevron { transform: rotate(180deg); }
  .m-group-body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 220ms ease, opacity 180ms ease;
  }
  .m-group.is-open .m-group-body { grid-template-rows: 1fr; opacity: 1; }
  .m-group-inner { overflow: hidden; min-height: 0; padding-bottom: 0; }
  .m-group.is-open .m-group-inner { padding-bottom: 0.5rem; }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu.open .mobile-backdrop,
    .mobile-menu.open .mobile-panel,
    .mobile-menu.closing .mobile-backdrop,
    .mobile-menu.closing .mobile-panel { animation-duration: 0.01ms; }
    .nav-panel,
    .nav-item.is-open .nav-panel { transform: none; transition: none; }
    .m-group-body { transition: none; }
  }
</style>

<script>
  /* ── Desktop menus: click, hover, keyboard ── */
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-item]'));
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  let hoverSuppressed: HTMLElement | null = null;

  const triggerOf = (item: HTMLElement) => item.querySelector<HTMLButtonElement>('.nav-trigger');

  function closeItem(item: HTMLElement, restoreFocus = false) {
    if (!item.classList.contains('is-open')) return;
    item.classList.remove('is-open');
    item.dataset.pinned = '';
    const t = triggerOf(item);
    t?.setAttribute('aria-expanded', 'false');
    if (restoreFocus) t?.focus({ preventScroll: true });
  }

  function openItem(item: HTMLElement, opts: { pin?: boolean; focusFirst?: boolean } = {}) {
    items.forEach((other) => other !== item && closeItem(other));
    item.classList.add('is-open');
    if (opts.pin) item.dataset.pinned = '1';
    triggerOf(item)?.setAttribute('aria-expanded', 'true');
    if (opts.focusFirst) item.querySelector<HTMLElement>('.nav-panel a[href]')?.focus({ preventScroll: true });
  }

  items.forEach((item) => {
    const trigger = triggerOf(item);
    if (!trigger) return;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    trigger.addEventListener('click', (e) => {
      const fromKeyboard = (e as MouseEvent).detail === 0;
      if (item.classList.contains('is-open') && (item.dataset.pinned || fromKeyboard)) {
        closeItem(item);
      } else {
        openItem(item, { pin: true, focusFirst: fromKeyboard });
      }
    });

    item.addEventListener('mouseenter', () => {
      if (!canHover.matches || hoverSuppressed === item) return;
      clearTimeout(closeTimer);
      if (!item.classList.contains('is-open')) openItem(item);
    });
    item.addEventListener('mouseleave', () => {
      if (hoverSuppressed === item) hoverSuppressed = null;
      if (item.dataset.pinned) return;
      closeTimer = setTimeout(() => {
        if (!item.contains(document.activeElement)) closeItem(item);
      }, 150);
    });

    // Escape from the button or anywhere inside the panel
    item.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !item.classList.contains('is-open')) return;
      e.stopPropagation();
      hoverSuppressed = item;
      closeItem(item, true);
    });

    item.addEventListener('focusout', () => {
      setTimeout(() => {
        if (!item.contains(document.activeElement) && !item.matches(':hover')) closeItem(item);
      }, 0);
    });
  });

  // A hover-opened menu closes on Escape even when focus is elsewhere (WCAG 1.4.13)
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    items.forEach((item) => {
      if (item.classList.contains('is-open')) {
        hoverSuppressed = item;
        closeItem(item, item.contains(document.activeElement));
      }
    });
  });
  document.addEventListener('click', (e) => {
    items.forEach((item) => {
      if (!item.contains(e.target as Node)) closeItem(item);
    });
  });

  /* ── Mobile menu dialog ── */
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const backdrop = mobileMenu?.querySelector('.mobile-backdrop');
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  /** Make everything except the dialog inert while it is open (F-24). */
  function setBackgroundInert(on: boolean) {
    Array.from(document.body.children).forEach((el) => {
      if (el === mobileMenu || el.tagName === 'SCRIPT') return;
      const h = el as HTMLElement;
      if (on && !h.inert) {
        h.inert = true;
        h.dataset.menuInert = '1';
      } else if (!on && h.dataset.menuInert) {
        h.inert = false;
        delete h.dataset.menuInert;
      }
    });
  }

  function openMenu() {
    if (!mobileMenu) return;
    clearTimeout(closeTimer);
    mobileMenu.classList.remove('hidden', 'closing');
    mobileMenu.classList.add('open');
    document.documentElement.classList.add('menu-open');
    menuBtn?.setAttribute('aria-expanded', 'true');
    setBackgroundInert(true);
    closeBtn?.focus({ preventScroll: true });
  }

  function closeMenu() {
    if (!mobileMenu || mobileMenu.classList.contains('hidden')) return;
    mobileMenu.classList.remove('open');
    mobileMenu.classList.add('closing');
    setBackgroundInert(false);
    menuBtn?.setAttribute('aria-expanded', 'false');
    // preventScroll: focusing the button must not scroll the page (HOME-CHROME-09)
    menuBtn?.focus({ preventScroll: true });
    closeTimer = setTimeout(() => {
      mobileMenu.classList.add('hidden');
      mobileMenu.classList.remove('closing');
      document.documentElement.classList.remove('menu-open');
    }, 200);
  }

  menuBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);
  // Navigating to an anchor on the same page closes the menu first
  mobileMenu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest?.('a[href]')) closeMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (!mobileMenu || mobileMenu.classList.contains('hidden') || mobileMenu.classList.contains('closing')) return;
    if (e.key === 'Escape') {
      closeMenu();
      return;
    }
    // Focus trap: keep Tab inside the dialog (skipping collapsed groups)
    if (e.key === 'Tab') {
      const focusable = Array.from(
        mobileMenu.querySelectorAll<HTMLElement>('a[href], button, [tabindex]:not([tabindex="-1"])')
      ).filter((el) => !el.closest('[inert]'));
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Collapsible categories inside the mobile menu
  document.querySelectorAll<HTMLElement>('[data-m-group]').forEach((group) => {
    const btn = group.querySelector<HTMLButtonElement>('.m-group-btn');
    const body = group.querySelector<HTMLElement>('.m-group-body');
    if (!btn || !body) return;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      group.classList.toggle('is-open', open);
      body.inert = !open;
    });
  });
</script>
