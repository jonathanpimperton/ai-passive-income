---
import Logo from './Logo.astro';
import { CATEGORIES, TOOLS, getToolPath } from '@lib/tools-data';

const currentPath = Astro.url.pathname;

// Group tools by category for dropdown (excluding utility — shown separately)
const financialCategories = (['saving-and-growth', 'debt-and-loans', 'income-and-planning', 'economic'] as const)
  .map((cat) => ({
    ...CATEGORIES[cat],
    tools: TOOLS.filter((t) => t.category === cat),
  }));
---

<header class="sticky top-0 z-50 bg-white border-b border-neutral-200">
  <nav class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16">
      <Logo />

      {/* Desktop navigation */}
      <div class="hidden lg:flex items-center gap-8">
        {/* Calculators dropdown */}
        <div class="relative group">
          <button
            class="flex items-center gap-1 text-sm font-medium text-neutral-700 hover:text-primary-500 transition-colors duration-150"
            aria-expanded="false"
            aria-haspopup="true"
          >
            Calculators
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          {/* Dropdown panel */}
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150">
            <div class="bg-white rounded-lg shadow-card-hover border border-neutral-200 p-6 min-w-[480px] grid grid-cols-2 gap-6">
              {financialCategories.map((cat) => (
                <div>
                  <h3 class="text-xs font-semibold text-neutral-500 uppercase tracking-wide mb-2">
                    {cat.label}
                  </h3>
                  <ul class="space-y-1">
                    {cat.tools.map((tool) => (
                      <li>
                        <a
                          href={getToolPath(tool)}
                          class:list={[
                            "block px-2 py-1.5 text-sm rounded-md transition-colors duration-150",
                            currentPath === getToolPath(tool)
                              ? "text-primary-500 bg-primary-50 font-medium"
                              : "text-neutral-700 hover:text-primary-500 hover:bg-neutral-50",
                          ]}
                        >
                          {tool.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>

        <a
          href="/tools"
          class:list={[
            "text-sm font-medium transition-colors duration-150",
            currentPath === '/tools' || currentPath === '/tools/'
              ? "text-primary-500"
              : "text-neutral-700 hover:text-primary-500",
          ]}
        >
          All Tools
        </a>

        <a
          href="/about"
          class:list={[
            "text-sm font-medium transition-colors duration-150",
            currentPath === '/about' || currentPath === '/about/'
              ? "text-primary-500"
              : "text-neutral-700 hover:text-primary-500",
          ]}
        >
          About
        </a>
      </div>

      {/* Mobile hamburger */}
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 -mr-2 text-neutral-700 hover:text-primary-500"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  {/* Mobile menu overlay */}
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 bg-white hidden lg:hidden overflow-y-auto"
    role="dialog"
    aria-label="Mobile navigation"
  >
    <div class="px-4 py-4">
      <div class="flex items-center justify-between mb-8">
        <Logo />
        <button
          id="mobile-menu-close"
          class="p-2 -mr-2 text-neutral-700 hover:text-primary-500"
          aria-label="Close menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="space-y-6">
        {financialCategories.map((cat) => (
          <div>
            <h3 class="text-xs font-semibold text-neutral-500 uppercase tracking-wide mb-2 px-2">
              {cat.label}
            </h3>
            <ul class="space-y-1">
              {cat.tools.map((tool) => (
                <li>
                  <a
                    href={getToolPath(tool)}
                    class:list={[
                      "block px-2 py-2.5 text-base rounded-md",
                      currentPath === getToolPath(tool)
                        ? "text-primary-500 bg-primary-50 font-medium"
                        : "text-neutral-700",
                    ]}
                  >
                    {tool.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="border-t border-neutral-200 pt-6 space-y-1">
          <a href="/tools" class="block px-2 py-2.5 text-base font-medium text-neutral-700">
            All Tools
          </a>
          <a href="/about" class="block px-2 py-2.5 text-base font-medium text-neutral-700">
            About
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');

  function openMenu() {
    mobileMenu?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    menuBtn?.setAttribute('aria-expanded', 'true');
  }

  function closeMenu() {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
    menuBtn?.setAttribute('aria-expanded', 'false');
  }

  menuBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  // Close on outside click
  mobileMenu?.addEventListener('click', (e) => {
    if (e.target === mobileMenu) closeMenu();
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
