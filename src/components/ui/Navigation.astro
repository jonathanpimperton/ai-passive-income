---
import Logo from './Logo.astro';
import ToolIcon from './ToolIcon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { CATEGORIES, TOOLS, getToolPath } from '@lib/tools-data';

const currentPath = Astro.url.pathname;

// Group tools by category for dropdown
const financialCategories = (['saving-and-growth', 'debt-and-loans', 'income-and-planning', 'economic'] as const)
  .map((cat) => ({
    ...CATEGORIES[cat],
    tools: TOOLS.filter((t) => t.category === cat),
  }));

// Utility and file tool categories for the "More Tools" column
const utilityTools = TOOLS.filter((t) => t.category === 'utility').slice(0, 4);
const fileTools = TOOLS.filter((t) => t.category === 'file-tools').slice(0, 4);
const allUtilityTools = TOOLS.filter((t) => t.category === 'utility');
const allFileTools = TOOLS.filter((t) => t.category === 'file-tools');
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-neutral-200/80 shadow-sm">
  <nav class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16">
      <Logo />

      {/* Desktop navigation */}
      <div class="hidden lg:flex items-center gap-8">
        <a
          href="/"
          class:list={[
            "text-sm font-medium transition-colors duration-150",
            currentPath === '/' || currentPath === ''
              ? "text-primary-600"
              : "text-neutral-700 hover:text-primary-600",
          ]}
        >
          Home
        </a>

        {/* Calculators dropdown */}
        <div class="relative group" id="desktop-dropdown">
          <button
            id="desktop-dropdown-btn"
            class="flex items-center gap-1.5 text-sm font-medium text-neutral-700 hover:text-primary-600 transition-colors duration-150 py-2"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="desktop-dropdown-panel"
          >
            Tools
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          {/* Dropdown panel */}
          <div id="desktop-dropdown-panel" class="nav-dropdown absolute left-1/2 -translate-x-1/2 top-full pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 group-hover:translate-y-0 translate-y-1">
            <div class="bg-white rounded-xl shadow-lg border border-neutral-200/80 p-5 min-w-[740px] grid grid-cols-3 gap-5">
              {/* Financial calculator categories — 2 columns */}
              {financialCategories.map((cat) => (
                <div>
                  <h3 class="text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-2.5 px-2">
                    {cat.label}
                  </h3>
                  <ul class="space-y-0.5">
                    {cat.tools.map((tool) => (
                      <li>
                        <a
                          href={getToolPath(tool)}
                          class:list={[
                            "flex items-center gap-2.5 px-2 py-2 text-sm rounded-lg transition-all duration-150",
                            currentPath === getToolPath(tool)
                              ? "text-primary-600 bg-primary-50 font-medium"
                              : "text-neutral-700 hover:text-primary-600 hover:bg-neutral-50",
                          ]}
                        >
                          <div class:list={[
                            "inline-flex items-center justify-center w-7 h-7 rounded-md shrink-0 transition-colors duration-150",
                            currentPath === getToolPath(tool)
                              ? "bg-primary-100 text-primary-600"
                              : "bg-neutral-100 text-neutral-500",
                          ]}>
                            <ToolIcon name={tool.icon} size={15} />
                          </div>
                          {tool.name.replace(' Calculator', '')}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}

              {/* Utility & File Tools — 3rd column */}
              <div class="space-y-5">
                <div>
                  <h3 class="text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-2.5 px-2">
                    Utility
                  </h3>
                  <ul class="space-y-0.5">
                    {utilityTools.map((tool) => (
                      <li>
                        <a
                          href={getToolPath(tool)}
                          class:list={[
                            "flex items-center gap-2.5 px-2 py-2 text-sm rounded-lg transition-all duration-150",
                            currentPath === getToolPath(tool)
                              ? "text-primary-600 bg-primary-50 font-medium"
                              : "text-neutral-700 hover:text-primary-600 hover:bg-neutral-50",
                          ]}
                        >
                          <div class:list={[
                            "inline-flex items-center justify-center w-7 h-7 rounded-md shrink-0 transition-colors duration-150",
                            currentPath === getToolPath(tool)
                              ? "bg-primary-100 text-primary-600"
                              : "bg-neutral-100 text-neutral-500",
                          ]}>
                            <ToolIcon name={tool.icon} size={15} />
                          </div>
                          {tool.name.replace(' Converter', '').replace(' Generator', '')}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3 class="text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-2.5 px-2">
                    File Tools
                  </h3>
                  <ul class="space-y-0.5">
                    {fileTools.map((tool) => (
                      <li>
                        <a
                          href={getToolPath(tool)}
                          class:list={[
                            "flex items-center gap-2.5 px-2 py-2 text-sm rounded-lg transition-all duration-150",
                            currentPath === getToolPath(tool)
                              ? "text-primary-600 bg-primary-50 font-medium"
                              : "text-neutral-700 hover:text-primary-600 hover:bg-neutral-50",
                          ]}
                        >
                          <div class:list={[
                            "inline-flex items-center justify-center w-7 h-7 rounded-md shrink-0 transition-colors duration-150",
                            currentPath === getToolPath(tool)
                              ? "bg-primary-100 text-primary-600"
                              : "bg-neutral-100 text-neutral-500",
                          ]}>
                            <ToolIcon name={tool.icon} size={15} />
                          </div>
                          {tool.name.replace(' Converter', '')}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <a
                  href="/scenarios"
                  class="flex items-center gap-2 px-2 py-2 text-sm text-neutral-600 hover:text-primary-600 hover:bg-neutral-50 rounded-lg transition-all duration-150"
                >
                  <div class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-neutral-100 text-neutral-500 shrink-0">
                    <ToolIcon name="calculator" size={15} />
                  </div>
                  Scenarios
                </a>
                <a
                  href="/tools"
                  class="flex items-center gap-2 px-2 py-2 text-sm font-medium text-primary-600 hover:text-primary-700 hover:bg-primary-50 rounded-lg transition-all duration-150"
                >
                  View all 37+ tools
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <a
          href="/tools"
          class:list={[
            "text-sm font-medium transition-colors duration-150",
            currentPath === '/tools' || currentPath === '/tools/'
              ? "text-primary-600"
              : "text-neutral-700 hover:text-primary-600",
          ]}
        >
          All Tools
        </a>

        <a
          href="/about"
          class:list={[
            "text-sm font-medium transition-colors duration-150",
            currentPath === '/about' || currentPath === '/about/'
              ? "text-primary-600"
              : "text-neutral-700 hover:text-primary-600",
          ]}
        >
          About
        </a>

        {/* Header search */}
        <div class="relative" id="header-search-wrapper">
          <button
            id="header-search-btn"
            class="p-2 text-neutral-500 hover:text-primary-600 transition-colors duration-150 rounded-lg hover:bg-neutral-50"
            aria-label="Search tools"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
          <div id="header-search-dropdown" class="absolute right-0 top-full mt-2 w-[360px] bg-white rounded-xl shadow-xl border border-neutral-200/80 overflow-hidden hidden z-50">
            <div class="p-3 border-b border-neutral-100">
              <input
                type="search"
                id="header-search-input"
                placeholder="Search tools..."
                class="w-full px-3 py-2 text-sm rounded-lg bg-neutral-50 border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent"
                autocomplete="off"
              />
            </div>
            <div id="header-search-results" class="max-h-[320px] overflow-y-auto"></div>
          </div>
        </div>

        <ThemeToggle />
      </div>

      {/* Mobile: theme toggle + hamburger */}
      <div class="flex items-center gap-1 lg:hidden">
        <ThemeToggle />
      </div>
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 -mr-2 text-neutral-700 hover:text-primary-600 transition-colors duration-150"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>
</header>

{/* Mobile menu overlay — OUTSIDE header to avoid backdrop-filter containing block issue on mobile WebKit */}
<div
  id="mobile-menu"
  class="mobile-menu fixed inset-0 z-50 hidden lg:hidden"
  role="dialog"
  aria-label="Mobile navigation"
>
  {/* Backdrop */}
  <div class="mobile-backdrop absolute inset-0 bg-black/20 backdrop-blur-sm" aria-hidden="true"></div>

  {/* Menu panel */}
  <div class="mobile-panel absolute top-0 right-0 bottom-0 w-full max-w-[340px] bg-white shadow-2xl overflow-y-auto">
    <div class="px-5 py-4">
      <div class="flex items-center justify-between mb-8">
        <Logo />
        <button
          id="mobile-menu-close"
          class="p-2 -mr-2 text-neutral-700 hover:text-primary-600 rounded-lg hover:bg-neutral-50 transition-colors duration-150"
          aria-label="Close menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="space-y-7">
        {financialCategories.map((cat) => (
          <div>
            <h3 class="text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-2 px-2">
              {cat.label}
            </h3>
            <ul class="space-y-0.5">
              {cat.tools.map((tool) => (
                <li>
                  <a
                    href={getToolPath(tool)}
                    class:list={[
                      "flex items-center gap-3 px-2 py-2.5 text-[15px] rounded-lg transition-colors duration-150",
                      currentPath === getToolPath(tool)
                        ? "text-primary-600 bg-primary-50 font-medium"
                        : "text-neutral-700 hover:bg-neutral-50",
                    ]}
                  >
                    <div class:list={[
                      "inline-flex items-center justify-center w-8 h-8 rounded-lg shrink-0",
                      currentPath === getToolPath(tool)
                        ? "bg-primary-100 text-primary-600"
                        : "bg-neutral-100 text-neutral-500",
                    ]}>
                      <ToolIcon name={tool.icon} size={16} />
                    </div>
                    {tool.name.replace(' Calculator', '')}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        {/* Utility Tools */}
        <div>
          <h3 class="text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-2 px-2">
            Utility
          </h3>
          <ul class="space-y-0.5">
            {allUtilityTools.map((tool) => (
              <li>
                <a
                  href={getToolPath(tool)}
                  class:list={[
                    "flex items-center gap-3 px-2 py-2.5 text-[15px] rounded-lg transition-colors duration-150",
                    currentPath === getToolPath(tool)
                      ? "text-primary-600 bg-primary-50 font-medium"
                      : "text-neutral-700 hover:bg-neutral-50",
                  ]}
                >
                  <div class:list={[
                    "inline-flex items-center justify-center w-8 h-8 rounded-lg shrink-0",
                    currentPath === getToolPath(tool)
                      ? "bg-primary-100 text-primary-600"
                      : "bg-neutral-100 text-neutral-500",
                  ]}>
                    <ToolIcon name={tool.icon} size={16} />
                  </div>
                  {tool.name.replace(' Generator', '').replace(' Converter', '')}
                </a>
              </li>
            ))}
          </ul>
        </div>

        {/* File Tools */}
        <div>
          <h3 class="text-[11px] font-semibold text-neutral-400 uppercase tracking-wider mb-2 px-2">
            File Tools
          </h3>
          <ul class="space-y-0.5">
            {allFileTools.map((tool) => (
              <li>
                <a
                  href={getToolPath(tool)}
                  class:list={[
                    "flex items-center gap-3 px-2 py-2.5 text-[15px] rounded-lg transition-colors duration-150",
                    currentPath === getToolPath(tool)
                      ? "text-primary-600 bg-primary-50 font-medium"
                      : "text-neutral-700 hover:bg-neutral-50",
                  ]}
                >
                  <div class:list={[
                    "inline-flex items-center justify-center w-8 h-8 rounded-lg shrink-0",
                    currentPath === getToolPath(tool)
                      ? "bg-primary-100 text-primary-600"
                      : "bg-neutral-100 text-neutral-500",
                  ]}>
                    <ToolIcon name={tool.icon} size={16} />
                  </div>
                  {tool.name.replace(' Converter', '')}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="border-t border-neutral-200 pt-6 space-y-0.5">
          <a href="/" class:list={[
            "flex items-center gap-3 px-2 py-2.5 text-[15px] font-medium rounded-lg transition-colors duration-150",
            currentPath === '/' || currentPath === ''
              ? "text-primary-600 bg-primary-50"
              : "text-neutral-700 hover:bg-neutral-50",
          ]}>
            <div class:list={[
              "inline-flex items-center justify-center w-8 h-8 rounded-lg shrink-0",
              currentPath === '/' || currentPath === ''
                ? "bg-primary-100 text-primary-600"
                : "bg-neutral-100 text-neutral-500",
            ]}>
              <ToolIcon name="home" size={16} />
            </div>
            Home
          </a>
          <a href="/tools" class="flex items-center gap-3 px-2 py-2.5 text-[15px] font-medium text-neutral-700 rounded-lg hover:bg-neutral-50 transition-colors duration-150">
            <div class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-neutral-100 text-neutral-500 shrink-0">
              <ToolIcon name="search" size={16} />
            </div>
            All Tools
          </a>
          <a href="/about" class="flex items-center gap-3 px-2 py-2.5 text-[15px] font-medium text-neutral-700 rounded-lg hover:bg-neutral-50 transition-colors duration-150">
            <div class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-neutral-100 text-neutral-500 shrink-0">
              <ToolIcon name="info" size={16} />
            </div>
            About
          </a>
        </div>
      </nav>
    </div>
  </div>
</div>

<style>
  /* Mobile menu slide-in animation */
  .mobile-menu.open .mobile-backdrop {
    animation: fadeIn 200ms ease-out forwards;
  }
  .mobile-menu.open .mobile-panel {
    animation: slideIn 250ms ease-out forwards;
  }
  .mobile-menu.closing .mobile-backdrop {
    animation: fadeOut 200ms ease-in forwards;
  }
  .mobile-menu.closing .mobile-panel {
    animation: slideOut 200ms ease-in forwards;
  }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
  @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
  @keyframes slideOut { from { transform: translateX(0); } to { transform: translateX(100%); } }

  /* Desktop dropdown subtle slide */
  .nav-dropdown {
    transform: translateY(4px);
  }

  /* Keyboard-opened dropdown state */
  .nav-dropdown.dropdown-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu.open .mobile-backdrop,
    .mobile-menu.open .mobile-panel,
    .mobile-menu.closing .mobile-backdrop,
    .mobile-menu.closing .mobile-panel {
      animation-duration: 0.01ms;
    }
    .nav-dropdown { transform: none; }
  }
</style>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const backdrop = mobileMenu?.querySelector('.mobile-backdrop');

  function openMenu() {
    if (!mobileMenu) return;
    mobileMenu.classList.remove('hidden', 'closing');
    mobileMenu.classList.add('open');
    document.body.style.overflow = 'hidden';
    menuBtn?.setAttribute('aria-expanded', 'true');
    closeBtn?.focus();
  }

  function closeMenu() {
    if (!mobileMenu) return;
    mobileMenu.classList.remove('open');
    mobileMenu.classList.add('closing');

    // Wait for animation to complete
    setTimeout(() => {
      mobileMenu.classList.add('hidden');
      mobileMenu.classList.remove('closing');
      document.body.style.overflow = '';
      menuBtn?.setAttribute('aria-expanded', 'false');
      menuBtn?.focus();
    }, 200);
  }

  menuBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  // Close on backdrop click
  backdrop?.addEventListener('click', closeMenu);

  // Close on Escape + focus trap
  document.addEventListener('keydown', (e) => {
    if (!mobileMenu || mobileMenu.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      closeMenu();
      return;
    }

    // Focus trap: keep Tab within the mobile menu when open
    if (e.key === 'Tab') {
      const focusable = mobileMenu.querySelectorAll<HTMLElement>(
        'a[href], button, [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // === Header search ===
  const headerSearchBtn = document.getElementById('header-search-btn');
  const headerSearchDropdown = document.getElementById('header-search-dropdown');
  const headerSearchInput = document.getElementById('header-search-input') as HTMLInputElement;
  const headerSearchResults = document.getElementById('header-search-results');
  const headerSearchWrapper = document.getElementById('header-search-wrapper');

  // Build search index from all tools
  const navTools: Array<{ name: string; description: string; path: string }> = [];
  document.querySelectorAll('#mobile-menu nav a[href^="/tools/"]').forEach((el) => {
    const a = el as HTMLAnchorElement;
    navTools.push({
      name: a.textContent?.trim() || '',
      description: '',
      path: a.pathname,
    });
  });

  // If no tools from mobile menu, use a static list
  if (navTools.length === 0) {
    // Fallback — the search will still work on the homepage where tool cards exist
  }

  function renderNavSearch(query: string) {
    if (!headerSearchResults || !headerSearchDropdown) return;
    if (!query.trim()) {
      headerSearchResults.innerHTML = '<div class="px-4 py-3 text-xs text-neutral-400">Type to search...</div>';
      return;
    }
    const q = query.toLowerCase();
    const matches = navTools.filter((t) => t.name.toLowerCase().includes(q)).slice(0, 6);
    if (matches.length === 0) {
      headerSearchResults.innerHTML = '<div class="px-4 py-3 text-sm text-neutral-500">No tools found</div>';
      return;
    }
    headerSearchResults.innerHTML = matches.map((t) =>
      `<a href="${t.path}" class="flex items-center gap-3 px-4 py-2.5 text-sm text-neutral-700 hover:bg-primary-50 hover:text-primary-600 transition-colors duration-100">
        <svg class="w-4 h-4 text-neutral-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
        ${t.name}
      </a>`
    ).join('');
  }

  headerSearchBtn?.addEventListener('click', () => {
    headerSearchDropdown?.classList.toggle('hidden');
    if (!headerSearchDropdown?.classList.contains('hidden')) {
      headerSearchInput?.focus();
      renderNavSearch(headerSearchInput?.value || '');
    }
  });

  headerSearchInput?.addEventListener('input', (e) => {
    renderNavSearch((e.target as HTMLInputElement).value);
  });

  headerSearchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      headerSearchDropdown?.classList.add('hidden');
      headerSearchBtn?.focus();
    }
  });

  // Close search on outside click
  document.addEventListener('click', (e) => {
    if (headerSearchWrapper && !headerSearchWrapper.contains(e.target as Node)) {
      headerSearchDropdown?.classList.add('hidden');
    }
  });

  // Desktop dropdown keyboard accessibility
  const dropdownBtn = document.getElementById('desktop-dropdown-btn');
  const dropdownPanel = document.getElementById('desktop-dropdown-panel');
  const dropdownContainer = document.getElementById('desktop-dropdown');

  if (dropdownBtn && dropdownPanel && dropdownContainer) {
    let dropdownOpen = false;

    function openDropdown() {
      dropdownOpen = true;
      dropdownBtn!.setAttribute('aria-expanded', 'true');
      dropdownPanel!.classList.add('dropdown-open');
    }

    function closeDropdown() {
      dropdownOpen = false;
      dropdownBtn!.setAttribute('aria-expanded', 'false');
      dropdownPanel!.classList.remove('dropdown-open');
    }

    // Toggle on Enter/Space
    dropdownBtn.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (dropdownOpen) {
          closeDropdown();
        } else {
          openDropdown();
          // Focus the first link in the dropdown
          const firstLink = dropdownPanel!.querySelector<HTMLElement>('a[href]');
          firstLink?.focus();
        }
      }
    });

    // Close on Escape from within dropdown
    dropdownPanel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDropdown();
        dropdownBtn!.focus();
      }
    });

    // Close when focus leaves the dropdown container
    dropdownContainer.addEventListener('focusout', () => {
      // Use setTimeout to let the new focus target settle
      setTimeout(() => {
        if (!dropdownContainer!.contains(document.activeElement)) {
          closeDropdown();
        }
      }, 0);
    });

    // Sync aria-expanded on hover for screen readers
    dropdownContainer.addEventListener('mouseenter', () => {
      dropdownBtn!.setAttribute('aria-expanded', 'true');
    });
    dropdownContainer.addEventListener('mouseleave', () => {
      if (!dropdownOpen) {
        dropdownBtn!.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
