---
/**
 * Analytics cookie banner and settings panel (plan D1; HOME-CHROME-06,
 * A11Y-PERF-09, F-20).
 *
 * Behaviour lives in BaseLayout's head script (window.calcrunConsent); this
 * component only asks and remembers:
 * - EEA + Switzerland: Google Analytics is not loaded until Accept. The banner
 *   asks first.
 * - Everywhere else: analytics runs by default; the banner says so and offers
 *   Decline, which stops it on this page, deletes the _ga cookies and keeps it
 *   off on later visits.
 * - Embeds and framed pages: never shown (and GA never loads there).
 * - The footer's "Cookie settings" button reopens it at any time, showing the
 *   current setting.
 *
 * Accessibility: a labelled region (not role=alert); it never steals focus on
 * first view, takes focus when the visitor opens it from Cookie settings and
 * returns focus there afterwards. While open, html.cookie-banner-open adds
 * bottom scroll padding so keyboard focus is never hidden behind it
 * (WCAG 2.4.11). Zero React: plain markup and a small inline script.
 */
---

<div
  id="cookie-banner"
  class="cookie-banner bg-white shadow-card-hover"
  role="region"
  aria-labelledby="cookie-banner-title"
>
  <div class="cb-inner">
    <div class="cb-head">
      <h2 id="cookie-banner-title" class="cb-title text-sm font-semibold text-neutral-900" tabindex="-1">Analytics cookies</h2>
      <button
        type="button"
        id="cookie-close"
        class="cookie-close -mt-1 -mr-2 w-9 h-9 items-center justify-center rounded-lg text-neutral-500 hover:text-neutral-900 hover:bg-neutral-100 transition-colors duration-150"
        aria-label="Close cookie settings"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <div class="cb-body">
      <p id="cookie-banner-text" class="cb-text text-neutral-600">
        We use Google Analytics cookies to count visits and see which tools are used. No ads.
      </p>
      <p id="cookie-banner-more" class="cb-more text-neutral-600">
        Decline stops analytics now and on future visits; Accept turns it on. You can change this here at any time.
      </p>
      <p id="cookie-banner-status" class="cookie-status text-sm font-medium text-neutral-800"></p>
    </div>
    <div class="cb-actions">
      <button
        type="button"
        id="cookie-decline"
        class="px-3.5 py-2 text-sm font-medium text-neutral-800 bg-neutral-100 rounded-lg hover:bg-neutral-200 transition-all duration-200"
      >
        Decline
      </button>
      <button
        type="button"
        id="cookie-accept"
        class="px-3.5 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-all duration-200"
      >
        Accept
      </button>
      <a href="/privacy/#analytics" data-astro-prefetch="hover" class="cb-link text-sm text-primary-700 underline underline-offset-2 hover:text-primary-800 transition-colors duration-150">Privacy details</a>
    </div>
  </div>
</div>

<style>
  /* Closed: invisible, out of the tab order and the accessibility tree;
     opening/closing animates (no display toggling). */
  .cookie-banner {
    position: fixed;
    z-index: 50;
    left: 0;
    right: 0;
    bottom: 0;
    border-top: 1px solid var(--color-neutral-200);
    opacity: 0;
    transform: translateY(12px);
    visibility: hidden;
    pointer-events: none;
    transition: opacity 200ms ease, transform 200ms ease, visibility 0s linear 200ms;
  }
  .cookie-banner.is-open {
    opacity: 1;
    transform: none;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 200ms ease, transform 200ms ease, visibility 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .cookie-banner,
    .cookie-banner.is-open { transition: none; transform: none; }
  }

  /* Phones (default): a compact strip, about 100px at 360px wide. The title
     is kept for screen readers but not shown on the first view. */
  .cb-inner { display: flex; flex-direction: column; gap: 0.5rem; padding: 0.625rem 1rem; }
  .cb-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }
  .cb-title { margin: 0; }
  .cookie-banner:not(.is-settings) .cb-head {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
  .cb-body { display: flex; flex-direction: column; gap: 0.25rem; }
  .cb-text,
  .cb-more { margin: 0; font-size: 0.875rem; line-height: 1.4; }
  .cb-more { display: none; }
  .cookie-banner.is-settings .cb-more { display: block; }
  .cookie-status { margin: 0; }
  .cookie-status:empty { display: none; }
  .cb-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .cb-link { margin-left: auto; white-space: nowrap; }
  .cookie-close { display: none; }
  .cookie-banner.is-settings .cookie-close { display: inline-flex; }

  /* Wider screens: a card at the bottom left, title shown */
  @media (min-width: 640px) {
    .cookie-banner {
      left: 1rem;
      right: auto;
      bottom: 1rem;
      max-width: 440px;
      border: 1px solid var(--color-neutral-200);
      border-radius: 0.5rem;
    }
    .cb-inner { padding: 1rem 1.25rem; gap: 0.625rem; }
    .cookie-banner:not(.is-settings) .cb-head { position: static; width: auto; height: auto; overflow: visible; clip: auto; white-space: normal; }
  }

  /* Short and wide (landscape phones, small laptop windows): one strip with
     the text beside the buttons */
  @media (max-height: 500px) and (min-width: 560px) {
    .cookie-banner {
      left: 0.5rem;
      right: 0.5rem;
      bottom: 0.5rem;
      max-width: 720px;
      border: 1px solid var(--color-neutral-200);
      border-radius: 0.5rem;
    }
    .cb-inner { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; padding: 0.5rem 0.75rem; }
    .cookie-banner:not(.is-settings) .cb-head { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .cookie-banner.is-settings .cb-head { flex-basis: 100%; }
    .cb-body { flex: 1 1 16rem; min-width: 0; }
    .cb-text,
    .cb-more { font-size: 0.8125rem; line-height: 1.35; }
    .cb-actions { flex-wrap: nowrap; }
  }

  /* Short and narrow (e.g. 320x200, a desktop at 400% zoom): the banner is
     capped at 40% of the screen and scrolls inside; the buttons come first so
     they are always on screen */
  @media (max-height: 500px) and (max-width: 559px) {
    .cookie-banner { max-height: 40vh; overflow-y: auto; overscroll-behavior: contain; }
    .cb-inner { padding: 0.5rem 0.75rem; gap: 0.375rem; }
    .cb-actions { order: -1; }
    .cb-text,
    .cb-more { font-size: 0.8125rem; line-height: 1.35; }
  }

  /* Keep focused controls clear of the open banner (WCAG 2.4.11): scroll room
     at the bottom of the page so the last links can rise above it (the
     focusin handler below does the scrolling) */
  :global(html.cookie-banner-open) { scroll-padding-bottom: 8rem; }
  :global(html.cookie-banner-open body) { padding-bottom: 8rem; }
  @media (min-width: 640px) {
    :global(html.cookie-banner-open) { scroll-padding-bottom: 11rem; }
    :global(html.cookie-banner-open body) { padding-bottom: 11rem; }
  }
  @media (max-height: 500px) and (min-width: 560px) {
    :global(html.cookie-banner-open) { scroll-padding-bottom: 6rem; }
    :global(html.cookie-banner-open body) { padding-bottom: 6rem; }
  }
  @media (max-height: 500px) and (max-width: 559px) {
    :global(html.cookie-banner-open) { scroll-padding-bottom: 41vh; }
    :global(html.cookie-banner-open body) { padding-bottom: 41vh; }
  }
</style>

<script is:inline>
  (function () {
    var banner = document.getElementById('cookie-banner');
    var c = window.calcrunConsent;
    if (!banner || !c || typeof c.set !== 'function') return;
    var text = document.getElementById('cookie-banner-text');
    var status = document.getElementById('cookie-banner-status');
    var title = document.getElementById('cookie-banner-title');
    var acceptBtn = document.getElementById('cookie-accept');
    var declineBtn = document.getElementById('cookie-decline');
    var closeBtn = document.getElementById('cookie-close');
    var returnFocus = null;

    // First view stays short (about 100px on a phone); the settings view adds
    // what Decline/Accept do and that the choice can be changed (cb-more).
    var COPY_ASK = 'May we use Google Analytics cookies to count visits? Nothing loads unless you accept. No ads.';
    var COPY_INFORM = 'We use Google Analytics cookies to count visits and see which tools are used. No ads.';

    function setOpen(open, settings) {
      banner.classList.toggle('is-open', open);
      banner.classList.toggle('is-settings', !!settings);
      document.documentElement.classList.toggle('cookie-banner-open', open);
    }

    function render(settings) {
      text.textContent = c.required ? COPY_ASK : COPY_INFORM;
      if (settings) {
        var on = c.choice === 'accepted' || (c.choice === null && !c.required);
        status.textContent = 'Current setting: analytics ' + (on ? 'on.' : 'off.');
      } else {
        status.textContent = '';
      }
    }

    function close() {
      setOpen(false, false);
      if (returnFocus && document.contains(returnFocus)) {
        returnFocus.focus({ preventScroll: true });
      }
      returnFocus = null;
    }

    function choose(value) {
      c.set(value);
      close();
    }

    if (acceptBtn) acceptBtn.addEventListener('click', function () { choose('accepted'); });
    if (declineBtn) declineBtn.addEventListener('click', function () { choose('declined'); });
    if (closeBtn) closeBtn.addEventListener('click', close);
    banner.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && banner.classList.contains('is-settings')) close();
    });

    // A control that receives focus under the open banner scrolls up above it
    // (browsers only scroll focus into view when it is off screen)
    function inFixedLayer(el) {
      for (var n = el; n && n !== document.body; n = n.parentElement) {
        var pos = getComputedStyle(n).position;
        if (pos === 'fixed' || pos === 'sticky') return true;
      }
      return false;
    }
    document.addEventListener('focusin', function (e) {
      if (!banner.classList.contains('is-open')) return;
      var el = e.target;
      if (!el || !el.getBoundingClientRect || banner.contains(el) || inFixedLayer(el)) return;
      var r = el.getBoundingClientRect();
      var b = banner.getBoundingClientRect();
      if (r.bottom <= b.top || r.top >= b.bottom || r.right <= b.left || r.left >= b.right) return;
      window.scrollBy({ top: r.bottom - b.top + 16, left: 0, behavior: 'instant' });
    });

    // Reopen from the footer (or anything with data-cookie-settings)
    c.open = function (trigger) {
      if (c.embed) return;
      returnFocus = trigger || document.activeElement;
      render(true);
      setOpen(true, true);
      if (title) title.focus({ preventScroll: true });
    };
    document.addEventListener('click', function (e) {
      var t = e.target && e.target.closest ? e.target.closest('[data-cookie-settings]') : null;
      if (!t) return;
      e.preventDefault();
      c.open(t);
    });

    // First view: ask (EEA) or inform (elsewhere) until a choice is stored
    if (c.embed || c.choice !== null) return;
    render(false);
    setOpen(true, false);
  })();
</script>
