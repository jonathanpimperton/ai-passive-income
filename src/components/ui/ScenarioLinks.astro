---
/**
 * Pre-calculated scenario links for a specific tool.
 * Shows scenario cards linking to /scenarios/{slug} pages.
 * Only renders if scenarios exist for the given tool.
 */
import ToolIcon from './ToolIcon.astro';
import { getCollection } from 'astro:content';

interface Props {
  toolSlug: string;
}

const { toolSlug } = Astro.props;
const allScenarios = await getCollection('scenarios');
const scenarios = allScenarios.filter((s) => s.data.toolSlug === toolSlug);

if (scenarios.length === 0) return;
---

<section class="mt-14">
  {/* Gradient divider */}
  <div class="h-px bg-gradient-to-r from-transparent via-primary-300/30 to-transparent mb-14" aria-hidden="true"></div>

  <div class="scenario-box bg-neutral-50 rounded-lg p-6 sm:p-8 border border-neutral-200/60">
    <div class="flex items-center gap-3 mb-1">
      <div class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-primary-100 text-primary-600 shrink-0">
        <ToolIcon name="calculator" size={18} />
      </div>
      <div>
        <p class="text-xs font-semibold text-primary-600 uppercase tracking-wider">Pre-Calculated</p>
        <h2 class="text-lg font-bold text-neutral-900">Popular Scenarios</h2>
      </div>
    </div>
    <p class="text-sm text-neutral-500 mb-5 leading-relaxed">
      See results for common scenarios, then customize with your own numbers.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {scenarios.map((scenario) => (
        <a
          href={`/scenarios/${scenario.data.slug}/`}
          class="group bg-white border border-neutral-200/80 rounded-xl p-4 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-200"
        >
          <h3 class="text-sm font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-200 mb-1.5 leading-snug">
            {scenario.data.title}
          </h3>
          <span class="text-base font-bold text-primary-600 tabular-nums">
            {scenario.data.resultSummary}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
