---
/**
 * Pre-calculated scenario links for a specific tool.
 * Shows scenario cards linking to /scenarios/{slug} pages.
 * Only renders if scenarios exist for the given tool.
 */
import ToolIcon from './ToolIcon.astro';
import { getCollection } from 'astro:content';

interface Props {
  toolSlug: string;
}

const { toolSlug } = Astro.props;
const allScenarios = await getCollection('scenarios');
const scenarios = allScenarios.filter((s) => s.data.toolSlug === toolSlug);

// Phase 3 hub pages: full reference tables for the tools whose per-value
// doorway scenarios were consolidated. Rendered even when a tool has no
// individual scenarios left.
const HUB_FOR_TOOL: Record<string, { href: string; label: string }> = {
  'salary-uk': { href: '/scenarios/uk-take-home-pay/', label: 'UK take-home pay by salary (£20K–£150K)' },
  'salary-us': { href: '/scenarios/us-take-home-pay/', label: 'US take-home pay by salary ($40K–$250K)' },
  'mortgage-payment': { href: '/scenarios/mortgage-payments-by-amount/', label: 'Mortgage payments by amount ($150K–$750K)' },
  'loan-amortization': { href: '/scenarios/mortgage-payments-by-amount/', label: 'Loan payments by amount ($150K–$750K)' },
  'compound-interest': { href: '/scenarios/investment-growth/', label: 'Investment growth by amount' },
  'investment-return': { href: '/scenarios/investment-growth/', label: 'Investment growth by amount' },
};
const hub = HUB_FOR_TOOL[toolSlug];

if (scenarios.length === 0 && !hub) return;
---

<section class="mt-14">
  {/* Gradient divider */}
  <div class="h-px bg-gradient-to-r from-transparent via-primary-300/30 to-transparent mb-14" aria-hidden="true"></div>

  <div class="scenario-box bg-neutral-50 rounded-lg p-6 sm:p-8 border border-neutral-200/60">
    <div class="flex items-center gap-3 mb-1">
      <div class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-primary-100 text-primary-600 shrink-0">
        <ToolIcon name="calculator" size={18} />
      </div>
      <div>
        <p class="text-xs font-semibold text-primary-600 uppercase tracking-wider">Pre-Calculated</p>
        <h2 class="text-lg font-bold text-neutral-900">Popular Scenarios</h2>
      </div>
    </div>
    <p class="text-sm text-neutral-500 mb-5 leading-relaxed">
      See results for common scenarios, then customize with your own numbers.
    </p>

    {hub && (
      <a
        href={hub.href}
        class="group flex items-center justify-between gap-3 bg-white border border-neutral-200/80 rounded-lg p-4 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-200 mb-3"
      >
        <div>
          <p class="text-xs font-semibold text-primary-600 uppercase tracking-wider mb-0.5">Reference table</p>
          <span class="text-sm font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-200 tabular-nums">{hub.label}</span>
        </div>
        <svg class="w-4 h-4 text-neutral-400 group-hover:text-primary-600 transition-colors duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </a>
    )}

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {scenarios.map((scenario) => (
        <a
          href={`/scenarios/${scenario.data.slug}/`}
          class="group bg-white border border-neutral-200/80 rounded-xl p-4 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-200"
        >
          <h3 class="text-sm font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-200 mb-1.5 leading-snug">
            {scenario.data.title}
          </h3>
          <span class="text-base font-bold text-primary-600 tabular-nums">
            {scenario.data.resultSummary}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
