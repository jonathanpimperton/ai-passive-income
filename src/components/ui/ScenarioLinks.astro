---
/**
 * Guides for a tool page: the hub reference table, the worked scenarios built
 * on this calculator and the comparisons that use it. Links are derived in
 * src/lib/internal-links.ts (the reverse of scenario `toolSlug` and comparison
 * `relatedTools`), so new content is linked from its tools automatically
 * (GROWTH-SEO-05). Renders nothing when a tool has no guides.
 */
import { getCollection } from 'astro:content';
import { hubForTool, scenariosForTool, comparisonsForTool, shortTitle } from '@lib/internal-links';

interface Props {
  toolSlug: string;
}

const { toolSlug } = Astro.props;
const scenarios = scenariosForTool(toolSlug, (await getCollection('scenarios')).map((s) => s.data));
const comparisons = comparisonsForTool(toolSlug, (await getCollection('comparisons')).map((c) => c.data));
const hub = hubForTool(toolSlug);

if (scenarios.length === 0 && comparisons.length === 0 && !hub) return;
---

<section class="mt-14" aria-labelledby="tool-guides-heading">
  <div class="scenario-box bg-neutral-50 rounded-lg p-6 sm:p-8 border border-neutral-200/60">
    <h2 id="tool-guides-heading" class="text-xl font-bold text-neutral-900 tracking-[-0.02em]">Worked examples and guides</h2>
    <p class="text-sm text-neutral-500 mt-1 mb-5 leading-relaxed">
      Real numbers run through this calculator, and the decisions it helps with.
    </p>

    {hub && (
      <a
        href={hub.href}
        data-astro-prefetch
        class="group flex items-center justify-between gap-3 bg-white border border-neutral-200/80 rounded-lg p-4 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-200 mb-3"
      >
        <div>
          <p class="text-xs font-semibold text-primary-600 uppercase tracking-wider mb-0.5">Reference table</p>
          <span class="text-sm font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-200 tabular-nums">{hub.label}</span>
        </div>
        <svg class="w-4 h-4 text-neutral-500 group-hover:text-primary-600 transition-colors duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </a>
    )}

    {scenarios.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {scenarios.map((scenario) => (
          <a
            href={`/scenarios/${scenario.slug}/`}
            data-astro-prefetch
            class="group bg-white border border-neutral-200/80 rounded-lg p-4 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-200"
          >
            <h3 class="text-sm font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-200 mb-1.5 leading-snug">
              {scenario.title}
            </h3>
            <span class="text-base font-bold text-primary-600 tabular-nums">
              {scenario.resultSummary}
            </span>
          </a>
        ))}
      </div>
    )}

    {comparisons.length > 0 && (
      <div class:list={[(hub || scenarios.length > 0) && 'mt-6 pt-6 border-t border-neutral-200/80']}>
        <h3 class="text-sm font-semibold text-neutral-900 mb-3">Compare your options</h3>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {comparisons.map((comparison) => (
            <li>
              <a
                href={`/comparisons/${comparison.slug}/`}
                data-astro-prefetch
                class="group block h-full bg-white border border-neutral-200/80 rounded-lg p-4 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-200"
              >
                <span class="block text-sm font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-200 leading-snug">
                  {shortTitle(comparison.title)}
                </span>
                <span class="block text-sm text-neutral-600 mt-1 leading-relaxed line-clamp-2">{comparison.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
