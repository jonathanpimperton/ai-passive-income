---
// Sun/moon toggle for light/dark mode.
// Theme state managed via data-theme attribute on <html>.
// Persisted in localStorage, respects prefers-color-scheme.
// Uses class-based selection (not IDs) so multiple instances work.
---

<button
  type="button"
  class="theme-toggle w-11 h-11 flex items-center justify-center rounded-lg text-neutral-500 hover:text-neutral-700 hover:bg-neutral-100 transition-colors duration-150"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg class="theme-icon-sun w-[18px] h-[18px] hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
  <!-- Moon icon (shown in light mode) -->
  <svg class="theme-icon-moon w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script is:inline>
  (function() {
    // Guard: this component is rendered twice (desktop + mobile nav).
    // Without this guard, the second script attaches a duplicate handler
    // to the first button, causing clicks to toggle twice (net zero).
    if (window.__themeToggleInit) return;
    window.__themeToggleInit = true;

    function init() {
      var buttons = document.querySelectorAll('.theme-toggle');
      var allSunIcons = document.querySelectorAll('.theme-icon-sun');
      var allMoonIcons = document.querySelectorAll('.theme-icon-moon');

      function setTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('calcrun.theme', theme);
        allSunIcons.forEach(function(icon) {
          if (theme === 'dark') { icon.classList.remove('hidden'); } else { icon.classList.add('hidden'); }
        });
        allMoonIcons.forEach(function(icon) {
          if (theme === 'dark') { icon.classList.add('hidden'); } else { icon.classList.remove('hidden'); }
        });
      }

      // Set initial icon state
      var current = document.documentElement.getAttribute('data-theme') || 'light';
      if (current === 'dark') {
        allSunIcons.forEach(function(icon) { icon.classList.remove('hidden'); });
        allMoonIcons.forEach(function(icon) { icon.classList.add('hidden'); });
      }

      // Attach click handler to ALL toggle buttons
      buttons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          setTheme(next);
        });
      });
    }

    // Defer to ensure ALL buttons are in the DOM (component rendered twice)
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
