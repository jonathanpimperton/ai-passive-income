---
// Dark mode toggle (sun/moon). Theme state is the data-theme attribute on
// <html>, set before paint by BaseLayout's head script.
// - Storage goes through calcrunStore (never throws when storage is blocked).
// - Choosing the theme your device already uses clears the stored choice, so
//   the site follows the OS again (HOME-CHROME-18: there was no way back).
// - With no stored choice the page follows OS changes live; the head script
//   fires `calcrun:themechange` and the buttons re-sync.
// - aria-pressed reflects dark mode. Class-based so several instances work.
---

<button
  type="button"
  class="theme-toggle w-11 h-11 flex items-center justify-center rounded-lg text-neutral-500 hover:text-neutral-700 hover:bg-neutral-100 transition-colors duration-150"
  aria-label="Dark mode"
  aria-pressed="false"
  title="Dark mode"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg class="theme-icon-sun w-[18px] h-[18px] hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
  <!-- Moon icon (shown in light mode) -->
  <svg class="theme-icon-moon w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script is:inline>
  (function() {
    // Guard: this component is rendered more than once (desktop + mobile nav).
    // Without this guard, a second script would attach a duplicate handler to
    // the first button and each click would toggle twice (net zero).
    if (window.__themeToggleInit) return;
    window.__themeToggleInit = true;

    var KEY = 'calcrun.theme';
    var store = window.calcrunStore;
    function osTheme() {
      try {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      } catch (e) {
        return 'light';
      }
    }

    function sync() {
      var dark = document.documentElement.getAttribute('data-theme') === 'dark';
      document.querySelectorAll('.theme-toggle').forEach(function(btn) {
        btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
      });
      document.querySelectorAll('.theme-icon-sun').forEach(function(icon) { icon.classList.toggle('hidden', !dark); });
      document.querySelectorAll('.theme-icon-moon').forEach(function(icon) { icon.classList.toggle('hidden', dark); });
    }

    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      if (store) {
        // Matching the device setting means "follow the device" again
        if (theme === osTheme()) store.remove(KEY); else store.set(KEY, theme);
      }
      sync();
    }

    function init() {
      sync();
      document.querySelectorAll('.theme-toggle').forEach(function(btn) {
        btn.addEventListener('click', function() {
          setTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
        });
      });
      window.addEventListener('calcrun:themechange', sync);
    }

    // Defer so every instance is in the DOM before binding
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
