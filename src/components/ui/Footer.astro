---
/**
 * Site footer (plan HO-6; HOME-CHROME-04/13/15).
 * - Guides column: answer tables, scenarios, comparisons, methodology, author.
 * - Calculators first; file and developer tools in their own column instead
 *   of sitting next to tax tools.
 * - "Cookie settings" reopens the analytics choice at any time (plan D1).
 */
import Logo from './Logo.astro';
import ToolIcon from './ToolIcon.astro';
import { TOOL_COUNT, getToolBySlug, getToolPath, type ToolMeta } from '@lib/tools-data';

const currentYear = new Date().getFullYear();

const pick = (slugs: string[]) => slugs.map((s) => getToolBySlug(s)).filter((t): t is ToolMeta => t !== undefined);
const shortName = (t: ToolMeta) => t.name.replace(/ Calculator$/, '').replace(/ Converter$/, '');

const calculators = pick(['salary-uk', 'salary-us', 'mortgage-payment', 'compound-interest', 'stamp-duty', 'retirement-savings']);
const otherTools = pick(['pdf-compress', 'heic-to-jpg', 'image-compressor', 'json-formatter']);

const guides = [
  { label: 'UK take-home pay table', href: '/scenarios/uk-take-home-pay/' },
  { label: 'US take-home pay table', href: '/scenarios/us-take-home-pay/' },
  { label: 'Worked scenarios', href: '/scenarios/' },
  { label: 'Comparisons', href: '/comparisons/' },
  { label: 'How we calculate UK pay', href: '/how-we-calculate/salary-uk/' },
  { label: 'Who builds CalcRun', href: '/author/' },
];
---

<footer class="mt-auto bg-surface-alt border-t border-neutral-200/80">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-14">
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-x-6 gap-y-10 lg:gap-10 mb-10">
      {/* Brand */}
      <div class="col-span-2 lg:col-span-1">
        <div class="mb-4">
          <Logo />
        </div>
        <p class="text-sm text-neutral-600 max-w-[260px] leading-relaxed">
          UK and US money calculators with cited sources and published formulas.
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-neutral-900 mb-4">Calculators</h2>
        <ul class="space-y-1 text-sm">
          {calculators.map((tool) => (
            <li><a href={getToolPath(tool)} class="text-neutral-600 hover:text-primary-700 transition-colors duration-150" data-astro-prefetch="hover">{shortName(tool)}</a></li>
          ))}
          <li>
            <a href="/tools/" class="inline-flex items-center gap-1 text-primary-700 hover:text-primary-800 font-medium transition-colors duration-150" data-astro-prefetch="hover">
              All {TOOL_COUNT} tools
              <ToolIcon name="arrow-right" size={14} />
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-neutral-900 mb-4">Guides</h2>
        <ul class="space-y-1 text-sm">
          {guides.map((g) => (
            <li><a href={g.href} class="text-neutral-600 hover:text-primary-700 transition-colors duration-150" data-astro-prefetch="hover">{g.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-neutral-900 mb-4">File &amp; developer tools</h2>
        <ul class="space-y-1 text-sm">
          {otherTools.map((tool) => (
            <li><a href={getToolPath(tool)} class="text-neutral-600 hover:text-primary-700 transition-colors duration-150" data-astro-prefetch="hover">{shortName(tool)}</a></li>
          ))}
          <li>
            <a href="/tools/#file-tools" class="inline-flex items-center gap-1 text-primary-700 hover:text-primary-800 font-medium transition-colors duration-150" data-astro-prefetch="hover">
              More tools
              <ToolIcon name="arrow-right" size={14} />
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-neutral-900 mb-4">Company</h2>
        <ul class="space-y-1 text-sm">
          <li><a href="/about/" class="text-neutral-600 hover:text-primary-700 transition-colors duration-150" data-astro-prefetch="hover">About</a></li>
          <li><a href="/privacy/" class="text-neutral-600 hover:text-primary-700 transition-colors duration-150" data-astro-prefetch="hover">Privacy policy</a></li>
          <li class="footer-js-only"><button type="button" class="footer-link-btn text-neutral-600 hover:text-primary-700 transition-colors duration-150" data-cookie-settings>Cookie settings</button></li>
          <li><a href="/terms/" class="text-neutral-600 hover:text-primary-700 transition-colors duration-150" data-astro-prefetch="hover">Terms of use</a></li>
          <li><a href="/disclosure/" class="text-neutral-600 hover:text-primary-700 transition-colors duration-150" data-astro-prefetch="hover">Affiliate disclosure</a></li>
          <li><a href="/accessibility/" class="text-neutral-600 hover:text-primary-700 transition-colors duration-150" data-astro-prefetch="hover">Accessibility</a></li>
          <li><a href="/embed/" class="text-neutral-600 hover:text-primary-700 transition-colors duration-150" data-astro-prefetch="hover">Embed our tools</a></li>
        </ul>
      </div>
    </div>

    {/* Solid hairline divider */}
    <div class="border-t border-neutral-200/80 mb-6"></div>

    <div class="flex flex-col sm:flex-row justify-between items-center gap-2">
      <p class="text-xs text-neutral-600">
        &copy; {currentYear} CalcRun. All rights reserved.
      </p>
      <p class="text-xs text-neutral-600">
        CalcRun provides educational tools, not financial advice.
      </p>
    </div>
  </div>
</footer>

<style>
  /* Comfortable touch targets on footer links */
  footer ul a,
  .footer-link-btn {
    display: inline-block;
    padding-block: 0.375rem;
    text-align: left;
  }
  /* Scoped rules out-cascade layered utilities — restore flex on the
     view-all links so the arrow glyph can never wrap onto its own line */
  footer ul a.inline-flex {
    display: inline-flex;
    white-space: nowrap;
  }
  /* Cookie settings needs JavaScript (so does analytics) */
  .footer-js-only { display: none; }
  :global(html.js) .footer-js-only { display: list-item; }
</style>
