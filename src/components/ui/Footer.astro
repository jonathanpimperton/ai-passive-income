            <path fill="#E5E7EB" d="M1160.01 988.373C1213.59 984.852 1249.35 1011.06 1257.41 1064.62C1235.78 1064.99 1214.14 1064.89 1192.52 1064.32C1191.25 1062.69 1189.96 1061.1 1188.63 1059.54C1175.12 1043.77 1151.49 1045.48 1137.14 1059.28C1128.16 1068.05 1123.23 1080.15 1123.5 1092.7C1123.98 1112.79 1137.77 1123.71 1157.36 1122.65C1170.25 1121.96 1178.65 1115.58 1186.96 1106.53C1196.94 1106.36 1245.47 1105.43 1251.92 1107.21L1252.14 1109.37C1246.88 1120.34 1242.93 1129.32 1235.64 1139.23C1218.28 1162.43 1190.9 1178.97 1162.32 1183.24C1111.82 1190.8 1071.28 1159.16 1064.58 1108.52C1060.59 1080.23 1068.23 1051.53 1085.77 1028.97C1104.36 1005.11 1130.31 992.004 1160.01 988.373Z"/>
