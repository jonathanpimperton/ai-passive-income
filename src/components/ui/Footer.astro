---
import ToolIcon from './ToolIcon.astro';
import { TOOLS, getToolPath } from '@lib/tools-data';

const currentYear = new Date().getFullYear();

const footerCalcs = ['compound-interest', 'loan-amortization', 'retirement-savings', 'investment-return']
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t) => t !== undefined);

const moreTools = [
  ...TOOLS.filter((t) => t.category === 'economic').slice(0, 2),
  ...TOOLS.filter((t) => t.category === 'utility').slice(0, 2),
];
---

<footer class="footer-dark mt-auto">
  {/* Gradient top edge — replaces flat border */}
  <div class="h-px bg-gradient-to-r from-transparent via-primary-600/50 to-transparent"></div>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 mb-10">
      {/* Brand */}
      <div>
        <a href="/" class="inline-block mb-4" aria-label="CalcRun Home">
          <svg
            role="img"
            aria-label="CalcRun"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="80 805 1810 410"
            class="h-7 w-auto footer-logo"
