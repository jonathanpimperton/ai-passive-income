---
import Logo from './Logo.astro';
import ToolIcon from './ToolIcon.astro';
import { TOOLS, getToolPath } from '@lib/tools-data';

const currentYear = new Date().getFullYear();

const footerCalcs = ['compound-interest', 'loan-amortization', 'retirement-savings', 'investment-return']
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t) => t !== undefined);

const moreTools = [
  ...TOOLS.filter((t) => t.category === 'economic').slice(0, 2),
  ...TOOLS.filter((t) => t.category === 'utility').slice(0, 2),
];
---

<footer class="mt-auto bg-surface-alt border-t border-neutral-200/80">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 mb-10">
      {/* Brand */}
      <div>
        <div class="mb-4">
          <Logo />
        </div>
        <p class="text-sm text-neutral-600 max-w-[240px] leading-relaxed">
          Financial calculators with interactive charts and cited sources.
        </p>
      </div>

      {/* Calculators */}
      <div>
        <h3 class="text-sm font-semibold text-neutral-900 mb-4">Calculators</h3>
        <ul class="space-y-2.5 text-sm">
          {footerCalcs.map((tool) => (
            <li><a href={getToolPath(tool)} class="text-neutral-600 hover:text-primary-700 transition-colors duration-150">{tool.name.replace(' Calculator', '')}</a></li>
          ))}
          <li>
            <a href="/tools/" class="inline-flex items-center gap-1 text-primary-600 hover:text-primary-700 font-medium transition-colors duration-150">
              View all tools
              <ToolIcon name="arrow-right" size={14} />
            </a>
          </li>
        </ul>
      </div>

      {/* More Tools */}
      <div>
        <h3 class="text-sm font-semibold text-neutral-900 mb-4">More Tools</h3>
        <ul class="space-y-2.5 text-sm">
          {moreTools.map((tool) => (
            <li><a href={getToolPath(tool)} class="text-neutral-600 hover:text-primary-700 transition-colors duration-150">{tool.name}</a></li>
          ))}
          <li>
            <a href="/tools/" class="inline-flex items-center gap-1 text-primary-600 hover:text-primary-700 font-medium transition-colors duration-150">
              All tools
              <ToolIcon name="arrow-right" size={14} />
            </a>
          </li>
        </ul>
      </div>

      {/* Company */}
      <div>
        <h3 class="text-sm font-semibold text-neutral-900 mb-4">Company</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/about/" class="text-neutral-600 hover:text-primary-700 transition-colors duration-150">About</a></li>
          <li><a href="/privacy/" class="text-neutral-600 hover:text-primary-700 transition-colors duration-150">Privacy Policy</a></li>
          <li><a href="/terms/" class="text-neutral-600 hover:text-primary-700 transition-colors duration-150">Terms of Use</a></li>
          <li><a href="/disclosure/" class="text-neutral-600 hover:text-primary-700 transition-colors duration-150">Affiliate Disclosure</a></li>
          <li><a href="/accessibility/" class="text-neutral-600 hover:text-primary-700 transition-colors duration-150">Accessibility</a></li>
          <li><a href="/embed/" class="text-neutral-600 hover:text-primary-700 transition-colors duration-150">Embed Our Tools</a></li>
        </ul>
      </div>
    </div>

    {/* Solid hairline divider */}
    <div class="border-t border-neutral-200/80 mb-6"></div>

    <div class="flex flex-col sm:flex-row justify-between items-center gap-2">
      <p class="text-xs text-neutral-500">
        &copy; {currentYear} CalcRun. All rights reserved.
      </p>
      <p class="text-xs text-neutral-500">
        CalcRun provides educational tools, not financial advice.
      </p>
    </div>
  </div>
</footer>

<style>
  /* Comfortable touch targets on footer links */
  footer ul a {
    display: inline-block;
    padding-block: 0.375rem;
  }
</style>
