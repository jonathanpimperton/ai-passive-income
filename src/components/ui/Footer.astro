            <path fill="#14B8A6" d="M1798.8 988.246C1820.16 985.829 1841.22 989.923 1854.3 1008.97C1876.65 1041.51 1865.28 1078.73 1858.63 1114.22C1854.37 1136.44 1850.27 1158.69 1846.32 1180.97L1784.38 1180.97L1798.39 1106.39C1800.59 1094.56 1804.46 1078.44 1804.76 1067.2C1805.42 1042.79 1773.1 1038.59 1757.25 1050.24C1745.75 1058.68 1744.32 1070.48 1741.87 1082.76C1736.16 1114.65 1730.24 1149.41 1723.57 1180.89L1661.73 1180.99C1663.78 1172.21 1665.42 1162.2 1666.9 1153.25C1675.9 1098.88 1688.09 1044.16 1696.73 989.799C1717.4 989.626 1738.07 989.601 1758.74 989.723L1745.9 1029.13C1747.83 1025.73 1749.85 1022.39 1751.96 1019.1C1763.62 1001.14 1778.29 992.553 1798.8 988.246Z"/>
          </svg>
        </a>
        <p class="text-sm text-white/50 max-w-[240px] leading-relaxed">
          Financial calculators with interactive charts and cited sources.
        </p>
      </div>

      {/* Calculators */}
      <div>
        <h3 class="text-sm font-semibold text-white/80 mb-4">Calculators</h3>
        <ul class="space-y-2.5 text-sm">
          {footerCalcs.map((tool) => (
            <li><a href={getToolPath(tool)} class="text-white/50 hover:text-white transition-colors duration-150">{tool.name.replace(' Calculator', '')}</a></li>
          ))}
          <li>
            <a href="/tools/" class="inline-flex items-center gap-1 text-primary-400 dark:text-primary-500 hover:text-primary-300 font-medium transition-colors duration-150">
              View all tools
              <ToolIcon name="arrow-right" size={14} />
            </a>
          </li>
        </ul>
      </div>

      {/* More Tools */}
      <div>
        <h3 class="text-sm font-semibold text-white/80 mb-4">More Tools</h3>
        <ul class="space-y-2.5 text-sm">
          {moreTools.map((tool) => (
            <li><a href={getToolPath(tool)} class="text-white/50 hover:text-white transition-colors duration-150">{tool.name}</a></li>
          ))}
          <li>
            <a href="/tools/" class="inline-flex items-center gap-1 text-primary-400 dark:text-primary-500 hover:text-primary-300 font-medium transition-colors duration-150">
              All tools
              <ToolIcon name="arrow-right" size={14} />
            </a>
          </li>
        </ul>
      </div>

      {/* Company */}
      <div>
        <h3 class="text-sm font-semibold text-white/80 mb-4">Company</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/about/" class="text-white/50 hover:text-white transition-colors duration-150">About</a></li>
          <li><a href="/privacy/" class="text-white/50 hover:text-white transition-colors duration-150">Privacy Policy</a></li>
          <li><a href="/terms/" class="text-white/50 hover:text-white transition-colors duration-150">Terms of Use</a></li>
          <li><a href="/disclosure/" class="text-white/50 hover:text-white transition-colors duration-150">Affiliate Disclosure</a></li>
          <li><a href="/accessibility/" class="text-white/50 hover:text-white transition-colors duration-150">Accessibility</a></li>
          <li><a href="/embed/" class="text-white/50 hover:text-white transition-colors duration-150">Embed Our Tools</a></li>
        </ul>
      </div>
    </div>

    {/* Divider */}
    <div class="h-px bg-white/10 mb-6"></div>

    <div class="flex flex-col sm:flex-row justify-between items-center gap-2">
      <p class="text-xs text-white/50">
        &copy; {currentYear} CalcRun. All rights reserved.
      </p>
      <p class="text-xs text-white/50">
        CalcRun provides educational tools, not financial advice.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-dark {
    background-color: #0F1B2D;
  }
  .footer-dark ul a {
    display: inline-block;
    padding-block: 0.375rem;
  }
</style>
