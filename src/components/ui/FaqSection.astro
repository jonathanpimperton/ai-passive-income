---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;
---

<section class="mt-14">
  {/* Gradient divider */}
  <div class="h-px bg-gradient-to-r from-transparent via-primary-300/30 to-transparent mb-14"></div>

  <h2 class="text-2xl font-bold text-neutral-900 mb-6">Frequently Asked Questions</h2>

  <div class="space-y-3">
    {faqs.map((faq) => (
      <details class="group bg-white border border-neutral-200/80 rounded-xl shadow-card overflow-hidden">
        <summary class="flex items-center justify-between cursor-pointer px-5 py-4 text-base font-medium text-neutral-900 hover:bg-neutral-50/50 transition-colors duration-150 [&::-webkit-details-marker]:hidden list-none">
          <span class="pr-4">{faq.question}</span>
          <div class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-neutral-100 group-hover:bg-primary-50 group-open:bg-primary-50 transition-colors duration-200 shrink-0">
            <svg
              class="w-4 h-4 text-neutral-500 group-open:text-primary-500 transition-all duration-200 group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </summary>
        <div class="px-5 pb-5 text-sm text-neutral-700 leading-relaxed border-t border-neutral-100 pt-4">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>
</section>
