---
/**
 * Affiliate partner cards — renders contextual partner recommendations
 * on tool pages that have affiliatePrograms in their frontmatter.
 *
 * Shows a heading with the affiliateContext string, then a grid of
 * partner cards with name, tagline, category badge, and CTA button.
 *
 * All links open in new tabs and include rel="noopener sponsored"
 * for FTC compliance and SEO best practice.
 */
import ToolIcon from './ToolIcon.astro';
import { resolvePartners, buildAffiliateUrl, type AffiliatePartner } from '@lib/affiliate-data';

interface Props {
  /** The contextual CTA heading, e.g. "Open a high-yield savings account" */
  context: string;
  /** Array of partner IDs from tool frontmatter, e.g. ["Betterment", "Marcus"] */
  programIds: string[];
  /** Tool slug for UTM campaign tracking */
  toolSlug: string;
}

const { context, programIds, toolSlug } = Astro.props;
const partners = resolvePartners(programIds);

// Don't render anything if no valid partners
if (partners.length === 0) return;
---

<div class="mt-10 mb-6">
  <div class="flex items-center gap-2.5 mb-4">
    <div class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-accent-100 text-accent-600 shrink-0">
      <ToolIcon name="sparkles" size={16} />
    </div>
    <h2 class="text-lg font-bold text-neutral-900">{context}</h2>
  </div>

  <div class:list={[
    "grid gap-3",
    partners.length === 1 && "grid-cols-1",
    partners.length === 2 && "grid-cols-1 sm:grid-cols-2",
    partners.length >= 3 && "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3",
  ]}>
    {partners.map((partner) => (
      <a
        href={buildAffiliateUrl(partner.id, toolSlug)}
        target="_blank"
        rel="noopener sponsored"
        class="group bg-white border border-neutral-200/80 rounded-xl p-5 shadow-card hover:shadow-card-hover hover:border-primary-200 transition-all duration-200 flex flex-col"
      >
        <div class="flex items-start gap-3 mb-3">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary-50 text-primary-600 shrink-0 group-hover:bg-primary-100 transition-colors duration-200">
            <ToolIcon name={partner.icon} size={20} />
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2 mb-0.5">
              <span class="text-sm font-bold text-neutral-900 group-hover:text-primary-700 transition-colors duration-200">
                {partner.name}
              </span>
              <span class="inline-flex items-center text-[10px] font-semibold text-primary-600 bg-primary-50 px-1.5 py-0.5 rounded-full uppercase tracking-wide shrink-0">
                {partner.category}
              </span>
            </div>
            <p class="text-sm text-neutral-500 leading-relaxed">{partner.tagline}</p>
          </div>
        </div>

        <div class="mt-auto pt-3 border-t border-neutral-100">
          <span class="inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 group-hover:text-primary-700 transition-colors duration-200">
            Learn more
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </span>
        </div>
      </a>
    ))}
  </div>

  <p class="text-xs text-neutral-400 mt-3 leading-relaxed">
    Affiliate link — we may earn a commission at no extra cost to you.
    <a href="/disclosure" class="text-primary-500 hover:text-primary-600 underline transition-colors duration-200">
      Full disclosure
    </a>
  </p>
</div>
