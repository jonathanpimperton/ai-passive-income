---
/**
 * "Take the Next Step" affiliate callout — visually prominent section
 * that renders contextual partner recommendations on tool pages.
 *
 * Uses a colored background to break visual rhythm and catch attention
 * without feeling like an ad. Partner cards have clear CTAs with buttons.
 *
 * All links open in new tabs with rel="noopener sponsored" for FTC compliance.
 */
import ToolIcon from './ToolIcon.astro';
import { resolvePartners, buildAffiliateUrl } from '@lib/affiliate-data';

interface Props {
  context: string;
  programIds: string[];
  toolSlug: string;
  category?: string;
}

const { context, programIds, toolSlug, category } = Astro.props;
const partners = resolvePartners(programIds);

if (partners.length === 0) return;

/* Contextual disclosure text based on page type */
const INVESTMENT_SLUGS = new Set(['compound-interest', 'investment-return', 'investment-fee', 'retirement-savings', 'retirement-contribution', 'retirement-age', 'savings-goal', 'roi']);
const LOAN_SLUGS = new Set(['mortgage-payment', 'mortgage-affordability', 'loan-amortization', 'rent-vs-buy']);

let disclosureText: string;
if (LOAN_SLUGS.has(toolSlug) || category === 'debt-and-loans') {
  disclosureText = 'We may earn a commission if you apply through these links. Your home may be repossessed if you do not keep up repayments on your mortgage.';
} else if (INVESTMENT_SLUGS.has(toolSlug) || category === 'saving-and-growth') {
  disclosureText = 'We may earn a commission if you open an account through these links. Capital at risk — the value of investments can go down as well as up.';
} else {
  disclosureText = 'We may earn a commission at no extra cost to you.';
}
---

<div class="mt-10 mb-6 rounded-lg bg-primary-50 border border-primary-200/60 p-6 sm:p-8 relative overflow-hidden">
  {/* Header */}
  <div class="relative flex items-center gap-3 mb-2">
    <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-primary-600 text-white shrink-0">
      <ToolIcon name="arrow-up-right" size={20} />
    </div>
    <div>
      <p class="text-xs font-semibold text-primary-600 uppercase tracking-wider mb-0.5">Take the Next Step</p>
      <h2 class="text-lg sm:text-xl font-bold text-neutral-900">{context}</h2>
    </div>
  </div>

  {/* Partner cards */}
  <div class:list={["relative grid gap-4 mt-5", partners.length >= 2 ? "grid-cols-1 sm:grid-cols-2" : "grid-cols-1 max-w-md"]}>
    {partners.map((partner) => (
      <a
        href={buildAffiliateUrl(partner.id, toolSlug)}
        target="_blank"
        rel="noopener sponsored"
        data-affiliate-partner={partner.id}
        data-affiliate-placement="take-next-step"
        class="group affiliate-link bg-white rounded-xl border border-neutral-200/80 p-5 sm:p-6 shadow-card hover:shadow-card-hover hover:border-primary-300 hover:-translate-y-0.5 transition-all duration-200 flex flex-col"
      >
        <div class="flex items-start gap-3 mb-1">
          <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-primary-50 text-primary-600 shrink-0 group-hover:bg-primary-700 group-hover:text-white transition-colors duration-200">
            <ToolIcon name={partner.icon} size={22} />
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-base font-bold text-neutral-900 group-hover:text-primary-700 transition-colors duration-200">
                {partner.name}
              </span>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-primary-100 text-primary-700">
                {partner.category}
              </span>
            </div>
            <p class="text-sm text-neutral-500 leading-relaxed">{partner.tagline}</p>
          </div>
        </div>

        <div class="mt-auto pt-3">
          <span class="inline-flex items-center justify-center w-full gap-2 h-11 rounded-xl text-sm font-semibold
            bg-primary-600 text-white group-hover:bg-primary-700 transition-all duration-200 shadow-sm shadow-primary-600/20">
            Get Started Free
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </span>
        </div>
      </a>
    ))}
  </div>

  <p class="relative text-xs text-neutral-500 mt-4 leading-relaxed">
    {disclosureText}{' '}
    We recommend partners based on relevance to the calculator you're using, not on commission rates.{' '}
    <a href="/disclosure" class="text-primary-600 hover:text-primary-700 underline transition-colors duration-200">
      Full disclosure
    </a>
  </p>
</div>
