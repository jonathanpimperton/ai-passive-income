---
/**
 * "Take the Next Step" affiliate callout — visually prominent section
 * that renders contextual partner recommendations on tool pages.
 *
 * Uses a colored background to break visual rhythm and catch attention
 * without feeling like an ad. Partner cards have clear CTAs with buttons.
 *
 * All links open in new tabs with rel="noopener sponsored" for FTC compliance.
 */
import ToolIcon from './ToolIcon.astro';
import { resolvePartners, buildAffiliateUrl } from '@lib/affiliate-data';

interface Props {
  context: string;
  programIds: string[];
  toolSlug: string;
}

const { context, programIds, toolSlug } = Astro.props;
const partners = resolvePartners(programIds);

if (partners.length === 0) return;
---

<div class="mt-10 mb-6 rounded-2xl bg-gradient-to-br from-primary-50 via-white to-accent-50 border border-primary-200/60 p-6 sm:p-8 relative overflow-hidden">
  {/* Decorative background element */}
  <div class="absolute top-0 right-0 w-40 h-40 bg-primary-100/30 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl pointer-events-none" aria-hidden="true"></div>

  {/* Header */}
  <div class="relative flex items-center gap-3 mb-2">
    <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-primary-600 text-white shrink-0 shadow-md shadow-primary-600/20">
      <ToolIcon name="sparkles" size={20} />
    </div>
    <div>
      <p class="text-xs font-semibold text-primary-600 uppercase tracking-wider mb-0.5">Take the Next Step</p>
      <h2 class="text-lg sm:text-xl font-bold text-neutral-900">{context}</h2>
    </div>
  </div>

  {/* Partner cards */}
  <div class:list={["relative grid gap-3 mt-5", partners.length >= 2 ? "grid-cols-1 sm:grid-cols-2" : "grid-cols-1 max-w-md"]}>
    {partners.map((partner) => (
      <a
        href={buildAffiliateUrl(partner.id, toolSlug)}
        target="_blank"
        rel="noopener sponsored"
        class="group bg-white rounded-xl border border-neutral-200/80 p-4 sm:p-5 shadow-card hover:shadow-card-hover hover:border-primary-300 transition-all duration-200 flex flex-col"
      >
        <div class="flex items-start gap-3 mb-3">
          <div class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary-50 text-primary-600 shrink-0 group-hover:bg-primary-600 group-hover:text-white transition-colors duration-200">
            <ToolIcon name={partner.icon} size={20} />
          </div>
          <div class="min-w-0 flex-1">
            <span class="text-sm font-bold text-neutral-900 group-hover:text-primary-700 transition-colors duration-200">
              {partner.name}
            </span>
            <p class="text-sm text-neutral-500 leading-relaxed mt-0.5">{partner.tagline}</p>
          </div>
        </div>

        <div class="mt-auto">
          <span class="inline-flex items-center justify-center w-full gap-2 h-10 rounded-lg text-sm font-semibold
            bg-primary-600 text-white group-hover:bg-primary-700 transition-colors duration-200 shadow-sm">
            Get Started Free
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </span>
        </div>
      </a>
    ))}
  </div>

  <p class="relative text-xs text-neutral-400 mt-4 leading-relaxed">
    Affiliate link — we may earn a commission at no extra cost to you.
    <a href="/disclosure" class="text-primary-500 hover:text-primary-600 underline transition-colors duration-200">
      Full disclosure
    </a>
  </p>
</div>
