---
/**
 * "Next step" affiliate recommendations — quiet rows, not cards.
 *
 * One bordered container with a neutral header, the FTC disclosure line
 * ABOVE the partner rows (compliance: disclosure before the links), and
 * one hairline-separated row per partner. Each row ends in a compact
 * teal text link instead of a block button.
 *
 * All links open in new tabs with rel="noopener sponsored" for FTC compliance.
 */
import { resolvePartners, buildAffiliateUrl } from '@lib/affiliate-data';

interface Props {
  context: string;
  programIds: string[];
  toolSlug: string;
  category?: string;
}

const { context, programIds, toolSlug, category } = Astro.props;
const partners = resolvePartners(programIds);

if (partners.length === 0) return;

/* Contextual disclosure text based on page type */
const INVESTMENT_SLUGS = new Set(['compound-interest', 'investment-return', 'investment-fee', 'retirement-savings', 'retirement-contribution', 'retirement-age', 'savings-goal', 'roi']);
const LOAN_SLUGS = new Set(['mortgage-payment', 'mortgage-affordability', 'loan-amortization', 'rent-vs-buy']);

let disclosureText: string;
if (LOAN_SLUGS.has(toolSlug) || category === 'debt-and-loans') {
  disclosureText = 'We may earn a commission if you apply through these links. Your home may be repossessed if you do not keep up repayments on your mortgage.';
} else if (INVESTMENT_SLUGS.has(toolSlug) || category === 'saving-and-growth') {
  disclosureText = 'We may earn a commission if you open an account through these links. Capital at risk — the value of investments can go down as well as up.';
} else {
  disclosureText = 'We may earn a commission at no extra cost to you.';
}
---

<div class="mt-10 mb-6 rounded-lg bg-surface border border-neutral-200/80 p-5 sm:p-6">
  {/* Header */}
  <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500">Next step</p>
  <h2 class="text-base sm:text-lg font-semibold text-neutral-900 mt-1">{context}</h2>

  {/* FTC disclosure — before the links */}
  <p class="text-xs text-neutral-500 mt-2 leading-relaxed">
    {disclosureText}{' '}
    We recommend partners based on relevance to the calculator you're using, not on commission rates.{' '}
    <a href="/disclosure/" class="underline hover:text-primary-600 transition-colors duration-150">
      Full disclosure
    </a>
  </p>

  {/* Partner rows */}
  <div class="mt-4 border-t border-neutral-200/80 divide-y divide-neutral-200/80">
    {partners.map((partner) => (
      <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-4 py-4">
        <div class="min-w-0 flex-1">
          <p class="text-sm">
            <span class="font-semibold text-neutral-900">{partner.name}</span>
            <span class="ml-2 text-xs text-neutral-500">{partner.category}</span>
          </p>
          <p class="text-sm text-neutral-500 mt-0.5">{partner.tagline}</p>
        </div>
        <a
          href={buildAffiliateUrl(partner.id, toolSlug)}
          target="_blank"
          rel="noopener sponsored"
          data-affiliate-partner={partner.id}
          data-affiliate-placement="take-next-step"
          class="affiliate-link shrink-0 text-sm font-medium text-primary-600 hover:text-primary-700 hover:underline transition-colors duration-150 whitespace-nowrap"
        >
          Visit {partner.name} <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    ))}
  </div>
</div>
