---
/**
 * Animated aurora gradient blobs for dark hero/header sections.
 * Pure CSS animation — 0KB JavaScript, respects prefers-reduced-motion.
 *
 * Usage: Place inside a `position: relative; overflow: hidden` container with a dark background.
 *   <section class="relative overflow-hidden bg-[#0F1B2D]">
 *     <AuroraBackground />
 *     <div class="relative z-10">...content...</div>
 *   </section>
 *
 * Props:
 *   intensity - "full" (homepage hero) | "medium" (index pages) | "subtle" (secondary sections)
 */
interface Props {
  intensity?: 'full' | 'medium' | 'subtle';
}

const { intensity = 'medium' } = Astro.props;

const configs = {
  full: {
    blobs: [
      { cls: 'ab-1', style: 'width:80%;height:80%;left:-20%;top:-40%;background:radial-gradient(circle,#1DD3B0 0%,#0B6E6E 40%,transparent 70%);filter:blur(60px);opacity:0.7' },
      { cls: 'ab-2', style: 'width:60%;height:60%;right:-15%;top:-25%;background:radial-gradient(circle,#67E8F9 0%,#0E7490 40%,transparent 70%);filter:blur(50px);opacity:0.55' },
      { cls: 'ab-3', style: 'width:90%;height:90%;left:10%;bottom:-60%;background:radial-gradient(circle,#0E8585 0%,#064E3B 40%,transparent 70%);filter:blur(80px);opacity:0.65' },
      { cls: 'ab-4', style: 'width:50%;height:50%;right:5%;top:5%;background:radial-gradient(circle,#5EEAD4 0%,#14B8A6 40%,transparent 70%);filter:blur(40px);opacity:0.4' },
      { cls: 'ab-5', style: 'width:55%;height:55%;left:5%;bottom:-20%;background:radial-gradient(circle,#38BDF8 0%,#0284C7 40%,transparent 70%);filter:blur(50px);opacity:0.45' },
      { cls: 'ab-6', style: 'width:40%;height:40%;left:45%;top:-10%;background:radial-gradient(circle,#A78BFA 0%,#6D28D9 40%,transparent 70%);filter:blur(40px);opacity:0.35' },
    ],
  },
  medium: {
    blobs: [
      { cls: 'ab-1', style: 'width:70%;height:70%;left:-15%;top:-35%;background:radial-gradient(circle,#1DD3B0 0%,#0B6E6E 40%,transparent 70%);filter:blur(70px);opacity:0.45' },
      { cls: 'ab-2', style: 'width:50%;height:50%;right:-10%;top:-20%;background:radial-gradient(circle,#67E8F9 0%,#0E7490 40%,transparent 70%);filter:blur(50px);opacity:0.35' },
      { cls: 'ab-3', style: 'width:80%;height:80%;left:15%;bottom:-55%;background:radial-gradient(circle,#0E8585 0%,#064E3B 40%,transparent 70%);filter:blur(80px);opacity:0.4' },
      { cls: 'ab-5', style: 'width:45%;height:45%;left:50%;top:-10%;background:radial-gradient(circle,#A78BFA 0%,#6D28D9 40%,transparent 70%);filter:blur(40px);opacity:0.2' },
    ],
  },
  subtle: {
    blobs: [
      { cls: 'ab-1', style: 'width:60%;height:60%;left:-10%;top:-30%;background:radial-gradient(circle,#14B8A6 0%,#0B6E6E 40%,transparent 70%);filter:blur(70px);opacity:0.3' },
      { cls: 'ab-2', style: 'width:50%;height:50%;right:-5%;top:-15%;background:radial-gradient(circle,#67E8F9 0%,#0E7490 40%,transparent 70%);filter:blur(60px);opacity:0.2' },
      { cls: 'ab-3', style: 'width:70%;height:70%;left:20%;bottom:-50%;background:radial-gradient(circle,#0E8585 0%,#064E3B 40%,transparent 70%);filter:blur(80px);opacity:0.25' },
    ],
  },
};

const { blobs } = configs[intensity];
---

<div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
  {blobs.map(({ cls, style }) => (
    <div class={`ab ${cls} absolute rounded-full mix-blend-hard-light`} style={style}></div>
  ))}
</div>

<style>
  .ab {
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ab-1 { animation: ab-d1 12s ease-in-out infinite; }
    .ab-2 { animation: ab-d2 15s ease-in-out infinite; }
    .ab-3 { animation: ab-d3 18s ease-in-out infinite; }
    .ab-4 { animation: ab-d4 10s ease-in-out infinite; }
    .ab-5 { animation: ab-d5 14s ease-in-out infinite; }
    .ab-6 { animation: ab-d6 13s ease-in-out infinite; }
  }

  @keyframes ab-d1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(200px, -120px) scale(1.15); }
    50% { transform: translate(-100px, 100px) scale(0.85); }
    75% { transform: translate(160px, 150px) scale(1.2); }
  }
  @keyframes ab-d2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-250px, 80px) scale(1.2); }
    66% { transform: translate(150px, -140px) scale(0.8); }
  }
  @keyframes ab-d3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    20% { transform: translate(120px, 140px) scale(1.15); }
    40% { transform: translate(-80px, -100px) scale(0.9); }
    60% { transform: translate(-180px, 60px) scale(1.1); }
    80% { transform: translate(100px, -120px) scale(0.88); }
  }
  @keyframes ab-d4 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-160px, -200px) scale(1.3); }
  }
  @keyframes ab-d5 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    30% { transform: translate(180px, -100px) scale(0.82); }
    70% { transform: translate(-140px, 120px) scale(1.18); }
  }
  @keyframes ab-d6 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40% { transform: translate(-120px, -160px) scale(1.15); }
    80% { transform: translate(140px, 100px) scale(0.85); }
  }
</style>
