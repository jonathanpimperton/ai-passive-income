---
/**
 * FTC-compliant affiliate disclosure banner.
 * Appears at the top of any page with affiliate links (below H1, above calculator).
 * Not dismissible -- FTC requires it to be visible.
 *
 * Compact on purpose (one bordered line, no icon chip) so it doesn't push
 * the calculator below the fold on phones. Pass `toolSlug` so secured-lending
 * pages (mortgage payment, affordability, rent-vs-buy, mortgage comparisons)
 * also carry the repossession warning; no other page does.
 */
import { isSecuredLendingPage, REPOSSESSION_WARNING } from '@lib/affiliate-data';

interface Props {
  toolSlug?: string;
}

const { toolSlug } = Astro.props;
const secured = isSecuredLendingPage(toolSlug);
---

<p class="affiliate-disclosure my-3 sm:my-4 rounded-lg border border-primary-200/60 bg-primary-50 px-3 py-2 sm:px-4 sm:py-3 text-sm text-neutral-700 leading-relaxed">
  <span class="font-semibold">Disclosure:</span> Some links on this page may be affiliate links. Paid links are marked "Affiliate link", and we may earn a commission on those at no extra cost to you.
  {secured && <> {REPOSSESSION_WARNING}</>}
  <a href="/disclosure/" class="text-primary-600 hover:text-primary-700 underline transition-colors duration-200 ml-1">
    Full disclosure &rarr;
  </a>
</p>
