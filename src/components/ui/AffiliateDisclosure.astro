---
/**
 * FTC-compliant affiliate disclosure banner.
 * Appears at the top of any page with affiliate links (below H1, above calculator).
 * Not dismissible — FTC requires it to be visible.
 */
import ToolIcon from './ToolIcon.astro';
---

<div class="bg-primary-50 border border-primary-200/60 rounded-xl px-5 py-4 my-4 flex items-start gap-3">
  <div class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-primary-100 text-primary-500 shrink-0 mt-0.5">
    <ToolIcon name="info" size={16} />
  </div>
  <p class="text-sm text-neutral-700 leading-relaxed">
    <span class="font-semibold">Disclosure:</span> Some links on this page are affiliate links. We may earn a commission at no extra cost to you.
    <a href="/disclosure" class="text-primary-500 hover:text-primary-700 underline transition-colors duration-200 ml-1">
      Full disclosure &rarr;
    </a>
  </p>
</div>
