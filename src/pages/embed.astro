---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';
import { TOOLS, CATEGORIES } from '@lib/tools-data';

/**
 * Embed code generator page.
 * Lets bloggers and site owners grab iframe snippets to embed CalcRun calculators.
 * Per build-spec: "Embeddable widgets = passive backlinks"
 */

// Only financial calculators are embeddable (not file converters or utility tools)
const embeddableCategories = ['saving-and-growth', 'debt-and-loans', 'income-and-planning', 'economic'];
const embeddableTools = TOOLS.filter((t) => embeddableCategories.includes(t.category));
---

<BaseLayout
  title="Embed Our Calculators — Free Widget Code"
  description="Add CalcRun financial calculators to your website for free. Copy the embed code and paste it into any page. Attribution required."
>
  {/* Page header */}
  <section class="bg-[linear-gradient(135deg,#0F1B2D_0%,#0A5555_50%,#0F1B2D_100%)] py-12 sm:py-16">
    <div class="max-w-[768px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3">Embed Our Calculators</h1>
      <p class="text-lg text-primary-200/90">
        Add any CalcRun calculator to your website — free, forever.
      </p>
    </div>
  </section>

  <div class="max-w-[960px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {/* How it works */}
    <div class="bg-white border border-neutral-200/80 rounded-lg shadow-card p-6 sm:p-8 mb-10">
      <div class="flex items-start gap-4 mb-6">
        <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-primary-100 text-primary-600 shrink-0">
          <ToolIcon name="code" size={20} />
        </div>
        <div>
          <h2 class="text-xl font-bold text-neutral-900 mb-1">How It Works</h2>
          <p class="text-neutral-600 leading-relaxed">
            Select a calculator below, copy the iframe code, and paste it into your website. The embed includes the full interactive calculator with a small "Powered by CalcRun" link.
          </p>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-neutral-50 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-primary-600 mb-1">1</div>
          <p class="text-sm text-neutral-700 font-medium">Pick a calculator</p>
        </div>
        <div class="bg-neutral-50 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-primary-600 mb-1">2</div>
          <p class="text-sm text-neutral-700 font-medium">Copy the embed code</p>
        </div>
        <div class="bg-neutral-50 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-primary-600 mb-1">3</div>
          <p class="text-sm text-neutral-700 font-medium">Paste into your site</p>
        </div>
      </div>
    </div>

    {/* Calculator selector + code generator */}
    <h2 class="text-xl font-bold text-neutral-900 mb-4">Choose a Calculator</h2>

    <div class="space-y-3" id="embed-list">
      {embeddableTools.map((tool) => {
        const url = `https://www.calcrun.com/tools/${tool.category}/${tool.slug}?embed`;
        const code = `<iframe src="${url}" width="100%" height="700" style="border:none;border-radius:12px;" loading="lazy" title="${tool.name}"></iframe>`;
        return (
          <div class="bg-white border border-neutral-200/80 rounded-lg shadow-card overflow-hidden embed-card">
            <button
              class="w-full flex items-center gap-3 p-4 sm:p-5 text-left hover:bg-neutral-50/50 transition-colors duration-150 embed-toggle"
              aria-expanded="false"
              aria-controls={`embed-panel-${tool.slug}`}
              data-slug={tool.slug}
            >
              <div class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-primary-50 text-primary-600 shrink-0">
                <ToolIcon name={tool.icon} size={18} />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-neutral-900 truncate">{tool.name}</p>
                <p class="text-xs text-neutral-500">{CATEGORIES[tool.category]?.label}</p>
              </div>
              <svg class="w-5 h-5 text-neutral-400 shrink-0 transition-transform duration-200 embed-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div id={`embed-panel-${tool.slug}`} class="embed-panel hidden border-t border-neutral-100 p-4 sm:p-5 bg-neutral-50/50">
              <label for={`embed-code-${tool.slug}`} class="text-xs font-medium text-neutral-500 uppercase tracking-wide mb-2 block">Embed Code</label>
              <div class="relative">
                <textarea
                  id={`embed-code-${tool.slug}`}
                  readonly
                  rows="3"
                  class="w-full px-4 py-3 text-xs font-mono text-neutral-700 bg-white border border-neutral-200/80 rounded-xl resize-none focus:outline-none focus:ring-2 focus:ring-primary-500"
                >{code}</textarea>
                <button
                  class="absolute top-2 right-2 px-3 py-1.5 text-xs font-medium text-primary-600 bg-primary-50 border border-primary-200/60 rounded-lg hover:bg-primary-100 transition-colors duration-150 copy-btn"
                  data-code={code}
                  aria-label={`Copy embed code for ${tool.name}`}
                >
                  Copy
                </button>
              </div>
              <p class="text-xs text-neutral-400 mt-2">
                Adjust <code class="bg-neutral-100 px-1 rounded">height</code> as needed. The calculator is fully responsive.
              </p>
            </div>
          </div>
        );
      })}
    </div>

    {/* Terms */}
    <div class="mt-10 bg-neutral-50 border border-neutral-200/60 rounded-lg p-6">
      <h3 class="text-base font-semibold text-neutral-900 mb-2">Embed Terms</h3>
      <ul class="text-sm text-neutral-600 space-y-1.5 leading-relaxed">
        <li>Embeds are free for personal and commercial use.</li>
        <li>The "Powered by CalcRun" attribution link must remain visible.</li>
        <li>Do not modify the iframe content or remove the attribution.</li>
        <li>We reserve the right to update calculators at any time.</li>
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
  // Toggle embed panels
  document.querySelectorAll('.embed-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.embed-card');
      if (!card) return;
      const panel = card.querySelector('.embed-panel');
      const chevron = card.querySelector('.embed-chevron');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all others
      document.querySelectorAll('.embed-toggle').forEach((other) => {
        if (other !== btn) {
          other.setAttribute('aria-expanded', 'false');
          const otherCard = other.closest('.embed-card');
          otherCard?.querySelector('.embed-panel')?.classList.add('hidden');
          otherCard?.querySelector('.embed-chevron')?.classList.remove('rotate-180');
        }
      });

      btn.setAttribute('aria-expanded', String(!isOpen));
      panel?.classList.toggle('hidden');
      chevron?.classList.toggle('rotate-180');
    });
  });

  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const code = (btn as HTMLElement).dataset.code;
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = original; }, 2000);
      } catch {
        // Fallback: select textarea
        const panel = btn.closest('.embed-panel');
        const textarea = panel?.querySelector('textarea');
        textarea?.select();
      }
    });
  });
</script>
