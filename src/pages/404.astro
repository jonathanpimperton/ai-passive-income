---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | CalcPath" description="The page you're looking for doesn't exist.">
  <div class="max-w-[768px] mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <p class="text-6xl font-bold text-primary-500 mb-4">404</p>
    <h1 class="text-2xl font-bold text-neutral-900 mb-3">Page Not Found</h1>
    <p class="text-neutral-500 mb-8">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/"
        class="inline-flex items-center justify-center gap-2 bg-primary-500 text-white font-semibold px-6 py-3 rounded-lg hover:bg-primary-700 transition-colors duration-150"
      >
        Go to Homepage
      </a>
      <a
        href="/tools"
        class="inline-flex items-center justify-center gap-2 bg-white text-neutral-700 font-semibold px-6 py-3 rounded-lg border border-neutral-200 hover:bg-neutral-50 transition-colors duration-150"
      >
        Browse Tools
      </a>
    </div>
  </div>
</BaseLayout>
