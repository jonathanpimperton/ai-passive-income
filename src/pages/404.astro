---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';
---

<BaseLayout title="Page Not Found | CalcRun" description="The page you're looking for doesn't exist." noindex={true}>
  <div class="max-w-[768px] mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 text-center">
    {/* Icon */}
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-xl bg-primary-50 text-primary-600 mb-8 mx-auto">
      <ToolIcon name="search" size={32} />
    </div>

    <p class="text-sm font-semibold text-primary-600 uppercase tracking-wider mb-2">Error 404</p>
    <h1 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-3">Page Not Found</h1>
    <p class="text-neutral-500 mb-10 max-w-[400px] mx-auto leading-relaxed">
      The page you're looking for doesn't exist or has been moved. Let's get you back on track.
    </p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href="/"
        class="inline-flex items-center justify-center gap-2 bg-primary-600 text-white font-semibold px-6 py-3 rounded-xl hover:bg-primary-700 shadow-lg shadow-primary-600/20 hover:shadow-primary-700/25 transition-all duration-200 hover:-translate-y-0.5"
      >
        <ToolIcon name="home" size={18} />
        Go to Homepage
      </a>
      <a
        href="/tools/"
        class="inline-flex items-center justify-center gap-2 bg-white text-neutral-700 font-semibold px-6 py-3 rounded-xl border border-neutral-200 hover:bg-neutral-50 hover:border-neutral-300 transition-all duration-200"
      >
        <ToolIcon name="calculator" size={18} />
        Browse Tools
      </a>
    </div>
  </div>
</BaseLayout>
