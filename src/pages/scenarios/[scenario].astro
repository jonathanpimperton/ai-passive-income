---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';
import { getCollection, render } from 'astro:content';
import { buildBreadcrumbSchema } from '@lib/seo';
import { TOOLS, getToolPath, type ToolMeta } from '@lib/tools-data';

export async function getStaticPaths() {
  const scenarios = await getCollection('scenarios');
  return scenarios.map((scenario) => ({
    params: { scenario: scenario.data.slug },
    props: { scenario },
  }));
}

const { scenario } = Astro.props;
const { title, slug, description, keywords, toolSlug, toolCategory, inputs, resultSummary } = scenario.data;
const { Content } = await render(scenario);

const toolMeta = TOOLS.find((t) => t.slug === toolSlug);
const toolPath = toolMeta ? getToolPath(toolMeta) : `/tools/${toolCategory}/${toolSlug}`;

// Get related scenarios (same tool, excluding current)
const allScenarios = await getCollection('scenarios');
const relatedScenarios = allScenarios
  .filter((s) => s.data.toolSlug === toolSlug && s.data.slug !== slug)
  .slice(0, 4);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Scenarios', url: '/scenarios' },
  { name: title, url: `/scenarios/${slug}` },
];

const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title={title}
  description={description}
  ogImage={`/og/${toolSlug}.png`}
  structuredData={[breadcrumbSchema]}
>
  {/* Dark gradient header */}
  <div class="bg-[linear-gradient(135deg,#0F1B2D_0%,#0A5555_50%,#0F1B2D_100%)] text-white">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <Breadcrumb items={breadcrumbs} />

      <div class="flex items-start gap-4 mt-4 mb-6">
        {toolMeta && (
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-white/10 text-white shrink-0 backdrop-blur-sm">
            <ToolIcon name={toolMeta.icon} size={24} />
          </div>
        )}
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h1>
      </div>
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-10">
      {/* Main content */}
      <div>
        {/* Answer card */}
        <div class="bg-white border border-neutral-200/80 rounded-2xl p-6 sm:p-8 shadow-card mb-8">
          <p class="text-xs font-semibold text-primary-600 uppercase tracking-wider mb-3">Quick Answer</p>
          <p class="text-3xl sm:text-4xl font-bold text-neutral-900 tabular-nums mb-4">{resultSummary}</p>
          <div class="flex flex-wrap gap-2">
            {Object.entries(inputs).map(([key, value]) => (
              <span class="inline-flex items-center gap-1 text-xs font-medium text-primary-700 bg-primary-50 px-2.5 py-1 rounded-full">
                <span class="text-primary-600">{key}:</span>
                <span class="tabular-nums">{value}</span>
              </span>
            ))}
          </div>
        </div>

        {/* Try it yourself CTA */}
        <a
          href={toolPath}
          class="inline-flex items-center gap-2 mb-8 px-5 py-3 text-sm font-semibold rounded-xl text-white bg-primary-600 hover:bg-primary-700 transition-all duration-200 shadow-sm shadow-primary-600/20"
        >
          Try it with your numbers
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>

        {/* Educational content */}
        <div class="prose max-w-none">
          <Content />
        </div>

        {/* Bottom CTA */}
        <div class="mt-10 bg-gradient-to-br from-primary-50 to-accent-50 border border-primary-200/60 rounded-2xl p-6 sm:p-8">
          <h2 class="text-xl font-bold text-neutral-900 mb-2">Ready to run your own numbers?</h2>
          <p class="text-sm text-neutral-600 mb-4 leading-relaxed">
            This scenario uses specific inputs. Your situation is unique — adjust the numbers to see what applies to you.
          </p>
          <a
            href={toolPath}
            class="inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold rounded-xl text-white bg-primary-600 hover:bg-primary-700 transition-all duration-200 shadow-sm shadow-primary-600/20"
          >
            {toolMeta ? `Open ${toolMeta.name}` : 'Open Calculator'}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      </div>

      {/* Sidebar */}
      <aside class="space-y-6">
        {/* Parent calculator card */}
        {toolMeta && (
          <div class="bg-white border border-neutral-200/80 rounded-xl p-5 shadow-card">
            <p class="text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-3">Calculator Used</p>
            <a href={toolPath} class="group flex items-start gap-3">
              <div class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary-50 text-primary-600 shrink-0 group-hover:bg-primary-600 group-hover:text-white transition-colors duration-200">
                <ToolIcon name={toolMeta.icon} size={20} />
              </div>
              <div>
                <span class="text-sm font-bold text-neutral-900 group-hover:text-primary-600 transition-colors duration-200">
                  {toolMeta.name}
                </span>
                <p class="text-xs text-neutral-500 mt-0.5">{toolMeta.description}</p>
              </div>
            </a>
          </div>
        )}

        {/* Related scenarios */}
        {relatedScenarios.length > 0 && (
          <div class="bg-white border border-neutral-200/80 rounded-xl p-5 shadow-card">
            <p class="text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-3">Related Scenarios</p>
            <ul class="space-y-3">
              {relatedScenarios.map((related) => (
                <li>
                  <a
                    href={`/scenarios/${related.data.slug}`}
                    class="group block"
                  >
                    <span class="text-sm font-medium text-neutral-900 group-hover:text-primary-600 transition-colors duration-200">
                      {related.data.title}
                    </span>
                    <span class="block text-xs text-primary-600 font-semibold tabular-nums mt-0.5">
                      {related.data.resultSummary}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
