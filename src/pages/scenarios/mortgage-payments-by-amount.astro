---
/**
 * Hub page: mortgage payments by loan amount.
 * Consolidates the retired per-amount mortgage doorway scenarios ($150k-$750k)
 * into one reference matrix. Every figure comes from the figure engine
 * (`mortgagePayment`, `mortgageTotalInterest`, `rate`), which is proven equal to
 * the Mortgage Payment Calculator's engine by src/lib/figures-grid.test.ts.
 * The rate columns are fixed steps plus the market average from market-rates.ts
 * (the calculators' own default rate), so the page ages the way the tools do.
 *
 * Retired scenario URLs 301 here with row anchors (e.g. /#300k) via
 * public/_redirects. Keep every row id.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Byline from '@components/ui/Byline.astro';
import HubTable from '@components/scenarios/HubTable.astro';
import type { HubRow } from '@components/scenarios/HubTable.astro';
import MortgagePaymentCalc from '@components/tools/MortgagePaymentCalc.tsx';
import { buildArticleSchema } from '@lib/seo';
import {
  fig,
  num,
  kAnchor,
  moneyLabel,
  first,
  last,
  MORTGAGE_AMOUNTS,
  MORTGAGE_RATES,
  MORTGAGE_TERM_YEARS,
  MORTGAGE_HEADLINE_AMOUNT,
  MORTGAGE_ROW_PAGES,
} from '@components/scenarios/hub-config';

const DATE_PUBLISHED = '2026-07-07';
const DATE_MODIFIED = '2026-11-15';

const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const gbp = (n: number) => '£' + Math.round(n).toLocaleString('en-GB');
const term = MORTGAGE_TERM_YEARS;

// Market snapshot: the calculators' default rates (src/lib/market-rates.ts)
const marketRate = num("rate('us30')");
const marketLabel = fig("rate('us30') | pct(2)");
const marketSource = fig("rateSource('us30')");
const market15 = num("rate('us15')");
const market15Label = fig("rate('us15') | pct(2)");
const marketUk5 = num("rate('uk5yr')");
const marketUk5Label = fig("rate('uk5yr') | pct(2)");
const marketUk5Source = fig("rateSource('uk5yr')");
const marketUk2 = num("rate('uk2yr')");
const marketUk2Label = fig("rate('uk2yr') | pct(2)");

const payment = (amount: number, rate: number, years = term) =>
  num(`mortgagePayment(${amount}, ${rate}, ${years})`);
const totalInterest = (amount: number, rate: number, years = term) =>
  num(`mortgageTotalInterest(${amount}, ${rate}, ${years})`);
const rateLabel = (r: number) => `${Number(r.toFixed(2))}%`;

const rows: HubRow[] = MORTGAGE_AMOUNTS.map((amount) => {
  const page = MORTGAGE_ROW_PAGES[amount];
  return {
    id: kAnchor(amount),
    label: usd(amount),
    href: page?.href,
    hrefLabel: page?.label,
    cells: [
      { text: usd(payment(amount, marketRate)), tone: 'plain', strong: true },
      ...MORTGAGE_RATES.map((r) => ({ text: usd(payment(amount, r)), tone: 'plain' as const })),
    ],
  };
});

// The rates either side of today's average, for the one-line reading of the table
const below = [...MORTGAGE_RATES].filter((r) => r <= marketRate).pop();
const above = MORTGAGE_RATES.find((r) => r >= marketRate);
const between =
  below !== undefined && above !== undefined && below !== above
    ? `between the ${rateLabel(below)} and ${rateLabel(above)} columns`
    : below === above && below !== undefined
      ? `the ${rateLabel(below)} column`
      : marketRate < MORTGAGE_RATES[0]
        ? `below the ${rateLabel(MORTGAGE_RATES[0])} column`
        : `above the ${rateLabel(MORTGAGE_RATES[MORTGAGE_RATES.length - 1])} column`;

const headlineAmount = MORTGAGE_HEADLINE_AMOUNT;
const headlinePay = payment(headlineAmount, marketRate);
const headlineInterest = totalInterest(headlineAmount, marketRate);

// Rates range, as prose: lowest column to highest, with today's average noted
const lowRate = MORTGAGE_RATES[0];
const highRate = MORTGAGE_RATES[MORTGAGE_RATES.length - 1];
const rateRange = `${rateLabel(lowRate)} to ${rateLabel(highRate)}`;

// Prose figures
const pay300Fixed = payment(300000, 6.5);
const swing400 = payment(400000, highRate) - payment(400000, lowRate);
const equivalentExtra = Math.round(
  (swing400 / (payment(400000, lowRate) / 400000)) / 1000,
) * 1000;
const pay400at6 = payment(400000, 6);

const interest300 = totalInterest(300000, marketRate);
const interestShare = (interest300 / 300000) * 100;
const interestRows = [200000, 300000, 400000, 500000].map((amount) => ({
  label: usd(amount),
  cells: [
    { text: usd(payment(amount, marketRate)), tone: 'plain' as const, strong: true },
    { text: usd(totalInterest(amount, marketRate)), tone: 'cost' as const, strong: true },
  ],
}));

const pay30 = payment(300000, marketRate, 30);
const pay15 = payment(300000, market15, 15);
const interest30 = totalInterest(300000, marketRate, 30);
const interest15 = totalInterest(300000, market15, 15);
const payRisePct = ((pay15 - pay30) / pay30) * 100;
const interestFallPct = ((interest30 - interest15) / interest30) * 100;

const ukPay5 = payment(300000, marketUk5, 25);
const ukPay2 = payment(300000, marketUk2, 25);

const amountLo = moneyLabel(first(MORTGAGE_AMOUNTS), '$');
const amountHi = moneyLabel(last(MORTGAGE_AMOUNTS), '$');
const title = `Mortgage Payments by Amount: ${amountLo} to ${amountHi}`;
const description = `Monthly payments on ${amountLo} to ${amountHi} mortgages at the latest ${marketLabel} average and at ${rateRange}, over ${term} years, plus total interest and a UK guide.`;

const articleSchema = buildArticleSchema({
  headline: title,
  description,
  path: '/scenarios/mortgage-payments-by-amount/',
  datePublished: DATE_PUBLISHED,
  dateModified: DATE_MODIFIED,
  ogImagePath: '/og/hubs/mortgage-payments-by-amount.png',
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Scenarios', url: '/scenarios/' },
  { name: 'Mortgage Payments by Amount', url: '/scenarios/mortgage-payments-by-amount/' },
];

const linkClass = 'text-primary-600 hover:text-primary-700 underline transition-colors duration-150';
const deepLinkClass = 'text-primary-600 hover:text-primary-700 font-medium underline decoration-primary-200 underline-offset-2 transition-colors duration-150';
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/og/hubs/mortgage-payments-by-amount.png"
  structuredData={[articleSchema]}
>
  {/* Page header */}
  <section class="border-b border-neutral-200/80 bg-bg">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <Breadcrumb items={breadcrumbs} />
      <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 tracking-[-0.02em]">
        Mortgage payments by amount: <span class="text-neutral-500 font-normal tabular-nums">{amountLo} to {amountHi}</span>
      </h1>
      <Byline datePublished={DATE_PUBLISHED} dateModified={DATE_MODIFIED} />
      <p class="mt-4 text-lg text-neutral-600 max-w-[720px] leading-relaxed">
        The monthly payment on every common loan amount from {amountLo} to {amountHi}, at the latest
        weekly average rate ({marketLabel}, {marketSource}) and at fixed rates from {rateRange}.
        30-year term, principal and interest. The amortization math is currency-agnostic: a
        &pound;300,000 loan at the same rate and term costs the same figure in pounds.
      </p>

      {/* The answer */}
      <div class="mt-6 max-w-[520px]" role="group" aria-label={`A ${usd(headlineAmount)} loan at ${marketLabel} over ${term} years`}>
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-white border border-neutral-200/80 rounded-lg p-4">
            <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider">A month</p>
            <p class="mt-1 text-2xl sm:text-3xl font-bold text-neutral-900 tabular-nums">{usd(headlinePay)}</p>
          </div>
          <div class="bg-white border border-neutral-200/80 rounded-lg p-4">
            <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider">Interest over {term} years</p>
            <p class="mt-1 text-2xl sm:text-3xl font-bold text-red-600 tabular-nums">{usd(headlineInterest)}</p>
          </div>
        </div>
        <p class="mt-2 text-sm text-neutral-600">
          A <span class="tabular-nums">{usd(headlineAmount)}</span> loan at <span class="tabular-nums">{marketLabel}</span>
          ({marketSource}), a snapshot, not a quote. That average sits {between}.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    {/* The matrix */}
    <HubTable
      caption={`Monthly principal-and-interest payment on a ${term}-year fixed mortgage, by loan amount and interest rate. The first rate column is the weekly average for a ${term}-year fixed loan (${marketLabel}, ${marketSource}).`}
      rowHeader="Loan amount"
      columns={[
        { label: `Average ${marketLabel}`, sub: marketSource, emphasis: true },
        ...MORTGAGE_RATES.map((r) => ({ label: rateLabel(r) })),
      ]}
      rows={rows}
      scrollCue="Swipe sideways for the other rates."
    />
    <p class="mt-3 text-xs text-neutral-500">
      Monthly payment, {term}-year ({term * 12}-payment) repayment term, principal and interest only.
      US buyers typically add property tax, homeowners insurance, and PMI; the
      <a href="#calculator" class="underline decoration-neutral-300 underline-offset-2 hover:text-primary-700 transition-colors duration-150">full calculator</a> below prices those in.
    </p>

    {/* Reading the table */}
    <section class="mt-14 max-w-[768px]">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-[-0.02em] mb-6">Reading the table</h2>
      <div class="space-y-6 text-neutral-700 leading-relaxed">
        <div>
          <h3 class="font-bold text-neutral-900 mb-1.5">It's pure principal and interest</h3>
          <p>
            Each figure is the fixed monthly repayment that clears the loan in exactly {term} years,
            the standard amortization formula and nothing else. A $300,000 loan at 6.5% costs
            {' '}<span class="tabular-nums">{usd(pay300Fixed)}</span> a month whether the property is
            in Texas or Tyneside. In the US, the number on your statement will be higher, because
            lenders escrow property tax and homeowners insurance on top, and add PMI when the down
            payment is under 20%. None of that is in this table.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-neutral-900 mb-1.5">The rate matters as much as the amount</h3>
          <p>
            Read across a row rather than down a column: on $400,000, moving from {rateLabel(lowRate)} to {rateLabel(highRate)} adds
            {' '}<span class="tabular-nums">{usd(swing400)}</span> a month, the same as borrowing roughly
            {' '}<span class="tabular-nums">{usd(equivalentExtra)}</span> more at {rateLabel(lowRate)}.
            When you compare lender quotes, a quarter-point difference compounds over {term * 12} payments.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-neutral-900 mb-1.5">Dollars, pounds, or euros: same digits</h3>
          <p>
            The formula only sees the loan amount, the rate, and the term. &pound;400,000 at 6% over
            {' '}{term} years is <span class="tabular-nums">{gbp(pay400at6)}</span> a month, the same digits
            as the dollar row. What changes between countries is the market convention, not
            the math; the UK section below covers the differences that matter.
          </p>
        </div>
      </div>
    </section>

    {/* Total interest */}
    <section class="mt-14 max-w-[768px]">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-[-0.02em] mb-4">What the interest adds up to</h2>
      <p class="text-neutral-700 leading-relaxed mb-5">
        Over a full {term}-year term at {marketLabel}, interest
        {interest300 > 300000 ? 'exceeds the amount you borrowed' : 'adds a large share on top of the amount you borrowed'}: on
        $300,000 you repay <span class="tabular-nums text-red-600">{usd(interest300)}</span> in
        interest, {Math.round(interestShare)}% of the original loan.
      </p>
      <HubTable
        class="max-w-[560px]"
        caption={`Total interest over ${term} years by loan amount at ${marketLabel}.`}
        rowHeader="Loan amount"
        columns={[
          { label: `Monthly at ${marketLabel}` },
          { label: `Total interest (${term} years)` },
        ]}
        rows={interestRows}
      />
    </section>

    {/* 15 vs 30 years */}
    <section class="mt-14 max-w-[768px]">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-[-0.02em] mb-4">The 15-year alternative</h2>
      <p class="text-neutral-700 leading-relaxed">
        Lenders price a 15-year loan lower than a 30-year (the same weekly survey puts it at {market15Label}).
        On $300,000 that makes the payment
        {' '}<span class="tabular-nums">{usd(pay15)}</span> against
        {' '}<span class="tabular-nums">{usd(pay30)}</span> on the {term}, so
        {' '}<span class="tabular-nums">{usd(pay15 - pay30)}</span> more a month ({Math.round(payRisePct)}% more),
        but lifetime interest falls from
        {' '}<span class="tabular-nums text-red-600">{usd(interest30)}</span> to
        {' '}<span class="tabular-nums text-red-600">{usd(interest15)}</span>, {Math.round(interestFallPct)}% less, keeping
        {' '}<span class="tabular-nums text-success-600">{usd(interest30 - interest15)}</span> in
        your pocket.
        <a href="/comparisons/15-year-vs-30-year-mortgage/" class={linkClass}>15-year vs 30-year mortgage</a> weighs
        the trade-off in full, including when the 30 is the smarter choice.
      </p>
    </section>

    {/* UK section */}
    <section class="mt-14 max-w-[768px]">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-[-0.02em] mb-4">Borrowing in pounds</h2>
      <p class="text-neutral-700 leading-relaxed mb-4">
        The table applies to UK mortgages unchanged, but two conventions differ. UK terms usually
        run 25 years rather than 30, so the monthly payment is higher and the total interest lower. And
        UK rates are typically fixed for only 2&ndash;5 years, after which you
        remortgage or roll onto the lender's standard variable rate, so the payment you start with
        is not the payment you keep for three decades.
      </p>
      <p class="text-neutral-700 leading-relaxed">
        Worked example on UK conventions:
        <a href="/scenarios/uk-300k-mortgage-payment/" class={linkClass}>a &pound;300,000 mortgage over 25 years</a> costs
        {' '}<span class="tabular-nums">{gbp(ukPay5)}</span> a month at {marketUk5Label}
        (a 5-year fix; {marketUk5Source}) or <span class="tabular-nums">{gbp(ukPay2)}</span> at {marketUk2Label}
        (a 2-year fix), with a year-by-year breakdown of how the interest and principal split shifts.
      </p>
    </section>

    {/* Embedded calculator */}
    <section class="mt-14" id="calculator">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-[-0.02em] mb-2">Price your own loan</h2>
      <p class="text-neutral-600 leading-relaxed mb-6 max-w-[640px]">
        The calculator below starts on a {usd(headlineAmount)} loan with no down payment at {marketLabel}
        over {term} years, so its principal-and-interest figure matches the average-rate column. Add a
        down payment, property tax, homeowners insurance, PMI and extra monthly payments. If your
        currency is set to pounds or euros, it shows the same digits in that currency, with the rate and
        term kept as set here.
      </p>
      <MortgagePaymentCalc
        client:load
        defaults={{ homePrice: headlineAmount, downPaymentPercent: 0, interestRate: marketRate, loanTerm: term }}
      />
    </section>

    {/* Deep dives */}
    <section class="mt-14 max-w-[768px]">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-[-0.02em] mb-5">Go deeper</h2>
      <ul class="space-y-3">
        <li>
          <a href="/scenarios/300k-mortgage-7-percent/" class={deepLinkClass}>$300,000 at 7%</a>
          <span class="text-neutral-600"> — a full worked example with the monthly split, a 15-year comparison and a 13th payment</span>
        </li>
        <li>
          <a href="/tools/debt-and-loans/mortgage-affordability/" class={deepLinkClass}>Mortgage affordability calculator</a>
          <span class="text-neutral-600"> — work backwards from your income to a loan amount</span>
        </li>
        <li>
          <a href="/tools/debt-and-loans/rent-vs-buy/" class={deepLinkClass}>Rent vs buy calculator</a>
          <span class="text-neutral-600"> — whether the payment above beats renting</span>
        </li>
        <li>
          <a href="/how-we-calculate/mortgage-payment/" class={deepLinkClass}>How we calculate mortgage payments</a>
          <span class="text-neutral-600"> — the formula, assumptions, and sources</span>
        </li>
        <li>
          <a href="/comparisons/fixed-vs-variable-rate-mortgage/" class={deepLinkClass}>Fixed vs variable rate mortgage</a>
          <span class="text-neutral-600"> — which rate structure fits your plans</span>
        </li>
      </ul>
    </section>
  </div>

  <script>
    const _gtag = (window as any).gtag as ((...a: unknown[]) => void) | undefined;
    const _scrollFired = new Set<number>();
    window.addEventListener('scroll', () => {
      const scrollPct = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight * 100;
      for (const depth of [50, 90]) {
        if (scrollPct >= depth && !_scrollFired.has(depth)) {
          _scrollFired.add(depth);
          if (_gtag) _gtag('event', 'scroll_depth', { depth, page_type: 'hub' });
        }
      }
    }, { passive: true });
  </script>
</BaseLayout>
