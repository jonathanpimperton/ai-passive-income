---
/**
 * Hub page: investment growth by amount.
 * Consolidates the retired per-amount investment doorway scenarios
 * (monthly-contribution and lump-sum variants) into one reference table.
 * Every figure comes from the figure engine (`compoundFV`, `compoundEarned`,
 * `inflationAdjust`), which calls the same function the Compound Interest
 * Calculator uses: 7% a year compounded monthly, deposits at the end of each
 * month. Nothing on this page is typed by hand.
 *
 * Retired scenario URLs 301 here with row anchors (e.g. /#500-per-month,
 * /#100000) via public/_redirects. Keep every row id.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import Byline from '@components/ui/Byline.astro';
import HubTable from '@components/scenarios/HubTable.astro';
import type { HubRow } from '@components/scenarios/HubTable.astro';
import CompoundInterestCalc from '@components/tools/CompoundInterestCalc.tsx';
import { buildArticleSchema } from '@lib/seo';
import {
  num,
  INVEST_RATE,
  INVEST_YEARS,
  INVEST_MONTHLY_AMOUNTS,
  INVEST_LUMP_SUMS,
  INVEST_HEADLINE_MONTHLY,
  INVEST_HEADLINE_YEARS,
  INVEST_ROW_PAGES,
} from '@components/scenarios/hub-config';

const DATE_PUBLISHED = '2026-07-07';
const DATE_MODIFIED = '2026-11-15';

const RATE = INVEST_RATE;
const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const rateText = `${Number(RATE.toFixed(2))}%`;
const lastYears = INVEST_YEARS[INVEST_YEARS.length - 1];

const monthlyBalance = (monthly: number, years: number) =>
  num(`compoundFV(0, ${monthly}, ${RATE}, ${years})`);
const lumpBalance = (principal: number, years: number) =>
  num(`compoundFV(${principal}, 0, ${RATE}, ${years})`);

const yearColumns = INVEST_YEARS.map((y) => ({ label: `${y} years` }));
const lastCol = INVEST_YEARS.length - 1;

// Table 1: monthly contributions, $0 starting balance, end-of-month deposits
const monthlyRows: HubRow[] = INVEST_MONTHLY_AMOUNTS.map((monthly) => {
  const id = `${monthly}-per-month`;
  const page = INVEST_ROW_PAGES[id];
  return {
    id,
    label: `${usd(monthly)}/month`,
    href: page?.href,
    hrefLabel: page?.label,
    cells: INVEST_YEARS.map((y, i) => ({
      text: usd(monthlyBalance(monthly, y)),
      tone: i === lastCol ? ('gain' as const) : ('plain' as const),
      strong: i === lastCol,
    })),
  };
});

// Table 2: one-off lump sums, no further contributions
const lumpRows: HubRow[] = INVEST_LUMP_SUMS.map((principal) => {
  const id = `${principal}`;
  const page = INVEST_ROW_PAGES[id];
  return {
    id,
    label: usd(principal),
    href: page?.href,
    hrefLabel: page?.label,
    cells: INVEST_YEARS.map((y, i) => ({
      text: usd(lumpBalance(principal, y)),
      tone: i === lastCol ? ('gain' as const) : ('plain' as const),
      strong: i === lastCol,
    })),
  };
});

// Headline: the monthly amount for the longest horizon
const headlineMonthly = INVEST_HEADLINE_MONTHLY;
const headlineYears = INVEST_HEADLINE_YEARS;
const balanceHead = monthlyBalance(headlineMonthly, headlineYears);
const contribHead = headlineMonthly * 12 * headlineYears;
const growthHead = num(`compoundEarned(0, ${headlineMonthly}, ${RATE}, ${headlineYears})`);
const growthShareHead = Math.round((growthHead / balanceHead) * 100);

// Lump sum story: 100,000 left alone
const lump100k = INVEST_YEARS.map((y) => lumpBalance(100000, y));
const multipleDecade = lumpBalance(1, INVEST_YEARS[0]);
const multipleLast = lumpBalance(1, lastYears);

// Sensitivity to the return assumption, same deposits and horizon
const lowRate = RATE - 2;
const highRate = RATE + 2;
const balanceLow = num(`compoundFV(0, ${headlineMonthly}, ${lowRate}, ${headlineYears})`);
const balanceHigh = num(`compoundFV(0, ${headlineMonthly}, ${highRate}, ${headlineYears})`);

// Inflation: what the longest-horizon balance buys in today's money at a steady 3%
const INFLATION = 3;
const lumpToday = num(`inflationAdjust(${lump100k[lastCol]}, ${INFLATION}, ${lastYears}, mode=value)`);

const title = `Investment Growth by Amount at ${rateText} a Year`;
const description = `What regular monthly investing from $100 to $2,000, and lump sums from $5,000 to $500,000, grow to over 10, 20 and 30 years at ${rateText} a year compounded monthly.`;

const articleSchema = buildArticleSchema({
  headline: title,
  description,
  path: '/scenarios/investment-growth/',
  datePublished: DATE_PUBLISHED,
  dateModified: DATE_MODIFIED,
  ogImagePath: '/og/hubs/investment-growth.png',
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Scenarios', url: '/scenarios/' },
  { name: 'Investment Growth', url: '/scenarios/investment-growth/' },
];

const linkClass = 'text-primary-600 hover:text-primary-700 underline transition-colors duration-150';
const deepLinkClass = 'text-primary-600 hover:text-primary-700 font-medium underline decoration-primary-200 underline-offset-2 transition-colors duration-150';
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/og/hubs/investment-growth.png"
  structuredData={[articleSchema]}
>
  {/* Page header */}
  <section class="border-b border-neutral-200/80 bg-bg">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <Breadcrumb items={breadcrumbs} />
      <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 tracking-[-0.02em]">
        Investment growth by amount <span class="text-neutral-500 font-normal">(at {rateText} a year)</span>
      </h1>
      <Byline datePublished={DATE_PUBLISHED} dateModified={DATE_MODIFIED} />
      <p class="mt-4 text-lg text-neutral-600 max-w-[720px] leading-relaxed">
        What regular monthly investing and one-off lump sums become over {INVEST_YEARS[0]}, {INVEST_YEARS[1]} and
        {' '}{lastYears} years at {rateText} a year, compounded monthly. It is an assumption, not a forecast: every
        figure is computed from it.
      </p>

      {/* The answer */}
      <div class="mt-6 max-w-[520px]" role="group" aria-label={`${usd(headlineMonthly)} a month for ${headlineYears} years at ${rateText}`}>
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-white border border-neutral-200/80 rounded-lg p-4">
            <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider">You pay in</p>
            <p class="mt-1 text-2xl sm:text-3xl font-bold text-neutral-900 tabular-nums">{usd(contribHead)}</p>
          </div>
          <div class="bg-white border border-neutral-200/80 rounded-lg p-4">
            <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider">It grows to</p>
            <p class="mt-1 text-2xl sm:text-3xl font-bold text-success-600 tabular-nums">{usd(balanceHead)}</p>
          </div>
        </div>
        <p class="mt-2 text-sm text-neutral-600">
          <span class="tabular-nums">{usd(headlineMonthly)}</span> a month for {headlineYears} years at {rateText}, starting from nothing
          (<a href={`#${headlineMonthly}-per-month`} class={linkClass}>see its row</a>).
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    {/* Table 1: monthly investing */}
    <section>
      <h2 class="text-2xl font-bold text-neutral-900 tracking-[-0.02em] mb-4">Monthly investing</h2>
      <p class="text-neutral-700 leading-relaxed mb-5 max-w-[720px]">
        Starting from zero and investing the same amount every month, at {rateText} a year
        compounded monthly with each deposit at the end of the month:
      </p>
      <HubTable
        class="max-w-[720px]"
        caption={`Balance after ${INVEST_YEARS.join(', ')} years of investing a fixed amount every month, starting from $0, at ${rateText} a year compounded monthly, deposits at the end of each month.`}
        rowHeader="Monthly amount"
        columns={yearColumns}
        rows={monthlyRows}
      />
      <p class="mt-4 text-neutral-700 leading-relaxed max-w-[720px]">
        The long timeframes do most of the work: invest {usd(headlineMonthly)} a month for {headlineYears} years and
        you deposit <span class="font-semibold tabular-nums">{usd(contribHead)}</span> in total,
        compounding adds another <span class="font-semibold text-success-600 tabular-nums">{usd(growthHead)}</span>,
        for a final balance of <span class="font-semibold tabular-nums">{usd(balanceHead)}</span>.
        That means {growthShareHead}% of the end result is growth, not deposits.
      </p>
      <p class="mt-3 text-xs text-neutral-500 max-w-[720px]">
        Figures are shown in dollars, but the maths is currency-agnostic: read them as pounds
        or euros and every number is identical.
      </p>
    </section>

    {/* Table 2: lump sums */}
    <section class="mt-14">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-[-0.02em] mb-4">Lump sums</h2>
      <p class="text-neutral-700 leading-relaxed mb-5 max-w-[720px]">
        A one-off amount invested once and left alone, with no further contributions, at the same
        {' '}{rateText} a year compounded monthly:
      </p>
      <HubTable
        class="max-w-[720px]"
        caption={`Balance after ${INVEST_YEARS.join(', ')} years of a one-off lump sum left invested at ${rateText} a year compounded monthly, no further deposits.`}
        rowHeader="Lump sum"
        columns={yearColumns}
        rows={lumpRows}
      />
      <p class="mt-4 text-neutral-700 leading-relaxed max-w-[720px]">
        At {rateText} compounded monthly, a lump sum grows by a factor of
        {' '}<span class="font-semibold tabular-nums">{multipleDecade.toFixed(1)}&times;</span> every {INVEST_YEARS[0]} years:
        {' '}{usd(100000)} left untouched becomes
        <span class="font-semibold tabular-nums"> {usd(lump100k[0])}</span> in {INVEST_YEARS[0]} years,
        <span class="font-semibold tabular-nums"> {usd(lump100k[1])}</span> in {INVEST_YEARS[1]}, and
        <span class="font-semibold text-success-600 tabular-nums"> {usd(lump100k[2])}</span> in {lastYears},
        a <span class="font-semibold tabular-nums">{multipleLast.toFixed(1)}&times;</span> multiple
        without a single further deposit.
      </p>
    </section>

    {/* Assumptions */}
    <section class="mt-14 max-w-[768px]">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-[-0.02em] mb-6">The assumptions behind these numbers</h2>
      <div class="space-y-6 text-neutral-700 leading-relaxed">
        <div>
          <h3 class="font-bold text-neutral-900 mb-1.5">Why {rateText}?</h3>
          <p>
            {rateText} is a round planning figure, not a forecast and not a historical average.
            The tables are only as good as that choice, so here is how much it matters:
            {' '}{usd(headlineMonthly)} a month for {headlineYears} years grows to
            {' '}<span class="tabular-nums">{usd(balanceLow)}</span> at {lowRate}%,
            {' '}<span class="tabular-nums">{usd(balanceHead)}</span> at {rateText} and
            {' '}<span class="tabular-nums">{usd(balanceHigh)}</span> at {highRate}%.
            Change the rate in the calculator below and watch the {headlineYears}-year column move.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-neutral-900 mb-1.5">Real returns are not a smooth line</h3>
          <p>
            No portfolio grows by the same amount every month. An average of {rateText} a year is built
            from years that gain a lot and years that lose a lot, and your actual balance will swing
            above and below these curves along the way. Over any single year these tables say nothing
            about what will happen.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-neutral-900 mb-1.5">Inflation eats purchasing power</h3>
          <p>
            These are nominal figures. At a steady {INFLATION}% inflation, the {usd(lump100k[lastCol])} from the {lastYears}-year
            lump sum buys what <span class="tabular-nums">{usd(lumpToday)}</span> buys today. To translate a
            future balance into today&rsquo;s money, run it through the
            <a href="/tools/economic/inflation/" class={linkClass}>inflation calculator</a>.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-neutral-900 mb-1.5">Currency doesn&rsquo;t change the maths</h3>
          <p>
            Compounding is unit-free: &pound;500 a month at {rateText} produces exactly the same numbers
            as $500 a month at {rateText}. Use whichever currency you think in.
          </p>
        </div>
      </div>
    </section>

    {/* Embedded calculator */}
    <section class="mt-14" id="calculator">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-[-0.02em] mb-2">Run your own numbers</h2>
      <p class="text-neutral-600 leading-relaxed mb-6 max-w-[640px]">
        The calculator below starts on the {usd(headlineMonthly)}-a-month, {headlineYears}-year row
        from zero, so it shows the same balance as the table. Change your starting balance, your monthly
        amount or your return assumption, with a year-by-year table and the split between deposits and growth.
      </p>
      <CompoundInterestCalc client:load defaults={{ principal: 0, monthlyContribution: headlineMonthly, annualRate: RATE, years: headlineYears }} />
    </section>

    {/* Deep dives */}
    <section class="mt-14 max-w-[768px]">
      <h2 class="text-2xl font-bold text-neutral-900 tracking-[-0.02em] mb-5">Go deeper</h2>
      <ul class="space-y-3">
        <li>
          <a href="/scenarios/500-per-month-investment-25-years/" class={deepLinkClass}>$500 a month for 25 years</a>
          <span class="text-neutral-600"> — one contribution level, worked through in full</span>
        </li>
        <li>
          <a href="/scenarios/100000-invested-30-years/" class={deepLinkClass}>$100,000 invested for 30 years</a>
          <span class="text-neutral-600"> — the flagship lump-sum scenario in detail</span>
        </li>
        <li>
          <a href="/scenarios/100k-investment-dividend-reinvest/" class={deepLinkClass}>$100k with dividends reinvested</a>
          <span class="text-neutral-600"> — why reinvesting payouts changes the curve</span>
        </li>
        <li>
          <a href="/comparisons/lump-sum-vs-dollar-cost-averaging/" class={deepLinkClass}>Lump sum vs dollar-cost averaging</a>
          <span class="text-neutral-600"> — got a lump sum? Whether to invest it all at once</span>
        </li>
        <li>
          <a href="/how-we-calculate/compound-interest/" class={deepLinkClass}>How we calculate compound interest</a>
          <span class="text-neutral-600"> — formulas, assumptions, and sources</span>
        </li>
      </ul>
    </section>
  </div>

  <script>
    const _gtag = (window as any).gtag as ((...a: unknown[]) => void) | undefined;
    const _scrollFired = new Set<number>();
    window.addEventListener('scroll', () => {
      const scrollPct = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight * 100;
      for (const depth of [50, 90]) {
        if (scrollPct >= depth && !_scrollFired.has(depth)) {
          _scrollFired.add(depth);
          if (_gtag) _gtag('event', 'scroll_depth', { depth, page_type: 'hub' });
        }
      }
    }, { passive: true });
  </script>
</BaseLayout>
