---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';
import { TOOLS, CATEGORIES, getToolPath, type CategorySlug } from '@lib/tools-data';

const categoryEntries = Object.entries(CATEGORIES) as [CategorySlug, typeof CATEGORIES[CategorySlug]][];
---

<BaseLayout
  title="Free Online Calculators & Tools | CalcRun"
  description="Browse all 38 free calculators, file converters, and utility tools. No signup, no ads, no data harvesting."
>
  {/* Page header with subtle gradient background */}
  <section class="bg-[linear-gradient(135deg,#0A2540_0%,#1A3A5C_50%,#0A2540_100%)] py-12 sm:py-16">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">All Tools</h1>
      <p class="text-lg text-primary-200/90">
        Free calculators and tools — instant results, no signup required.
      </p>
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {categoryEntries.map(([slug, cat], catIndex) => {
      const categoryTools = TOOLS.filter((t) => t.category === slug);
      return categoryTools.length > 0 && (
        <section id={slug} class="mb-14">
          {/* Gradient divider between sections (not before first) */}
          {catIndex > 0 && (
            <div class="h-px bg-gradient-to-r from-transparent via-primary-300/30 to-transparent mb-14"></div>
          )}

          <div class="flex items-center gap-3 mb-6">
            <h2 class="text-xl font-bold text-neutral-900">
              {cat.label}
            </h2>
            <span class="text-sm font-medium text-neutral-500 bg-neutral-100 px-2.5 py-0.5 rounded-full">
              {categoryTools.length}
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {categoryTools.map((tool) => (
              <a
                href={getToolPath(tool)}
                class="group relative bg-white border border-neutral-200/80 rounded-2xl p-5 shadow-card hover:shadow-card-hover hover:-translate-y-1 transition-all duration-200"
              >
                <div class="flex items-start gap-3.5">
                  <div class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary-50 text-primary-600 group-hover:bg-primary-500 group-hover:text-white transition-all duration-200 shrink-0">
                    <ToolIcon name={tool.icon} size={20} />
                  </div>
                  <div class="min-w-0">
                    <h3 class="text-base font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-150">
                      {tool.name}
                    </h3>
                    <p class="text-sm text-neutral-500 mt-1 leading-relaxed">{tool.description}</p>
                  </div>
                </div>
                {/* Subtle bottom accent on hover */}
                <div class="absolute bottom-0 left-4 right-4 h-0.5 bg-gradient-to-r from-primary-500 to-accent-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>
