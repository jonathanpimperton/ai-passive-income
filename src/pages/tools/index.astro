---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';
import { TOOLS, POPULAR_TOOL_SLUGS, CATEGORIES, getToolPath, type CategorySlug } from '@lib/tools-data';

const categoryEntries = Object.entries(CATEGORIES) as [CategorySlug, typeof CATEGORIES[CategorySlug]][];
---

<BaseLayout
  title="Online Calculators & Tools | CalcRun"
  description="Browse all 44 calculators, file converters, and utility tools. No signup, no ads, no data harvesting."
>
  {/* Page header */}
  <section class="border-b border-neutral-200/80 bg-bg">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 tracking-[-0.02em]">All Tools</h1>
      <p class="mt-2 text-lg text-neutral-600 max-w-[640px]">
        <span class="tabular-nums">{TOOLS.length}</span> calculators and tools — instant results, no signup required.
      </p>
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {categoryEntries.map(([slug, cat], catIndex) => {
      const categoryTools = TOOLS.filter((t) => t.category === slug);
      if (categoryTools.length === 0) return null;
      return (
        <section id={slug} class="mb-14">
          {catIndex > 0 && (
            <div class="h-px bg-neutral-200/80 mb-14"></div>
          )}

          <div class="grid grid-cols-1 lg:grid-cols-[2fr_3fr] gap-6 lg:gap-10">
            {/* Left column: category info */}
            <div class="lg:pr-4" style={`border-left: 3px solid ${cat.color}; padding-left: 1rem;`}>
              <div class="flex items-center gap-2.5 mb-2">
                <h2 class="font-serif text-xl font-bold text-neutral-900">{cat.label}</h2>
                <span class="text-sm font-medium text-neutral-500 bg-neutral-100 px-2.5 py-0.5 rounded-full">{categoryTools.length}</span>
              </div>
              <p class="text-sm text-neutral-500 leading-relaxed">{cat.tagline}</p>
            </div>

            {/* Right column: tool cards */}
            <div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {categoryTools.map((tool) => {
                    const isPopular = POPULAR_TOOL_SLUGS.includes(tool.slug);
                    return (
                      <a
                        href={getToolPath(tool)}
                        class="group flex items-start gap-3.5 bg-white border border-neutral-200/80 rounded-lg shadow-card hover:shadow-card-hover hover:border-primary-500/40 transition-all duration-200 hover:-translate-y-0.5 p-4"
                      >
                        <div class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary-50 text-primary-600 group-hover:bg-primary-700 group-hover:text-white transition-all duration-200 shrink-0">
                          <ToolIcon name={tool.icon} size={20} />
                        </div>
                        <div class="min-w-0">
                          <div class="flex items-center gap-2 mb-0.5">
                            <h3 class="font-semibold text-[0.9375rem] text-neutral-900 group-hover:text-primary-600 transition-colors duration-150">{tool.name}</h3>
                            {isPopular && (
                              <span class="inline-block text-xs font-semibold text-primary-700 bg-primary-50 px-2 py-0.5 rounded-full leading-none">Popular</span>
                            )}
                          </div>
                          <p class="text-sm text-neutral-500 leading-relaxed line-clamp-2">{tool.description}</p>
                        </div>
                      </a>
                    );
                  })}
                </div>
            </div>
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>
