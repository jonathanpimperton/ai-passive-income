---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';
import { TOOLS, POPULAR_TOOL_SLUGS, CATEGORIES, getToolPath, type CategorySlug } from '@lib/tools-data';

const categoryEntries = Object.entries(CATEGORIES) as [CategorySlug, typeof CATEGORIES[CategorySlug]][];
---

<BaseLayout
  title="Free Online Calculators & Tools | CalcRun"
  description="Browse all 37 free calculators, file converters, and utility tools. No signup, no ads, no data harvesting."
>
  {/* Page header — solid navy, distinct from homepage hero gradient */}
  <section class="bg-[#0F1B2D] py-12 sm:py-16">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-2">All Tools</h1>
      <p class="text-lg text-white/60">
        Free calculators and tools — instant results, no signup required.
      </p>
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {categoryEntries.map(([slug, cat], catIndex) => {
      const categoryTools = TOOLS.filter((t) => t.category === slug);
      return categoryTools.length > 0 && (
        <section id={slug} class="mb-14">
          {catIndex > 0 && (
            <div class="h-px bg-gradient-to-r from-transparent via-primary-300/30 to-transparent mb-14"></div>
          )}

          <div class="flex items-center gap-3 mb-6">
            <h2 class="font-serif text-xl font-bold text-neutral-900">
              {cat.label}
            </h2>
            <span class="text-sm font-medium text-neutral-500 bg-neutral-100 px-2.5 py-0.5 rounded-full">
              {categoryTools.length}
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {categoryTools.map((tool) => {
              const isPopular = POPULAR_TOOL_SLUGS.includes(tool.slug);
              return (
                <a
                  href={getToolPath(tool)}
                  class={`group relative bg-white border border-neutral-200/80 rounded-lg shadow-card hover:shadow-card-hover hover:border-primary-500/40 hover:-translate-y-0.5 transition-all duration-200 ${isPopular ? 'p-6' : 'p-5'}`}
                >
                  <div class={`flex items-start ${isPopular ? 'gap-4' : 'gap-3.5'}`}>
                    <div class={`inline-flex items-center justify-center rounded-lg bg-primary-50 text-primary-600 group-hover:bg-primary-700 group-hover:text-white transition-all duration-200 shrink-0 ${isPopular ? 'w-12 h-12' : 'w-10 h-10'}`}>
                      <ToolIcon name={tool.icon} size={isPopular ? 24 : 20} />
                    </div>
                    <div class="min-w-0">
                      <div class="flex items-center gap-2 mb-1">
                        <h3 class={`font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-150 ${isPopular ? 'text-lg' : 'text-base'}`}>
                          {tool.name}
                        </h3>
                        {isPopular && (
                          <span class="inline-block text-xs font-semibold text-white bg-accent-700 px-2 py-0.5 rounded-full leading-none">Popular</span>
                        )}
                      </div>
                      <p class="text-sm text-neutral-500 leading-relaxed">{tool.description}</p>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>
