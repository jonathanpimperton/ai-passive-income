---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolPageLayout from '@components/ui/ToolPageLayout.astro';
import ToolIsland from '@components/ui/ToolIsland.astro';
import { getCollection, render } from 'astro:content';
import { buildWebApplicationSchema, buildFaqSchema } from '@lib/seo';
import { toolComponent } from '@lib/tool-islands';
import { islandPreloads } from '@lib/island-preload';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({
    params: { category: tool.data.category, tool: tool.data.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { name, slug, category, description, faq, keywords } = tool.data;
const { Content } = await render(tool);

const webAppSchema = buildWebApplicationSchema({ name, description, slug, category, keywords });
const faqSchema = faq.length > 0 ? buildFaqSchema(faq) : null;
const structuredData = [webAppSchema, ...(faqSchema ? [faqSchema] : [])];

/**
 * The calculator island hydrates with client:load (see ToolIsland.astro).
 * In production builds its whole static-import closure is preloaded from
 * <head> so the chunks download in parallel instead of as a waterfall
 * (LA-1). Dev serves source modules, so no hints there.
 */
const preloads = import.meta.env.PROD ? islandPreloads(toolComponent(slug)) : [];
---

<BaseLayout
  title={`${name} | CalcRun`}
  description={description}
  ogImage={`/og/${slug}.png`}
  structuredData={structuredData}
>
  <Fragment slot="head">
    {preloads.map((href) => <link rel="modulepreload" href={href} />)}
  </Fragment>
  <ToolPageLayout tool={{ data: tool.data }}>
    <ToolIsland slug={slug} name={name} />
    <Fragment slot="content">
      <Content />
    </Fragment>
  </ToolPageLayout>
</BaseLayout>
