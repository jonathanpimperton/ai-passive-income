---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolPageLayout from '@components/ui/ToolPageLayout.astro';
import { getCollection, render } from 'astro:content';
import { buildWebApplicationSchema, buildFaqSchema } from '@lib/seo';

/**
 * All tool components must be statically imported — Astro requires
 * direct imports for client:* hydration directives to work.
 * See: https://docs.astro.build/en/concepts/islands/
 */
import PlaceholderCalc from '@components/tools/PlaceholderCalc.tsx';
import CompoundInterestCalc from '@components/tools/CompoundInterestCalc.tsx';
import LoanAmortizationCalc from '@components/tools/LoanAmortizationCalc.tsx';
import InvestmentReturnCalc from '@components/tools/InvestmentReturnCalc.tsx';
import RetirementSavingsCalc from '@components/tools/RetirementSavingsCalc.tsx';
import DebtPayoffCalc from '@components/tools/DebtPayoffCalc.tsx';
import SavingsGoalCalc from '@components/tools/SavingsGoalCalc.tsx';
import QrCodeGenerator from '@components/tools/QrCodeGenerator.tsx';
import PasswordGenerator from '@components/tools/PasswordGenerator.tsx';
import EmergencyFundCalc from '@components/tools/EmergencyFundCalc.tsx';
import RoiCalc from '@components/tools/RoiCalc.tsx';
import InflationCalc from '@components/tools/InflationCalc.tsx';
import SalaryCalc from '@components/tools/SalaryCalc.tsx';
import SalaryUkCalc from '@components/tools/SalaryUkCalc.tsx';
import NetWorthCalc from '@components/tools/NetWorthCalc.tsx';
import RentVsBuyCalc from '@components/tools/RentVsBuyCalc.tsx';
import MortgagePaymentCalc from '@components/tools/MortgagePaymentCalc.tsx';
import PercentageCalculator from '@components/tools/PercentageCalculator.tsx';
import JsonFormatter from '@components/tools/JsonFormatter.tsx';
import ImageCompressor from '@components/tools/ImageCompressor.tsx';
import ImageResizer from '@components/tools/ImageResizer.tsx';
import ImageFormatConverter from '@components/tools/ImageFormatConverter.tsx';
import SvgToPngConverter from '@components/tools/SvgToPngConverter.tsx';
import HeicToJpgConverter from '@components/tools/HeicToJpgConverter.tsx';
import CsvJsonConverter from '@components/tools/CsvJsonConverter.tsx';
import MarkdownHtmlConverter from '@components/tools/MarkdownHtmlConverter.tsx';
import ImagesToPdf from '@components/tools/ImagesToPdf.tsx';
import PdfMerge from '@components/tools/PdfMerge.tsx';
import PdfSplit from '@components/tools/PdfSplit.tsx';
import PdfCompress from '@components/tools/PdfCompress.tsx';
import PdfToImage from '@components/tools/PdfToImage.tsx';
import ExcelToPdf from '@components/tools/ExcelToPdf.tsx';
import Base64EncodeDecode from '@components/tools/Base64EncodeDecode.tsx';
import UrlEncodeDecode from '@components/tools/UrlEncodeDecode.tsx';
import JwtDecoder from '@components/tools/JwtDecoder.tsx';
import JsonYamlConverter from '@components/tools/JsonYamlConverter.tsx';
import JsonXmlConverter from '@components/tools/JsonXmlConverter.tsx';
import PngToIco from '@components/tools/PngToIco.tsx';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({
    params: { category: tool.data.category, tool: tool.data.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { name, slug, category, description, faq, keywords } = tool.data;
const { Content } = await render(tool);

const webAppSchema = buildWebApplicationSchema({ name, description, slug, category, keywords });
const faqSchema = faq.length > 0 ? buildFaqSchema(faq) : null;
const structuredData = [webAppSchema, ...(faqSchema ? [faqSchema] : [])];

/**
 * Map tool slugs to their calculator components.
 * Tools not yet built fall through to PlaceholderCalc.
 */
const CALCULATOR_MAP: Record<string, string> = {
  'compound-interest': 'CompoundInterestCalc',
  'loan-amortization': 'LoanAmortizationCalc',
  'investment-return': 'InvestmentReturnCalc',
  'retirement-savings': 'RetirementSavingsCalc',
  'debt-payoff': 'DebtPayoffCalc',
  'savings-goal': 'SavingsGoalCalc',
  'qr-code': 'QrCodeGenerator',
  'password-generator': 'PasswordGenerator',
  'emergency-fund': 'EmergencyFundCalc',
  'roi': 'RoiCalc',
  'inflation': 'InflationCalc',
  'salary-us': 'SalaryCalc',
  'salary-uk': 'SalaryUkCalc',
  'net-worth': 'NetWorthCalc',
  'rent-vs-buy': 'RentVsBuyCalc',
  'mortgage-payment': 'MortgagePaymentCalc',
  'percentage-calculator': 'PercentageCalculator',
  'json-formatter': 'JsonFormatter',
  'image-compressor': 'ImageCompressor',
  'image-resizer': 'ImageResizer',
  'image-format-converter': 'ImageFormatConverter',
  'svg-to-png': 'SvgToPngConverter',
  'heic-to-jpg': 'HeicToJpgConverter',
  'csv-json': 'CsvJsonConverter',
  'markdown-html': 'MarkdownHtmlConverter',
  'images-to-pdf': 'ImagesToPdf',
  'pdf-merge': 'PdfMerge',
  'pdf-split': 'PdfSplit',
  'pdf-compress': 'PdfCompress',
  'pdf-to-image': 'PdfToImage',
  'excel-to-pdf': 'ExcelToPdf',
  'base64-encode-decode': 'Base64EncodeDecode',
  'url-encode-decode': 'UrlEncodeDecode',
  'jwt-decoder': 'JwtDecoder',
  'json-yaml': 'JsonYamlConverter',
  'json-xml': 'JsonXmlConverter',
  'png-to-ico': 'PngToIco',
};

const hasCalculator = slug in CALCULATOR_MAP;
---

<BaseLayout
  title={`Free ${name} Online | CalcRun`}
  description={description}
  structuredData={structuredData}
>
  <ToolPageLayout tool={{ data: tool.data }}>
    {slug === 'compound-interest' && <CompoundInterestCalc client:load />}
    {slug === 'loan-amortization' && <LoanAmortizationCalc client:load />}
    {slug === 'investment-return' && <InvestmentReturnCalc client:load />}
    {slug === 'retirement-savings' && <RetirementSavingsCalc client:load />}
    {slug === 'debt-payoff' && <DebtPayoffCalc client:load />}
    {slug === 'savings-goal' && <SavingsGoalCalc client:load />}
    {slug === 'qr-code' && <QrCodeGenerator client:load />}
    {slug === 'password-generator' && <PasswordGenerator client:load />}
    {slug === 'emergency-fund' && <EmergencyFundCalc client:load />}
    {slug === 'roi' && <RoiCalc client:load />}
    {slug === 'inflation' && <InflationCalc client:load />}
    {slug === 'salary-us' && <SalaryCalc client:load />}
    {slug === 'salary-uk' && <SalaryUkCalc client:load />}
    {slug === 'net-worth' && <NetWorthCalc client:load />}
    {slug === 'rent-vs-buy' && <RentVsBuyCalc client:load />}
    {slug === 'mortgage-payment' && <MortgagePaymentCalc client:load />}
    {slug === 'percentage-calculator' && <PercentageCalculator client:load />}
    {slug === 'json-formatter' && <JsonFormatter client:load />}
    {slug === 'image-compressor' && <ImageCompressor client:load />}
    {slug === 'image-resizer' && <ImageResizer client:load />}
    {slug === 'image-format-converter' && <ImageFormatConverter client:load />}
    {slug === 'svg-to-png' && <SvgToPngConverter client:load />}
    {slug === 'heic-to-jpg' && <HeicToJpgConverter client:load />}
    {slug === 'csv-json' && <CsvJsonConverter client:load />}
    {slug === 'markdown-html' && <MarkdownHtmlConverter client:load />}
    {slug === 'images-to-pdf' && <ImagesToPdf client:load />}
    {slug === 'pdf-merge' && <PdfMerge client:load />}
    {slug === 'pdf-split' && <PdfSplit client:load />}
    {slug === 'pdf-compress' && <PdfCompress client:load />}
    {slug === 'pdf-to-image' && <PdfToImage client:load />}
    {slug === 'excel-to-pdf' && <ExcelToPdf client:load />}
    {slug === 'base64-encode-decode' && <Base64EncodeDecode client:load />}
    {slug === 'url-encode-decode' && <UrlEncodeDecode client:load />}
    {slug === 'jwt-decoder' && <JwtDecoder client:load />}
    {slug === 'json-yaml' && <JsonYamlConverter client:load />}
    {slug === 'json-xml' && <JsonXmlConverter client:load />}
    {slug === 'png-to-ico' && <PngToIco client:load />}
    {!hasCalculator && <PlaceholderCalc name={name} client:load />}
    <Fragment slot="content">
      <Content />
    </Fragment>
  </ToolPageLayout>
</BaseLayout>
