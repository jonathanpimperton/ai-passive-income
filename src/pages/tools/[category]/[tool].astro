---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolPageLayout from '@components/ui/ToolPageLayout.astro';
import { getCollection, render } from 'astro:content';
import { buildWebApplicationSchema, buildFaqSchema } from '@lib/seo';

/**
 * All tool components must be statically imported — Astro requires
 * direct imports for client:* hydration directives to work.
 * See: https://docs.astro.build/en/concepts/islands/
 *
 * During the foundation phase, all tools use PlaceholderCalc.
 * Each will be replaced with its real implementation in Sprints 1-3.
 */
import PlaceholderCalc from '@components/tools/PlaceholderCalc.tsx';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({
    params: { category: tool.data.category, tool: tool.data.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { name, slug, category, description, faq } = tool.data;
const { Content } = await render(tool);

const webAppSchema = buildWebApplicationSchema({ name, description, slug, category });
const faqSchema = faq.length > 0 ? buildFaqSchema(faq) : null;
const structuredData = [webAppSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={`Free ${name} Online | CalcPath`}
  description={description}
  structuredData={structuredData}
>
  <ToolPageLayout tool={{ data: tool.data }}>
    <PlaceholderCalc name={name} client:load />
    <Fragment slot="content">
      <Content />
    </Fragment>
  </ToolPageLayout>
</BaseLayout>
