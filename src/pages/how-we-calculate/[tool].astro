---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';
import Byline from '@components/ui/Byline.astro';
import { getCollection, render } from 'astro:content';
import { TOOLS, getToolPath } from '@lib/tools-data';
import { buildArticleSchema, methodologyDescription, toolTaxYearLabel } from '@lib/seo';
import { guidesForTool, shortTitle } from '@lib/internal-links';
import { gitFileDates } from '@lib/sitemap-lastmod.mjs';

export async function getStaticPaths() {
  const methodologies = await getCollection('methodologies');
  return methodologies.map((m) => ({
    params: { tool: m.data.slug },
    props: { methodology: m },
  }));
}

const { methodology } = Astro.props;
const { title, slug, toolSlug, formula, variables, assumptions, limitations, dataSources } = methodology.data;
const { Content } = await render(methodology);

const toolMeta = TOOLS.find((t) => t.slug === toolSlug);
const toolPath = toolMeta ? getToolPath(toolMeta) : '#';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Tools', url: '/tools/' },
  { name: toolMeta?.name || slug, url: toolPath },
  { name: 'How We Calculate', url: `/how-we-calculate/${slug}/` },
];

// Per-page description (every page used to share one, MTH-26) and the tax
// year the calculator uses, derived from the rates modules.
const toolName = toolMeta?.name || title.replace(/^How We Calculate:\s*/, '');
const description = methodologyDescription(toolName, toolSlug);
const taxYear = toolTaxYearLabel(toolSlug);

// Methodology markdown has no editorial dates, so the byline and Article
// JSON-LD use its git history (created / last changed), the same source as the
// sitemap lastmod. Unknown dates (shallow clone) are omitted, never guessed.
// CALCRUN_ROOT is set by astro.config.mjs to the project root.
const dates = gitFileDates(process.env.CALCRUN_ROOT ?? process.cwd(), methodology.filePath ?? `src/data/methodologies/${slug}.md`);
const articleSchema = buildArticleSchema({
  type: 'TechArticle',
  headline: title,
  description,
  path: `/how-we-calculate/${slug}/`,
  datePublished: dates.published,
  dateModified: dates.modified,
  ogImagePath: `/og/${toolSlug}.png`,
});

// Links back to the guides that use this calculator (GROWTH-SEO-05).
const guides = guidesForTool(
  toolSlug,
  (await getCollection('scenarios')).map((s) => s.data),
  (await getCollection('comparisons')).map((c) => c.data)
);
const hasGuides = !!guides.hub || guides.scenarios.length > 0 || guides.comparisons.length > 0;
---

{/* BreadcrumbList JSON-LD is emitted once by the Breadcrumb component below */}
<BaseLayout
  title={title}
  description={description}
  ogImage={`/og/${toolSlug}.png`}
  structuredData={[articleSchema]}
>
  <!-- Page header -->
  <section class="border-b border-neutral-200/80 bg-bg">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <Breadcrumb items={breadcrumbs} />

      <div class="flex items-start gap-4">
        {toolMeta && (
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-primary-50 text-primary-600 shrink-0">
            <ToolIcon name={toolMeta.icon} size={24} />
          </div>
        )}
        <div>
          <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 tracking-[-0.02em]">{title}</h1>
          <p class="mt-2 text-lg text-neutral-600 max-w-[640px]">
            The formula, inputs and assumptions behind the <a href={toolPath} class="text-primary-600 hover:text-primary-700 underline decoration-primary-300 underline-offset-2 transition-colors duration-150">{toolName}</a>{taxYear && <>, for the {taxYear}</>}.
          </p>
          {dates.published && dates.modified && <Byline datePublished={dates.published} dateModified={dates.modified} />}
        </div>
      </div>
    </div>
  </section>

  <div id="main-content" class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

      <!-- Main content -->
      <div class="lg:col-span-2">

        <!-- Formula card -->
        <div class="bg-white rounded-lg border border-neutral-200/80 shadow-card p-6 mb-8">
          <h2 class="text-lg font-bold text-neutral-900 mb-3">Formula</h2>
          <div class="bg-neutral-50 rounded-lg p-4 font-mono text-sm text-neutral-800 overflow-x-auto">
            {formula}
          </div>
        </div>

        <!-- Variables -->
        <div class="bg-white rounded-lg border border-neutral-200/80 shadow-card p-6 mb-8">
          <h2 class="text-lg font-bold text-neutral-900 mb-4">Variables</h2>
          <div class="space-y-3">
            {variables.map((v) => (
              <div class="flex flex-wrap gap-x-3 gap-y-1 items-baseline">
                <span class="font-mono text-sm font-bold text-primary-600 bg-primary-50 px-2 py-0.5 rounded shrink-0 max-w-full break-words">{v.name}</span>
                <span class="text-sm text-neutral-700 min-w-0">{v.description}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Prose content (educational explanation) -->
        <div class="bg-white rounded-lg border border-neutral-200/80 shadow-card p-6 mb-8">
          <div class="prose prose-neutral max-w-none prose-headings:font-serif prose-headings:tracking-tight prose-a:text-primary-600">
            <Content />
          </div>
        </div>

        <!-- Assumptions -->
        <div class="bg-white rounded-lg border border-neutral-200/80 shadow-card p-6 mb-8">
          <h2 class="text-lg font-bold text-neutral-900 mb-4">Assumptions</h2>
          <ul class="space-y-2">
            {assumptions.map((a) => (
              <li class="flex gap-2 text-sm text-neutral-700">
                <span class="text-primary-600 shrink-0 mt-0.5">&#10003;</span>
                {a}
              </li>
            ))}
          </ul>
        </div>

        <!-- Limitations -->
        <div class="bg-white rounded-lg border border-neutral-200/80 shadow-card p-6 mb-8">
          <h2 class="text-lg font-bold text-neutral-900 mb-4">Limitations</h2>
          <ul class="space-y-2">
            {limitations.map((l) => (
              <li class="flex gap-2 text-sm text-neutral-700">
                <span class="text-neutral-500 shrink-0 mt-0.5">&#9888;</span>
                {l}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div class="lg:sticky lg:top-20 space-y-6" data-sticky-fit>

          <!-- Try the calculator CTA -->
          <div class="bg-primary-50 rounded-lg border border-primary-200/60 p-6">
            <h3 class="text-base font-bold text-neutral-900 mb-2">Try the calculator</h3>
            <p class="text-sm text-neutral-600 mb-4">Run your own numbers with the {toolMeta?.name || slug}.</p>
            <a
              href={toolPath}
              data-astro-prefetch
              class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary-600 text-white text-sm font-semibold rounded-lg hover:bg-primary-700 transition-colors duration-200"
            >
              Open calculator &rarr;
            </a>
          </div>

          <!-- Guides that use this calculator (links back, GROWTH-SEO-05) -->
          {hasGuides && (
            <nav class="bg-white rounded-lg border border-neutral-200/80 shadow-card p-6" aria-labelledby="method-guides-heading">
              <h3 id="method-guides-heading" class="text-base font-bold text-neutral-900 mb-3">See it worked through</h3>
              <ul class="space-y-2.5">
                {guides.hub && (
                  <li>
                    <a href={guides.hub.href} data-astro-prefetch class="text-sm text-primary-600 hover:text-primary-700 underline decoration-primary-300 underline-offset-2 transition-colors duration-150">{guides.hub.label}</a>
                  </li>
                )}
                {guides.scenarios.map((s) => (
                  <li>
                    <a href={`/scenarios/${s.slug}/`} data-astro-prefetch class="text-sm text-primary-600 hover:text-primary-700 underline decoration-primary-300 underline-offset-2 transition-colors duration-150">{s.title}</a>
                  </li>
                ))}
                {guides.comparisons.map((c) => (
                  <li>
                    <a href={`/comparisons/${c.slug}/`} data-astro-prefetch class="text-sm text-primary-600 hover:text-primary-700 underline decoration-primary-300 underline-offset-2 transition-colors duration-150">{shortTitle(c.title)}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          <!-- Data Sources -->
          {dataSources && dataSources.length > 0 && (
            <div class="bg-white rounded-lg border border-neutral-200/80 shadow-card p-6">
              <h3 class="text-base font-bold text-neutral-900 mb-3">Data Sources</h3>
              <ul class="space-y-2">
                {dataSources.map((source) => (
                  <li>
                    <a
                      href={source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm text-primary-600 hover:text-primary-700 underline"
                    >
                      {source.name} &nearr;
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
