---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/ui/Breadcrumb.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';
import { getCollection, render } from 'astro:content';
import AffiliateLinks from '@components/ui/AffiliateLinks.astro';
import Byline from '@components/ui/Byline.astro';
import { TOOLS, getToolPath } from '@lib/tools-data';
import { buildArticleSchema, buildFaqSchema } from '@lib/seo';

export async function getStaticPaths() {
  const comparisons = await getCollection('comparisons');
  return comparisons.map((comparison) => ({
    params: { comparison: comparison.data.slug },
    props: { comparison },
  }));
}

const { comparison } = Astro.props;
const { title, slug, description, keywords, relatedTools, verdict, comparisonTable, datePublished, dateModified, sources, faq, affiliateContext, affiliatePrograms } = comparison.data;
const { Content } = await render(comparison);

const articleSchema = buildArticleSchema({
  headline: title,
  description,
  path: `/comparisons/${slug}/`,
  datePublished,
  dateModified,
  ogImagePath: `/og/comparisons/${slug}.png`,
});
const structuredData = faq && faq.length > 0 ? [articleSchema, buildFaqSchema(faq)] : [articleSchema];

// Resolve related tools to actual tool metadata
const resolvedTools = relatedTools
  .map((toolSlug) => TOOLS.find((t) => t.slug === toolSlug))
  .filter(Boolean);

// Get other comparisons for sidebar (excluding current)
const allComparisons = await getCollection('comparisons');
const otherComparisons = allComparisons
  .filter((c) => c.data.slug !== slug)
  .slice(0, 5);

// Extract the option names from the title (before the colon).
// Supports both "A vs B" and three-way "A vs B vs C" titles.
const titleParts = title.split(':')[0];
const optionLabels = titleParts.split(/\s+vs\.?\s+/i).map((part) => part.trim());
const option1Label = optionLabels.length >= 2 ? optionLabels[0] : 'Option A';
const option2Label = optionLabels.length >= 2 ? optionLabels[1] : 'Option B';
// Third column renders only when the table data actually has option3 values
const hasOption3 = comparisonTable.some((row) => row.option3 !== undefined);
const option3Label = hasOption3 ? (optionLabels[2] ?? 'Option C') : null;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Comparisons', url: '/comparisons/' },
  { name: titleParts, url: `/comparisons/${slug}/` },
];
---

{/* BreadcrumbList JSON-LD is emitted once by the Breadcrumb component below */}
<BaseLayout
  title={title}
  description={description}
  ogImage={`/og/comparisons/${slug}.png`}
  structuredData={structuredData}
>
  {/* Page header */}
  <section class="border-b border-neutral-200/80 bg-bg">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <Breadcrumb items={breadcrumbs} />

      <div class="flex items-start gap-4">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-primary-50 text-primary-600 shrink-0">
          <ToolIcon name="scale" size={24} />
        </div>
        <div>
          <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 tracking-[-0.02em]">{title}</h1>
          <p class="mt-2 text-lg text-neutral-600 max-w-[640px]">{description}</p>
          <Byline datePublished={datePublished} dateModified={dateModified} />
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-10">
      {/* Main content */}
      <div>
        {/* Verdict card */}
        <div class="bg-white border border-neutral-200/80 rounded-lg p-6 sm:p-8 shadow-card mb-8">
          <p class="text-xs font-semibold text-primary-600 uppercase tracking-wider mb-3">The Verdict</p>
          <p class="text-lg font-medium text-neutral-900 leading-relaxed">{verdict}</p>
        </div>

        {/* Comparison table */}
        <div class="bg-white border border-neutral-200/80 rounded-lg shadow-card mb-8 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-neutral-50 border-b border-neutral-200/80">
                  <th class:list={['text-left px-5 py-3.5 font-semibold text-neutral-700', option3Label ? 'w-[22%]' : 'w-[30%]']}>Feature</th>
                  <th class:list={['text-left px-5 py-3.5 font-semibold text-primary-700', option3Label ? 'w-[26%]' : 'w-[35%]']}>{option1Label}</th>
                  <th class:list={['text-left px-5 py-3.5 font-semibold text-primary-700', option3Label ? 'w-[26%]' : 'w-[35%]']}>{option2Label}</th>
                  {option3Label && (
                    <th class="text-left px-5 py-3.5 font-semibold text-primary-700 w-[26%]">{option3Label}</th>
                  )}
                </tr>
              </thead>
              <tbody>
                {comparisonTable.map((row, i) => (
                  <tr class:list={[
                    "border-b border-neutral-100 last:border-b-0",
                    i % 2 === 1 ? "bg-neutral-50/50" : "",
                  ]}>
                    <td class="px-5 py-3.5 font-medium text-neutral-700">{row.feature}</td>
                    <td class="px-5 py-3.5 text-neutral-600">{row.option1}</td>
                    <td class="px-5 py-3.5 text-neutral-600">{row.option2}</td>
                    {option3Label && <td class="px-5 py-3.5 text-neutral-600">{row.option3}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {/* Educational content */}
        <div class="prose max-w-none">
          <Content />
        </div>

        {/* FAQ (rendered on-page — the same items feed FAQPage JSON-LD) */}
        {faq && faq.length > 0 && (
          <section class="mt-10">
            <h2 class="text-2xl font-bold text-neutral-900 tracking-[-0.02em] mb-5">Common questions</h2>
            <div class="divide-y divide-neutral-200/80 border-t border-b border-neutral-200/80">
              {faq.map((item) => (
                <div class="py-5">
                  <h3 class="font-bold text-neutral-900 mb-1.5">{item.question}</h3>
                  <p class="text-neutral-700 leading-relaxed">{item.answer}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        {/* Sources (E-E-A-T): primary references behind the figures above */}
        {sources && sources.length > 0 && (
          <div class="mt-8 border-t border-neutral-200/80 pt-5">
            <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-2">Sources</p>
            <ul class="space-y-1.5">
              {sources.map((source) => (
                <li class="text-sm text-neutral-600">
                  <a
                    href={source.url}
                    rel="noopener"
                    target="_blank"
                    class="underline decoration-neutral-300 underline-offset-2 hover:text-primary-700 hover:decoration-primary-400 transition-all duration-150"
                  >{source.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Affiliate section */}
        {affiliateContext && affiliatePrograms && affiliatePrograms.length > 0 && (
          <AffiliateLinks context={affiliateContext} programIds={affiliatePrograms} toolSlug={slug} />
        )}

        {/* Bottom CTA */}
        {resolvedTools.length > 0 && (
          <div class="mt-10 bg-neutral-50 border border-neutral-200/80 rounded-lg p-6 sm:p-8">
            <h2 class="text-xl font-bold text-neutral-900 mb-2">Run the numbers yourself</h2>
            <p class="text-sm text-neutral-600 mb-4 leading-relaxed">
              Use our calculators to see how these options compare with your specific numbers.
            </p>
            <div class="flex flex-wrap gap-3">
              {resolvedTools.slice(0, 3).map((tool) => (
                <a
                  href={getToolPath(tool!)}
                  class="inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold rounded-lg text-white bg-primary-600 hover:bg-primary-700 transition-all duration-200 shadow-sm shadow-primary-600/20"
                >
                  <ToolIcon name={tool!.icon} size={16} />
                  {tool!.name}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      {/* Sidebar */}
      <aside class="space-y-6">
        {/* Related calculators */}
        {resolvedTools.length > 0 && (
          <div class="bg-white border border-neutral-200/80 rounded-xl p-5 shadow-card">
            <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-3">Related Calculators</p>
            <ul class="space-y-3">
              {resolvedTools.map((tool) => (
                <li>
                  <a href={getToolPath(tool!)} class="group flex items-start gap-3">
                    <div class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary-50 text-primary-600 shrink-0 group-hover:bg-primary-700 group-hover:text-white transition-colors duration-200">
                      <ToolIcon name={tool!.icon} size={20} />
                    </div>
                    <div>
                      <span class="text-sm font-bold text-neutral-900 group-hover:text-primary-600 transition-colors duration-200">
                        {tool!.name}
                      </span>
                      <p class="text-xs text-neutral-500 mt-0.5">{tool!.description}</p>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Other comparisons */}
        {otherComparisons.length > 0 && (
          <div class="bg-white border border-neutral-200/80 rounded-xl p-5 shadow-card">
            <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-3">More Comparisons</p>
            <ul class="space-y-3">
              {otherComparisons.map((other) => (
                <li>
                  <a
                    href={`/comparisons/${other.data.slug}/`}
                    class="group block"
                  >
                    <span class="text-sm font-medium text-neutral-900 group-hover:text-primary-600 transition-colors duration-200">
                      {other.data.title.split(':')[0]}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>

  <script>
    const _gtag = (window as any).gtag as ((...a: unknown[]) => void) | undefined;

    // Affiliate click tracking on comparison pages
    document.addEventListener('click', (e) => {
      const link = (e.target as Element).closest?.('a.affiliate-link') as HTMLAnchorElement | null;
      if (link && _gtag) {
        _gtag('event', 'affiliate_click', {
          partner: link.dataset.affiliatePartner || '',
          placement: link.dataset.affiliatePlacement || 'comparison',
          page_type: 'comparison',
        });
      }
    });

    // Scroll depth milestones
    const _scrollFired = new Set<number>();
    window.addEventListener('scroll', () => {
      const scrollPct = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight * 100;
      for (const depth of [50, 90]) {
        if (scrollPct >= depth && !_scrollFired.has(depth)) {
          _scrollFired.add(depth);
          if (_gtag) _gtag('event', 'scroll_depth', { depth, page_type: 'comparison' });
        }
      }
    }, { passive: true });
  </script>
</BaseLayout>
