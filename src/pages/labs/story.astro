      .dawn-hint {
        position: fixed;
        top: 44%;
        left: 50%;
        margin: 0;
        z-index: 40;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 640;
        font-size: clamp(1.5rem, 2.6vw, 2.1rem);
        letter-spacing: -0.03em;
        color: #0b6e6e;
        opacity: 0;
        pointer-events: none;
        white-space: nowrap;
        will-change: transform, opacity;
      }
      .static-story .dawn-hint { display: none; }
      .static-story .story-header { position: absolute; }

      .scroll-cue {
        position: absolute;
