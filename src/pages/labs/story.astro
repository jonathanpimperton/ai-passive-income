      .bento-tile:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 38px rgba(20, 22, 26, 0.08);
        border-color: var(--tone);
      }
      .bento-mini { padding: 20px 22px 16px; }

      .tone-grow { --tone: #14805a; }
      .tone-keep { --tone: #0b6e6e; }
      .tone-owe { --tone: #c4442a; }
      .tone-neutral { --tone: #555a66; }

      .bento-motif {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 62%;
        height: 58%;
        color: var(--tone);
        opacity: 0.11;
        pointer-events: none;
        transition: opacity 0.3s ease;
        /* fade the art out of the bottom strip where the tool links sit */
        mask-image: linear-gradient(to top, transparent 6%, black 52%);
        -webkit-mask-image: linear-gradient(to top, transparent 6%, black 52%);
      }
      .bento-motif-bars { width: 46%; height: 52%; right: 14px; bottom: 0; }
      .bento-tile:hover .bento-motif { opacity: 0.19; }

      .bento-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
      .bento-label {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 640;
        font-size: clamp(1.3rem, 1.9vw, 1.65rem);
        letter-spacing: -0.02em;
        color: #14161a;
      }
      .bento-label-sm { font-size: 1.1rem; }
      .bento-mini-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 7px;
        background: color-mix(in srgb, var(--tone) 10%, #ffffff);
        border: 1px solid color-mix(in srgb, var(--tone) 18%, #ffffff);
        color: var(--tone);
        margin-right: 9px;
        vertical-align: -6px;
      }
      .bento-count {
        font-size: 12px;
        font-weight: 700;
        color: var(--tone);
