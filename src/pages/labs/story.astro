        justify-content: center;
        gap: 4px 14px;
      }
      /* Trust items wrap whole, never mid-phrase */
      .trust-item { white-space: nowrap; }
      .daylight-ctas { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
      .cta-primary {
        background: #0b6e6e;
