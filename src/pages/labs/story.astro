        transform: translateY(26px);
        opacity: 0;
        will-change: transform, opacity;
        transition: border-color 0.3s ease;
      }
      /* Soft obsidian scrim behind each row — the data line passes beneath the
         ledger without ever striking through its text */
      .figure-row::before {
        content: '';
        position: absolute;
        inset: -4px -16px;
        background: rgba(10, 11, 13, 0.78);
        filter: blur(9px);
