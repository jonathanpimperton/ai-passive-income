        animation: cue-pulse 2.4s ease-in-out infinite;
        transform-origin: top;
      }
      .cue-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.34em;
        text-transform: uppercase;
        color: #6b7280;
      }
      @keyframes cue-pulse {
        0%, 100% { opacity: 0.35; transform: scaleY(0.82); }
        50% { opacity: 1; transform: scaleY(1); }
      }

      /* ════ Chapters ════ */
      .chapter {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        text-align: left;
        gap: 48px;
        padding: 0 clamp(24px, 7vw, 110px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }
      .chapter.active { pointer-events: auto; }

      .chapter-copy { max-width: 30rem; }
      .kicker {
        margin: 0 0 14px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: #6b7280;
      }
      .chapter-title {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 640;
        font-size: clamp(2.6rem, 6vw, 4.6rem);
        letter-spacing: -0.03em;
        line-height: 1;
      }
      .chapter-grow .chapter-title { color: #57d9a3; }
      .chapter-keep .chapter-title { color: #5fd3d3; }
      .chapter-owe  .chapter-title { color: #f08a70; }
      .chapter-lede {
