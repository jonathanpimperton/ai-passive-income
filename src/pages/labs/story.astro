---
/**
 * R2.0 MOTION PROTOTYPE — "The Number Theater" (owner review gate).
 * Scroll-driven cinematic homepage concept: obsidian theater → three data
 * chapters (Grow / Keep / Owe) told by one morphing glowing line → dawn
 * handoff into the light product.
 *
 * Standalone page (own <html>), noindex, excluded from sitemap. Real copy,
 * real figures computed by the site's own engines. GSAP + ScrollTrigger,
 * scrub-tied to native scroll (no scroll-jacking). prefers-reduced-motion
 * renders every act settled with plain scroll.
 */
import '../../styles/global.css';
import { formatNumber, compoundInterest, loanMonthlyPayment, debtPayoff } from '@lib/calculator-utils';
import { calcIncomeTax, calcNI } from '@lib/uk-tax-calc';
import { calcFederalTax, calcFICA } from '@lib/us-tax-calc';
import { calculateSdlt } from '@lib/stamp-duty';
import DecisionEngine from '@components/homepage/DecisionEngine.tsx';

/* ── Live figures (the story never lies — same engines as the tools) ── */
const grow500x10 = compoundInterest(0, 500, 0.07, 10, 12);
const grow10kPlus200 = compoundInterest(10_000, 200, 0.07, 20, 12);
const grow1000x20 = compoundInterest(0, 1000, 0.07, 20, 12);

const ukTakeHome50k = 50_000 - calcIncomeTax(50_000) - calcNI(50_000);
const usTakeHome100k = 100_000 - calcFederalTax(100_000, 'single') - calcFICA(100_000, 'single').total;
const ukKeptPct = Math.round((ukTakeHome50k / 50_000) * 100);
const sdltFtb450 = calculateSdlt(450_000, 'first-time').totalTax;

const mortgage300k = loanMonthlyPayment(300_000, 0.065, 360);
const mortgage300kLow = loanMonthlyPayment(300_000, 0.055, 360);
const rateSaving = mortgage300kLow ? Math.round(mortgage300k - mortgage300kLow) : 0;
const cardPayoff = debtPayoff([{ name: 'Card', balance: 5000, rate: 0.22, minPayment: 250 }], 0, 'avalanche');

const CHAPTERS = [
  {
    id: 'grow',
    kicker: 'Chapter one',
    title: 'Grow it.',
    lede: 'Small, boring, monthly amounts become startling numbers. Compounding does the work — time does the heavy lifting.',
    figures: [
      { label: '£500/mo invested for 10 years', value: `£${formatNumber(Math.round(grow500x10))}`, href: '/scenarios/500-per-month-10-years/' },
      { label: '$10,000 + $200/mo for 20 years', value: `$${formatNumber(Math.round(grow10kPlus200))}`, href: '/tools/saving-and-growth/compound-interest/' },
      { label: '£1,000/mo invested for 20 years', value: `£${formatNumber(Math.round(grow1000x20))}`, href: '/tools/saving-and-growth/investment-return/' },
    ],
  },
  {
    id: 'keep',
    kicker: 'Chapter two',
    title: 'Keep it.',
    lede: 'Your salary is not your money — some of it was never yours. Know exactly what stays with you, to the pound.',
    figures: [
      { label: `£50,000 UK salary — you keep ${ukKeptPct}%`, value: `£${formatNumber(Math.round(ukTakeHome50k / 12))}/mo`, href: '/tools/income-and-planning/salary-uk/' },
      { label: '$100,000 US salary, single filer', value: `$${formatNumber(Math.round(usTakeHome100k / 12))}/mo`, href: '/tools/income-and-planning/salary-us/' },
      { label: 'Stamp duty, £450K first home', value: `£${formatNumber(Math.round(sdltFtb450))}`, href: '/tools/economic/stamp-duty/' },
    ],
  },
  {
    id: 'owe',
    kicker: 'Chapter three',
    title: 'Owe it.',
    lede: 'Debt has a shape: slow at first, then suddenly gone. See the whole curve before you sign anything.',
    figures: [
      { label: '$300K mortgage at 6.5%, 30 years', value: `$${formatNumber(Math.round(mortgage300k))}/mo`, href: '/tools/debt-and-loans/mortgage-payment/' },
      { label: '£5,000 card at 22%, £250/mo', value: `debt-free in ${cardPayoff.months} mo`, href: '/tools/debt-and-loans/credit-card-payoff/' },
      { label: 'Same mortgage at 5.5% instead', value: `saves $${formatNumber(rateSaving)}/mo`, href: '/tools/debt-and-loans/loan-amortization/' },
    ],
  },
];

/* ── Daylight board: more answers, chapter-coded, count-up on reveal ── */
const ukTakeHome30k = 30_000 - calcIncomeTax(30_000) - calcNI(30_000);
const usTakeHome60k = 60_000 - calcFederalTax(60_000, 'single') - calcFICA(60_000, 'single').total;
const grow10kLump30 = compoundInterest(10_000, 0, 0.07, 30, 12);
const grow250x40 = compoundInterest(0, 250, 0.07, 40, 12);
const mortgage200kUk = loanMonthlyPayment(200_000, 0.045, 300);
const debt30k = debtPayoff([{ name: 'Loan', balance: 30_000, rate: 0.08, minPayment: 600 }], 0, 'avalanche');
const sdltFtb300 = calculateSdlt(300_000, 'first-time').totalTax;

const BOARD = [
  {
    id: 'grow', label: 'Grow it', color: 'grow',
    rows: [
      { q: '£10,000 left alone for 30 years at 7%', a: `£${formatNumber(Math.round(grow10kLump30))}`, n: Math.round(grow10kLump30), pre: '£', suf: '', href: '/tools/saving-and-growth/compound-interest/' },
      { q: '$250/mo from age 25 to 65', a: `$${formatNumber(Math.round(grow250x40))}`, n: Math.round(grow250x40), pre: '$', suf: '', href: '/tools/saving-and-growth/investment-return/' },
      { q: '£500/mo invested for 10 years', a: `£${formatNumber(Math.round(grow500x10))}`, n: Math.round(grow500x10), pre: '£', suf: '', href: '/scenarios/500-per-month-10-years/' },
    ],
  },
  {
    id: 'keep', label: 'Keep it', color: 'keep',
    rows: [
      { q: '£30,000 UK salary — monthly take-home', a: `£${formatNumber(Math.round(ukTakeHome30k / 12))}`, n: Math.round(ukTakeHome30k / 12), pre: '£', suf: '/mo', href: '/scenarios/30k-salary-uk-take-home/' },
      { q: '$60,000 US salary, single filer', a: `$${formatNumber(Math.round(usTakeHome60k / 12))}`, n: Math.round(usTakeHome60k / 12), pre: '$', suf: '/mo', href: '/tools/income-and-planning/salary-us/' },
      { q: 'Stamp duty on a £300K first home', a: `£${formatNumber(Math.round(sdltFtb300))}`, n: Math.round(sdltFtb300), pre: '£', suf: '', href: '/tools/economic/stamp-duty/' },
    ],
  },
  {
    id: 'owe', label: 'Owe it', color: 'owe',
    rows: [
      { q: '£200K mortgage at 4.5% over 25 years', a: `£${formatNumber(Math.round(mortgage200kUk))}`, n: Math.round(mortgage200kUk), pre: '£', suf: '/mo', href: '/tools/debt-and-loans/mortgage-payment/' },
      { q: '£30K of debt at £600/mo', a: `debt-free in ${debt30k.months} mo`, n: debt30k.months, pre: 'debt-free in ', suf: ' mo', href: '/tools/debt-and-loans/debt-payoff/' },
      { q: 'Same $300K mortgage, 1% lower rate', a: `saves $${formatNumber(rateSaving)}/mo`, n: rateSaving, pre: 'saves $', suf: '/mo', href: '/tools/debt-and-loans/loan-amortization/' },
    ],
  },
];

const QUESTION = 'What is your number?';
const questionWords = QUESTION.split(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>The Number Theater — CalcRun prototype</title>
    <meta name="description" content="Motion prototype — scroll-driven homepage concept for CalcRun." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/SpaceGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/DMSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="story-body">
    {/* ── Floating minimal header — present from frame 0 ─────────── */}
    <header class="story-header" id="story-header">
      <a href="/" class="story-wordmark" aria-label="CalcRun home">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
          <rect x="1" y="1" width="22" height="22" rx="6" fill="#0B6E6E" />
          <path d="M6 15.5 L10.5 11 L13.5 13.5 L18 8.5" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M18 8.5 h-3.2 M18 8.5 v3.2" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" />
        </svg>
        <span>Calc<em>Run</em></span>
      </a>
      <a href="/tools/" class="story-skip">Skip to the calculators →</a>
    </header>

    {/* ── The theater: 620vh scroll track driving a sticky stage ── */}
    <div class="track" id="track">
      <div class="stage">

        {/* Chapter washes (parallax layer, 0.6×) */}
        <div class="wash" id="wash-grow"></div>
        <div class="wash" id="wash-keep"></div>
        <div class="wash" id="wash-owe"></div>

        {/* The data line (0.8× layer) */}
        <svg class="line-stage" id="line-stage" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <filter id="glow" x="-20%" y="-50%" width="140%" height="200%">
              <feGaussianBlur stdDeviation="7" />
            </filter>
            <linearGradient id="kept-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#38AEAE" stop-opacity="0.16" />
              <stop offset="1" stop-color="#38AEAE" stop-opacity="0.02" />
            </linearGradient>
          </defs>
          <path id="area-kept" d="" fill="url(#kept-fill)" opacity="0" />
          <path id="line-glow" d="" fill="none" stroke="#38AEAE" stroke-width="7" opacity="0" filter="url(#glow)" />
          <path id="line-core" d="" fill="none" stroke="#5FD3D3" stroke-width="2" opacity="0" vector-effect="non-scaling-stroke" />
        </svg>

        {/* Act 0 — the question */}
        <p class="dawn-hint" id="dawn-hint" aria-hidden="true">Now, run yours.</p>

        <section class="act act-0" id="act-0" aria-label="Introduction">
          <h1 class="question" id="question">
            {questionWords.map((word, wi) => (
              <span class="q-word">
                {word.split('').map((ch) => <span class="q-char" data-wi={wi}>{ch}</span>)}
                {wi < questionWords.length - 1 && <span class="q-space"> </span>}
              </span>
            ))}
          </h1>
          <p class="question-sub" id="question-sub">
            CalcRun — financial calculators for salary, mortgage, investing and debt.
            <span class="sub-quiet">Answers as you type. No signup, no ads.</span>
          </p>
          <div class="scroll-cue" id="scroll-cue" aria-hidden="true">
            <span class="cue-line"></span>
            <span class="cue-label">scroll</span>
          </div>
        </section>

        {/* Chapters */}
        {CHAPTERS.map((c, i) => (
          <section class={`act chapter chapter-${c.id}`} id={`chapter-${c.id}`} aria-label={c.title}>
            <div class="chapter-copy">
              <p class="kicker"><span class="mask"><span class="mask-inner">{c.kicker}</span></span></p>
              <h2 class="chapter-title"><span class="mask"><span class="mask-inner">{c.title}</span></span></h2>
              <p class="chapter-lede"><span class="mask"><span class="mask-inner">{c.lede}</span></span></p>
            </div>
            <div class="chapter-figures">
              {c.figures.map((f) => (
                <a class="figure-card" href={f.href}>
                  <span class="figure-value tabular-nums">{f.value}</span>
                  <span class="figure-label">{f.label}</span>
                  <span class="figure-arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>

    {/* ── DAYLIGHT — the instrument room: same standard, full utility ── */}
    <main class="daylight" id="daylight">

      {/* D1 — the live instrument */}
      <section class="d-section d-engine">
        <div class="d-inner">
          <p class="d-kicker reveal">Your turn</p>
          <h2 class="d-title"><span class="d-mask"><span class="d-mask-inner">Run your numbers</span></span></h2>
          <p class="d-sub reveal">The same questions, live — answers as you type. No signup, no ads.</p>
          <div class="d-engine-wrap reveal">
            <DecisionEngine client:visible />
          </div>
        </div>
      </section>

      {/* D2 — the answer board (count-ups on reveal, chapter-coded) */}
      <section class="d-section d-board">
        <div class="d-inner">
          <p class="d-kicker reveal">Straight answers</p>
          <h2 class="d-title d-title-sm"><span class="d-mask"><span class="d-mask-inner">The numbers people come for</span></span></h2>
          <div class="board-groups">
            {BOARD.map((g) => (
              <div class={`board-group board-${g.id}`}>
                <h3 class="board-label"><span class="board-dot" aria-hidden="true"></span>{g.label}</h3>
                <ul class="board-rows">
                  {g.rows.map((r) => (
                    <li>
                      <a class="board-row reveal" href={r.href}>
                        <span class="board-q">{r.q}</span>
                        <span class="board-a tabular-nums" data-count={r.n} data-pre={r.pre} data-suf={r.suf}>{r.a}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* D3 — trust + close */}
      <section class="d-section d-close">
        <div class="d-inner">
          <p class="d-trust reveal">
            Built by an ACA-qualified accountant&ensp;·&ensp;Tax rates verified for
            <span class="tabular-nums"> 2026/27</span> (UK) &amp; <span class="tabular-nums">2026</span> (US)&ensp;·&ensp;Every calculator documents its formula
          </p>
          <div class="daylight-ctas reveal">
            <a class="cta-primary" href="/tools/">Explore all 46 calculators</a>
            <a class="cta-quiet" href="/scenarios/">Browse instant answers →</a>
          </div>
        </div>
      </section>
    </main>

    <style>
      /* ════ Theater base ════ */
      .story-body {
        margin: 0;
        background: #0a0b0d;
        color: #fcfcfa;
        font-family: 'DM Sans', sans-serif;
        overflow-x: hidden;
      }

      .story-header {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 24px;
        transition: background-color 0.4s ease;
      }
      .story-wordmark {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        text-decoration: none;
        color: #fcfcfa;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 19px;
        letter-spacing: -0.02em;
        transition: color 0.4s ease;
      }
      .story-wordmark em { font-style: normal; color: #38aeae; }
      .story-skip {
        color: #8b93a1;
        text-decoration: none;
        font-size: 14px;
        padding: 8px 14px;
        border: 1px solid rgba(139, 147, 161, 0.35);
        border-radius: 8px;
        transition: color 0.2s ease, border-color 0.2s ease;
      }
      .story-skip:hover { color: #fcfcfa; border-color: #8b93a1; }
      .story-header.light .story-wordmark { color: #14161a; }
      .story-header.light .story-wordmark em { color: #0b6e6e; }
      .story-header.light .story-skip { color: #555a66; border-color: #e4e4e0; }
      .story-header.light .story-skip:hover { color: #14161a; }

      /* ════ Stage ════ */
      .track { height: 620vh; position: relative; }
      .stage {
        position: sticky;
        top: 0;
        height: 100vh;
        overflow: hidden;
      }

      .wash {
        position: absolute;
        inset: -20% 0;
        opacity: 0;
        pointer-events: none;
      }
      #wash-grow { background: radial-gradient(90% 70% at 30% 85%, rgba(24, 138, 96, 0.22), transparent 70%); }
      #wash-keep { background: radial-gradient(90% 70% at 70% 80%, rgba(56, 174, 174, 0.20), transparent 70%); }
      #wash-owe  { background: radial-gradient(90% 70% at 35% 80%, rgba(200, 74, 48, 0.17), transparent 70%); }

      .line-stage {
        position: absolute;
        inset: 12% 0 8% 0;
        width: 100%;
        height: 80%;
        pointer-events: none;
        /* the line is a floating data ribbon, not a wall-to-wall divider */
        mask-image: linear-gradient(to right, transparent, black 9%, black 91%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, black 9%, black 91%, transparent);
      }

      .act {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px;
        text-align: center;
      }

      /* ════ Act 0 — the question ════ */
      .question {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 640;
        font-size: clamp(2.6rem, 7.5vw, 5.6rem);
        letter-spacing: -0.03em;
        line-height: 1.04;
        max-width: 14ch;
      }
      .q-word { display: inline-block; white-space: nowrap; }
      .q-char { display: inline-block; will-change: transform, opacity; }
      .q-space { display: inline-block; width: 0.28em; }

      .question-sub {
        margin: 26px 0 0;
        font-size: clamp(1rem, 1.6vw, 1.2rem);
        color: #aeb5bf;
        max-width: 44ch;
        line-height: 1.55;
      }
      .question-sub .sub-quiet { display: block; color: #6b7280; font-size: 0.88em; margin-top: 6px; }

      .dawn-hint {
        position: absolute;
        top: 58%;
        left: 50%;
        transform: translateX(-50%);
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        font-size: clamp(1.3rem, 2.4vw, 1.9rem);
        letter-spacing: -0.02em;
        color: #0b6e6e;
        opacity: 0;
        pointer-events: none;
      }

      .scroll-cue {
        position: absolute;
        bottom: 34px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
      }
      .cue-line {
        width: 1px;
        height: 56px;
        background: linear-gradient(to bottom, transparent, #38aeae 30%, #38aeae 70%, transparent);
        animation: cue-pulse 2.4s ease-in-out infinite;
        transform-origin: top;
      }
      .cue-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        letter-spacing: 0.34em;
        text-transform: uppercase;
        color: #6b7280;
      }
      @keyframes cue-pulse {
        0%, 100% { opacity: 0.35; transform: scaleY(0.82); }
        50% { opacity: 1; transform: scaleY(1); }
      }

      /* ════ Chapters ════ */
      .chapter {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        text-align: left;
        gap: 48px;
        padding: 0 clamp(24px, 7vw, 110px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }
      .chapter.active { pointer-events: auto; }

      .chapter-copy { max-width: 30rem; }
      .kicker {
        margin: 0 0 14px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: #6b7280;
      }
      .chapter-title {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 640;
        font-size: clamp(2.6rem, 6vw, 4.6rem);
        letter-spacing: -0.03em;
        line-height: 1;
      }
      .chapter-grow .chapter-title { color: #57d9a3; }
      .chapter-keep .chapter-title { color: #5fd3d3; }
      .chapter-owe  .chapter-title { color: #f08a70; }
      .chapter-lede {
        margin: 20px 0 0;
        color: #aeb5bf;
        font-size: clamp(1rem, 1.5vw, 1.15rem);
        line-height: 1.6;
        max-width: 38ch;
      }

      .mask { display: block; overflow: hidden; }
      .mask-inner { display: block; transform: translateY(112%); will-change: transform; }

      .chapter-figures {
        display: flex;
        flex-direction: column;
        gap: 14px;
        width: min(360px, 34vw);
      }
      .figure-card {
        display: block;
        position: relative;
        padding: 18px 44px 16px 20px;
        border: 1px solid rgba(139, 147, 161, 0.22);
        border-radius: 10px;
        text-decoration: none;
        /* solid-enough dark surface so the glowing line passes BEHIND, not through */
        background: rgba(13, 15, 18, 0.86);
        backdrop-filter: blur(6px);
        transform: translateY(26px);
        opacity: 0;
        transition: border-color 0.25s ease, background-color 0.25s ease;
        will-change: transform, opacity;
      }
      .figure-card:hover { border-color: rgba(56, 174, 174, 0.65); background: rgba(56, 174, 174, 0.06); }
      .figure-value {
        display: block;
        font-size: clamp(1.3rem, 2vw, 1.6rem);
        font-weight: 700;
        color: #fcfcfa;
        letter-spacing: -0.01em;
      }
      .figure-label {
        display: block;
        margin-top: 5px;
        font-size: 13.5px;
        color: #8b93a1;
        line-height: 1.45;
      }
      .figure-arrow {
        position: absolute;
        right: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #38aeae;
        font-size: 18px;
        opacity: 0;
        transition: opacity 0.25s ease, transform 0.25s ease;
      }
      .figure-card:hover .figure-arrow { opacity: 1; transform: translateY(-50%) translateX(2px); }

      /* ════ Daylight — the instrument room ════ */
      .daylight {
        background: #fcfcfa;
        color: #14161a;
      }
      .d-section { padding: clamp(64px, 11vh, 130px) 24px; }
      .d-engine { padding-top: clamp(40px, 7vh, 80px); }
      .d-board { background: #f6f6f5; border-block: 1px solid #e4e4e0; }
      .d-inner { max-width: 1100px; margin: 0 auto; }

      .d-kicker {
        margin: 0 0 14px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: #6b7280;
        text-align: center;
      }
      .d-title {
        margin: 0;
        text-align: center;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 640;
        letter-spacing: -0.03em;
        font-size: clamp(2.3rem, 5vw, 3.8rem);
        color: #14161a;
      }
      .d-title-sm { font-size: clamp(1.9rem, 4vw, 2.9rem); }
      .d-sub {
        margin: 16px auto 40px;
        text-align: center;
        color: #555a66;
        max-width: 46ch;
        line-height: 1.6;
      }
      .d-mask { display: block; overflow: hidden; }
      .d-mask-inner { display: block; }

      .d-engine-wrap { margin-top: 8px; }
      .engine-panel {
        background: #ffffff;
        border: 1px solid #e4e4e0;
        border-radius: 0.75rem;
        color: #14161a;
      }
      .engine-panel .shimmer-line {
        background: linear-gradient(90deg, rgba(0,0,0,0.04) 25%, rgba(0,0,0,0.08) 50%, rgba(0,0,0,0.04) 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
      }

      /* The board */
      .board-groups {
        margin-top: 44px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: clamp(28px, 4vw, 56px);
      }
      .board-label {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0 0 10px;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 640;
        font-size: 1.15rem;
        letter-spacing: -0.01em;
        color: #14161a;
      }
      .board-dot { width: 9px; height: 9px; border-radius: 3px; }
      .board-grow .board-dot { background: #14805a; }
      .board-keep .board-dot { background: #0b6e6e; }
      .board-owe  .board-dot { background: #c4442a; }

      .board-rows { list-style: none; margin: 0; padding: 0; }
      .board-row {
        display: block;
        padding: 15px 12px 14px;
        border-bottom: 1px solid #e4e4e0;
        border-left: 2px solid transparent;
        text-decoration: none;
        transition: border-color 0.2s ease, background-color 0.2s ease, padding-left 0.2s ease;
      }
      .board-row:hover { background: rgba(11, 110, 110, 0.04); padding-left: 16px; }
      .board-grow .board-row:hover { border-left-color: #14805a; }
      .board-keep .board-row:hover { border-left-color: #0b6e6e; }
      .board-owe  .board-row:hover { border-left-color: #c4442a; }
      .board-q { display: block; font-size: 14px; color: #555a66; line-height: 1.45; }
      .board-a {
        display: block;
        margin-top: 5px;
        font-size: clamp(1.25rem, 1.8vw, 1.5rem);
        font-weight: 700;
        color: #14161a;
        letter-spacing: -0.01em;
      }

      /* Close */
      .d-close { text-align: center; }
      .d-trust {
        margin: 0 auto 30px;
        font-size: 14px;
        color: #555a66;
        max-width: 72ch;
        line-height: 1.8;
      }
      .daylight-ctas { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
      .cta-primary {
        background: #0b6e6e;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        padding: 13px 26px;
        border-radius: 10px;
        transition: background-color 0.2s ease;
      }
      .cta-primary:hover { background: #0a5555; }
      .cta-quiet {
        color: #0b6e6e;
        text-decoration: none;
        font-weight: 600;
        padding: 13px 10px;
      }

      /* ════ Mobile ════ */
      @media (max-width: 820px) {
        .chapter { flex-direction: column; justify-content: center; gap: 26px; text-align: center; padding: 88px 20px 20px; }
        .chapter-copy { max-width: none; }
        .chapter-lede { margin-inline: auto; }
        .chapter-figures { width: 100%; max-width: 420px; gap: 10px; }
        .figure-card { padding: 13px 40px 12px 16px; }
        .line-stage { inset: 6% 0 4% 0; height: 90%; opacity: 0.6; }
        .story-skip { font-size: 13px; padding: 7px 11px; }
        .board-groups { grid-template-columns: 1fr; gap: 20px; }
      }

      /* ════ Reduced motion / no-JS: every act settled, plain scroll ════ */
      @media (prefers-reduced-motion: reduce) {
        .cue-line { animation: none; opacity: 0.7; }
      }
      .static-story .track { height: auto; }
      .static-story .stage { position: static; height: auto; overflow: visible; }
      .static-story .act { position: static; min-height: 92vh; opacity: 1 !important; visibility: visible !important; }
      .static-story .mask-inner { transform: none; }
      .static-story .figure-card { transform: none; opacity: 1; }
      .static-story .line-stage, .static-story .wash, .static-story .scroll-cue { display: none; }
      .static-story .q-char { transform: none !important; opacity: 1 !important; }
    </style>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        document.body.classList.add('static-story');
      } else {
        gsap.registerPlugin(ScrollTrigger);

        /* ── Path shapes: equal-length point arrays, lerped for morphs ── */
        const N = 140;
        const pts = (fn: (t: number) => number) =>
          Array.from({ length: N }, (_, i) => {
            const t = i / (N - 1);
            return [t * 1000, fn(t)] as [number, number];
          });

        const FLAT = pts(() => 310);
        const GROW = pts((t) => 340 - (300 * (Math.exp(2.8 * t) - 1)) / (Math.exp(2.8) - 1));
        const KEEP = pts((t) => 185 - 55 * t); // income line, rising gently
        const OWE = pts((t) => 62 + 258 * Math.pow(t, 1.85));
        const HAIR = pts(() => 200);

        const toPath = (a: [number, number][]) =>
          'M' + a.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' L');

        const lerpPts = (a: [number, number][], b: [number, number][], t: number) =>
          a.map(([x, y], i) => [x, y + (b[i][1] - y) * t] as [number, number]);

        const core = document.getElementById('line-core')!;
        const glow = document.getElementById('line-glow')!;
        const areaKept = document.getElementById('area-kept')!;
        const setLine = (a: [number, number][]) => {
          const d = toPath(a);
          core.setAttribute('d', d);
          glow.setAttribute('d', d);
        };
        setLine(FLAT);
        areaKept.setAttribute('d', toPath(KEEP) + ' L1000,340 L0,340 Z');

        /** Morph proxy — one tween per shape change */
        const morph = (from: [number, number][], to: [number, number][]) => {
          const proxy = { t: 0 };
          return gsap.to(proxy, {
            t: 1,
            ease: 'none',
            onUpdate: () => setLine(lerpPts(from, to, proxy.t)),
          });
        };

        /* ── Line draw-in (dash) ── */
        const coreP = core as unknown as SVGPathElement;
        const drawLen = 1400;
        core.setAttribute('stroke-dasharray', String(drawLen));
        core.setAttribute('stroke-dashoffset', String(drawLen));
        glow.setAttribute('stroke-dasharray', String(drawLen));
        glow.setAttribute('stroke-dashoffset', String(drawLen));

        /* ── Question char scatter targets (seeded by index — stable) ── */
        const chars = gsap.utils.toArray<HTMLElement>('.q-char');
        const seeded = (i: number, s: number) => {
          const x = Math.sin(i * 127.1 + s * 311.7) * 43758.5453;
          return x - Math.floor(x);
        };

        /* ── Master timeline, scrubbed over the track ── */
        const chapters = ['grow', 'keep', 'owe'];
        const tl = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: '#track',
            start: 'top top',
            end: 'bottom bottom',
            scrub: 0.6,
          },
        });

        /* Act 0 hold (0–6) — CSS pulse carries it */
        tl.to({}, { duration: 6 });

        /* Act 1: dissolution (6–16) — chars scatter down-stage, line draws */
        tl.to(chars, {
          duration: 8,
          x: (i) => (seeded(i, 1) - 0.5) * 340,
          y: (i) => 120 + seeded(i, 2) * 260,
          rotation: (i) => (seeded(i, 3) - 0.5) * 50,
          opacity: 0,
          ease: 'power2.in',
          stagger: { each: 0.06, from: 'random' },
        }, 6);
        tl.to(['#question-sub', '#scroll-cue'], { duration: 4, opacity: 0, y: -30 }, 6);
        tl.to(['#line-core', '#line-glow'], { duration: 3, opacity: 1 }, 9);
        tl.to(['#line-core', '#line-glow'], { duration: 6, strokeDashoffset: 0, ease: 'power1.inOut' }, 9);

        /* Chapter machinery */
        const chapterIn = (id: string, at: number) => {
          tl.to(`#wash-${id}`, { duration: 3, opacity: 1 }, at);
          tl.to(`#chapter-${id}`, { duration: 0.4, opacity: 1, visibility: 'visible' }, at);
          tl.to(`#chapter-${id} .mask-inner`, { duration: 3, y: 0, ease: 'power4.out', stagger: 0.35 }, at + 0.4);
          tl.to(`#chapter-${id} .figure-card`, { duration: 2.6, y: 0, opacity: 1, ease: 'power3.out', stagger: 0.5 }, at + 1.6);
          tl.add(() => document.getElementById(`chapter-${id}`)?.classList.add('active'), at + 1);
        };
        const chapterOut = (id: string, at: number) => {
          tl.add(() => document.getElementById(`chapter-${id}`)?.classList.remove('active'), at);
          tl.to(`#chapter-${id} .mask-inner`, { duration: 2, y: '-112%', ease: 'power3.in', stagger: 0.15 }, at);
          tl.to(`#chapter-${id} .figure-card`, { duration: 2, y: -22, opacity: 0, ease: 'power2.in', stagger: 0.15 }, at);
          tl.to(`#chapter-${id}`, { duration: 0.4, opacity: 0, visibility: 'hidden' }, at + 2.2);
          tl.to(`#wash-${id}`, { duration: 3, opacity: 0 }, at + 0.5);
        };

        /* GROW (16–30) */
        tl.add(morph(FLAT, GROW).duration(4), 16);
        chapterIn('grow', 17);
        chapterOut('grow', 28);

        /* KEEP (30–44) — area fill rises under the income line */
        tl.add(morph(GROW, KEEP).duration(4), 30);
        tl.to('#area-kept', { duration: 3, opacity: 1 }, 32.5);
        chapterIn('keep', 31);
        tl.to('#area-kept', { duration: 2, opacity: 0 }, 42);
        chapterOut('keep', 42);

        /* OWE (44–58) */
        tl.add(morph(KEEP, OWE).duration(4), 44);
        chapterIn('owe', 45);
        chapterOut('owe', 56);

        /* DAWN (58–74): line flattens to a hairline, obsidian → paper */
        tl.add(morph(OWE, HAIR).duration(4), 58);
        tl.to(['#line-glow'], { duration: 4, opacity: 0 }, 60);
        tl.to(['#line-core'], { duration: 6, stroke: '#0B6E6E', opacity: 0.5 }, 60);
        tl.to('.story-body', { duration: 10, backgroundColor: '#FCFCFA', ease: 'power1.inOut' }, 60);
        tl.to('#dawn-hint', { duration: 4, opacity: 1, ease: 'power2.out' }, 67);
        tl.to({}, { duration: 2 }); // settle

        /* Header flip that works in both scroll directions */
        ScrollTrigger.create({
          trigger: '#track',
          start: '93% bottom',
          onEnter: () => document.getElementById('story-header')?.classList.add('light'),
          onLeaveBack: () => document.getElementById('story-header')?.classList.remove('light'),
        });

        /* Gentle chapter snapping — desktop pointers only (?nosnap disables for QA) */
        if (window.matchMedia('(pointer: fine)').matches && !location.search.includes('nosnap')) {
          const total = 72;
          ScrollTrigger.create({
            trigger: '#track',
            start: 'top top',
            end: 'bottom bottom',
            snap: {
              snapTo: [0, 22 / total, 36 / total, 50 / total, 1],
              duration: { min: 0.25, max: 0.55 },
              ease: 'power2.inOut',
              delay: 0.1,
            },
          });
        }

        /* ── Daylight choreography: reveals, masked titles, count-ups ── */
        const fmtInt = (v: number) => Math.round(v).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');

        gsap.set('.reveal', { opacity: 0, y: 26 });
        gsap.set('.d-mask-inner', { yPercent: 112 });

        ScrollTrigger.batch('.reveal', {
          start: 'top 88%',
          once: true,
          onEnter: (els) => gsap.to(els, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08 }),
        });

        gsap.utils.toArray<HTMLElement>('.d-mask-inner').forEach((el) => {
          ScrollTrigger.create({
            trigger: el,
            start: 'top 88%',
            once: true,
            onEnter: () => gsap.to(el, { yPercent: 0, duration: 1.05, ease: 'power4.out' }),
          });
        });

        gsap.utils.toArray<HTMLElement>('.board-a').forEach((el) => {
          const target = parseFloat(el.dataset.count || '0');
          if (!target) return;
          const pre = el.dataset.pre || '';
          const suf = el.dataset.suf || '';
          ScrollTrigger.create({
            trigger: el,
            start: 'top 92%',
            once: true,
            onEnter: () => {
              const proxy = { v: 0 };
              gsap.to(proxy, {
                v: target,
                duration: 1.3,
                ease: 'power2.out',
                onUpdate: () => { el.textContent = pre + fmtInt(proxy.v) + suf; },
              });
            },
          });
        });
      }
    </script>
  </body>
</html>
