      }

      /* ════ Mobile ════ */
      @media (max-width: 820px) {
        .chapter { flex-direction: column; justify-content: center; gap: 26px; text-align: center; padding: 88px 20px 20px; }
        .chapter-copy { max-width: none; }
        .chapter-lede { margin-inline: auto; }
        .chapter-figures { width: 100%; max-width: 440px; }
        .figure-row { padding: 13px 2px; }
        .figure-label { text-align: left; }
        .figure-value { font-size: 1.3rem; }
        .figure-value.is-phrase { font-size: 1.05rem; }
        .chapter-index { font-size: 8rem; left: 6px; bottom: 2vh; }
        .decision-row { flex-direction: column; align-items: flex-start; gap: 6px; }
        .bento { grid-template-columns: 1fr; grid-template-areas: "sg" "dl" "ip" "ec" "mini"; gap: 12px; }
        .area-saving-and-growth, .area-debt-and-loans { min-height: 210px; }
        .area-income-and-planning, .area-economic { min-height: 170px; }
        .line-stage { inset: 6% 0 4% 0; height: 90%; opacity: 0.6; }
        .story-skip { font-size: 13px; padding: 7px 11px; }

      }

      /* ════ Reduced motion / no-JS: every act settled, plain scroll ════ */
      @media (prefers-reduced-motion: reduce) {
        .cue-line { animation: none; opacity: 0.7; }
      }
      .static-story .track { height: auto; }
      .static-story .stage { position: static; height: auto; overflow: visible; }
      .static-story .act { position: static; min-height: 92vh; opacity: 1 !important; visibility: visible !important; }
      .static-story .mask-inner { transform: none; }
      .static-story .figure-row { transform: none; opacity: 1; }
      .static-story .line-stage, .static-story .wash, .static-story .scroll-cue { display: none; }
      .static-story .q-char { transform: none !important; opacity: 1 !important; }
    </style>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        document.body.classList.add('static-story');
      } else {
        gsap.registerPlugin(ScrollTrigger);

        /* ── Path shapes: equal-length point arrays, lerped for morphs ── */
        const N = 140;
        const pts = (fn: (t: number) => number) =>
          Array.from({ length: N }, (_, i) => {
            const t = i / (N - 1);
            return [t * 1000, fn(t)] as [number, number];
          });

        const FLAT = pts(() => 310);
        const GROW = pts((t) => 340 - (300 * (Math.exp(2.8 * t) - 1)) / (Math.exp(2.8) - 1));
        // income line rides the lower band — clear of the headline and ledger text
        const KEEP = pts((t) => 322 - 72 * t);
        const OWE = pts((t) => 62 + 258 * Math.pow(t, 1.85));
        const HAIR = pts(() => 200);

        const toPath = (a: [number, number][]) =>
          'M' + a.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' L');

        const lerpPts = (a: [number, number][], b: [number, number][], t: number) =>
          a.map(([x, y], i) => [x, y + (b[i][1] - y) * t] as [number, number]);

        const core = document.getElementById('line-core')!;
        const glow = document.getElementById('line-glow')!;
        const areaKept = document.getElementById('area-kept')!;
        const setLine = (a: [number, number][]) => {
          const d = toPath(a);
          core.setAttribute('d', d);
          glow.setAttribute('d', d);
        };
        setLine(FLAT);
        areaKept.setAttribute('d', toPath(KEEP) + ' L1000,340 L0,340 Z');

        /** Morph proxy — one tween per shape change */
        const morph = (from: [number, number][], to: [number, number][]) => {
          const proxy = { t: 0 };
          return gsap.to(proxy, {
            t: 1,
            ease: 'none',
            onUpdate: () => setLine(lerpPts(from, to, proxy.t)),
          });
        };

        /* ── Line draw-in (dash) ── */
        const coreP = core as unknown as SVGPathElement;
        const drawLen = 1400;
        core.setAttribute('stroke-dasharray', String(drawLen));
        core.setAttribute('stroke-dashoffset', String(drawLen));
        glow.setAttribute('stroke-dasharray', String(drawLen));
        glow.setAttribute('stroke-dashoffset', String(drawLen));

        /* ── Question char scatter targets (seeded by index — stable) ── */
        const chars = gsap.utils.toArray<HTMLElement>('.q-char');
        const seeded = (i: number, s: number) => {
          const x = Math.sin(i * 127.1 + s * 311.7) * 43758.5453;
          return x - Math.floor(x);
        };

        /* ── Master timeline, scrubbed over the track ── */
        const chapters = ['grow', 'keep', 'owe'];
        const tl = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: '#track',
            start: 'top top',
            end: 'bottom bottom',
            scrub: 1.1,
          },
        });

        /* Act 0 hold (0–6) — CSS pulse carries it */
        tl.to({}, { duration: 6 });

        /* Act 1: dissolution (6–16) — chars scatter down-stage, line draws */
        tl.to(chars, {
          duration: 8,
          x: (i) => (seeded(i, 1) - 0.5) * 340,
          y: (i) => 120 + seeded(i, 2) * 260,
          rotation: (i) => (seeded(i, 3) - 0.5) * 50,
          opacity: 0,
          ease: 'power2.inOut',
          stagger: { each: 0.07, from: 'random' },
        }, 6);
        tl.to(['#question-sub', '#scroll-cue'], { duration: 4, opacity: 0, y: -30 }, 6);
        tl.to(['#line-core', '#line-glow'], { duration: 3, opacity: 1 }, 9);
        tl.to(['#line-core', '#line-glow'], { duration: 6, strokeDashoffset: 0, ease: 'power1.inOut' }, 9);

        /* Chapter machinery */
        const chapterIn = (id: string, at: number) => {
          tl.to(`#wash-${id}`, { duration: 5, opacity: 1, ease: 'sine.inOut' }, at - 1);
          tl.to(`#chapter-${id}`, { duration: 0.6, opacity: 1, visibility: 'visible' }, at);
          tl.fromTo(`#chapter-${id} .chapter-index`, { opacity: 0 }, { duration: 4, opacity: 1, ease: 'sine.out' }, at);
          tl.to(`#chapter-${id} .mask-inner`, { duration: 3.6, y: 0, ease: 'power3.out', stagger: 0.45 }, at + 0.5);
          tl.to(`#chapter-${id} .figure-row`, { duration: 3, y: 0, opacity: 1, ease: 'power3.out', stagger: 0.6 }, at + 1.8);
          tl.add(() => document.getElementById(`chapter-${id}`)?.classList.add('active'), at + 1);
        };
        const chapterOut = (id: string, at: number) => {
          tl.add(() => document.getElementById(`chapter-${id}`)?.classList.remove('active'), at);
          tl.to(`#chapter-${id} .mask-inner`, { duration: 2.4, y: '-112%', ease: 'power2.in', stagger: 0.18 }, at);
          tl.to(`#chapter-${id} .figure-row`, { duration: 2.4, y: -20, opacity: 0, ease: 'power2.in', stagger: 0.18 }, at);
          tl.to(`#chapter-${id} .chapter-index`, { duration: 2.4, opacity: 0, ease: 'sine.in' }, at);
          tl.to(`#chapter-${id}`, { duration: 0.5, opacity: 0, visibility: 'hidden' }, at + 2.6);
          tl.to(`#wash-${id}`, { duration: 4.5, opacity: 0, ease: 'sine.inOut' }, at + 0.8);
        };

        /* GROW (16–30) */
        tl.add(morph(FLAT, GROW).duration(6), 15);
        chapterIn('grow', 17);
        chapterOut('grow', 28);

        /* KEEP (30–44) — area fill rises under the income line */
        tl.add(morph(GROW, KEEP).duration(6), 29);
        tl.to('#area-kept', { duration: 3, opacity: 1 }, 32.5);
        chapterIn('keep', 31);
        tl.to('#area-kept', { duration: 2, opacity: 0 }, 42);
        chapterOut('keep', 42);

        /* OWE (44–58) */
        tl.add(morph(KEEP, OWE).duration(6), 43);
        chapterIn('owe', 45);
        chapterOut('owe', 56);

        /* DAWN (58–74): line flattens to a hairline; obsidian grades through a
           warm horizon into paper — no scroll position parks on flat grey */
        tl.add(morph(OWE, HAIR).duration(6), 57);
        tl.to(['#line-glow'], { duration: 4, opacity: 0 }, 60);
        tl.to(['#line-core'], { duration: 6, stroke: '#0B6E6E', opacity: 0.5 }, 60);
        tl.to('.story-body', { duration: 4.5, backgroundColor: '#2E2724', ease: 'power1.in' }, 60);
        tl.to('.story-body', { duration: 3.5, backgroundColor: '#EFE9E1', ease: 'none' }, 64.5);
        tl.to('.story-body', { duration: 3, backgroundColor: '#FCFCFA', ease: 'power1.out' }, 68);
        tl.to('#dawn-glow', { duration: 5, opacity: 0.6, ease: 'sine.in' }, 61);
        tl.to('#dawn-glow', { duration: 4.5, opacity: 0, ease: 'sine.out' }, 66.5);
        tl.to({}, { duration: 3.5 }); // hold through the dawn settle

        /* Header flip that works in both scroll directions */
        ScrollTrigger.create({
          trigger: '#track',
          start: '93% bottom',
          onEnter: () => document.getElementById('story-header')?.classList.add('light'),
          onLeaveBack: () => document.getElementById('story-header')?.classList.remove('light'),
        });

        /* ── The baton pass: the fixed "Run your numbers" hint travels into the
           static daylight heading of the same words, tracking its live position
           every frame, then swaps with it. Scrubbed — reverses cleanly. ── */
        const hint = document.getElementById('dawn-hint')!;
        const batonTarget = document.getElementById('daylight-title')!;
        gsap.set(hint, { xPercent: -50, yPercent: -50 });
        gsap.set(batonTarget, { opacity: 0 });

        /* Hint fade-in owns its own scrubbed trigger (NOT the master timeline —
           the timeline's scrub smoothing would re-write opacity after the baton
           trigger hides it on fast scrolls, leaving a ghost over the daylight) */
        gsap.fromTo(hint, { opacity: 0 }, {
          opacity: 1,
          ease: 'none',
          scrollTrigger: { trigger: '#track', start: '86% bottom', end: '92% bottom', scrub: true },
        });
        const inkMix = gsap.utils.interpolate('#0B6E6E', '#14161A');
        let hintBase: DOMRect | null = null;

        ScrollTrigger.create({
          trigger: batonTarget,
          start: 'top bottom',
          end: 'top 25%',
          scrub: true,
          invalidateOnRefresh: true,
          onRefresh: () => { hintBase = null; },
          onUpdate: (self) => {
            const t = self.progress;
            if (!hintBase) {
              gsap.set(hint, { x: 0, y: 0, scale: 1 });
              hintBase = hint.getBoundingClientRect();
            }
            const tr = batonTarget.getBoundingClientRect();
            const scaleTarget = tr.height / hintBase.height;
            const dx = tr.left + tr.width / 2 - (hintBase.left + hintBase.width / 2);
            const dy = tr.top + tr.height / 2 - (hintBase.top + hintBase.height / 2);
            const eased = gsap.parseEase('power2.inOut')(t);
            if (t >= 0.985) {
              gsap.set(batonTarget, { opacity: 1 });
              gsap.set(hint, { opacity: 0 });
            } else {
              gsap.set(batonTarget, { opacity: 0 });
              gsap.set(hint, {
                x: dx * eased,
                y: dy * eased,
                scale: 1 + (scaleTarget - 1) * eased,
                color: inkMix(eased),
                opacity: 1,
              });
            }
          },
          onLeave: () => {
            gsap.set(batonTarget, { opacity: 1 });
            gsap.set(hint, { opacity: 0 });
          },
        });

        /* Real site navigation takes over in daylight; the story header bows out
           the moment daylight first peeks over the fold — one brand header on
           screen at any scroll position, never two */
        ScrollTrigger.create({
          trigger: '#daylight',
          start: 'top bottom',
          onEnter: () => document.getElementById('story-header')?.classList.add('gone'),
          onLeaveBack: () => document.getElementById('story-header')?.classList.remove('gone'),
        });

        /* Gentle chapter snapping — desktop pointers only (?nosnap disables for QA) */
        if (window.matchMedia('(pointer: fine)').matches && !location.search.includes('nosnap')) {
          const total = tl.duration();
          ScrollTrigger.create({
            trigger: '#track',
            start: 'top top',
            end: 'bottom bottom',
            snap: {
              snapTo: [0, 22 / total, 36 / total, 50 / total, 1],
              duration: { min: 0.4, max: 0.9 },
              ease: 'power3.inOut',
              delay: 0.15,
            },
          });
        }

        /* ── Daylight choreography: reveals, masked titles, count-ups ── */
        const fmtInt = (v: number) => Math.round(v).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');

        gsap.set('.reveal', { opacity: 0, y: 26 });
        gsap.set('.d-mask-inner', { yPercent: 112 });

        ScrollTrigger.batch('.reveal', {
          start: 'top 88%',
          once: true,
          onEnter: (els) => gsap.to(els, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08 }),
        });

        gsap.utils.toArray<HTMLElement>('.d-mask-inner').forEach((el) => {
          ScrollTrigger.create({
            trigger: el,
            start: 'top 88%',
            once: true,
            onEnter: () => gsap.to(el, { yPercent: 0, duration: 1.05, ease: 'power4.out' }),
          });
        });

        gsap.utils.toArray<HTMLElement>('.decision-a').forEach((el) => {
          const target = parseFloat(el.dataset.count || '0');
          if (!target) return;
          const pre = el.dataset.pre || '';
          const suf = el.dataset.suf || '';
          ScrollTrigger.create({
            trigger: el,
            start: 'top 92%',
            once: true,
            onEnter: () => {
              const proxy = { v: 0 };
              gsap.to(proxy, {
                v: target,
                duration: 1.3,
                ease: 'power2.out',
                onUpdate: () => { el.textContent = pre + fmtInt(proxy.v) + suf; },
              });
            },
          });
        });
      }
    </script>
  </body>
</html>
