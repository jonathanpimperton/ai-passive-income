        background: linear-gradient(to top, #ffffff 72%, rgba(255, 255, 255, 0));
      }
      .bento-samples li { font-size: 13px; color: #6b7280; }
      .bento-samples li::before { content: '·'; margin-right: 6px; color: var(--tone); }
      .bento-go {
        position: absolute;
        top: 31px;
        right: 28px;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--tone);
        opacity: 0;
        transform: translateX(-4px);
        transition: opacity 0.25s ease, transform 0.25s ease;
