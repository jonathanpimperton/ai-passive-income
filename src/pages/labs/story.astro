      .bento-mini .bento-go { top: 22px; right: 22px; }
      .bento-tile:hover .bento-go { opacity: 1; transform: translateX(0); }
      .bento-tile:hover .bento-count { opacity: 0; }
      .bento-count { transition: opacity 0.2s ease; }

      .d-close-link { margin: 0; }
      .d-close-link a { color: #0b6e6e; font-weight: 600; text-decoration: none; }
      .d-close-link a:hover { text-decoration: underline; }

            /* Prominent view-all */
      .d-viewall { margin-top: 34px; text-align: center; }
      .cta-viewall {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: #0b6e6e;
        color: #ffffff;
        text-decoration: none;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 640;
        font-size: clamp(1.05rem, 1.6vw, 1.3rem);
        letter-spacing: -0.01em;
        padding: 18px 34px;
        border-radius: 14px;
        transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 10px 28px rgba(11, 110, 110, 0.22);
      }
      .cta-viewall:hover { background: #0a5555; transform: translateY(-2px); box-shadow: 0 16px 36px rgba(11, 110, 110, 0.28); }
      .cta-viewall svg { transition: transform 0.2s ease; }
      .cta-viewall:hover svg { transform: translateX(3px); }

      /* Close */
      .d-close { text-align: center; }
      .d-trust {
        margin: 0 auto 30px;
        font-size: 14px;
        color: #555a66;
