      .bento-tagline { margin: 0; font-size: 14.5px; color: #555a66; line-height: 1.5; max-width: 36ch; }
      .bento-tagline-sm { font-size: 13px; max-width: none; }
      .bento-samples {
        list-style: none;
        margin: auto 0 0;
        padding: 12px 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: 6px 16px;
