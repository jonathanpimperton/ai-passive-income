---
import BaseLayout from '@layouts/BaseLayout.astro';
import EmailCapture from '@components/ui/EmailCapture.tsx';
import DecisionEngine from '@components/homepage/DecisionEngine.tsx';
import { TOOLS, getToolPath } from '@lib/tools-data';
import { buildWebsiteSchema } from '@lib/seo';
import { calcSimpleIncomeTax, calcNI } from '@lib/uk-tax-calc';
import { formatNumber } from '@lib/calculator-utils';

const websiteSchema = buildWebsiteSchema();

/** Build search index as JSON for the nav search (all tools) */
const searchIndex = JSON.stringify(TOOLS.map((t) => ({
  name: t.name,
  description: t.description,
  category: t.category,
  path: getToolPath(t),
})));

/** 10 flagship tools for discovery section */
const FLAGSHIP_SLUGS = [
  'compound-interest',
  'salary-uk',
  'salary-us',
  'mortgage-payment',
  'mortgage-affordability',
  'retirement-savings',
  'debt-payoff',
  'investment-return',
  'net-worth',
  'emergency-fund',
];
const flagshipTools = FLAGSHIP_SLUGS
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t): t is NonNullable<typeof t> => t !== undefined);

/** 3 featured comparisons for discovery section */
const FEATURED_COMPARISONS = [
  { title: 'Renting vs Buying in 2026', slug: 'renting-vs-buying-2026' },
  { title: 'Pay Off Debt vs Invest', slug: 'pay-off-debt-vs-invest' },
  { title: 'Roth vs Traditional 401(k)', slug: 'roth-vs-traditional-401k' },
];

/** 5 featured scenarios for discovery section */
const FEATURED_SCENARIOS = [
  { title: '£50K salary UK take-home', slug: '50k-salary-uk-take-home' },
  { title: '$100K salary after tax', slug: '100k-salary-take-home' },
  { title: '£500/mo invested for 10 years', slug: '500-per-month-10-years' },
  { title: '$300K mortgage at 6.5%', slug: '300k-mortgage-6-5-percent' },
  { title: '6-month emergency fund', slug: '6-month-emergency-fund' },
];

/**
 * Server-render the default salary result for the skeleton.
 * This shows a real result before React hydrates — no blank state.
 */
const defaultGross = 45000;
const defaultTax = calcSimpleIncomeTax(defaultGross);
const defaultNI = calcNI(defaultGross);
const defaultNet = defaultGross - defaultTax - defaultNI;
const defaultMonthly = defaultNet / 12;
const defaultKeepPct = ((defaultNet / defaultGross) * 100).toFixed(0);
const defaultTakeHomePct = ((defaultNet / defaultGross) * 100).toFixed(0);
const defaultTaxPct = ((defaultTax / defaultGross) * 100).toFixed(0);
const defaultNIPct = ((defaultNI / defaultGross) * 100).toFixed(0);
---

<BaseLayout
  title="Financial Calculators & Tools | CalcRun"
  description="Financial calculators with interactive charts and plain-English explanations. Mortgage, salary, compound interest, retirement — no signup, no ads."
  structuredData={[websiteSchema]}
>
  {/* ===== SECTION 1: DECISION ENGINE ===== */}
  <section class="py-12 sm:py-16 lg:py-20">
    <div class="max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 sm:mb-10">
        <p class="text-sm font-medium text-primary-600 tracking-wide uppercase mb-3">{TOOLS.length} financial calculators & tools with real-time results</p>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 tracking-[-0.02em]">
          What are you trying to figure out?
        </h1>
        <p class="mt-3 text-neutral-500 text-lg">Pick a question. See a real answer.</p>
      </div>

      {/* Server-rendered skeleton — replaced by React on hydrate */}
      <div id="engine-skeleton">
        <div class="hidden lg:grid lg:grid-cols-[280px_1fr] lg:gap-6">
          {/* Tab list skeleton */}
          <div class="space-y-2">
            <div class="w-full text-left px-5 py-4 rounded-lg border-l-[3px] border-l-primary-500 bg-primary-50 font-semibold text-neutral-900">
              <span class="text-[15px] leading-snug">What does this salary really become?</span>
            </div>
            <div class="w-full text-left px-5 py-4 rounded-lg border-l-[3px] border-l-transparent text-neutral-500">
              <span class="text-[15px] leading-snug">Can I actually afford this house?</span>
            </div>
            <div class="w-full text-left px-5 py-4 rounded-lg border-l-[3px] border-l-transparent text-neutral-500">
              <span class="text-[15px] leading-snug">How fast does £500/mo snowball?</span>
            </div>
          </div>

          {/* Result panel skeleton — real server-computed values */}
          <div class="engine-panel rounded-xl p-6 sm:p-8">
            <div class="space-y-5">
              {/* Fake input area */}
              <div class="space-y-3">
                <div>
                  <div class="text-sm font-medium text-neutral-700 mb-1.5">Gross salary</div>
                  <div class="shimmer-line h-11 rounded-lg"></div>
                  <div class="shimmer-line h-2 rounded-full mt-2.5"></div>
                </div>
                <div>
                  <div class="text-sm font-medium text-neutral-700 mb-1.5">Country</div>
                  <div class="flex gap-1">
                    <div class="flex-1 py-2 rounded-lg text-sm font-medium text-center bg-primary-50 text-primary-700 border border-primary-200">🇬🇧 UK</div>
                    <div class="flex-1 py-2 rounded-lg text-sm text-center text-neutral-500 border border-neutral-200">🇺🇸 US</div>
                  </div>
                </div>
              </div>

              <div class="h-px bg-gradient-to-r from-transparent via-neutral-200 to-transparent"></div>

              {/* Real computed result */}
              <div class="space-y-3">
                <div>
                  <p class="text-sm text-neutral-500 mb-1">Monthly take-home</p>
                  <p class="text-3xl sm:text-4xl font-bold tabular-nums lining-nums result-number">
                    £{formatNumber(Math.round(defaultMonthly))}<span class="text-lg font-medium text-neutral-500">/mo</span>
                  </p>
                </div>
                <p class="text-sm text-neutral-500">
                  You keep {defaultKeepPct}% — tax: £{formatNumber(Math.round(defaultTax))}, NI: £{formatNumber(Math.round(defaultNI))}
                </p>
                {/* Bar */}
                <div>
                  <div class="flex gap-[3px] h-3 rounded-full overflow-hidden">
                    <div class="rounded-l-full bg-primary-500" style={`width:${defaultTakeHomePct}%`}></div>
                    <div class="bg-neutral-400" style={`width:${defaultTaxPct}%`}></div>
                    <div class="rounded-r-full bg-neutral-300" style={`width:${defaultNIPct}%`}></div>
                  </div>
                  <div class="flex justify-between mt-1.5">
                    <span class="text-[11px] text-neutral-500">Take-home {defaultTakeHomePct}%</span>
                    <span class="text-[11px] text-neutral-500">Tax {defaultTaxPct}%</span>
                    <span class="text-[11px] text-neutral-500">NI {defaultNIPct}%</span>
                  </div>
                </div>
                <a
                  href="/tools/income-and-planning/salary-uk"
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors duration-150 mt-2"
                >
                  See full breakdown
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* Mobile skeleton: first accordion open */}
        <div class="lg:hidden space-y-3">
          <div class="rounded-xl overflow-hidden border border-neutral-200/80">
            <div class="w-full text-left px-5 py-4 flex items-center justify-between bg-primary-50 font-semibold text-neutral-900">
              <span class="text-sm leading-snug">What does this salary really become?</span>
              <svg class="w-5 h-5 shrink-0 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </div>
            <div class="engine-panel p-5 border-t border-neutral-100">
              <div class="space-y-3">
                <div>
                  <p class="text-sm text-neutral-500 mb-1">Monthly take-home</p>
                  <p class="text-3xl font-bold tabular-nums lining-nums result-number">
                    £{formatNumber(Math.round(defaultMonthly))}<span class="text-lg font-medium text-neutral-500">/mo</span>
                  </p>
                </div>
                <p class="text-sm text-neutral-500">
                  You keep {defaultKeepPct}% — tax: £{formatNumber(Math.round(defaultTax))}, NI: £{formatNumber(Math.round(defaultNI))}
                </p>
              </div>
            </div>
          </div>
          <div class="rounded-xl border border-neutral-200/80 px-5 py-4 text-neutral-600 text-sm">Can I actually afford this house?</div>
          <div class="rounded-xl border border-neutral-200/80 px-5 py-4 text-neutral-600 text-sm">How fast does £500/mo snowball?</div>
        </div>
      </div>

      <DecisionEngine client:load />
    </div>
  </section>

  {/* ===== SECTION 2: DISCOVERY — Flagship Tools + Comparisons + Scenarios ===== */}
  <section class="py-12 sm:py-16 bg-neutral-50">
    <div class="max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-10">
        {/* Column 1: Flagship tools */}
        <div>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-neutral-900 mb-5">Popular calculators</h2>
          <div class="space-y-1">
            {flagshipTools.map((tool) => (
              <a
                href={getToolPath(tool)}
                class="group flex items-center justify-between py-2.5 border-b border-neutral-200/60 hover:border-primary-300/50 transition-colors duration-150"
              >
                <span class="text-[15px] font-medium text-neutral-900 group-hover:text-primary-600 transition-colors duration-150 pr-4">
                  {tool.name}
                </span>
                <svg class="w-4 h-4 shrink-0 text-neutral-300 group-hover:text-primary-500 transition-colors duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            ))}
          </div>
          <a href="/tools" class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors duration-150">
            See all {TOOLS.length} tools
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>

        {/* Column 2: Featured comparisons */}
        <div>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-neutral-900 mb-5">Comparisons</h2>
          <div class="space-y-1">
            {FEATURED_COMPARISONS.map((comp) => (
              <a
                href={`/comparisons/${comp.slug}`}
                class="group flex items-center justify-between py-2.5 border-b border-neutral-200/60 hover:border-primary-300/50 transition-colors duration-150"
              >
                <span class="text-[15px] font-medium text-neutral-900 group-hover:text-primary-600 transition-colors duration-150 pr-4">
                  {comp.title}
                </span>
                <svg class="w-4 h-4 shrink-0 text-neutral-300 group-hover:text-primary-500 transition-colors duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            ))}
          </div>
          <a href="/comparisons" class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors duration-150">
            All 15 comparisons
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>

        {/* Column 3: Featured scenarios */}
        <div>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-neutral-900 mb-5">Common scenarios</h2>
          <div class="space-y-1">
            {FEATURED_SCENARIOS.map((scenario) => (
              <a
                href={`/scenarios/${scenario.slug}`}
                class="group flex items-center justify-between py-2.5 border-b border-neutral-200/60 hover:border-primary-300/50 transition-colors duration-150"
              >
                <span class="text-[15px] font-medium text-neutral-900 group-hover:text-primary-600 transition-colors duration-150 pr-4">
                  {scenario.title}
                </span>
                <svg class="w-4 h-4 shrink-0 text-neutral-300 group-hover:text-primary-500 transition-colors duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            ))}
          </div>
          <a href="/scenarios" class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors duration-150">
            Browse 100+ scenarios
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ===== SECTION 3: NEWSLETTER ===== */}
  <section class="py-12 sm:py-16 border-t border-neutral-100">
    <div class="max-w-[600px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-lg sm:text-xl font-bold text-neutral-900 mb-1">Practical money decisions, weekly</h2>
      <p class="text-sm text-neutral-500 mb-5">Salary breakdowns, mortgage explainers, and new calculators — one email a week. Unsubscribe any time.</p>
      <EmailCapture client:visible variant="newsletter" />
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ===== Decision Engine Panel — light mode (default) ===== */
  .engine-panel {
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-neutral-200, #e5e5e5);
    border-radius: 0.75rem;
    color: var(--color-text, #1A1A2E);
  }

  /* Shimmer skeleton for initial load */
  .engine-panel .shimmer-line {
    background: linear-gradient(90deg, rgba(0,0,0,0.04) 25%, rgba(0,0,0,0.08) 50%, rgba(0,0,0,0.04) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }

  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* ===== Dark mode overrides ===== */
  [data-theme="dark"] .engine-panel {
    background: var(--color-surface, #1E2128);
    border-color: var(--color-neutral-700, #3f3f46);
  }

  [data-theme="dark"] .engine-panel .shimmer-line {
    background: linear-gradient(90deg, rgba(255,255,255,0.06) 25%, rgba(255,255,255,0.12) 50%, rgba(255,255,255,0.06) 75%);
    background-size: 200% 100%;
  }
</style>
