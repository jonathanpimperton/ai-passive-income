          <span class="trust-item">Every calculator documents its formula</span>
        </p>
        <p class="d-close-link reveal"><a href="/scenarios/">Browse 100+ instant answers →</a></p>
        <p class="d-replay"><button type="button" id="replay-intro">↺ Watch the intro again</button></p>
      </div>
    </section>
  </div>

  <style is:global>
    /* ════ Theater base — :has(#track) pins this to the homepage even if the
       bundler ever merges this stylesheet into a shared chunk ════ */
    html:not(.intro-seen) body:has(#track) { background: #0a0b0d; }

    /* Returning visitors this session: the theater collapses, daylight is the page */
    html.intro-seen .story-header,
    html.intro-seen .track,
    html.intro-seen .dawn-hint { display: none; }
    .d-replay { display: none; margin: 18px 0 0; }
    html.intro-seen .d-replay { display: block; }
    .d-replay button {
      background: none;
      border: none;
      padding: 6px 8px;
      font: inherit;
      font-size: 13px;
      color: var(--color-neutral-500);
      cursor: pointer;
      transition: color 0.2s ease;
    }
    .d-replay button:hover { color: var(--color-primary-600); }

    .story-header {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 24px;
      color: #fcfcfa;
      transition: background-color 0.4s ease, opacity 0.35s ease;
    }
    .story-wordmark {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      text-decoration: none;
      color: #fcfcfa;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 19px;
      letter-spacing: -0.02em;
      transition: color 0.4s ease;
    }
    .story-wordmark em { font-style: normal; color: #38aeae; }
    .story-skip {
      color: #8b93a1;
      text-decoration: none;
      font-size: 14px;
      padding: 8px 14px;
      border: 1px solid rgba(139, 147, 161, 0.35);
      border-radius: 8px;
      transition: color 0.2s ease, border-color 0.2s ease;
    }
    .story-skip:hover { color: #fcfcfa; border-color: #8b93a1; }
    .story-header.light .story-wordmark { color: #14161a; }
    .story-header.light .story-wordmark em { color: #0b6e6e; }
    .story-header.light .story-skip { color: #555a66; border-color: #e4e4e0; }
    .story-header.light .story-skip:hover { color: #14161a; }
    .story-header.gone {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.35s ease, visibility 0s 0.35s;
    }

    /* ════ Stage ════ */
    .track { height: 700vh; position: relative; color: #fcfcfa; }
    .stage {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    .wash {
      position: absolute;
      inset: -20% 0;
      opacity: 0;
      pointer-events: none;
    }
    #wash-grow { background: radial-gradient(90% 70% at 30% 85%, rgba(24, 138, 96, 0.22), transparent 70%); }
    #wash-keep { background: radial-gradient(90% 70% at 70% 80%, rgba(56, 174, 174, 0.20), transparent 70%); }
    #wash-owe  { background: radial-gradient(90% 70% at 35% 80%, rgba(200, 74, 48, 0.17), transparent 70%); }
    .dawn-glow {
      background: radial-gradient(110% 58% at 50% 64%, rgba(232, 96, 76, 0.20), rgba(240, 138, 112, 0.06) 52%, transparent 76%);
    }

    .line-stage {
      position: absolute;
      inset: 12% 0 8% 0;
      width: 100%;
      height: 80%;
      pointer-events: none;
      /* the line is a floating data ribbon, not a wall-to-wall divider */
      mask-image: linear-gradient(to right, transparent, black 9%, black 91%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 9%, black 91%, transparent);
    }

    .act {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      text-align: center;
    }

    /* ════ Act 0 — the question ════ */
    .question {
      margin: 0;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 560;
      font-size: clamp(2.9rem, 7.8vw, 6.2rem);
      letter-spacing: -0.045em;
      line-height: 1.03;
      max-width: 15ch;
      text-wrap: balance;
      color: #fcfcfa;
    }
    .q-accent .q-char {
      color: #5fd3d3;
      /* tight halo hugging the letterforms + faint ambient bloom */
      text-shadow: 0 0 16px rgba(95, 211, 211, 0.5), 0 0 44px rgba(56, 174, 174, 0.26);
    }
    .q-word { display: inline-block; white-space: nowrap; }
    .q-char { display: inline-block; will-change: transform, opacity; }

    .question-sub {
      margin: 26px 0 0;
      font-size: clamp(1rem, 1.6vw, 1.2rem);
      color: #aeb5bf;
      max-width: 44ch;
      line-height: 1.55;
    }
    .question-sub .sub-quiet { display: block; color: #8b93a1; font-size: 0.88em; margin-top: 6px; }

    .dawn-hint {
      position: fixed;
      top: 44%;
      left: 50%;
      margin: 0;
      z-index: 40;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 640;
      font-size: clamp(1.5rem, 2.6vw, 2.1rem);
      letter-spacing: -0.03em;
      color: var(--color-primary-600);
      opacity: 0;
      pointer-events: none;
      white-space: nowrap;
      will-change: transform, opacity;
    }
    .static-story .dawn-hint { display: none; }
    .static-story .story-header { position: absolute; }

    .scroll-cue {
      position: absolute;
      bottom: 34px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    .cue-line {
      width: 1px;
      height: 56px;
      background: linear-gradient(to bottom, transparent, #38aeae 30%, #38aeae 70%, transparent);
      animation: cue-pulse 2.4s ease-in-out infinite;
      transform-origin: top;
    }
    .cue-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: #8b93a1;
    }
    @keyframes cue-pulse {
      0%, 100% { opacity: 0.35; transform: scaleY(0.82); }
      50% { opacity: 1; transform: scaleY(1); }
    }

    /* ════ Chapters ════ */
    .chapter {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: left;
      gap: 48px;
      padding: 0 clamp(24px, 7vw, 110px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .chapter.active { pointer-events: auto; }

    .chapter-copy { max-width: 30rem; }
    .kicker {
      margin: 0 0 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: #8b93a1;
    }
    .chapter-title {
      margin: 0;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 640;
      font-size: clamp(2.6rem, 6vw, 4.6rem);
      letter-spacing: -0.03em;
      line-height: 1;
    }
    .chapter-grow .chapter-title { color: #57d9a3; }
    .chapter-keep .chapter-title { color: #5fd3d3; }
    .chapter-owe  .chapter-title { color: #f08a70; }
    .chapter-lede {
      margin: 20px 0 0;
      color: #aeb5bf;
      font-size: clamp(1rem, 1.5vw, 1.15rem);
      line-height: 1.6;
      max-width: 38ch;
    }

    .mask { display: block; overflow: hidden; }
    .mask-inner { display: block; transform: translateY(112%); will-change: transform; }

    .chapter-index {
      position: absolute;
      left: clamp(8px, 3vw, 60px);
      bottom: 4vh;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: clamp(9rem, 26vh, 19rem);
      line-height: 1;
      color: transparent;
      -webkit-text-stroke: 1px rgba(139, 147, 161, 0.13);
      pointer-events: none;
      user-select: none;
    }

    .chapter-figures {
      display: flex;
      flex-direction: column;
      width: min(500px, 40vw);
    }
    .figure-row {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: baseline;
      column-gap: 18px;
      padding: 19px 2px;
      border-top: 1px solid rgba(139, 147, 161, 0.18);
      text-decoration: none;
      transform: translateY(26px);
      opacity: 0;
      will-change: transform, opacity;
      transition: border-color 0.3s ease;
    }
    /* Soft obsidian scrim behind each row — the data line passes beneath the
       ledger without ever striking through its text */
    .figure-row::before {
      content: '';
      position: absolute;
      inset: -4px -16px;
      background: rgba(10, 11, 13, 0.78);
      filter: blur(9px);
      border-radius: 14px;
      z-index: -1;
    }
    .figure-row:last-child { border-bottom: 1px solid rgba(139, 147, 161, 0.18); }
    .figure-row:hover { border-top-color: rgba(56, 174, 174, 0.55); }
    .figure-label {
      font-size: 13.5px;
      color: #8b93a1;
      line-height: 1.45;
      transition: color 0.25s ease;
      text-shadow: 0 2px 14px rgba(10, 11, 13, 0.9);
    }
    .figure-region {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      letter-spacing: 0.14em;
      color: #8b93a1;
      border: 1px solid rgba(139, 147, 161, 0.35);
      border-radius: 5px;
      padding: 2px 6px 1px;
      margin-right: 9px;
      vertical-align: 2px;
    }
    .figure-row:hover .figure-label { color: #d7dbe1; }
    .figure-value {
      font-size: clamp(1.45rem, 2.2vw, 2rem);
      font-weight: 700;
      color: #fcfcfa;
      letter-spacing: -0.02em;
      white-space: nowrap;
      justify-self: end;
      text-align: right;
      /* keeps numerals crisp where the glowing line passes behind the ledger */
      text-shadow: 0 2px 20px rgba(10, 11, 13, 0.95), 0 0 6px rgba(10, 11, 13, 0.8);
    }
    /* Phrase-length values step down so the row grid never collapses */
    .figure-value.is-phrase { font-size: clamp(1.15rem, 1.7vw, 1.5rem); }
    .figure-arrow {
      color: #38aeae;
      opacity: 0;
      transition: opacity 0.25s ease;
      font-size: 0.8em;
    }
    .figure-row:hover .figure-arrow { opacity: 1; }

    /* ════ Daylight — the instrument room (semantic tokens: dark-mode aware) ════ */
    .daylight {
      background: var(--color-bg);
      color: var(--color-neutral-900);
    }
    .d-section { padding: clamp(64px, 11vh, 130px) 24px; }
    .d-engine { padding-top: clamp(40px, 7vh, 80px); }
    .d-board { background: var(--color-neutral-50); border-block: 1px solid var(--color-border); }
    .d-inner { max-width: 1100px; margin: 0 auto; }

    .d-kicker {
      margin: 0 0 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--color-neutral-500);
      text-align: center;
    }
    .d-title {
      margin: 0;
      text-align: center;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 640;
      letter-spacing: -0.03em;
      font-size: clamp(2.3rem, 5vw, 3.8rem);
      color: var(--color-neutral-900);
    }
    .d-title-sm { font-size: clamp(1.9rem, 4vw, 2.9rem); }
    .d-sub {
      margin: 16px auto 40px;
      text-align: center;
      color: var(--color-neutral-600);
      max-width: 46ch;
      line-height: 1.6;
    }
    .d-board .d-sub { max-width: 42ch; }
    .d-mask { display: block; overflow: hidden; }
    .d-mask-inner { display: block; }

    .d-engine-wrap { margin-top: 8px; }
    .engine-panel {
      background: var(--color-surface, #fff);
      border: 1px solid var(--color-neutral-200, #e5e5e5);
      border-radius: 0.75rem;
      color: var(--color-text, #1A1A2E);
    }
    .engine-panel .shimmer-line {
      background: linear-gradient(90deg, rgba(0,0,0,0.04) 25%, rgba(0,0,0,0.08) 50%, rgba(0,0,0,0.04) 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
    }
    [data-theme="dark"] .engine-panel {
      background: var(--color-surface, #1E2128);
      border-color: var(--color-neutral-700, #3f3f46);
    }
    [data-theme="dark"] .engine-panel .shimmer-line {
      background: linear-gradient(90deg, rgba(255,255,255,0.06) 25%, rgba(255,255,255,0.12) 50%, rgba(255,255,255,0.06) 75%);
      background-size: 200% 100%;
    }

    /* Decision ledger */
    .d-inner-narrow { max-width: 860px; }
    .decision-rows { list-style: none; margin: 44px 0 0; padding: 0; }
    .decision-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 28px;
      padding: 21px 4px;
      border-top: 1px solid var(--color-border);
      text-decoration: none;
      transition: background-color 0.25s ease;
    }
    .decision-rows li:last-child .decision-row { border-bottom: 1px solid var(--color-border); }
    .decision-row:hover { background: rgba(11, 110, 110, 0.035); }
    [data-theme="dark"] .decision-row:hover { background: rgba(56, 174, 174, 0.07); }
    .decision-q {
      font-size: clamp(0.95rem, 1.3vw, 1.05rem);
      color: var(--color-neutral-700);
      line-height: 1.5;
      max-width: 42ch;
    }
    .d-region {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      letter-spacing: 0.14em;
      color: var(--color-neutral-500);
      border: 1px solid var(--color-border);
      border-radius: 5px;
      padding: 2px 6px 1px;
      margin-right: 9px;
      vertical-align: 2px;
      background: var(--color-surface);
    }
    .decision-a {
      font-size: clamp(1.2rem, 2vw, 1.6rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      white-space: nowrap;
      text-align: right;
    }
    .kind-gain .decision-a { color: var(--color-success-600); }
    .kind-cost .decision-a { color: #c4442a; }
    [data-theme="dark"] .kind-cost .decision-a { color: var(--color-red-600); }

    /* Bento — composed grid: two heroes, two mids, stacked minis */
    .d-bento { background: var(--color-bg); }
    .bento {
      margin-top: 44px;
      display: grid;
      gap: 16px;
      grid-template-columns: repeat(6, 1fr);
      grid-template-areas:
        "sg sg sg sg dl dl"
        "ip ip ec ec mini mini";
    }
    .area-saving-and-growth { grid-area: sg; min-height: 280px; }
    .area-debt-and-loans { grid-area: dl; min-height: 280px; }
    .area-income-and-planning { grid-area: ip; min-height: 220px; }
    .area-economic { grid-area: ec; min-height: 220px; }
    .bento-stack { grid-area: mini; display: grid; grid-template-rows: 1fr 1fr; gap: 16px; }

    .bento-tile {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 28px 28px 24px;
      border: 1px solid var(--color-border);
      border-radius: 16px;
      background: var(--color-surface);
      text-decoration: none;
      overflow: hidden;
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .bento-tile:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 38px rgba(20, 22, 26, 0.08);
      border-color: var(--tone);
    }
    .bento-mini { padding: 20px 22px 16px; }

    .tone-grow { --tone: var(--color-success-600); }
    .tone-keep { --tone: var(--color-primary-600); }
    .tone-owe { --tone: #c4442a; }
    [data-theme="dark"] .tone-owe { --tone: var(--color-red-600); }
    .tone-neutral { --tone: var(--color-neutral-600); }

    .bento-motif {
      position: absolute;
      right: 0;
      bottom: 0;
      width: 62%;
      height: 58%;
      color: var(--tone);
      opacity: 0.11;
      pointer-events: none;
      transition: opacity 0.3s ease;
      /* fade the art out of the bottom strip where the tool links sit */
      mask-image: linear-gradient(to top, transparent 6%, black 52%);
      -webkit-mask-image: linear-gradient(to top, transparent 6%, black 52%);
    }
    .bento-motif-bars { width: 46%; height: 52%; right: 14px; bottom: 0; }
    .bento-tile:hover .bento-motif { opacity: 0.19; }

    .bento-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .bento-label {
      margin: 0;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 640;
      font-size: clamp(1.3rem, 1.9vw, 1.65rem);
      letter-spacing: -0.02em;
      color: var(--color-neutral-900);
    }
    .bento-label-sm { font-size: 1.1rem; }
    .bento-mini-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border-radius: 7px;
      background: color-mix(in srgb, var(--tone) 10%, var(--color-surface));
      border: 1px solid color-mix(in srgb, var(--tone) 18%, var(--color-surface));
      color: var(--tone);
      margin-right: 9px;
      vertical-align: -6px;
    }
    .bento-count {
      font-size: 12px;
      font-weight: 700;
      color: var(--tone);
      background: color-mix(in srgb, var(--tone) 9%, var(--color-surface));
      border: 1px solid color-mix(in srgb, var(--tone) 22%, var(--color-surface));
      padding: 3px 9px;
      border-radius: 999px;
      white-space: nowrap;
      transition: opacity 0.2s ease;
    }
    .bento-tagline { margin: 0; font-size: 14.5px; color: var(--color-neutral-600); line-height: 1.5; max-width: 36ch; }
    .bento-tagline-sm { font-size: 13px; max-width: none; }
    .bento-samples {
      list-style: none;
      margin: auto 0 0;
      padding: 12px 0 0;
      display: flex;
      flex-wrap: wrap;
      gap: 6px 16px;
      position: relative;
      z-index: 1;
      /* solid ground under the links — card art always fades before text */
      background: linear-gradient(to top, var(--color-surface) 72%, transparent);
    }
    .bento-samples li { font-size: 13px; color: var(--color-neutral-500); }
    .bento-samples li::before { content: '·'; margin-right: 6px; color: var(--tone); }
    .bento-go {
      position: absolute;
      top: 31px;
      right: 28px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--tone);
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }
    .bento-mini .bento-go { top: 22px; right: 22px; }
    .bento-tile:hover .bento-go { opacity: 1; transform: translateX(0); }
    .bento-tile:hover .bento-count { opacity: 0; }

    .d-close-link { margin: 0; }
    .d-close-link a { color: var(--color-primary-600); font-weight: 600; text-decoration: none; }
    .d-close-link a:hover { text-decoration: underline; }

    /* Prominent view-all */
    .d-viewall { margin-top: 34px; text-align: center; }
    .cta-viewall {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: #0b6e6e;
      color: #ffffff;
      text-decoration: none;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 640;
      font-size: clamp(1.05rem, 1.6vw, 1.3rem);
      letter-spacing: -0.01em;
      padding: 18px 34px;
      border-radius: 14px;
      transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
      box-shadow: 0 10px 28px rgba(11, 110, 110, 0.22);
    }
    .cta-viewall:hover { background: #0a5555; transform: translateY(-2px); box-shadow: 0 16px 36px rgba(11, 110, 110, 0.28); }
    .cta-viewall svg { transition: transform 0.2s ease; }
    .cta-viewall:hover svg { transform: translateX(3px); }

    /* Close */
    .d-close { text-align: center; border-top: 1px solid var(--color-border); }
    .d-trust {
      margin: 0 auto 30px;
      font-size: 14px;
      color: var(--color-neutral-600);
      max-width: 72ch;
      line-height: 1.8;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 4px 14px;
    }
    /* Trust items wrap whole, never mid-phrase */
    .trust-item { white-space: nowrap; }

    /* ════ Mobile ════ */
    @media (max-width: 820px) {
      .chapter { flex-direction: column; justify-content: center; gap: 26px; text-align: center; padding: 88px 20px 20px; }
      .chapter-copy { max-width: none; }
      .chapter-lede { margin-inline: auto; }
      .chapter-figures { width: 100%; max-width: 440px; }
      .figure-row { padding: 13px 2px; }
      .figure-label { text-align: left; }
      .figure-value { font-size: 1.3rem; }
      .figure-value.is-phrase { font-size: 1.05rem; }
      .chapter-index { font-size: 8rem; left: 6px; bottom: 2vh; }
      .decision-row { flex-direction: column; align-items: flex-start; gap: 6px; }
      .bento { grid-template-columns: 1fr; grid-template-areas: "sg" "dl" "ip" "ec" "mini"; gap: 12px; }
      .area-saving-and-growth, .area-debt-and-loans { min-height: 210px; }
      .area-income-and-planning, .area-economic { min-height: 170px; }
      .line-stage { inset: 6% 0 4% 0; height: 90%; opacity: 0.6; }
      .story-skip { font-size: 13px; padding: 7px 11px; }
    }

    /* ════ Reduced motion: every act settled, plain scroll ════ */
    @media (prefers-reduced-motion: reduce) {
      .cue-line { animation: none; opacity: 0.7; }
    }
    .static-story .track { height: auto; }
    .static-story .stage { position: static; height: auto; overflow: visible; }
    .static-story .act { position: static; min-height: 92vh; opacity: 1 !important; visibility: visible !important; }
    .static-story .mask-inner { transform: none; }
    .static-story .figure-row { transform: none; opacity: 1; }
    .static-story .line-stage, .static-story .wash, .static-story .scroll-cue { display: none; }
    .static-story .q-char { transform: none !important; opacity: 1 !important; }
  </style>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    const html = document.documentElement;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const seen = html.classList.contains('intro-seen');
    const track = document.getElementById('track');
    const ga = (name: string, params?: Record<string, string>) =>
      (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag?.('event', name, params);

    if (reduced) {
      document.body.classList.add('static-story');
    }
    if (!reduced) {
      gsap.registerPlugin(ScrollTrigger);

      /* The engine's SSR skeleton collapses when React hydrates (after the
         load-event refresh), shifting everything below it up by its height —
         re-measure trigger positions the moment that happens, or every
         daylight trigger sits several hundred px too low and never fires. */
      const skeleton = document.getElementById('engine-skeleton');
      if (skeleton) {
        const mo = new MutationObserver(() => {
          if (skeleton.style.display === 'none') {
            ScrollTrigger.refresh();
            mo.disconnect();
          }
        });
        mo.observe(skeleton, { attributes: true, attributeFilter: ['style'] });
      }
      /* Font swap also nudges layout — one more re-measure once fonts settle */
      document.fonts?.ready.then(() => ScrollTrigger.refresh());
    }

    /* ── The theater — first homepage visit of the session only ── */
    if (!reduced && !seen && track) {
      /* ── Path shapes: equal-length point arrays, lerped for morphs ── */
      const N = 140;
      const pts = (fn: (t: number) => number) =>
        Array.from({ length: N }, (_, i) => {
          const t = i / (N - 1);
          return [t * 1000, fn(t)] as [number, number];
        });

      const FLAT = pts(() => 310);
      const GROW = pts((t) => 340 - (300 * (Math.exp(2.8 * t) - 1)) / (Math.exp(2.8) - 1));
      // income line rides the lower band — clear of the headline and ledger text
      const KEEP = pts((t) => 322 - 72 * t);
      const OWE = pts((t) => 62 + 258 * Math.pow(t, 1.85));
      const HAIR = pts(() => 200);

      const toPath = (a: [number, number][]) =>
        'M' + a.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' L');

      const lerpPts = (a: [number, number][], b: [number, number][], t: number) =>
        a.map(([x, y], i) => [x, y + (b[i][1] - y) * t] as [number, number]);

      const core = document.getElementById('line-core')!;
      const glow = document.getElementById('line-glow')!;
      const areaKept = document.getElementById('area-kept')!;
      const setLine = (a: [number, number][]) => {
        const d = toPath(a);
        core.setAttribute('d', d);
        glow.setAttribute('d', d);
      };
      setLine(FLAT);
      areaKept.setAttribute('d', toPath(KEEP) + ' L1000,340 L0,340 Z');

      /** Morph proxy — one tween per shape change */
      const morph = (from: [number, number][], to: [number, number][]) => {
        const proxy = { t: 0 };
        return gsap.to(proxy, {
          t: 1,
          ease: 'none',
          onUpdate: () => setLine(lerpPts(from, to, proxy.t)),
        });
      };

      /* ── Line draw-in (dash) ── */
      const drawLen = 1400;
      core.setAttribute('stroke-dasharray', String(drawLen));
      core.setAttribute('stroke-dashoffset', String(drawLen));
      glow.setAttribute('stroke-dasharray', String(drawLen));
      glow.setAttribute('stroke-dashoffset', String(drawLen));

      /* ── Question char scatter targets (seeded by index — stable) ── */
      const chars = gsap.utils.toArray<HTMLElement>('.q-char');
      const seeded = (i: number, s: number) => {
        const x = Math.sin(i * 127.1 + s * 311.7) * 43758.5453;
        return x - Math.floor(x);
      };

      /* GA4: which chapters were actually seen (fires once each) */
      const fired = new Set<string>();
      const mark = (n: string) => {
        if (!fired.has(n)) {
          fired.add(n);
          ga('story_chapter', { chapter: n });
        }
      };

      /* Dark theme: the dawn grades into the dark product surface instead of paper */
      const isDark = html.getAttribute('data-theme') === 'dark';
      const bgFinal = getComputedStyle(html).getPropertyValue('--color-bg').trim() || (isDark ? '#121418' : '#FCFCFA');
      const dawnMid1 = isDark ? '#26211E' : '#2E2724';
      const dawnMid2 = isDark ? '#1A1B1E' : '#EFE9E1';
      const tealFinal = getComputedStyle(html).getPropertyValue('--color-primary-600').trim() || '#0B6E6E';

      /* ── Master timeline, scrubbed over the track ── */
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: '#track',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 1.1,
        },
      });

      /* Act 0 hold (0–6) — CSS pulse carries it */
      tl.to({}, { duration: 6 });

      /* Act 1: dissolution (6–16) — chars scatter down-stage, line draws */
      tl.to(chars, {
        duration: 8,
        x: (i) => (seeded(i, 1) - 0.5) * 340,
        y: (i) => 120 + seeded(i, 2) * 260,
        rotation: (i) => (seeded(i, 3) - 0.5) * 50,
        opacity: 0,
        ease: 'power2.inOut',
        stagger: { each: 0.07, from: 'random' },
      }, 6);
      tl.to(['#question-sub', '#scroll-cue'], { duration: 4, opacity: 0, y: -30 }, 6);
      tl.to(['#line-core', '#line-glow'], { duration: 3, opacity: 1 }, 9);
      tl.to(['#line-core', '#line-glow'], { duration: 6, strokeDashoffset: 0, ease: 'power1.inOut' }, 9);

      /* Chapter machinery */
      const chapterIn = (id: string, at: number) => {
        tl.to(`#wash-${id}`, { duration: 5, opacity: 1, ease: 'sine.inOut' }, at - 1);
        tl.to(`#chapter-${id}`, { duration: 0.6, opacity: 1, visibility: 'visible' }, at);
        tl.fromTo(`#chapter-${id} .chapter-index`, { opacity: 0 }, { duration: 4, opacity: 1, ease: 'sine.out' }, at);
        tl.to(`#chapter-${id} .mask-inner`, { duration: 3.6, y: 0, ease: 'power3.out', stagger: 0.45 }, at + 0.5);
        tl.to(`#chapter-${id} .figure-row`, { duration: 3, y: 0, opacity: 1, ease: 'power3.out', stagger: 0.6 }, at + 1.8);
        tl.add(() => {
          document.getElementById(`chapter-${id}`)?.classList.add('active');
          mark(id);
        }, at + 1);
      };
      const chapterOut = (id: string, at: number) => {
        tl.add(() => document.getElementById(`chapter-${id}`)?.classList.remove('active'), at);
        tl.to(`#chapter-${id} .mask-inner`, { duration: 2.4, y: '-112%', ease: 'power2.in', stagger: 0.18 }, at);
        tl.to(`#chapter-${id} .figure-row`, { duration: 2.4, y: -20, opacity: 0, ease: 'power2.in', stagger: 0.18 }, at);
        tl.to(`#chapter-${id} .chapter-index`, { duration: 2.4, opacity: 0, ease: 'sine.in' }, at);
        tl.to(`#chapter-${id}`, { duration: 0.5, opacity: 0, visibility: 'hidden' }, at + 2.6);
        tl.to(`#wash-${id}`, { duration: 4.5, opacity: 0, ease: 'sine.inOut' }, at + 0.8);
      };

      /* GROW (16–30) */
      tl.add(morph(FLAT, GROW).duration(6), 15);
      chapterIn('grow', 17);
      chapterOut('grow', 28);

      /* KEEP (30–44) — area fill rises under the income line */
      tl.add(morph(GROW, KEEP).duration(6), 29);
      tl.to('#area-kept', { duration: 3, opacity: 1 }, 32.5);
      chapterIn('keep', 31);
      tl.to('#area-kept', { duration: 2, opacity: 0 }, 42);
      chapterOut('keep', 42);

      /* OWE (44–58) */
      tl.add(morph(KEEP, OWE).duration(6), 43);
      chapterIn('owe', 45);
      chapterOut('owe', 56);

      /* DAWN (58–74): line flattens to a hairline; obsidian grades through a
         warm horizon into the product surface — no scroll position parks on
         flat grey */
      tl.add(morph(OWE, HAIR).duration(6), 57);
      tl.to(['#line-glow'], { duration: 4, opacity: 0 }, 60);
      tl.to(['#line-core'], { duration: 6, stroke: tealFinal, opacity: 0.5 }, 60);
      tl.to(document.body, { duration: 4.5, backgroundColor: dawnMid1, ease: 'power1.in' }, 60);
      tl.to(document.body, { duration: 3.5, backgroundColor: dawnMid2, ease: 'none' }, 64.5);
      tl.to(document.body, { duration: 3, backgroundColor: bgFinal, ease: 'power1.out' }, 68);
      tl.to('#dawn-glow', { duration: 5, opacity: 0.6, ease: 'sine.in' }, 61);
      tl.to('#dawn-glow', { duration: 4.5, opacity: 0, ease: 'sine.out' }, 66.5);
      tl.to({}, { duration: 3.5 }); // hold through the dawn settle

      /* Header flip that works in both scroll directions. In dark theme the
         dawn stays dark, so the header keeps its night styling throughout. */
      if (!isDark) {
        ScrollTrigger.create({
          trigger: '#track',
          start: '93% bottom',
          onEnter: () => document.getElementById('story-header')?.classList.add('light'),
          onLeaveBack: () => document.getElementById('story-header')?.classList.remove('light'),
        });
      }

      /* ── The baton pass: the fixed "Run your numbers" hint travels into the
         static daylight heading of the same words, tracking its live position
         every frame, then swaps with it. Scrubbed — reverses cleanly. ── */
      const hint = document.getElementById('dawn-hint')!;
      const batonTarget = document.getElementById('daylight-title')!;
      gsap.set(hint, { xPercent: -50, yPercent: -50 });
      gsap.set(batonTarget, { opacity: 0 });

      /* Hint fade-in owns its own scrubbed trigger (NOT the master timeline —
         the timeline's scrub smoothing would re-write opacity after the baton
         trigger hides it on fast scrolls, leaving a ghost over the daylight) */
      gsap.fromTo(hint, { opacity: 0 }, {
        opacity: 1,
        ease: 'none',
        scrollTrigger: { trigger: '#track', start: '86% bottom', end: '92% bottom', scrub: true },
      });

      const hintColor = getComputedStyle(hint).color;
      const inkFinal = getComputedStyle(batonTarget).color;
      const inkMix = gsap.utils.interpolate(hintColor, inkFinal);
      let hintBase: DOMRect | null = null;

      ScrollTrigger.create({
        trigger: batonTarget,
        start: 'top bottom',
        end: 'top 25%',
        scrub: true,
        invalidateOnRefresh: true,
        onRefresh: () => { hintBase = null; },
        onUpdate: (self) => {
          const t = self.progress;
          if (!hintBase) {
            gsap.set(hint, { x: 0, y: 0, scale: 1 });
            hintBase = hint.getBoundingClientRect();
          }
          const tr = batonTarget.getBoundingClientRect();
          const scaleTarget = tr.height / hintBase.height;
          const dx = tr.left + tr.width / 2 - (hintBase.left + hintBase.width / 2);
          const dy = tr.top + tr.height / 2 - (hintBase.top + hintBase.height / 2);
          const eased = gsap.parseEase('power2.inOut')(t);
          if (t >= 0.985) {
            gsap.set(batonTarget, { opacity: 1 });
            gsap.set(hint, { opacity: 0 });
          } else {
            gsap.set(batonTarget, { opacity: 0 });
            gsap.set(hint, {
              x: dx * eased,
              y: dy * eased,
              scale: 1 + (scaleTarget - 1) * eased,
              color: inkMix(eased),
              opacity: 1,
            });
          }
        },
        onLeave: () => {
          gsap.set(batonTarget, { opacity: 1 });
          gsap.set(hint, { opacity: 0 });
        },
      });

      /* Real site navigation takes over in daylight; the story header bows out
         the moment daylight first peeks over the fold — one brand header on
         screen at any scroll position, never two */
      ScrollTrigger.create({
        trigger: '#daylight',
        start: 'top bottom',
        onEnter: () => {
          document.getElementById('story-header')?.classList.add('gone');
          mark('daylight');
        },
        onLeaveBack: () => document.getElementById('story-header')?.classList.remove('gone'),
      });

      /* Gentle chapter snapping — desktop pointers only (?nosnap disables for QA) */
      if (window.matchMedia('(pointer: fine)').matches && !location.search.includes('nosnap')) {
        const total = tl.duration();
        ScrollTrigger.create({
          trigger: '#track',
          start: 'top top',
          end: 'bottom bottom',
          snap: {
            snapTo: [0, 22 / total, 36 / total, 50 / total, 1],
            duration: { min: 0.4, max: 0.9 },
            ease: 'power3.inOut',
            delay: 0.15,
          },
        });
      }

      /* Skip pill: jump straight to the daylight product (native anchor as fallback) */
      document.getElementById('story-skip')?.addEventListener('click', (e) => {
        e.preventDefault();
        const daylight = document.getElementById('daylight');
        if (daylight) {
          window.scrollTo({ top: daylight.getBoundingClientRect().top + window.scrollY, behavior: 'instant' as ScrollBehavior });
        }
        ga('story_skip');
      });
    }

    /* ── Daylight choreography: reveals, masked titles, count-ups ── */
    if (!reduced) {
      const fmtInt = (v: number) => Math.round(v).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',');

      gsap.set('.reveal', { opacity: 0, y: 26 });
      gsap.set('.d-mask-inner', { yPercent: 112 });

      /* Per-element triggers with a rAF micro-queue for the stagger.
         (ScrollTrigger.batch stopped firing for later elements on this page
         once some reveals fired at load — create() is reliable.) */
      let revealQueue: HTMLElement[] = [];
      let revealFlushScheduled = false;
      const flushReveals = () => {
        gsap.to(revealQueue, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08 });
        revealQueue = [];
        revealFlushScheduled = false;
      };
      gsap.utils.toArray<HTMLElement>('.reveal').forEach((el) => {
        ScrollTrigger.create({
          trigger: el,
          start: 'top 88%',
          once: true,
          onEnter: () => {
            revealQueue.push(el);
            if (!revealFlushScheduled) {
              revealFlushScheduled = true;
              requestAnimationFrame(flushReveals);
            }
          },
        });
      });

      gsap.utils.toArray<HTMLElement>('.d-mask-inner').forEach((el) => {
        ScrollTrigger.create({
          trigger: el,
          start: 'top 88%',
          once: true,
          onEnter: () => gsap.to(el, { yPercent: 0, duration: 1.05, ease: 'power4.out' }),
        });
      });

      gsap.utils.toArray<HTMLElement>('.decision-a').forEach((el) => {
        const target = parseFloat(el.dataset.count || '0');
        if (!target) return;
        const pre = el.dataset.pre || '';
        const suf = el.dataset.suf || '';
        ScrollTrigger.create({
          trigger: el,
          start: 'top 92%',
          once: true,
          onEnter: () => {
            const proxy = { v: 0 };
            gsap.to(proxy, {
              v: target,
              duration: 1.3,
              ease: 'power2.out',
              onUpdate: () => { el.textContent = pre + fmtInt(proxy.v) + suf; },
            });
          },
        });
      });
    }

    /* ── Replay: clear the session flag and start the theater from the top ── */
    document.getElementById('replay-intro')?.addEventListener('click', () => {
      try { sessionStorage.removeItem('calcrun.introSeen'); } catch { /* storage blocked — reload alone still replays */ }
      ga('story_replay');
      // Without this the browser restores the pre-reload scroll position and
      // the theater reopens mid-track instead of at the question
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      location.reload();
    });
    // Hand scroll restoration back to the browser for normal navigation
    if ('scrollRestoration' in history && history.scrollRestoration === 'manual') {
      history.scrollRestoration = 'auto';
    }
  </script>
</BaseLayout>
