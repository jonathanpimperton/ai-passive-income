  <style is:global>
    /* ════ Every mode: the hero. Default (no class, no JS, returning visitor,
       reduced motion) is the compact light hero; html.intro-play below turns
       the same markup into the theater. ════ */
    .track { position: relative; }
    .stage { position: relative; }
    .wash,
    .line-stage,
    .scroll-cue,
    .stage-skip,
    .chapter,
    .dawn-hint { display: none; }

    .act-0 {
      padding: clamp(40px, 7vh, 72px) 24px 4px;
      text-align: center;
    }
    .hero-title { margin: 0; }
    .hero-noun {
      display: block;
      margin-bottom: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--color-neutral-600);
    }
    .question {
      display: block;
      margin: 0 auto;
      max-width: 20ch;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      font-size: clamp(2rem, 4.6vw, 3.2rem);
      letter-spacing: -0.035em;
      line-height: 1.08;
      text-wrap: balance;
      color: var(--color-neutral-900);
    }
    .q-accent .q-char { color: var(--color-primary-600); }
    .q-word { display: inline-block; white-space: nowrap; }
    .q-char { display: inline-block; }
    .question-sub {
      margin: 16px auto 0;
      max-width: 52ch;
      font-size: clamp(1rem, 1.4vw, 1.1rem);
      line-height: 1.55;
      color: var(--color-neutral-600);
    }
    .question-sub .sub-quiet { display: block; margin-top: 4px; font-size: 0.92em; color: var(--color-neutral-600); }

    /* Recently used (returning visitors; space exists only when there is something to show) */
    .hero-recents { display: none; }
    html.intro-seen.has-recents .hero-recents {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 8px 12px;
      margin: 20px auto 0;
      max-width: 720px;
    }
    .hero-recents-label { font-size: 13px; color: var(--color-neutral-600); }
    .hero-recents-list { display: contents; list-style: none; }
    .hero-recents-list a {
      display: inline-block;
      padding: 6px 12px;
      font-size: 14px;
      font-weight: 500;
      color: var(--color-neutral-800);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      text-decoration: none;
      transition: border-color 150ms ease, color 150ms ease;
    }
    .hero-recents-list a:hover { color: var(--color-primary-700); border-color: var(--color-primary-600); }

    .d-replay { display: none; margin: 18px 0 0; }
    html.intro-seen .d-replay { display: block; }
    .d-replay button {
      background: none;
      border: none;
      padding: 6px 8px;
      font: inherit;
      font-size: 13px;
      color: var(--color-neutral-600);
      cursor: pointer;
      transition: color 0.2s ease;
    }
    .d-replay button:hover { color: var(--color-primary-600); }

    /* ════ Intro mode: the theater ════ */
    /* :has(#track) pins this to the homepage even if the bundler ever merges
       this stylesheet into a shared chunk */
    html.intro-play body:has(#track) { background: #0a0b0d; }
    html.intro-play .track { height: 700vh; color: #fcfcfa; }
    html.intro-play .stage {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    /* The real site header stays usable over the theater, in a night tone,
       until the dawn turns the page light (html.intro-day) */
    html.intro-play:not(.intro-day) .site-header {
      background: rgba(10, 11, 13, 0.72);
      border-bottom-color: rgba(255, 255, 255, 0.08);
      box-shadow: none;
    }
    html.intro-play:not(.intro-day) .site-header .logo-word { color: #fcfcfa; }
