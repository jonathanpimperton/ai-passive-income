</style>

<script>
  // ===== Category filter logic =====
  const pills = document.querySelectorAll('.category-pill');
  const cards = document.querySelectorAll('.tool-card');
  const navCards = document.querySelectorAll('.category-nav-card');

  function filterByCategory(category: string) {
    // Update active pill
    pills.forEach((p) => {
      const pillCat = (p as HTMLElement).dataset.category;
      if (pillCat === category || (category === 'all' && pillCat === 'all')) {
        p.classList.add('active');
        p.setAttribute('aria-selected', 'true');
      } else {
        p.classList.remove('active');
        p.setAttribute('aria-selected', 'false');
      }
    });

    // Update active nav card
    navCards.forEach((nc) => {
      const ncCat = (nc as HTMLElement).dataset.categoryCard;
      if (ncCat === category) {
        nc.classList.add('active');
      } else {
        nc.classList.remove('active');
      }
    });

    // Animate filter
    cards.forEach((card) => {
      const cardCategory = (card as HTMLElement).dataset.toolCategory;
      const shouldShow = category === 'all' || cardCategory === category;
      const el = card as HTMLElement;

      if (!shouldShow) {
        el.classList.add('hiding');
        setTimeout(() => { el.classList.add('card-hidden'); }, 200);
      } else {
        el.classList.remove('card-hidden');
        void el.offsetHeight;
        el.classList.remove('hiding');
      }
    });
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const category = (pill as HTMLElement).dataset.category || 'all';
      filterByCategory(category);
    });
  });

  navCards.forEach((nc) => {
    nc.addEventListener('click', () => {
      const category = (nc as HTMLElement).dataset.categoryCard || 'all';
      filterByCategory(category);
      document.getElementById('tools-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // ===== Animated stat counters =====
  const statCounters = document.querySelectorAll('.stat-counter');
  let statsAnimated = false;

  function animateCounter(el: Element) {
    const numberEl = el.querySelector('.stat-number') as HTMLElement;
    const suffixEl = el.querySelector('.stat-suffix') as HTMLElement;
    const target = parseInt((el as HTMLElement).dataset.target || '0', 10);
    const suffix = (el as HTMLElement).dataset.suffix || '';

    if (suffixEl && suffix) {
      suffixEl.textContent = suffix;
    }

    if (target === 0) {
      numberEl.textContent = '0';
      return;
    }

    const duration = 1200;
    const startTime = performance.now();

    function update(currentTime: number) {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(eased * target);
      numberEl.textContent = current.toString();

      if (progress < 1) {
        requestAnimationFrame(update);
      }
    }

    requestAnimationFrame(update);
  }

  const statsObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting && !statsAnimated) {
        statsAnimated = true;
        statCounters.forEach((counter) => animateCounter(counter));
      }
    });
  }, { threshold: 0.5 });

  statCounters.forEach((counter) => statsObserver.observe(counter));

  // ===== Hero word cycling =====
  const heroWord = document.querySelector('.hero-word') as HTMLElement;
  if (heroWord) {
    const words: string[] = JSON.parse(heroWord.dataset.words || '[]');
    let currentIndex = 0;

    setInterval(() => {
      heroWord.classList.add('fade-out');

      setTimeout(() => {
        currentIndex = (currentIndex + 1) % words.length;
        heroWord.textContent = words[currentIndex];
        heroWord.classList.remove('fade-out');
        heroWord.classList.add('fade-in');
        void heroWord.offsetHeight;
        heroWord.classList.remove('fade-in');
      }, 300);
    }, 3000);
  }
</script>
