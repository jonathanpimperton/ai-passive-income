---
/**
 * HOMEPAGE — "The Number Theater" (R2.1, promoted from /labs/story).
 *
 * Scroll-driven cinematic opening: obsidian theater → three data chapters
 * (Grow / Keep / Owe) told by one morphing glowing line → dawn handoff into
 * the light product (live engine, decision board, bento, discovery, close).
 *
 * The theater plays ONCE per browsing session: a pre-paint head script reads
 * sessionStorage and adds `intro-seen` to <html>, which collapses the track so
 * returning navigations land directly in the daylight product. A quiet
 * "Watch the intro again" control clears the flag.
 *
 * All figures are computed at build time by the site's own engines — the
 * story can never drift from what the calculators say. GSAP + ScrollTrigger,
 * scrub-tied to native scroll. prefers-reduced-motion renders every act
 * settled with plain scroll; no-JS collapses to daylight via <noscript>.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Navigation from '@components/ui/Navigation.astro';
import DecisionEngine from '@components/homepage/DecisionEngine.tsx';
import EmailCapture from '@components/ui/EmailCapture.tsx';
import { buildWebsiteSchema } from '@lib/seo';
import { formatNumber, compoundInterest, loanMonthlyPayment, debtPayoff } from '@lib/calculator-utils';
import { calcIncomeTax, calcNI } from '@lib/uk-tax-calc';
import { calcFederalTax, calcFICA } from '@lib/us-tax-calc';
import { calculateSdlt } from '@lib/stamp-duty';
import { UK_TAX_YEAR } from '@lib/uk-rates';
import { US_TAX_YEAR } from '@lib/us-rates';
import { TOOLS, CATEGORIES, getToolPath } from '@lib/tools-data';

const websiteSchema = buildWebsiteSchema();

/* ── Live figures (the story never lies — same engines as the tools) ── */
const grow500x10 = compoundInterest(0, 500, 0.07, 10, 12);
const grow10kPlus200 = compoundInterest(10_000, 200, 0.07, 20, 12);
const grow1000x20 = compoundInterest(0, 1000, 0.07, 20, 12);

const ukTakeHome50k = 50_000 - calcIncomeTax(50_000) - calcNI(50_000);
const usTakeHome100k = 100_000 - calcFederalTax(100_000, 'single') - calcFICA(100_000, 'single').total;
const ukKeptPct = Math.round((ukTakeHome50k / 50_000) * 100);
const sdltFtb450 = calculateSdlt(450_000, 'first-time').totalTax;

const mortgage300k = loanMonthlyPayment(300_000, 0.065, 360);
const mortgage300kLow = loanMonthlyPayment(300_000, 0.055, 360);
const rateSaving = mortgage300kLow ? Math.round(mortgage300k - mortgage300kLow) : 0;
const cardPayoff = debtPayoff([{ name: 'Card', balance: 5000, rate: 0.22, minPayment: 250 }], 0, 'avalanche');

const CHAPTERS = [
  {
    id: 'grow',
    index: '01',
    kicker: '01 — Grow',
    title: 'Grow it.',
    lede: 'What steady monthly amounts become over ten, twenty, forty years.',
    figures: [
      { region: 'UK', label: '£500/mo for 10 yrs', value: `£${formatNumber(Math.round(grow500x10))}`, phrase: false, href: '/scenarios/investment-growth/#500-per-month' },
      { region: 'US', label: '$10,000 + $200/mo for 20 yrs', value: `$${formatNumber(Math.round(grow10kPlus200))}`, phrase: false, href: '/tools/saving-and-growth/compound-interest/' },
      { region: 'UK', label: '£1,000/mo for 20 yrs', value: `£${formatNumber(Math.round(grow1000x20))}`, phrase: false, href: '/tools/saving-and-growth/investment-return/' },
    ],
  },
  {
    id: 'keep',
    index: '02',
    kicker: '02 — Keep',
    title: 'Keep it.',
    lede: 'Tax, National Insurance, deductions — what is actually left, to the pound.',
    figures: [
      { region: 'UK', label: `£50,000 salary — you keep ${ukKeptPct}%`, value: `£${formatNumber(Math.round(ukTakeHome50k / 12))}/mo`, phrase: false, href: '/tools/income-and-planning/salary-uk/' },
      { region: 'US', label: '$100,000 salary, single filer', value: `$${formatNumber(Math.round(usTakeHome100k / 12))}/mo`, phrase: false, href: '/tools/income-and-planning/salary-us/' },
      { region: 'UK', label: 'Stamp duty, £450K first home', value: `£${formatNumber(Math.round(sdltFtb450))}`, phrase: false, href: '/tools/economic/stamp-duty/' },
    ],
  },
  {
    id: 'owe',
    index: '03',
    kicker: '03 — Owe',
    title: 'Owe it.',
    lede: 'What borrowing costs month by month, and what one percent changes.',
    figures: [
      { region: 'US', label: '$300K mortgage at 6.5%, 30 yrs', value: `$${formatNumber(Math.round(mortgage300k))}/mo`, phrase: false, href: '/tools/debt-and-loans/mortgage-payment/' },
      { region: 'UK', label: '£5,000 card at 22%, £250/mo', value: `debt-free in ${cardPayoff.months} mo`, phrase: true, href: '/tools/debt-and-loans/credit-card-payoff/' },
      { region: 'US', label: 'Same mortgage at 5.5% instead', value: `saves $${formatNumber(rateSaving)}/mo`, phrase: true, href: '/tools/debt-and-loans/loan-amortization/' },
    ],
  },
];

/* ── Daylight: decisions priced with their consequences ── */
const start25 = compoundInterest(0, 250, 0.07, 40, 12);
const start35 = compoundInterest(0, 250, 0.07, 30, 12);
const startEarlyDelta = start25 - start35;
const pension100x30 = compoundInterest(0, 100, 0.07, 30, 12);
const mortgageRateTotal = (mortgage300k - mortgage300kLow) * 360;
const ukTax50k = calcIncomeTax(50_000) + calcNI(50_000);
const card150 = debtPayoff([{ name: 'Card', balance: 5000, rate: 0.22, minPayment: 150 }], 0, 'avalanche');
const card250 = debtPayoff([{ name: 'Card', balance: 5000, rate: 0.22, minPayment: 250 }], 0, 'avalanche');
const cardMonthsSooner = card150.months - card250.months;
const wait5 = compoundInterest(0, 500, 0.07, 30, 12) - compoundInterest(0, 500, 0.07, 25, 12);

const DECISIONS = [
  { region: 'UK', q: 'Start investing at 25 instead of 35 — £250 a month at 7%', n: Math.round(startEarlyDelta), pre: '+£', suf: ' by 65', kind: 'gain', href: '/tools/saving-and-growth/compound-interest/' },
  { region: 'UK', q: 'Put £100 more into your pension every month', n: Math.round(pension100x30), pre: '+£', suf: ' after 30 years', kind: 'gain', href: '/tools/income-and-planning/retirement-savings/' },
  { region: 'US', q: 'Negotiate one percent off a $300K mortgage', n: Math.round(mortgageRateTotal), pre: '−$', suf: ' over the loan', kind: 'gain', href: '/tools/debt-and-loans/mortgage-payment/' },
  { region: 'UK', q: 'The taxman’s share of a £50,000 salary', n: Math.round(ukTax50k), pre: '£', suf: ' a year', kind: 'cost', href: '/tools/income-and-planning/salary-uk/' },
  { region: 'UK', q: 'Pay £250/mo on a £5,000 card instead of £150', n: cardMonthsSooner, pre: 'debt-free ', suf: ' months sooner', kind: 'gain', href: '/tools/debt-and-loans/credit-card-payoff/' },
  { region: 'UK', q: 'Wait five years before starting to invest £500/mo', n: Math.round(wait5), pre: '−£', suf: ' at year 30', kind: 'cost', href: '/tools/saving-and-growth/investment-return/' },
];

/* ── Bento: every category, engine-counted, with sample tools ── */
const BENTO_ORDER = ['saving-and-growth', 'debt-and-loans', 'income-and-planning', 'economic', 'utility', 'file-tools'] as const;
const BENTO_META: Record<string, { size: string; tone: string; motif: string }> = {
  'saving-and-growth': { size: 'lg', tone: 'grow', motif: 'growth' },
  'debt-and-loans': { size: 'lg', tone: 'owe', motif: 'decline' },
  'income-and-planning': { size: 'md', tone: 'keep', motif: 'bars' },
  economic: { size: 'md', tone: 'keep', motif: 'steps' },
  utility: { size: 'sm', tone: 'neutral', motif: 'none' },
  'file-tools': { size: 'sm', tone: 'neutral', motif: 'none' },
};
const BENTO = BENTO_ORDER.map((slug) => {
  const cat = CATEGORIES[slug];
  const tools = TOOLS.filter((t) => t.category === slug);
  return {
    slug,
    label: cat.label,
    tagline: cat.tagline,
    count: tools.length,
    samples: tools.slice(0, 3).map((t) => ({ name: t.name.replace(/ Calculator$/, ''), href: getToolPath(t) })),
    ...BENTO_META[slug],
  };
});
const TOOL_COUNT = TOOLS.length;

const QUESTION = 'Get clarity on your financial decisions';
const questionWords = QUESTION.split(' ');

/* ── Discovery: flagship tools, comparisons, precomputed scenario answers ── */
const FLAGSHIP_SLUGS = [
  'mortgage-payment',
  'mortgage-affordability',
  'compound-interest',
  'investment-return',
  'retirement-savings',
  'salary-uk',
  'salary-us',
  'debt-payoff',
  'net-worth',
  'emergency-fund',
];
const flagshipTools = FLAGSHIP_SLUGS
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t): t is NonNullable<typeof t> => t !== undefined);

const FEATURED_COMPARISONS = [
  { title: 'Renting vs Buying in 2026', slug: 'renting-vs-buying-2026' },
  { title: 'Pay Off Debt vs Invest', slug: 'pay-off-debt-vs-invest' },
  { title: 'Roth vs Traditional 401(k)', slug: 'roth-vs-traditional-401k' },
  { title: '15-Year vs 30-Year Mortgage', slug: '15-year-vs-30-year-mortgage' },
  { title: 'Snowball vs Avalanche', slug: 'snowball-vs-avalanche-debt' },
];

const invest1000x20 = compoundInterest(0, 1000, 0.07, 20, 12);
// Phase 3: doorway scenarios consolidated into hub pages — hub entries carry
// row anchors so the link lands on the matching table row.
const FEATURED_SCENARIOS = [
  { title: '£50K salary UK take-home', href: '/scenarios/50k-salary-uk-take-home/', answer: `£${formatNumber(Math.round(ukTakeHome50k / 12))}/mo` },
  { title: '$100K salary after tax', href: '/scenarios/100k-salary-take-home/', answer: `$${formatNumber(Math.round(usTakeHome100k / 12))}/mo` },
  { title: '£500/mo invested for 10 years', href: '/scenarios/investment-growth/#500-per-month', answer: `£${formatNumber(Math.round(grow500x10 / 500) * 500)}` },
  { title: '$300K mortgage at 6.5%', href: '/scenarios/mortgage-payments-by-amount/#300k', answer: `$${formatNumber(Math.round(mortgage300k))}/mo` },
  { title: '$1,000/mo invested for 20 years', href: '/scenarios/investment-growth/#1000-per-month', answer: `$${formatNumber(Math.round(invest1000x20 / 1000) * 1000)}` },
];

/* Server-rendered default mortgage result for the engine skeleton — a real
   answer is visible before React hydrates, never a blank state */
const MORTGAGE_RATE = 0.0675;
const MORTGAGE_TERM_YEARS = 30;
const MORTGAGE_DTI = 0.36;
const defaultIncome = 75000;
const defaultDown = 50000;
const defaultMaxMonthlyPmt = (defaultIncome / 12) * MORTGAGE_DTI;
const defaultTermMonths = MORTGAGE_TERM_YEARS * 12;
const defaultR = MORTGAGE_RATE / 12;
const defaultFactor = (Math.pow(1 + defaultR, defaultTermMonths) - 1) / (defaultR * Math.pow(1 + defaultR, defaultTermMonths));
const defaultMaxLoan = defaultMaxMonthlyPmt * defaultFactor;
const defaultMaxPrice = defaultMaxLoan + defaultDown;
const defaultMortgagePayment = loanMonthlyPayment(defaultMaxLoan, MORTGAGE_RATE, defaultTermMonths);
const defaultLoanPct = ((defaultMaxLoan / defaultMaxPrice) * 100).toFixed(0);
const defaultDownPct = ((defaultDown / defaultMaxPrice) * 100).toFixed(0);
---

<BaseLayout
  title="Financial Calculators & Tools | CalcRun"
  description="Financial calculators with interactive charts and plain-English explanations. Mortgage, salary, compound interest, retirement — no signup, no ads."
  structuredData={[websiteSchema]}
  hideNav
>
  {/* Pre-paint: returning visitors in this session skip straight to daylight */}
  <script is:inline slot="head">
    (function(){try{var k='calcrun.introSeen';if(sessionStorage.getItem(k)==='1'){document.documentElement.classList.add('intro-seen');}sessionStorage.setItem(k,'1');}catch(e){}})();
  </script>
  {/* No JS: collapse the theater — the daylight product is the page */}
  <noscript slot="head">
    <style>
      .story-header, .track, .dawn-hint { display: none !important; }
      body { background: var(--color-bg) !important; }
    </style>
  </noscript>

  {/* ── Floating minimal header — present from frame 0 ─────────── */}
  <header class="story-header" id="story-header">
    <a href="/" class="story-wordmark" aria-label="CalcRun home">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
        <rect x="1" y="1" width="22" height="22" rx="6" fill="#0B6E6E" />
        <path d="M6 15.5 L10.5 11 L13.5 13.5 L18 8.5" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M18 8.5 h-3.2 M18 8.5 v3.2" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" />
      </svg>
      <span>Calc<em>Run</em></span>
    </a>
    <a href="#daylight" class="story-skip" id="story-skip">Skip to the calculators →</a>
  </header>

  {/* ── The theater: 700vh scroll track driving a sticky stage ── */}
  <div class="track" id="track">
    <div class="stage">

      {/* Chapter washes (parallax layer) */}
      <div class="wash" id="wash-grow"></div>
      <div class="wash" id="wash-keep"></div>
      <div class="wash" id="wash-owe"></div>
      {/* Warm horizon glow — keeps the dawn transit atmospheric, never flat grey */}
      <div class="wash dawn-glow" id="dawn-glow"></div>

      {/* The data line */}
      <svg class="line-stage" id="line-stage" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <filter id="glow" x="-20%" y="-50%" width="140%" height="200%">
            <feGaussianBlur stdDeviation="7" />
          </filter>
          <linearGradient id="kept-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#38AEAE" stop-opacity="0.16" />
            <stop offset="1" stop-color="#38AEAE" stop-opacity="0.02" />
          </linearGradient>
        </defs>
        <path id="area-kept" d="" fill="url(#kept-fill)" opacity="0" />
        <path id="line-glow" d="" fill="none" stroke="#38AEAE" stroke-width="7" opacity="0" filter="url(#glow)" />
        <path id="line-core" d="" fill="none" stroke="#5FD3D3" stroke-width="2" opacity="0" vector-effect="non-scaling-stroke" />
      </svg>

      {/* Act 0 — the question */}
      <section class="act act-0" id="act-0" aria-label="Introduction">
        {/* Word spans on one template line with explicit string spaces between
            them — any extra markup inside the h1 shows up as doubled word gaps.
            aria-label carries the sentence; char spans are hidden from SRs. */}
        <h1 class="question" id="question" aria-label={QUESTION}>
          <span aria-hidden="true">{questionWords.map((word, wi) => (
            <Fragment><span class={word === 'clarity' ? 'q-word q-accent' : 'q-word'}>{word.split('').map((ch) => <span class="q-char" data-wi={wi}>{ch}</span>)}</span>{wi < questionWords.length - 1 ? ' ' : ''}</Fragment>
          ))}</span>
        </h1>
        <p class="question-sub" id="question-sub">
          CalcRun — salary, mortgage, investing and debt calculators.
          <span class="sub-quiet">Answers in seconds. No signup. No ads.</span>
        </p>
        <div class="scroll-cue" id="scroll-cue" aria-hidden="true">
          <span class="cue-line"></span>
          <span class="cue-label">scroll</span>
        </div>
      </section>

      {/* Chapters */}
      {CHAPTERS.map((c) => (
        <section class={`act chapter chapter-${c.id}`} id={`chapter-${c.id}`} aria-label={c.title}>
          <span class="chapter-index" aria-hidden="true">{c.index}</span>
          <div class="chapter-copy">
            <p class="kicker"><span class="mask"><span class="mask-inner">{c.kicker}</span></span></p>
            <h2 class="chapter-title"><span class="mask"><span class="mask-inner">{c.title}</span></span></h2>
            <p class="chapter-lede"><span class="mask"><span class="mask-inner">{c.lede}</span></span></p>
          </div>
          <div class="chapter-figures">
            {c.figures.map((f) => (
              <a class="figure-row" href={f.href}>
                <span class="figure-label"><span class="figure-region" aria-hidden="true">{f.region}</span>{f.label}</span>
                <span class={`figure-value tabular-nums${f.phrase ? ' is-phrase' : ''}`}>{f.value}<span class="figure-arrow" aria-hidden="true"> →</span></span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <p class="dawn-hint" id="dawn-hint" aria-hidden="true">Run your numbers</p>

  {/* ── DAYLIGHT — the instrument room: same standard, full utility ── */}
  <div class="daylight" id="daylight">
    {/* The real site navigation takes over from the story header here */}
    <Navigation />

    {/* D1 — the live instrument */}
    <section class="d-section d-engine">
      <div class="d-inner">
        <p class="d-kicker reveal">Your turn</p>
        <h2 class="d-title" id="daylight-title">Run your numbers</h2>
        <p class="d-sub reveal">The same questions, live — answers as you type. No signup, no ads.</p>
        <div class="d-engine-wrap reveal">
          {/* Server-rendered skeleton with a real computed answer — replaced by React on hydrate */}
          <div id="engine-skeleton">
            <div class="hidden lg:grid lg:grid-cols-[320px_1fr] lg:gap-6">
              <div>
                <div class="w-full text-left px-5 py-5 border-l-[4px] border-l-primary-500 font-bold text-neutral-900">
                  <span class="text-xl leading-relaxed">Can I actually afford this house?</span>
                </div>
                <div class="w-full text-left px-5 py-5 border-l-[4px] border-l-transparent font-medium text-neutral-800">
                  <span class="text-xl leading-relaxed">What does $500/mo grow into?</span>
                </div>
                <div class="w-full text-left px-5 py-5 border-l-[4px] border-l-transparent font-medium text-neutral-800">
                  <span class="text-xl leading-relaxed">When can I retire?</span>
                </div>
                <div class="w-full text-left px-5 py-5 border-l-[4px] border-l-transparent font-medium text-neutral-800">
                  <span class="text-xl leading-relaxed">What's my take-home pay?</span>
                </div>
              </div>

              <div class="engine-panel rounded-xl p-6 sm:p-8">
                <div class="space-y-5">
                  <div class="space-y-3">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <p class="text-sm text-neutral-500 mb-1">You could afford up to</p>
                        <p class="text-2xl sm:text-4xl lg:text-5xl font-bold tabular-nums lining-nums result-number whitespace-nowrap">
                          ${formatNumber(Math.round(defaultMaxPrice))}
                        </p>
                      </div>
                      <a
                        href="/tools/debt-and-loans/mortgage-affordability/"
                        class="shrink-0 inline-flex items-center gap-1.5 text-sm font-semibold text-white bg-primary-600 hover:bg-primary-700 px-4 py-2.5 rounded-lg transition-all duration-150"
                      >
                        Open full calculator
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                      </a>
                    </div>
                    <p class="text-sm text-neutral-500">
                      ${formatNumber(Math.round(defaultMortgagePayment))}/mo at {(MORTGAGE_RATE * 100).toFixed(2)}% over {MORTGAGE_TERM_YEARS} years
                    </p>
                    <div>
                      <div class="flex gap-[3px] h-4 rounded-full overflow-hidden">
                        <div class="rounded-l-full bg-primary-500" style={`width:${defaultLoanPct}%`}></div>
                        <div class="rounded-r-full bg-neutral-300" style={`width:${defaultDownPct}%`}></div>
                      </div>
                      <div class="flex justify-between mt-1.5">
                        <span class="text-xs text-neutral-500">Loan {defaultLoanPct}%</span>
                        <span class="text-xs text-neutral-500">Down payment {defaultDownPct}%</span>
                      </div>
                    </div>
                  </div>

                  <div class="h-px bg-neutral-200/80"></div>

                  <div class="space-y-3">
                    <div>
                      <div class="text-sm font-medium text-neutral-700 mb-1.5">Annual income</div>
                      <div class="shimmer-line h-11 rounded-lg"></div>
                      <div class="shimmer-line h-2 rounded-full mt-2.5"></div>
                    </div>
                    <div>
                      <div class="text-sm font-medium text-neutral-700 mb-1.5">Down payment</div>
                      <div class="shimmer-line h-11 rounded-lg"></div>
                      <div class="shimmer-line h-2 rounded-full mt-2.5"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            {/* Mobile skeleton: first accordion open — mortgage */}
            <div class="lg:hidden space-y-3">
              <div class="rounded-xl overflow-hidden border border-neutral-200/80">
                <div class="w-full text-left px-5 py-4 flex items-center justify-between bg-primary-50 font-semibold text-neutral-900">
                  <span class="text-[15px] font-medium leading-snug">Can I actually afford this house?</span>
                  <svg class="w-5 h-5 shrink-0 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </div>
                <div class="engine-panel p-5 border-t border-neutral-100">
                  <div class="space-y-3">
                    <div>
                      <p class="text-sm text-neutral-500 mb-1">You could afford up to</p>
                      <p class="text-2xl sm:text-3xl font-bold tabular-nums lining-nums result-number whitespace-nowrap">
                        ${formatNumber(Math.round(defaultMaxPrice))}
                      </p>
                    </div>
                    <p class="text-sm text-neutral-500">
                      ${formatNumber(Math.round(defaultMortgagePayment))}/mo at {(MORTGAGE_RATE * 100).toFixed(2)}%
                    </p>
                  </div>
                </div>
              </div>
              <div class="rounded-xl border border-neutral-200/80 px-5 py-4 text-neutral-600 text-[15px] font-medium">What does $500/mo grow into?</div>
              <div class="rounded-xl border border-neutral-200/80 px-5 py-4 text-neutral-600 text-[15px] font-medium">When can I retire?</div>
              <div class="rounded-xl border border-neutral-200/80 px-5 py-4 text-neutral-600 text-[15px] font-medium">What's my take-home pay?</div>
            </div>
          </div>

          <DecisionEngine client:idle />
        </div>
      </div>
    </section>

    {/* D2 — decisions, priced */}
    <section class="d-section d-board">
      <div class="d-inner d-inner-narrow">
        <p class="d-kicker reveal">Live calculations</p>
        <h2 class="d-title d-title-sm"><span class="d-mask"><span class="d-mask-inner">Good financial decisions create value</span></span></h2>
        <p class="d-sub reveal">Every number below comes from a CalcRun calculator. Open one and run your own.</p>
        <ul class="decision-rows">
          {DECISIONS.map((d) => (
            <li>
              <a class={`decision-row reveal kind-${d.kind}`} href={d.href}>
                <span class="decision-q"><span class="d-region" aria-hidden="true">{d.region}</span>{d.q}</span>
                <span class="decision-a tabular-nums" data-count={d.n} data-pre={d.pre} data-suf={d.suf}>{d.pre}{formatNumber(d.n)}{d.suf}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* D2.5 — every category, bento */}
    <section class="d-section d-bento">
      <div class="d-inner">
        <p class="d-kicker reveal">The full toolkit</p>
        <h2 class="d-title d-title-sm"><span class="d-mask"><span class="d-mask-inner">Every corner of your money</span></span></h2>
        <div class="bento">
