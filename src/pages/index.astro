    html.intro-play:not(.intro-day) .site-header .search-toggle,
    html.intro-play:not(.intro-day) .site-header .menu-btn,
    html.intro-play:not(.intro-day) .site-header .nojs-menu-link { color: #c9ced6; }
    html.intro-play:not(.intro-day) .site-header .nav-trigger:hover,
    html.intro-play:not(.intro-day) .site-header .nav-link:hover,
    html.intro-play:not(.intro-day) .site-header .nav-item.is-open .nav-trigger,
    html.intro-play:not(.intro-day) .site-header .theme-toggle:hover,
    html.intro-play:not(.intro-day) .site-header .search-toggle:hover,
    html.intro-play:not(.intro-day) .site-header .menu-btn:hover { color: #ffffff; background: rgba(255, 255, 255, 0.08); }
    @media (min-width: 1024px) {
      html.intro-play:not(.intro-day) .site-header .search-input {
        color: #fcfcfa;
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.18);
      }
      html.intro-play:not(.intro-day) .site-header .search-input::placeholder { color: #a3abb7; }
      html.intro-play:not(.intro-day) .site-header .search-field-icon { color: #a3abb7; }
    }

    html.intro-play .wash {
      display: block;
      position: absolute;
      inset: -20% 0;
      opacity: 0;
      pointer-events: none;
    }
    #wash-grow { background: radial-gradient(90% 70% at 30% 85%, rgba(24, 138, 96, 0.22), transparent 70%); }
    #wash-keep { background: radial-gradient(90% 70% at 70% 80%, rgba(56, 174, 174, 0.20), transparent 70%); }
    #wash-owe  { background: radial-gradient(90% 70% at 35% 80%, rgba(200, 74, 48, 0.17), transparent 70%); }
    .dawn-glow {
      background: radial-gradient(110% 58% at 50% 64%, rgba(232, 96, 76, 0.20), rgba(240, 138, 112, 0.06) 52%, transparent 76%);
    }

    html.intro-play .line-stage {
      display: block;
      position: absolute;
      inset: 12% 0 8% 0;
      width: 100%;
      height: 80%;
      pointer-events: none;
    }

    html.intro-play .act {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 88px 24px 24px;
      text-align: center;
    }

    html.intro-play .stage-skip {
      display: inline-flex;
      position: absolute;
      top: 80px;
      right: 24px;
      z-index: 5;
      color: #aeb5bf;
      text-decoration: none;
      font-size: 14px;
