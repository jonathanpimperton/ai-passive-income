---
/**
 * HOMEPAGE — "The Number Theater" (R2.1), constrained per plan-2026-11 D2.
 *
 * Scroll-driven cinematic opening: obsidian theater -> three data chapters
 * (Grow / Keep / Owe) told by one morphing line -> dawn handoff into the
 * light product (live engine, decision board, bento, discovery, close).
 *
 * When the intro plays (head gate below, html.intro-play):
 * - once per BROWSER (localStorage via calcrunStore; the old per-session
 *   sessionStorage flag is still honoured), and never for visitors arriving
 *   from another CalcRun page, the installed app (display-mode standalone),
 *   reduced-motion users, embeds or deep links (#...) (HOME-CHROME-01);
 * - reload and Back keep the intro for that history entry (history.state),
 *   so the browser restores scroll into the same layout (HOME-CHROME-03);
 *   rotating mid-intro keeps the timeline position (HOME-CHROME-14);
 * - the real site header (menus + search) is visible throughout, in a night
 *   tone over the theater (HOME-CHROME-01);
 * - no scroll snapping (HOME-CHROME-02).
 *
 * Otherwise (html.intro-seen, and with no JavaScript) the theater collapses to
 * a compact light hero holding the same H1 and the product follows directly.
 *
 * Crawlable and accessible (HOME-CHROME-12/15, GROWTH-SEO-01, A11Y-PERF-14,
 * F-21): one noun H1 in the first viewport in every mode; product sections
 * are visible in the server HTML (no opacity reveals); the header sits outside
 * <main> and the skip link jumps past the theater. No user-agent sniffing.
 *
 * All figures are computed at build time by the site's own engines.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import DecisionEngine from '@components/homepage/DecisionEngine.tsx';
import EmailCapture from '@components/ui/EmailCapture.tsx';
import { getCollection } from 'astro:content';
import { buildWebsiteSchema } from '@lib/seo';
import { formatNumber, compoundInterest, loanMonthlyPayment, debtPayoff } from '@lib/calculator-utils';
import { calcIncomeTax, calcNI } from '@lib/uk-tax-calc';
import { calcFederalTax, calcFICA } from '@lib/us-tax-calc';
import { calculateSdlt } from '@lib/stamp-duty';
import { UK_TAX_YEAR } from '@lib/uk-rates';
import { US_TAX_YEAR } from '@lib/us-rates';
import { TOOLS, TOOL_COUNT, CATEGORIES, getToolPath } from '@lib/tools-data';
import { HUBS } from '@lib/search-index';

const websiteSchema = buildWebsiteSchema();

/* ── Live figures (the story never lies — same engines as the tools) ── */
const grow500x10 = compoundInterest(0, 500, 0.07, 10, 12);
const grow10kPlus200 = compoundInterest(10_000, 200, 0.07, 20, 12);
const grow1000x20 = compoundInterest(0, 1000, 0.07, 20, 12);

const ukTakeHome50k = 50_000 - calcIncomeTax(50_000) - calcNI(50_000);
const usTakeHome100k = 100_000 - calcFederalTax(100_000, 'single') - calcFICA(100_000, 'single').total;
const ukKeptPct = Math.round((ukTakeHome50k / 50_000) * 100);
const sdltFtb450 = calculateSdlt(450_000, 'first-time').totalTax;

const mortgage300k = loanMonthlyPayment(300_000, 0.065, 360);
const mortgage300kLow = loanMonthlyPayment(300_000, 0.055, 360);
const rateSaving = mortgage300kLow ? Math.round(mortgage300k - mortgage300kLow) : 0;
const cardPayoff = debtPayoff([{ name: 'Card', balance: 5000, rate: 0.22, minPayment: 250 }], 0, 'avalanche');

const CHAPTERS = [
  {
    id: 'grow',
    index: '01',
    kicker: '01 — Grow',
    title: 'Grow it.',
    lede: 'What steady monthly amounts become over ten, twenty, forty years.',
    figures: [
      { region: 'UK', label: '£500/mo for 10 yrs', value: `£${formatNumber(Math.round(grow500x10))}`, phrase: false, href: '/scenarios/investment-growth/#500-per-month' },
      { region: 'US', label: '$10,000 + $200/mo for 20 yrs', value: `$${formatNumber(Math.round(grow10kPlus200))}`, phrase: false, href: '/tools/saving-and-growth/compound-interest/' },
      { region: 'UK', label: '£1,000/mo for 20 yrs', value: `£${formatNumber(Math.round(grow1000x20))}`, phrase: false, href: '/tools/saving-and-growth/investment-return/' },
    ],
  },
  {
    id: 'keep',
    index: '02',
    kicker: '02 — Keep',
    title: 'Keep it.',
    lede: 'Tax, National Insurance, deductions — what is actually left, to the pound.',
    figures: [
      { region: 'UK', label: `£50,000 salary — you keep ${ukKeptPct}%`, value: `£${formatNumber(Math.round(ukTakeHome50k / 12))}/mo`, phrase: false, href: '/tools/income-and-planning/salary-uk/' },
      { region: 'US', label: '$100,000 salary, single filer', value: `$${formatNumber(Math.round(usTakeHome100k / 12))}/mo`, phrase: false, href: '/tools/income-and-planning/salary-us/' },
      { region: 'UK', label: 'Stamp duty, £450K first home', value: `£${formatNumber(Math.round(sdltFtb450))}`, phrase: false, href: '/tools/economic/stamp-duty/' },
    ],
  },
  {
    id: 'owe',
    index: '03',
    kicker: '03 — Owe',
    title: 'Owe it.',
    lede: 'What borrowing costs month by month, and what one percent changes.',
    figures: [
      { region: 'US', label: '$300K mortgage at 6.5%, 30 yrs', value: `$${formatNumber(Math.round(mortgage300k))}/mo`, phrase: false, href: '/tools/debt-and-loans/mortgage-payment/' },
      { region: 'UK', label: '£5,000 card at 22%, £250/mo', value: `debt-free in ${cardPayoff.months} mo`, phrase: true, href: '/tools/debt-and-loans/credit-card-payoff/' },
      { region: 'US', label: 'Same mortgage at 5.5% instead', value: `saves $${formatNumber(rateSaving)}/mo`, phrase: true, href: '/tools/debt-and-loans/loan-amortization/' },
    ],
  },
];

/* ── Daylight: decisions priced with their consequences ── */
const start25 = compoundInterest(0, 250, 0.07, 40, 12);
const start35 = compoundInterest(0, 250, 0.07, 30, 12);
const startEarlyDelta = start25 - start35;
const pension100x30 = compoundInterest(0, 100, 0.07, 30, 12);
const mortgageRateTotal = (mortgage300k - mortgage300kLow) * 360;
const ukTax50k = calcIncomeTax(50_000) + calcNI(50_000);
const card150 = debtPayoff([{ name: 'Card', balance: 5000, rate: 0.22, minPayment: 150 }], 0, 'avalanche');
const card250 = debtPayoff([{ name: 'Card', balance: 5000, rate: 0.22, minPayment: 250 }], 0, 'avalanche');
const cardMonthsSooner = card150.months - card250.months;
const wait5 = compoundInterest(0, 500, 0.07, 30, 12) - compoundInterest(0, 500, 0.07, 25, 12);

const DECISIONS = [
  { region: 'UK', q: 'Start investing at 25 instead of 35 — £250 a month at 7%', n: Math.round(startEarlyDelta), pre: '+£', suf: ' by 65', kind: 'gain', href: '/tools/saving-and-growth/compound-interest/' },
  { region: 'UK', q: 'Put £100 more into your pension every month', n: Math.round(pension100x30), pre: '+£', suf: ' after 30 years', kind: 'gain', href: '/tools/income-and-planning/retirement-savings/' },
  { region: 'US', q: 'Negotiate one percent off a $300K mortgage', n: Math.round(mortgageRateTotal), pre: '−$', suf: ' over the loan', kind: 'gain', href: '/tools/debt-and-loans/mortgage-payment/' },
  { region: 'UK', q: 'The taxman’s share of a £50,000 salary', n: Math.round(ukTax50k), pre: '£', suf: ' a year', kind: 'cost', href: '/tools/income-and-planning/salary-uk/' },
  { region: 'UK', q: 'Pay £250/mo on a £5,000 card instead of £150', n: cardMonthsSooner, pre: 'debt-free ', suf: ' months sooner', kind: 'gain', href: '/tools/debt-and-loans/credit-card-payoff/' },
  { region: 'UK', q: 'Wait five years before starting to invest £500/mo', n: Math.round(wait5), pre: '−£', suf: ' at year 30', kind: 'cost', href: '/tools/saving-and-growth/investment-return/' },
];

/* ── Bento: every category, engine-counted, with sample tools ── */
const BENTO_ORDER = ['saving-and-growth', 'debt-and-loans', 'income-and-planning', 'economic', 'utility', 'file-tools'] as const;
const BENTO_META: Record<string, { size: string; tone: string; motif: string }> = {
  'saving-and-growth': { size: 'lg', tone: 'grow', motif: 'growth' },
  'debt-and-loans': { size: 'lg', tone: 'owe', motif: 'decline' },
  'income-and-planning': { size: 'md', tone: 'keep', motif: 'bars' },
  economic: { size: 'md', tone: 'keep', motif: 'steps' },
  utility: { size: 'sm', tone: 'neutral', motif: 'none' },
  'file-tools': { size: 'sm', tone: 'neutral', motif: 'none' },
};
const BENTO = BENTO_ORDER.map((slug) => {
  const cat = CATEGORIES[slug];
  const tools = TOOLS.filter((t) => t.category === slug);
  return {
    slug,
    label: cat.label,
    tagline: cat.tagline,
    count: tools.length,
    samples: tools.slice(0, 3).map((t) => ({ name: t.name.replace(/ Calculator$/, ''), href: getToolPath(t) })),
    ...BENTO_META[slug],
  };
});

/* ── Hero: the noun says what the site is; the question is the signature ── */
const HERO_NOUN = 'UK & US money calculators';
const QUESTION = 'Get clarity on your financial decisions';
const H1_LABEL = `UK and US money calculators: ${QUESTION.toLowerCase()}`;
const questionWords = QUESTION.split(' ');

/* ── Discovery: flagship tools, comparisons, precomputed scenario answers ── */
const FLAGSHIP_SLUGS = [
  'salary-uk',
  'salary-us',
  'mortgage-payment',
  'mortgage-affordability',
  'compound-interest',
  'investment-return',
  'retirement-savings',
  'debt-payoff',
  'net-worth',
  'emergency-fund',
];
const flagshipTools = FLAGSHIP_SLUGS
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t): t is NonNullable<typeof t> => t !== undefined);

// UK and US articles side by side (HOME-CHROME-10); region shown, not implied
const FEATURED_COMPARISONS = [
  { title: 'Pension vs ISA', slug: 'pension-vs-isa-uk', region: 'UK' },
  { title: 'Renting vs Buying', slug: 'renting-vs-buying-2026', region: '' },
  { title: 'Roth vs Traditional 401(k)', slug: 'roth-vs-traditional-401k', region: 'US' },
  { title: 'Cash ISA vs Savings Account', slug: 'cash-isa-vs-savings-account', region: 'UK' },
  { title: 'Pay Off Debt vs Invest', slug: 'pay-off-debt-vs-invest', region: '' },
  { title: '15-Year vs 30-Year Mortgage', slug: '15-year-vs-30-year-mortgage', region: '' },
];

const invest1000x20 = compoundInterest(0, 1000, 0.07, 20, 12);
// Phase 3: doorway scenarios consolidated into hub pages — hub entries carry
// row anchors so the link lands on the matching table row.
const FEATURED_SCENARIOS = [
  { title: '£50K salary UK take-home', href: '/scenarios/50k-salary-uk-take-home/', answer: `£${formatNumber(Math.round(ukTakeHome50k / 12))}/mo` },
  { title: '$100K salary after tax', href: '/scenarios/100k-salary-take-home/', answer: `$${formatNumber(Math.round(usTakeHome100k / 12))}/mo` },
  { title: '£500/mo invested for 10 years', href: '/scenarios/investment-growth/#500-per-month', answer: `£${formatNumber(Math.round(grow500x10 / 500) * 500)}` },
  { title: '$300K mortgage at 6.5%', href: '/scenarios/mortgage-payments-by-amount/#300k', answer: `$${formatNumber(Math.round(mortgage300k))}/mo` },
  { title: '$1,000/mo invested for 20 years', href: '/scenarios/investment-growth/#1000-per-month', answer: `$${formatNumber(Math.round(invest1000x20 / 1000) * 1000)}` },
];

// Counted, never typed (HOME-CHROME-16): scenario pages + the hub tables
// (HUBS is cross-checked against the hub pages by search-index.test.ts)
const scenarioDocs = await getCollection('scenarios');
const SCENARIO_PAGE_COUNT = scenarioDocs.length + Object.keys(HUBS).length;

// "Recently used" return hook: slug -> name/path for the inline renderer
const RECENT_TOOL_MAP = Object.fromEntries(TOOLS.map((t) => [t.slug, [t.name.replace(/ Calculator$/, ''), getToolPath(t)]]));
---

<BaseLayout
  title="CalcRun: UK & US Money Calculators - Salary, Mortgage, Tax"
  description="Salary, mortgage, compound interest, retirement and tax calculators for the UK and US, with charts and plain-English explanations. No signup, no ads."
  structuredData={[websiteSchema]}
  skipTo="daylight"
  skipLabel="Skip to the calculators"
>
  {/* Pre-paint intro gate (plan D2). calcrunStore comes from BaseLayout's boot script. */}
  <script is:inline slot="head">
    (function () {
      var d = document.documentElement;
      var K = 'calcrun.introSeen';
      var st = null;
      try { st = history.state; } catch (e) { st = null; }
      var reduced = false;
      var standalone = false;
      try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) { reduced = false; }
      try { standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true; } catch (e) { standalone = false; }
      var embed = /[?&]embed(?:[=&]|$)/.test(location.search);
      var sameOrigin = false;
      try { sameOrigin = !!document.referrer && new URL(document.referrer).origin === location.origin; } catch (e) { sameOrigin = false; }
      var seen = calcrunStore.get(K) === '1' || calcrunStore.sget(K) === '1';
      // Reload or Back/Forward into an entry that played the intro (or asked to replay it)
      // keeps it, so the browser restores scroll into the same layout. A fresh
      // navigation to "/" (even from "/" itself) does not.
      var navType = '';
      try {
        var navEntry = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        navType = navEntry ? navEntry.type : (performance.navigation && performance.navigation.type === 1 ? 'reload' : performance.navigation && performance.navigation.type === 2 ? 'back_forward' : '');
      } catch (e) { navType = ''; }
      var keep = !!(st && st.calcrunIntro === 1) && (navType === 'reload' || navType === 'back_forward');
      var play = !embed && (keep || (!seen && !sameOrigin && !standalone && !reduced && !location.hash));
      if (play) {
        d.classList.add('intro-play');
        if (reduced) d.classList.add('intro-static');
        calcrunStore.set(K, '1');
        try {
          var next = {};
          if (st && typeof st === 'object') { for (var p in st) { if (Object.prototype.hasOwnProperty.call(st, p)) next[p] = st[p]; } }
          next.calcrunIntro = 1;
          history.replaceState(next, '');
        } catch (e) { /* history unavailable: reload simply shows the product */ }
      } else {
        d.classList.add('intro-seen');
        // A same-URL navigation can carry the old entry's state: drop the intro mark
        if (st && st.calcrunIntro === 1) {
          try {
            var kept = {};
            for (var q in st) { if (q !== 'calcrunIntro' && Object.prototype.hasOwnProperty.call(st, q)) kept[q] = st[q]; }
            history.replaceState(kept, '');
          } catch (e) { /* history unavailable: nothing to clear */ }
        }
        var r = calcrunStore.get('calcrun.recentTools');
        if (r && r.indexOf('"') >= 0) d.classList.add('has-recents');
      }
    })();
  </script>

  {/* ── The theater: a 700vh scroll track driving a sticky stage (intro mode only) ── */}
  <div class="track" id="track">
    <div class="stage">
      <a href="#daylight" class="stage-skip" id="story-skip">Skip to the calculators &rarr;</a>

      {/* Chapter washes (parallax layer) */}
      <div class="wash" id="wash-grow"></div>
      <div class="wash" id="wash-keep"></div>
      <div class="wash" id="wash-owe"></div>
      {/* Warm horizon glow — keeps the dawn transit atmospheric, never flat grey */}
      <div class="wash dawn-glow" id="dawn-glow"></div>

      {/* The data line. Ends fade through the stroke gradient (no CSS mask, no
          blur filter: both re-rasterise every frame — A11Y-PERF-16). */}
      <svg class="line-stage" id="line-stage" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="kept-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#38AEAE" stop-opacity="0.16" />
            <stop offset="1" stop-color="#38AEAE" stop-opacity="0.02" />
          </linearGradient>
          <linearGradient id="line-fade-core" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1000" y2="0">
            <stop class="core-stop" offset="0" stop-color="#5FD3D3" stop-opacity="0" />
            <stop class="core-stop" offset="0.09" stop-color="#5FD3D3" stop-opacity="1" />
            <stop class="core-stop" offset="0.91" stop-color="#5FD3D3" stop-opacity="1" />
            <stop class="core-stop" offset="1" stop-color="#5FD3D3" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="line-fade-glow" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1000" y2="0">
            <stop offset="0" stop-color="#38AEAE" stop-opacity="0" />
            <stop offset="0.09" stop-color="#38AEAE" stop-opacity="0.22" />
            <stop offset="0.91" stop-color="#38AEAE" stop-opacity="0.22" />
            <stop offset="1" stop-color="#38AEAE" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path id="area-kept" d="" fill="url(#kept-fill)" opacity="0" />
        <path id="line-glow" d="" fill="none" stroke="url(#line-fade-glow)" stroke-width="10" stroke-linecap="round" opacity="0" />
        <path id="line-core" d="" fill="none" stroke="url(#line-fade-core)" stroke-width="2" opacity="0" vector-effect="non-scaling-stroke" />
      </svg>

      {/* Act 0 — the hero. Intro mode: the dark full-screen question. Otherwise:
          a compact light hero. One H1 either way. */}
      <section class="act act-0" id="act-0" aria-labelledby="home-title">
        <h1 class="hero-title" id="home-title" aria-label={H1_LABEL}>
          <span class="hero-noun">{HERO_NOUN}</span>
          {/* Word spans on one template line with explicit string spaces between
              them — any extra markup inside shows up as doubled word gaps. */}
          <span class="question" id="question" aria-hidden="true">{questionWords.map((word, wi) => (
            <Fragment><span class={word === 'clarity' ? 'q-word q-accent' : 'q-word'}>{word.split('').map((ch) => <span class="q-char" data-wi={wi}>{ch}</span>)}</span>{wi < questionWords.length - 1 ? ' ' : ''}</Fragment>
          ))}</span>
        </h1>
        <p class="question-sub" id="question-sub">
          Salary, mortgage, savings, tax and debt calculators, built on published UK and US rates.
          <span class="sub-quiet">Answers in seconds. No signup. No ads.</span>
        </p>
        {/* Returning visitors: their recent tools (local to this browser) */}
        <nav class="hero-recents" id="hero-recents" aria-label="Recently used">
          <span class="hero-recents-label">Recently used</span>
          <ul class="hero-recents-list" id="hero-recents-list"></ul>
        </nav>
        <script is:inline define:vars={{ toolMap: RECENT_TOOL_MAP }}>
          (function () {
            var d = document.documentElement;
            if (!d.classList.contains('has-recents')) return;
            var list = document.getElementById('hero-recents-list');
            var slugs = [];
            var store = window.calcrunStore && typeof window.calcrunStore.get === 'function' ? window.calcrunStore : null;
            try { slugs = JSON.parse((store && store.get('calcrun.recentTools')) || '[]'); } catch (e) { slugs = []; }
            if (!Array.isArray(slugs)) slugs = [];
            var n = 0;
            for (var i = 0; i < slugs.length && n < 4; i++) {
              var t = toolMap[slugs[i]];
              if (!t || !list) continue;
              var li = document.createElement('li');
              var a = document.createElement('a');
              a.href = t[1];
              a.textContent = t[0];
              li.appendChild(a);
              list.appendChild(li);
              n++;
            }
            if (!n) d.classList.remove('has-recents');
          })();
        </script>
        <div class="scroll-cue" id="scroll-cue" aria-hidden="true">
          <span class="cue-line"></span>
          <span class="cue-label">scroll</span>
        </div>
      </section>

      {/* Chapters */}
      {CHAPTERS.map((c) => (
        <section class={`act chapter chapter-${c.id}`} id={`chapter-${c.id}`} aria-label={c.title}>
          <span class="chapter-index" aria-hidden="true">{c.index}</span>
          <div class="chapter-copy">
            <p class="kicker"><span class="mask"><span class="mask-inner">{c.kicker}</span></span></p>
            <h2 class="chapter-title"><span class="mask"><span class="mask-inner">{c.title}</span></span></h2>
            <p class="chapter-lede"><span class="mask"><span class="mask-inner">{c.lede}</span></span></p>
          </div>
          <div class="chapter-figures">
            {c.figures.map((f) => (
              <a class="figure-row" href={f.href}>
                <span class="figure-label"><span class="figure-region" aria-hidden="true">{f.region}</span>{f.label}</span>
                <span class={`figure-value tabular-nums${f.phrase ? ' is-phrase' : ''}`}>{f.value}<span class="figure-arrow" aria-hidden="true"> →</span></span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <p class="dawn-hint" id="dawn-hint" aria-hidden="true">Run your numbers</p>

  {/* ── DAYLIGHT — the instrument room: same standard, full utility ── */}
  <div class="daylight" id="daylight" tabindex="-1">
    {/* D1 — the live instrument. No separate skeleton: the island's own server
        HTML is the first paint, so nothing jumps on hydration (A11Y-PERF-07). */}
    <section class="d-section d-engine">
      <div class="d-inner">
        <p class="d-kicker">Your turn</p>
        <h2 class="d-title" id="daylight-title">Run your numbers</h2>
        <p class="d-sub">The same questions, live — answers as you type. No signup, no ads.</p>
        <div class="d-engine-wrap">
          <DecisionEngine client:idle />
        </div>
      </div>
    </section>

    {/* D2 — decisions, priced */}
    <section class="d-section d-board">
      <div class="d-inner d-inner-narrow">
        <p class="d-kicker">Live calculations</p>
        <h2 class="d-title d-title-sm">Good financial decisions create value</h2>
        <p class="d-sub">Every number below comes from a CalcRun calculator. Open one and run your own.</p>
        <ul class="decision-rows">
          {DECISIONS.map((d) => (
            <li>
              <a class={`decision-row kind-${d.kind}`} href={d.href}>
                <span class="decision-q"><span class="d-region" aria-hidden="true">{d.region}</span>{d.q}</span>
                <span class="decision-a tabular-nums" data-count={d.n} data-pre={d.pre} data-suf={d.suf}>{d.pre}{formatNumber(d.n)}{d.suf}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* D2.5 — every category, bento */}
    <section class="d-section d-bento">
      <div class="d-inner">
        <p class="d-kicker">The full toolkit</p>
        <h2 class="d-title d-title-sm">Every corner of your money</h2>
        <div class="bento">
          {BENTO.filter((b) => b.size !== 'sm').map((b) => (
            <a class={`bento-tile area-${b.slug} tone-${b.tone}`} href={`/tools/#${b.slug}`}>
              {b.motif === 'growth' && (
                <svg class="bento-motif" viewBox="0 0 300 140" preserveAspectRatio="none" aria-hidden="true"><path d="M0,132 C90,128 190,96 300,10" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="M0,132 C90,128 190,96 300,10 L300,140 L0,140 Z" fill="currentColor" opacity="0.18" stroke="none" /></svg>
              )}
              {b.motif === 'decline' && (
                <svg class="bento-motif" viewBox="0 0 300 140" preserveAspectRatio="none" aria-hidden="true"><path d="M0,12 C110,20 210,70 300,132" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="M0,12 C110,20 210,70 300,132 L300,140 L0,140 Z" fill="currentColor" opacity="0.12" stroke="none" /></svg>
              )}
