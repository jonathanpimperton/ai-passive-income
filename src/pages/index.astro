---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';
import EmailCapture from '@components/ui/EmailCapture.tsx';
import { TOOLS, POPULAR_TOOL_SLUGS, CATEGORIES, getToolPath, type CategorySlug, type ToolMeta } from '@lib/tools-data';
import { buildWebsiteSchema } from '@lib/seo';

const popularTools = POPULAR_TOOL_SLUGS
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t): t is ToolMeta => t !== undefined);

const categoryEntries = Object.entries(CATEGORIES) as [CategorySlug, typeof CATEGORIES[CategorySlug]][];
const websiteSchema = buildWebsiteSchema();

/** Quick-link pills for hero — most-searched categories */
const quickLinks = [
  { label: 'Mortgage', slug: 'mortgage-payment', category: 'debt-and-loans' },
  { label: 'UK Salary', slug: 'salary-uk', category: 'income-and-planning' },
  { label: 'Compound Interest', slug: 'compound-interest', category: 'saving-and-growth' },
  { label: 'Retirement', slug: 'retirement-savings', category: 'income-and-planning' },
  { label: 'Debt Payoff', slug: 'debt-payoff', category: 'debt-and-loans' },
  { label: 'Loan Amortization', slug: 'loan-amortization', category: 'debt-and-loans' },
];

/** Specific CTA hooks for the bottom section */
const ctaHooks = [
  { text: 'Wondering if you can retire at 55?', link: '/tools/income-and-planning/retirement-savings', label: 'Try the retirement calculator' },
  { text: 'Evaluating a job offer?', link: '/tools/income-and-planning/salary-us', label: 'See your real take-home pay' },
  { text: 'Buying your first home?', link: '/tools/debt-and-loans/mortgage-payment', label: 'Calculate your monthly payment' },
];
---

<BaseLayout
  title="Free Financial Calculators Online | CalcRun"
  description="Free financial calculators with interactive charts and plain-English explanations. Mortgage, salary, compound interest, retirement — no signup, no ads."
  structuredData={[websiteSchema]}
>
  {/* ===== HERO ===== */}
  <section class="hero-bg relative overflow-hidden py-16 sm:py-20 lg:py-24">
    <div class="relative z-10 max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight tracking-[-0.02em] max-w-[700px] mx-auto">
        Clear calculators for real financial decisions
      </h1>
      <p class="mt-4 text-lg sm:text-xl text-white/70 max-w-[600px] mx-auto leading-relaxed">
        Mortgage repayments, salary breakdowns, compound interest — calculated properly, explained clearly.
      </p>

      {/* Search bar */}
      <div class="mt-8 max-w-[520px] mx-auto relative">
        <div class="relative">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-neutral-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="search"
            id="hero-search"
            placeholder="Search 37+ financial calculators..."
            class="w-full pl-12 pr-4 py-3.5 rounded-xl bg-white text-neutral-900 placeholder-neutral-400 text-base shadow-lg border-0 focus:outline-none focus:ring-2 focus:ring-primary-400"
            autocomplete="off"
          />
        </div>
        {/* Search results dropdown */}
        <div id="hero-search-results" class="absolute top-full left-0 right-0 mt-2 bg-white rounded-xl shadow-xl border border-neutral-200/80 overflow-hidden z-50 hidden">
        </div>
      </div>

      {/* Quick-link pills */}
      <div class="mt-6 flex flex-wrap justify-center gap-2.5 sm:gap-2">
        {quickLinks.map((link) => (
          <a
            href={`/tools/${link.category}/${link.slug}`}
            class="inline-flex items-center px-4 py-2 sm:px-3.5 sm:py-1.5 rounded-full text-sm font-medium bg-white/10 text-white/90 border border-white/15 hover:bg-white/20 hover:border-white/25 transition-all duration-150"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ===== TRUST STRIP ===== */}
  <section class="trust-strip py-6 sm:py-8 border-b border-neutral-100">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 lg:gap-14 text-sm text-neutral-600">
        <div class="flex items-center gap-2">
          <svg class="w-4.5 h-4.5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
          <span class="font-medium">37+ free calculators</span>
        </div>
        <div class="hidden sm:block w-px h-5 bg-neutral-200" aria-hidden="true"></div>
        <div class="flex items-center gap-2">
          <svg class="w-4.5 h-4.5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <span class="font-medium">Updated for 2025/26 tax year</span>
        </div>
        <div class="hidden sm:block w-px h-5 bg-neutral-200" aria-hidden="true"></div>
        <div class="flex items-center gap-2">
          <svg class="w-4.5 h-4.5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          <span class="font-medium">Calculations run in your browser</span>
        </div>
      </div>
    </div>
  </section>

  {/* ===== POPULAR CALCULATORS ===== */}
  <section id="popular" class="py-16 sm:py-20 lg:py-24">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-neutral-900">Most Popular</h2>
          <p class="text-neutral-500 mt-2">The tools people search for most.</p>
        </div>
        <a href="/tools" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors duration-150">
          View all
          <ToolIcon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {popularTools.map((tool, i) => {
          const isFeature = i < 2;
          return (
            <a
              href={getToolPath(tool)}
              class={`tool-card-popular group relative bg-white border border-neutral-200/80 rounded-lg shadow-card hover:shadow-card-hover hover:border-primary-500/40 transition-all duration-200 hover:-translate-y-0.5 ${isFeature ? 'lg:col-span-2 p-6 sm:p-7' : 'p-5'}`}
            >
              <div class={`flex items-start gap-4 ${isFeature ? '' : 'gap-3'}`}>
                <div class={`inline-flex items-center justify-center rounded-xl bg-primary-50 text-primary-600 group-hover:bg-primary-500 group-hover:text-white transition-all duration-200 shrink-0 ${isFeature ? 'w-14 h-14' : 'w-10 h-10'}`}>
                  <ToolIcon name={tool.icon} size={isFeature ? 28 : 20} />
                </div>
                <div class="min-w-0">
                  <h3 class={`font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-150 mb-1 ${isFeature ? 'text-xl' : 'text-base'}`}>
                    {tool.name}
                  </h3>
                  <p class={`text-neutral-500 leading-relaxed ${isFeature ? 'text-sm sm:text-base' : 'text-sm'}`}>{tool.description}</p>
                  {isFeature && (
                    <span class="inline-flex items-center gap-1 mt-3 text-sm font-semibold text-primary-600 group-hover:text-primary-700 transition-colors duration-150">
                      Try it free
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                    </span>
                  )}
                </div>
              </div>
            </a>
          );
        })}
      </div>

      <a href="/tools" class="sm:hidden mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600">
        View all tools <ToolIcon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  {/* ===== NEWSLETTER SIGNUP ===== */}
  <section class="py-10 sm:py-14 border-t border-neutral-100">
    <div class="max-w-[600px] mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-lg sm:text-xl font-bold text-neutral-900 mb-1">Get financial tips in your inbox</h2>
      <p class="text-sm text-neutral-500 mb-5">Short, practical guides. No spam, unsubscribe any time.</p>
      <EmailCapture client:visible variant="newsletter" />
    </div>
  </section>

  {/* ===== SPACER ===== */}
  <div class="h-4 sm:h-6"></div>

  {/* ===== ALL TOOLS ===== */}
  <section class="py-16 sm:py-20 lg:py-24 bg-neutral-50">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-neutral-900 mb-2">All Tools</h2>
      <p class="text-neutral-500 mb-8">Browse by category or filter to find the right tool.</p>

      {/* Category filter pills */}
      <div class="flex flex-wrap gap-2 mb-10" role="tablist" aria-label="Filter tools by category">
        <button
          data-category="all"
          class="category-pill active px-4 py-2.5 rounded-full text-sm font-medium transition-all duration-200"
          role="tab"
          aria-selected="true"
        >
          All
        </button>
        {categoryEntries.map(([slug, cat]) => (
          <button
            data-category={slug}
            class="category-pill px-4 py-2.5 rounded-full text-sm font-medium transition-all duration-200"
            role="tab"
            aria-selected="false"
          >
            {cat.label}
          </button>
        ))}
      </div>

      {/* Tool grid — popular tools get larger cards for visual hierarchy */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="tools-grid">
        {TOOLS.map((tool) => {
          const isPopular = POPULAR_TOOL_SLUGS.includes(tool.slug);
          return (
            <a
              href={getToolPath(tool)}
              data-tool-category={tool.category}
              class={`tool-card group bg-white border border-neutral-200/80 rounded-lg shadow-card hover:shadow-card-hover hover:border-primary-500/40 transition-all duration-200 hover:-translate-y-0.5 ${isPopular ? 'sm:col-span-2 lg:col-span-1 xl:col-span-1 p-6' : 'p-5'}`}
            >
              <div class={`flex items-start ${isPopular ? 'gap-4' : 'gap-3.5'}`}>
                <div class={`inline-flex items-center justify-center rounded-lg bg-primary-50 text-primary-600 group-hover:bg-primary-500 group-hover:text-white transition-all duration-200 shrink-0 ${isPopular ? 'w-12 h-12' : 'w-10 h-10'}`}>
                  <ToolIcon name={tool.icon} size={isPopular ? 24 : 20} />
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <h3 class={`font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-150 ${isPopular ? 'text-lg' : 'text-base'}`}>
                      {tool.name}
                    </h3>
                    {isPopular && (
                      <span class="inline-block text-xs font-semibold text-white bg-accent-600 px-2 py-0.5 rounded-full leading-none">Popular</span>
                    )}
                  </div>
                  <p class="text-sm text-neutral-500 leading-relaxed">{tool.description}</p>
                  <span class="inline-block mt-2.5 text-xs font-medium text-primary-600 bg-primary-50 px-2.5 py-0.5 rounded-full">
                    {CATEGORIES[tool.category].label}
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* ===== BOTTOM CTA ===== */}
  <section class="bg-[#0F1B2D] py-16 sm:py-20">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-[900px]">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mb-3">Start with a question that matters to you</h2>
        <p class="text-white/50 mb-8 text-sm sm:text-base">Pick one and get your answer in under a minute.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-[900px] mb-10">
        {/* Featured card — larger */}
        <a
          href={ctaHooks[0].link}
          class="group sm:col-span-2 lg:col-span-1 bg-white/[0.07] border border-white/10 rounded-lg p-6 hover:bg-white/[0.12] hover:border-white/20 transition-all duration-200 text-left"
        >
          <p class="text-white font-semibold text-lg mb-2">{ctaHooks[0].text}</p>
          <p class="text-white/50 text-sm mb-3">Model different retirement ages and contribution levels.</p>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-400 group-hover:text-accent-300 transition-colors duration-150">
            {ctaHooks[0].label}
            <ToolIcon name="arrow-right" size={14} />
          </span>
        </a>
        {/* Secondary cards */}
        {ctaHooks.slice(1).map((hook) => (
          <a
            href={hook.link}
            class="group bg-white/[0.04] border border-white/10 rounded-lg p-5 hover:bg-white/[0.08] hover:border-white/15 transition-all duration-200 text-left"
          >
            <p class="text-white font-medium mb-2">{hook.text}</p>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-400 group-hover:text-accent-300 transition-colors duration-150">
              {hook.label}
              <ToolIcon name="arrow-right" size={14} />
            </span>
          </a>
        ))}
      </div>

      <a
        href="/tools"
        class="inline-flex items-center justify-center gap-2 bg-accent-600 text-white font-semibold px-7 py-3.5 rounded-lg hover:bg-accent-500 transition-all duration-200"
      >
        Browse all tools
        <ToolIcon name="arrow-right" size={18} />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== HERO ===== */
  .hero-bg {
    background: linear-gradient(135deg, #0F1B2D 0%, #0A4444 50%, #0F1B2D 100%);
  }

  /* ===== CATEGORY PILLS ===== */
  .category-pill {
    background-color: var(--color-neutral-100);
    color: var(--color-neutral-700);
  }
  .category-pill:hover {
    background-color: var(--color-neutral-200);
  }
  .category-pill.active {
    background-color: var(--color-primary-500);
    color: white;
    box-shadow: 0 2px 8px rgba(11, 110, 110, 0.25);
  }

  /* ===== FILTER TRANSITIONS ===== */
  .tool-card {
    transition: all 0.2s ease, opacity 0.25s ease, transform 0.25s ease;
  }
  .tool-card.hiding {
    opacity: 0;
    transform: scale(0.95) translateY(4px);
    pointer-events: none;
  }
  .tool-card.card-hidden {
    display: none;
  }

  /* ===== SEARCH RESULTS ===== */
  .search-result-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    transition: background-color 0.1s ease;
    text-decoration: none;
    color: inherit;
  }
  .search-result-item:hover,
  .search-result-item.active {
    background-color: var(--color-primary-50);
  }
  .search-result-item .result-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    background-color: var(--color-primary-50);
    color: var(--color-primary-600);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .search-result-item:hover .result-icon,
  .search-result-item.active .result-icon {
    background-color: var(--color-primary-500);
    color: white;
  }

  /* ===== REDUCED MOTION ===== */
  @media (prefers-reduced-motion: reduce) {
    .tool-card { transition-duration: 0.01ms; }
  }
</style>

<script>
  // ===== Tool search data (embedded at build) =====
  interface SearchTool {
    name: string;
    slug: string;
    category: string;
    description: string;
    path: string;
  }

  // Build search index from DOM (all tool cards in the grid)
  const searchTools: SearchTool[] = [];
  document.querySelectorAll('#tools-grid .tool-card').forEach((card) => {
    const el = card as HTMLAnchorElement;
    const name = el.querySelector('h3')?.textContent?.trim() || '';
    const desc = el.querySelector('p')?.textContent?.trim() || '';
    const category = el.dataset.toolCategory || '';
    searchTools.push({
      name,
      slug: name.toLowerCase().replace(/\s+/g, '-'),
      category,
      description: desc,
      path: el.href,
    });
  });

  const heroSearch = document.getElementById('hero-search') as HTMLInputElement;
  const heroResults = document.getElementById('hero-search-results') as HTMLDivElement;
  let activeIndex = -1;

  function renderSearchResults(query: string) {
    if (!query.trim()) {
      heroResults.classList.add('hidden');
      heroResults.innerHTML = '';
      activeIndex = -1;
      return;
    }

    const q = query.toLowerCase();
    const matches = searchTools.filter((t) =>
      t.name.toLowerCase().includes(q) ||
      t.description.toLowerCase().includes(q)
    ).slice(0, 6);

    if (matches.length === 0) {
      heroResults.innerHTML = '<div class="px-4 py-3 text-sm text-neutral-500">No tools found</div>';
      heroResults.classList.remove('hidden');
      activeIndex = -1;
      return;
    }

    heroResults.innerHTML = matches.map((tool, i) =>
      `<a href="${tool.path}" class="search-result-item${i === activeIndex ? ' active' : ''}" data-index="${i}">
        <div class="result-icon">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
        </div>
        <div>
          <div class="text-sm font-medium text-neutral-900">${tool.name}</div>
          <div class="text-xs text-neutral-500 truncate max-w-[340px]">${tool.description}</div>
        </div>
      </a>`
    ).join('');
    heroResults.classList.remove('hidden');
    activeIndex = -1;
  }

  heroSearch?.addEventListener('input', (e) => {
    renderSearchResults((e.target as HTMLInputElement).value);
  });

  heroSearch?.addEventListener('keydown', (e) => {
    const items = heroResults.querySelectorAll('.search-result-item');
    if (!items.length) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, items.length - 1);
      items.forEach((item, i) => item.classList.toggle('active', i === activeIndex));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
      items.forEach((item, i) => item.classList.toggle('active', i === activeIndex));
    } else if (e.key === 'Enter' && activeIndex >= 0) {
      e.preventDefault();
      (items[activeIndex] as HTMLAnchorElement).click();
    } else if (e.key === 'Escape') {
      heroResults.classList.add('hidden');
      heroSearch.blur();
    }
  });

  // Close search results on outside click
  document.addEventListener('click', (e) => {
    if (!heroSearch?.contains(e.target as Node) && !heroResults?.contains(e.target as Node)) {
      heroResults?.classList.add('hidden');
    }
  });

  // Re-show results on focus if there's a query
  heroSearch?.addEventListener('focus', () => {
    if (heroSearch.value.trim()) {
      renderSearchResults(heroSearch.value);
    }
  });

  // ===== Category filter logic =====
  const pills = document.querySelectorAll('.category-pill');
  const cards = document.querySelectorAll('.tool-card');

  function filterByCategory(category: string) {
    pills.forEach((p) => {
      const pillCat = (p as HTMLElement).dataset.category;
      if (pillCat === category || (category === 'all' && pillCat === 'all')) {
        p.classList.add('active');
        p.setAttribute('aria-selected', 'true');
      } else {
        p.classList.remove('active');
        p.setAttribute('aria-selected', 'false');
      }
    });

    cards.forEach((card) => {
      const cardCategory = (card as HTMLElement).dataset.toolCategory;
      const shouldShow = category === 'all' || cardCategory === category;
      const el = card as HTMLElement;

      if (!shouldShow) {
        el.classList.add('hiding');
        setTimeout(() => { el.classList.add('card-hidden'); }, 200);
      } else {
        el.classList.remove('card-hidden');
        void el.offsetHeight;
        el.classList.remove('hiding');
      }
    });
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const category = (pill as HTMLElement).dataset.category || 'all';
      filterByCategory(category);
    });
  });
</script>
