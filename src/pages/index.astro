---
import BaseLayout from '@layouts/BaseLayout.astro';
import EmailCapture from '@components/ui/EmailCapture.tsx';
import DecisionEngine from '@components/homepage/DecisionEngine.tsx';
import { TOOLS, getToolPath } from '@lib/tools-data';
import { buildWebsiteSchema } from '@lib/seo';
import { formatNumber, loanMonthlyPayment, compoundInterest } from '@lib/calculator-utils';
import { calcIncomeTax, calcNI } from '@lib/uk-tax-calc';
import { calcFederalTax, calcFICA } from '@lib/us-tax-calc';
import { UK_TAX_YEAR } from '@lib/uk-rates';
import { US_TAX_YEAR } from '@lib/us-rates';

const websiteSchema = buildWebsiteSchema();

/** Build search index as JSON for the nav search (all tools) */
const searchIndex = JSON.stringify(TOOLS.map((t) => ({
  name: t.name,
  description: t.description,
  category: t.category,
  path: getToolPath(t),
})));

/** 10 flagship tools for discovery section */
const FLAGSHIP_SLUGS = [
  'mortgage-payment',
  'mortgage-affordability',
  'compound-interest',
  'investment-return',
  'retirement-savings',
  'salary-uk',
  'salary-us',
  'debt-payoff',
  'net-worth',
  'emergency-fund',
];
const flagshipTools = FLAGSHIP_SLUGS
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t): t is NonNullable<typeof t> => t !== undefined);

/** 5 featured comparisons for discovery section */
const FEATURED_COMPARISONS = [
  { title: 'Renting vs Buying in 2026', slug: 'renting-vs-buying-2026' },
  { title: 'Pay Off Debt vs Invest', slug: 'pay-off-debt-vs-invest' },
  { title: 'Roth vs Traditional 401(k)', slug: 'roth-vs-traditional-401k' },
  { title: '15-Year vs 30-Year Mortgage', slug: '15-year-vs-30-year-mortgage' },
  { title: 'Snowball vs Avalanche', slug: 'snowball-vs-avalanche-debt' },
];

/**
 * Featured scenarios with the ANSWER precomputed at build time using the
 * site's own engines — the numbers are the hook, and they can never drift
 * from what the calculators actually say.
 */
const ukTakeHome50k = 50_000 - calcIncomeTax(50_000) - calcNI(50_000);
const usTakeHome100k = 100_000 - calcFederalTax(100_000, 'single') - calcFICA(100_000, 'single').total;
const invest500x10 = compoundInterest(0, 500, 0.07, 10, 12);
const mortgage300k = loanMonthlyPayment(300_000, 0.065, 360);
const invest1000x20 = compoundInterest(0, 1000, 0.07, 20, 12);

const FEATURED_SCENARIOS = [
  { title: '£50K salary UK take-home', slug: '50k-salary-uk-take-home', answer: `£${formatNumber(Math.round(ukTakeHome50k / 12))}/mo` },
  { title: '$100K salary after tax', slug: '100k-salary-take-home', answer: `$${formatNumber(Math.round(usTakeHome100k / 12))}/mo` },
  { title: '£500/mo invested for 10 years', slug: '500-per-month-10-years', answer: `£${formatNumber(Math.round(invest500x10 / 500) * 500)}` },
  { title: '$300K mortgage at 6.5%', slug: '300k-mortgage-6-5-percent', answer: `$${formatNumber(Math.round(mortgage300k))}/mo` },
  { title: '$1,000/mo invested for 20 years', slug: '1000-per-month-for-20-years', answer: `$${formatNumber(Math.round(invest1000x20 / 1000) * 1000)}` },
];

/**
 * Server-render the default mortgage result for the skeleton.
 * This shows a real result before React hydrates — no blank state.
 */
const MORTGAGE_RATE = 0.0675;
const MORTGAGE_TERM_YEARS = 30;
const MORTGAGE_DTI = 0.36;
const defaultIncome = 75000;
const defaultDown = 50000;
const defaultMaxMonthlyPmt = (defaultIncome / 12) * MORTGAGE_DTI;
const defaultTermMonths = MORTGAGE_TERM_YEARS * 12;
const defaultR = MORTGAGE_RATE / 12;
const defaultFactor = (Math.pow(1 + defaultR, defaultTermMonths) - 1) / (defaultR * Math.pow(1 + defaultR, defaultTermMonths));
const defaultMaxLoan = defaultMaxMonthlyPmt * defaultFactor;
const defaultMaxPrice = defaultMaxLoan + defaultDown;
const defaultMortgagePayment = loanMonthlyPayment(defaultMaxLoan, MORTGAGE_RATE, defaultTermMonths);
const defaultLoanPct = ((defaultMaxLoan / defaultMaxPrice) * 100).toFixed(0);
const defaultDownPct = ((defaultDown / defaultMaxPrice) * 100).toFixed(0);
---

<BaseLayout
  title="Financial Calculators & Tools | CalcRun"
  description="Financial calculators with interactive charts and plain-English explanations. Mortgage, salary, compound interest, retirement — no signup, no ads."
  structuredData={[websiteSchema]}
>
  {/* ===== SECTION 1: DECISION ENGINE ===== */}
  <section class="py-6 sm:py-8 lg:py-10">
    <div class="max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-6 sm:mb-8 lg:mb-10">
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-neutral-900 tracking-[-0.02em]">
          Run your numbers
        </h1>
        <p class="mt-2 text-neutral-500 text-lg sm:text-xl">Financial calculators for salary, mortgage, investing, and debt — answers as you type</p>
        <p class="mt-3 text-sm text-neutral-500">
          <span class="tabular-nums">{TOOLS.length}</span> calculators &amp; tools&ensp;·&ensp;no signup&ensp;·&ensp;no ads
        </p>
      </div>

      {/* Server-rendered skeleton — replaced by React on hydrate */}
      <div id="engine-skeleton">
        <div class="hidden lg:grid lg:grid-cols-[320px_1fr] lg:gap-6">
          {/* Tab list skeleton */}
          <div>
            <div class="w-full text-left px-5 py-5 border-l-[4px] border-l-primary-500 font-bold text-neutral-900">
              <span class="text-xl leading-relaxed">Can I actually afford this house?</span>
            </div>
            <div class="w-full text-left px-5 py-5 border-l-[4px] border-l-transparent font-medium text-neutral-800">
              <span class="text-xl leading-relaxed">What does $500/mo grow into?</span>
            </div>
            <div class="w-full text-left px-5 py-5 border-l-[4px] border-l-transparent font-medium text-neutral-800">
              <span class="text-xl leading-relaxed">When can I retire?</span>
            </div>
            <div class="w-full text-left px-5 py-5 border-l-[4px] border-l-transparent font-medium text-neutral-800">
              <span class="text-xl leading-relaxed">What's my take-home pay?</span>
            </div>
          </div>

          {/* Result panel skeleton — mortgage result first */}
          <div class="engine-panel rounded-xl p-6 sm:p-8">
            <div class="space-y-5">
              <div class="space-y-3">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="text-sm text-neutral-500 mb-1">You could afford up to</p>
                    <p class="text-2xl sm:text-4xl lg:text-5xl font-bold tabular-nums lining-nums result-number whitespace-nowrap">
                      ${formatNumber(Math.round(defaultMaxPrice))}
                    </p>
                  </div>
                  <a
                    href="/tools/debt-and-loans/mortgage-affordability/"
                    class="shrink-0 inline-flex items-center gap-1.5 text-sm font-semibold text-white bg-primary-600 hover:bg-primary-700 px-4 py-2.5 rounded-lg transition-all duration-150"
                  >
                    Open full calculator
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                  </a>
                </div>
                <p class="text-sm text-neutral-500">
                  ${formatNumber(Math.round(defaultMortgagePayment))}/mo at {(MORTGAGE_RATE * 100).toFixed(2)}% over {MORTGAGE_TERM_YEARS} years
                </p>
                <div>
                  <div class="flex gap-[3px] h-4 rounded-full overflow-hidden">
                    <div class="rounded-l-full bg-primary-500" style={`width:${defaultLoanPct}%`}></div>
                    <div class="rounded-r-full bg-neutral-300" style={`width:${defaultDownPct}%`}></div>
                  </div>
                  <div class="flex justify-between mt-1.5">
                    <span class="text-xs text-neutral-500">Loan {defaultLoanPct}%</span>
                    <span class="text-xs text-neutral-500">Down payment {defaultDownPct}%</span>
                  </div>
                </div>
              </div>

              <div class="h-px bg-neutral-200/80"></div>

              <div class="space-y-3">
                <div>
                  <div class="text-sm font-medium text-neutral-700 mb-1.5">Annual income</div>
                  <div class="shimmer-line h-11 rounded-lg"></div>
                  <div class="shimmer-line h-2 rounded-full mt-2.5"></div>
                </div>
                <div>
                  <div class="text-sm font-medium text-neutral-700 mb-1.5">Down payment</div>
                  <div class="shimmer-line h-11 rounded-lg"></div>
                  <div class="shimmer-line h-2 rounded-full mt-2.5"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Mobile skeleton: first accordion open — mortgage */}
        <div class="lg:hidden space-y-3">
          <div class="rounded-xl overflow-hidden border border-neutral-200/80">
            <div class="w-full text-left px-5 py-4 flex items-center justify-between bg-primary-50 font-semibold text-neutral-900">
              <span class="text-[15px] font-medium leading-snug">Can I actually afford this house?</span>
              <svg class="w-5 h-5 shrink-0 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </div>
            <div class="engine-panel p-5 border-t border-neutral-100">
              <div class="space-y-3">
                <div>
                  <p class="text-sm text-neutral-500 mb-1">You could afford up to</p>
                  <p class="text-2xl sm:text-3xl font-bold tabular-nums lining-nums result-number whitespace-nowrap">
                    ${formatNumber(Math.round(defaultMaxPrice))}
                  </p>
                </div>
                <p class="text-sm text-neutral-500">
                  ${formatNumber(Math.round(defaultMortgagePayment))}/mo at {(MORTGAGE_RATE * 100).toFixed(2)}%
                </p>
              </div>
            </div>
          </div>
          <div class="rounded-xl border border-neutral-200/80 px-5 py-4 text-neutral-600 text-[15px] font-medium">What does $500/mo grow into?</div>
          <div class="rounded-xl border border-neutral-200/80 px-5 py-4 text-neutral-600 text-[15px] font-medium">When can I retire?</div>
          <div class="rounded-xl border border-neutral-200/80 px-5 py-4 text-neutral-600 text-[15px] font-medium">What's my take-home pay?</div>
        </div>
      </div>

      <DecisionEngine client:load />
    </div>
  </section>

  {/* ===== SECTION 2: TRUST STRIP ===== */}
  <section class="border-y border-neutral-200/60 bg-surface">
    <div class="max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-center gap-2.5 sm:gap-10 text-sm text-neutral-600">
        <a href="/about/" class="inline-flex items-center gap-2 hover:text-primary-700 transition-colors duration-150">
          <svg class="w-4 h-4 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          Built by an ACA-qualified accountant
        </a>
        <span class="inline-flex items-center gap-2">
          <svg class="w-4 h-4 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          Tax rates verified for <span class="tabular-nums">{UK_TAX_YEAR}</span> (UK) &amp; <span class="tabular-nums">{US_TAX_YEAR}</span> (US)
        </span>
        <a href="/about/" class="inline-flex items-center gap-2 hover:text-primary-700 transition-colors duration-150">
          <svg class="w-4 h-4 text-primary-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          Every calculator documents its formula
        </a>
      </div>
    </div>
  </section>

  {/* ===== SECTION 3: DISCOVERY — Flagship Tools + Comparisons + Instant Answers ===== */}
  <section class="py-10 sm:py-14 bg-neutral-50">
    <div class="max-w-[1100px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-10">
        {/* Column 1: Flagship tools */}
        <div>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-neutral-900 mb-5">Popular calculators</h2>
          <div class="space-y-0">
            {flagshipTools.map((tool) => (
              <a
                href={getToolPath(tool)}
                class="group flex items-center justify-between py-3 border-b border-neutral-200/60 hover:border-primary-300/50 transition-colors duration-150"
              >
                <span class="text-[15px] font-medium text-neutral-900 group-hover:text-primary-600 transition-colors duration-150 pr-4">
                  {tool.name}
                </span>
                <svg class="w-4 h-4 shrink-0 text-neutral-300 group-hover:text-primary-500 transition-colors duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            ))}
          </div>
          <a href="/tools/" class="inline-flex items-center gap-1.5 mt-5 py-2 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors duration-150">
            See all tools
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>

        {/* Column 2: Featured comparisons */}
        <div>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-neutral-900 mb-5">Comparisons</h2>
          <div class="space-y-0">
            {FEATURED_COMPARISONS.map((comp) => (
              <a
                href={`/comparisons/${comp.slug}/`}
                class="group flex items-center justify-between py-3 border-b border-neutral-200/60 hover:border-primary-300/50 transition-colors duration-150"
              >
                <span class="text-[15px] font-medium text-neutral-900 group-hover:text-primary-600 transition-colors duration-150 pr-4">
                  {comp.title}
                </span>
                <svg class="w-4 h-4 shrink-0 text-neutral-300 group-hover:text-primary-500 transition-colors duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            ))}
          </div>
          <a href="/comparisons/" class="inline-flex items-center gap-1.5 mt-5 py-2 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors duration-150">
            All comparisons
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>

        {/* Column 3: Instant answers — precomputed results as the hook */}
        <div>
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-neutral-900 mb-5">Instant answers</h2>
          <div class="space-y-0">
            {FEATURED_SCENARIOS.map((scenario) => (
              <a
                href={`/scenarios/${scenario.slug}/`}
                class="group flex items-center justify-between gap-3 py-3 border-b border-neutral-200/60 hover:border-primary-300/50 transition-colors duration-150"
              >
                <span class="text-[15px] font-medium text-neutral-900 group-hover:text-primary-600 transition-colors duration-150">
                  {scenario.title}
                </span>
                <span class="shrink-0 text-sm font-semibold text-primary-700 tabular-nums">
                  {scenario.answer}
                </span>
              </a>
            ))}
          </div>
          <a href="/scenarios/" class="inline-flex items-center gap-1.5 mt-5 py-2 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors duration-150">
            Browse scenarios
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ===== SECTION 4: NEWSLETTER ===== */}
  <section class="py-10 sm:py-14">
    <div class="max-w-[560px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-surface border border-neutral-200/80 rounded-lg p-6 sm:p-8">
        <h2 class="text-lg font-bold text-neutral-900 mb-1">One worked money question, weekly</h2>
        <p class="text-sm text-neutral-500 mb-4">New tools, scenarios, and money maths worth knowing. Unsubscribe anytime.</p>
        <EmailCapture client:visible variant="newsletter" />
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ===== Decision Engine Panel — light mode (default) ===== */
  .engine-panel {
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-neutral-200, #e5e5e5);
    border-radius: 0.75rem;
    color: var(--color-text, #1A1A2E);
  }

  /* Shimmer skeleton for initial load */
  .engine-panel .shimmer-line {
    background: linear-gradient(90deg, rgba(0,0,0,0.04) 25%, rgba(0,0,0,0.08) 50%, rgba(0,0,0,0.04) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }

  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* ===== Dark mode overrides ===== */
  [data-theme="dark"] .engine-panel {
    background: var(--color-surface, #1E2128);
    border-color: var(--color-neutral-700, #3f3f46);
  }

  [data-theme="dark"] .engine-panel .shimmer-line {
    background: linear-gradient(90deg, rgba(255,255,255,0.06) 25%, rgba(255,255,255,0.12) 50%, rgba(255,255,255,0.06) 75%);
    background-size: 200% 100%;
  }
</style>
