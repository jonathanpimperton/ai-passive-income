    bottom: 30%;
    left: 12%;
    animation: iconDrift3 11s ease-in-out infinite;
  }
  .hero-float-icon-4 {
    bottom: 20%;
    right: 15%;
    animation: iconDrift4 13s ease-in-out infinite;
