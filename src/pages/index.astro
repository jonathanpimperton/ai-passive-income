    }
    html.intro-play .stage-skip:hover { color: #fcfcfa; border-color: #8b93a1; }

    /* ════ Act 0 — the question ════ */
    html.intro-play .hero-noun { color: #8b93a1; margin-bottom: 22px; }
    html.intro-play .question {
      max-width: 15ch;
      font-weight: 560;
      font-size: clamp(2.9rem, 7.8vw, 6.2rem);
      letter-spacing: -0.045em;
      line-height: 1.03;
      color: #fcfcfa;
    }
    html.intro-play .q-accent .q-char {
      color: #5fd3d3;
      /* tight halo hugging the letterforms + faint ambient bloom */
      text-shadow: 0 0 16px rgba(95, 211, 211, 0.5), 0 0 44px rgba(56, 174, 174, 0.26);
    }
    html.intro-play .question-sub {
      margin: 26px 0 0;
      font-size: clamp(1rem, 1.6vw, 1.2rem);
      color: #aeb5bf;
      max-width: 44ch;
    }
    html.intro-play .question-sub .sub-quiet { color: #8b93a1; font-size: 0.88em; margin-top: 6px; }

    html.intro-play .dawn-hint {
      display: block;
      position: fixed;
      top: 44%;
      left: 50%;
      margin: 0;
      z-index: 40;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 640;
      font-size: clamp(1.5rem, 2.6vw, 2.1rem);
      letter-spacing: -0.03em;
      color: var(--color-primary-600);
      opacity: 0;
      pointer-events: none;
      white-space: nowrap;
      will-change: transform, opacity;
    }

    html.intro-play .scroll-cue {
      display: flex;
      position: absolute;
      bottom: 34px;
      left: 50%;
      transform: translateX(-50%);
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    .cue-line {
      width: 1px;
      height: 56px;
      background: linear-gradient(to bottom, transparent, #38aeae 30%, #38aeae 70%, transparent);
      animation: cue-pulse 2.4s ease-in-out infinite;
      transform-origin: top;
    }
    .cue-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: #8b93a1;
    }
    @keyframes cue-pulse {
      0%, 100% { opacity: 0.35; transform: scaleY(0.82); }
      50% { opacity: 1; transform: scaleY(1); }
    }

    /* ════ Chapters ════ */
    html.intro-play .chapter {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: left;
      gap: 48px;
      padding: 0 clamp(24px, 7vw, 110px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    html.intro-play .chapter.active { pointer-events: auto; }

    .chapter-copy { max-width: 30rem; }
    .kicker {
      margin: 0 0 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: #8b93a1;
    }
    .chapter-title {
      margin: 0;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 640;
      font-size: clamp(2.6rem, 6vw, 4.6rem);
      letter-spacing: -0.03em;
      line-height: 1;
    }
    .chapter-grow .chapter-title { color: #57d9a3; }
    .chapter-keep .chapter-title { color: #5fd3d3; }
    .chapter-owe  .chapter-title { color: #f08a70; }
    .chapter-lede {
      margin: 20px 0 0;
      color: #aeb5bf;
      font-size: clamp(1rem, 1.5vw, 1.15rem);
      line-height: 1.6;
      max-width: 38ch;
    }

    .mask { display: block; overflow: hidden; }
    .mask-inner { display: block; transform: translateY(112%); will-change: transform; }

    .chapter-index {
      position: absolute;
      left: clamp(8px, 3vw, 60px);
      bottom: 4vh;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: clamp(9rem, 26vh, 19rem);
      line-height: 1;
      color: transparent;
      -webkit-text-stroke: 1px rgba(139, 147, 161, 0.13);
      pointer-events: none;
      user-select: none;
    }

    .chapter-figures {
      display: flex;
      flex-direction: column;
      width: min(500px, 40vw);
    }
    .figure-row {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      align-items: baseline;
      column-gap: 18px;
      padding: 19px 2px;
      border-top: 1px solid rgba(139, 147, 161, 0.18);
      text-decoration: none;
      transform: translateY(26px);
      opacity: 0;
      will-change: transform, opacity;
      transition: border-color 0.3s ease;
    }
    /* Soft obsidian scrim behind each row — the data line passes beneath the
       ledger without ever striking through its text */
    .figure-row::before {
      content: '';
      position: absolute;
      inset: -4px -16px;
      background: rgba(10, 11, 13, 0.78);
      filter: blur(9px);
      border-radius: 14px;
      z-index: -1;
    }
    .figure-row:last-child { border-bottom: 1px solid rgba(139, 147, 161, 0.18); }
    .figure-row:hover { border-top-color: rgba(56, 174, 174, 0.55); }
    .figure-label {
      font-size: 13.5px;
      color: #8b93a1;
      line-height: 1.45;
      transition: color 0.25s ease;
      text-shadow: 0 2px 14px rgba(10, 11, 13, 0.9);
    }
    .figure-region {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      letter-spacing: 0.14em;
      color: #8b93a1;
      border: 1px solid rgba(139, 147, 161, 0.35);
      border-radius: 5px;
      padding: 2px 6px 1px;
      margin-right: 9px;
      vertical-align: 2px;
    }
    .figure-row:hover .figure-label { color: #d7dbe1; }
    .figure-value {
      font-size: clamp(1.45rem, 2.2vw, 2rem);
      font-weight: 700;
      color: #fcfcfa;
      letter-spacing: -0.02em;
      white-space: nowrap;
      justify-self: end;
      text-align: right;
      /* keeps numerals crisp where the glowing line passes behind the ledger */
      text-shadow: 0 2px 20px rgba(10, 11, 13, 0.95), 0 0 6px rgba(10, 11, 13, 0.8);
    }
    /* Phrase-length values step down so the row grid never collapses */
    .figure-value.is-phrase { font-size: clamp(1.15rem, 1.7vw, 1.5rem); }
    .figure-arrow {
      color: #38aeae;
      opacity: 0;
      transition: opacity 0.25s ease;
      font-size: 0.8em;
    }
    .figure-row:hover .figure-arrow { opacity: 1; }

