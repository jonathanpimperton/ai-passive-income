---
import BaseLayout from '@layouts/BaseLayout.astro';
import { TOOLS, POPULAR_TOOL_SLUGS, CATEGORIES, getToolPath, type CategorySlug, type ToolMeta } from '@lib/tools-data';
import { buildWebsiteSchema } from '@lib/seo';

const popularTools = POPULAR_TOOL_SLUGS
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t): t is ToolMeta => t !== undefined);

const categoryEntries = Object.entries(CATEGORIES) as [CategorySlug, typeof CATEGORIES[CategorySlug]][];
const websiteSchema = buildWebsiteSchema();
---

<BaseLayout
  title="Free Financial Calculators Online | CalcPath"
  description="See your numbers instantly — no signup, no ads, no data harvesting. Free financial calculators with interactive charts and plain-English explanations."
  structuredData={[websiteSchema]}
>
  {/* Hero section — dark gradient per design-system.md */}
  <section class="bg-[linear-gradient(135deg,#0A2540_0%,#1A3A5C_50%,#0A2540_100%)] py-16 sm:py-24">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-[36px] font-bold text-white leading-tight tracking-[-0.02em]">
        Free Financial Calculators
      </h1>
      <p class="mt-4 text-lg sm:text-xl text-primary-200 max-w-[600px] mx-auto">
        See your numbers instantly — no signup, no ads, no data harvesting.
      </p>
      <a
        href="/tools"
        class="mt-8 inline-flex items-center gap-2 bg-accent-600 text-white font-semibold px-6 py-3 rounded-lg hover:bg-accent-500 transition-colors duration-150"
      >
        Browse Calculators
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  {/* Popular Calculators — 6 cards, covers all 5 customer segments */}
  <section class="py-16 sm:py-20">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-8">Popular Calculators</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {popularTools.map((tool) => (
          <a
            href={getToolPath(tool)}
            class="bg-white border border-neutral-200 rounded-xl p-6 shadow-card hover:shadow-card-hover hover:-translate-y-0.5 transition-all duration-150 group"
          >
            <div class="flex items-start justify-between mb-3">
              <h3 class="text-lg font-semibold text-neutral-900 group-hover:text-primary-500 transition-colors duration-150">
                {tool.name}
              </h3>
              <svg class="w-5 h-5 text-neutral-400 group-hover:text-primary-500 shrink-0 mt-0.5 transition-colors duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
            <p class="text-sm text-neutral-500">{tool.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* All Tools with category filters */}
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 mb-8">All Tools</h2>

      {/* Category filter pills */}
      <div class="flex flex-wrap gap-2 mb-8" role="tablist" aria-label="Filter tools by category">
        <button
          data-category="all"
          class="category-pill px-4 py-2 rounded-full text-sm font-medium bg-primary-500 text-white transition-colors duration-150"
          role="tab"
          aria-selected="true"
        >
          All
        </button>
        {categoryEntries.map(([slug, cat]) => (
          <button
            data-category={slug}
            class="category-pill px-4 py-2 rounded-full text-sm font-medium bg-neutral-100 text-neutral-700 hover:bg-neutral-200 transition-colors duration-150"
            role="tab"
            aria-selected="false"
          >
            {cat.label}
          </button>
        ))}
      </div>

      {/* Tool grid */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="tools-grid">
        {TOOLS.map((tool) => (
          <a
            href={getToolPath(tool)}
            data-tool-category={tool.category}
            class="tool-card bg-neutral-50 border border-neutral-200 rounded-xl p-5 hover:shadow-card hover:-translate-y-0.5 transition-all duration-150 group"
          >
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-base font-semibold text-neutral-900 group-hover:text-primary-500 transition-colors duration-150">
                {tool.name}
              </h3>
              <svg class="w-4 h-4 text-neutral-400 group-hover:text-primary-500 shrink-0 mt-0.5 transition-colors duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
            <p class="text-sm text-neutral-500">{tool.description}</p>
            <span class="inline-block mt-3 text-xs font-medium text-primary-500 bg-primary-50 px-2 py-0.5 rounded-full">
              {CATEGORIES[tool.category].label}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const pills = document.querySelectorAll('.category-pill');
  const cards = document.querySelectorAll('.tool-card');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const category = (pill as HTMLElement).dataset.category;

      // Update active pill
      pills.forEach((p) => {
        p.classList.remove('bg-primary-500', 'text-white');
        p.classList.add('bg-neutral-100', 'text-neutral-700');
        p.setAttribute('aria-selected', 'false');
      });
      pill.classList.remove('bg-neutral-100', 'text-neutral-700');
      pill.classList.add('bg-primary-500', 'text-white');
      pill.setAttribute('aria-selected', 'true');

      // Filter cards
      cards.forEach((card) => {
        const cardCategory = (card as HTMLElement).dataset.toolCategory;
        if (category === 'all' || cardCategory === category) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
