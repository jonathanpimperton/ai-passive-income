        <div class="d-viewall reveal">
          {/* Single span for the label — flex gap between text fragments would
              otherwise split "View all | 46 | tools" into gapped pieces */}
          <a class="cta-viewall" href="/tools/">
            <span>View all <span class="tabular-nums">{TOOL_COUNT}</span> tools</span>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/></svg>
