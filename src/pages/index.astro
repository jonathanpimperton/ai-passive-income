---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';
import { TOOLS, POPULAR_TOOL_SLUGS, CATEGORIES, getToolPath, type CategorySlug, type ToolMeta } from '@lib/tools-data';
import { buildWebsiteSchema } from '@lib/seo';

const popularTools = POPULAR_TOOL_SLUGS
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t): t is ToolMeta => t !== undefined);

const categoryEntries = Object.entries(CATEGORIES) as [CategorySlug, typeof CATEGORIES[CategorySlug]][];
const websiteSchema = buildWebsiteSchema();

/** Category card metadata for visual category navigation */
const categoryCards: { slug: CategorySlug; icon: string; color: string; hoverBg: string; count: number }[] = [
  {
    slug: 'saving-and-growth',
    icon: 'trending-up',
    color: 'text-accent-600 bg-accent-50',
    hoverBg: 'group-hover:bg-accent-600 group-hover:text-white',
    count: TOOLS.filter(t => t.category === 'saving-and-growth').length,
  },
  {
    slug: 'debt-and-loans',
    icon: 'credit-card',
    color: 'text-primary-600 bg-primary-50',
    hoverBg: 'group-hover:bg-primary-600 group-hover:text-white',
    count: TOOLS.filter(t => t.category === 'debt-and-loans').length,
  },
  {
    slug: 'income-and-planning',
    icon: 'briefcase',
    color: 'text-primary-600 bg-primary-50',
    hoverBg: 'group-hover:bg-primary-600 group-hover:text-white',
    count: TOOLS.filter(t => t.category === 'income-and-planning').length,
  },
  {
    slug: 'economic',
    icon: 'trending-down',
    color: 'text-warning-600 bg-warning-50',
    hoverBg: 'group-hover:bg-warning-600 group-hover:text-white',
    count: TOOLS.filter(t => t.category === 'economic').length,
  },
  {
    slug: 'utility',
    icon: 'zap',
    color: 'text-accent-600 bg-accent-50',
    hoverBg: 'group-hover:bg-accent-600 group-hover:text-white',
    count: TOOLS.filter(t => t.category === 'utility').length,
  },
];

/** Persona data for "Who Is This For?" section */
const personas = [
  {
    hook: 'Just got your first real paycheck?',
    description: 'See how even small monthly savings grow into serious money over time.',
    icon: 'graduation-cap',
    color: 'text-accent-600 bg-accent-50',
    hoverBg: 'group-hover:bg-accent-600 group-hover:text-white',
    tools: [
      { name: 'Compound Interest', slug: 'compound-interest', category: 'saving-and-growth' as CategorySlug },
      { name: 'Savings Goal', slug: 'savings-goal', category: 'saving-and-growth' as CategorySlug },
      { name: 'Emergency Fund', slug: 'emergency-fund', category: 'income-and-planning' as CategorySlug },
    ],
  },
  {
    hook: 'Buying vs. renting?',
    description: 'Compare the real cost of homeownership against renting — with actual numbers.',
    icon: 'home',
    color: 'text-primary-600 bg-primary-50',
    hoverBg: 'group-hover:bg-primary-600 group-hover:text-white',
    tools: [
      { name: 'Rent vs. Buy', slug: 'rent-vs-buy', category: 'debt-and-loans' as CategorySlug },
      { name: 'Mortgage Payment', slug: 'mortgage-payment', category: 'debt-and-loans' as CategorySlug },
      { name: 'Loan Amortization', slug: 'loan-amortization', category: 'debt-and-loans' as CategorySlug },
    ],
  },
  {
    hook: 'On track for retirement?',
    description: 'Find out if your savings rate will actually get you there — adjusted for inflation.',
    icon: 'piggy-bank',
    color: 'text-warning-600 bg-warning-50',
    hoverBg: 'group-hover:bg-warning-600 group-hover:text-white',
    tools: [
      { name: 'Retirement Savings', slug: 'retirement-savings', category: 'income-and-planning' as CategorySlug },
      { name: 'Investment Return', slug: 'investment-return', category: 'saving-and-growth' as CategorySlug },
      { name: 'Inflation', slug: 'inflation', category: 'economic' as CategorySlug },
    ],
  },
  {
    hook: 'Drowning in payments?',
    description: 'Compare snowball vs. avalanche strategies and pick a payoff date you can actually hit.',
    icon: 'credit-card',
    color: 'text-primary-600 bg-primary-50',
    hoverBg: 'group-hover:bg-primary-600 group-hover:text-white',
    tools: [
      { name: 'Debt Payoff', slug: 'debt-payoff', category: 'debt-and-loans' as CategorySlug },
      { name: 'Loan Amortization', slug: 'loan-amortization', category: 'debt-and-loans' as CategorySlug },
      { name: 'Savings Goal', slug: 'savings-goal', category: 'saving-and-growth' as CategorySlug },
    ],
  },
];

/** Ticker items for scrolling marquee */
const tickerItems = [
  { label: 'Monthly mortgage payment', slug: 'mortgage-payment', category: 'debt-and-loans' as CategorySlug },
  { label: 'Retirement savings goal', slug: 'retirement-savings', category: 'income-and-planning' as CategorySlug },
  { label: 'Debt payoff timeline', slug: 'debt-payoff', category: 'debt-and-loans' as CategorySlug },
  { label: 'Investment growth', slug: 'investment-return', category: 'saving-and-growth' as CategorySlug },
  { label: 'Salary breakdown', slug: 'salary-us', category: 'income-and-planning' as CategorySlug },
  { label: 'Compound interest', slug: 'compound-interest', category: 'saving-and-growth' as CategorySlug },
  { label: 'Loan amortization', slug: 'loan-amortization', category: 'debt-and-loans' as CategorySlug },
  { label: 'Rent vs. buy analysis', slug: 'rent-vs-buy', category: 'debt-and-loans' as CategorySlug },
  { label: 'Emergency fund target', slug: 'emergency-fund', category: 'income-and-planning' as CategorySlug },
  { label: 'Net worth tracker', slug: 'net-worth', category: 'income-and-planning' as CategorySlug },
  { label: 'ROI calculation', slug: 'roi', category: 'saving-and-growth' as CategorySlug },
  { label: 'Inflation impact', slug: 'inflation', category: 'economic' as CategorySlug },
];

/** Specific CTA hooks for the bottom section */
const ctaHooks = [
  { text: 'Wondering if you can retire at 55?', link: '/tools/income-and-planning/retirement-savings', label: 'Try the retirement calculator' },
  { text: 'Evaluating a job offer?', link: '/tools/income-and-planning/salary-us', label: 'See your real take-home pay' },
  { text: 'Buying your first home?', link: '/tools/debt-and-loans/mortgage-payment', label: 'Calculate your monthly payment' },
];

/** Words to cycle through in the hero */
const heroWords = ['Time', 'Privacy', 'Intelligence'];
---

<BaseLayout
  title="Free Financial Calculators Online | CalcRun"
  description="See your numbers instantly — no signup, no ads, no data harvesting. Free financial calculators with interactive charts and plain-English explanations."
  structuredData={[websiteSchema]}
>
  {/* ===== HERO — animated dark gradient with floating icons and dot pattern ===== */}
  <section class="hero-gradient relative overflow-hidden py-20 sm:py-28 lg:py-32">
    {/* Dot pattern overlay */}
    <div class="hero-dots absolute inset-0" aria-hidden="true"></div>

    {/* Floating glow orbs */}
    <div class="hero-orb hero-orb-1" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-2" aria-hidden="true"></div>

    {/* Floating mini-icons */}
    <div class="hero-float-icon hero-float-icon-1" aria-hidden="true">
      <ToolIcon name="calculator" size={20} />
    </div>
    <div class="hero-float-icon hero-float-icon-2" aria-hidden="true">
      <ToolIcon name="trending-up" size={18} />
    </div>
    <div class="hero-float-icon hero-float-icon-3" aria-hidden="true">
      <ToolIcon name="dollar-sign" size={16} />
    </div>
    <div class="hero-float-icon hero-float-icon-4" aria-hidden="true">
      <ToolIcon name="percent" size={18} />
    </div>

    <div class="relative z-10 max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
      {/* Animated gradient-border badge */}
      <div class="hero-badge-wrapper inline-block mb-6">
        <div class="hero-badge inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-1.5">
          <ToolIcon name="sparkles" class="text-primary-300" size={16} />
          <span class="text-sm font-medium text-primary-200">100% free, no signup required</span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight tracking-[-0.02em] max-w-[700px] mx-auto">
        Financial Calculators That
        <span class="hero-cycling-text relative inline-block">
          <span class="text-transparent bg-clip-text bg-[linear-gradient(135deg,#93C5FD,#10B981)]">
            Respect Your <span class="hero-word-container"><span class="hero-word" data-words={JSON.stringify(heroWords)}>Time</span></span>
          </span>
        </span>
      </h1>
      <p class="mt-5 text-lg sm:text-xl text-primary-200/90 max-w-[560px] mx-auto leading-relaxed">
        See your numbers instantly — no signup, no ads, no data harvesting. Just clear math and honest results.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/tools"
          class="inline-flex items-center justify-center gap-2 bg-accent-600 text-white font-semibold px-7 py-3.5 rounded-xl hover:bg-accent-500 shadow-lg shadow-accent-600/25 hover:shadow-accent-500/30 transition-all duration-200 hover:-translate-y-0.5"
        >
          Browse Calculators
          <ToolIcon name="arrow-right" size={18} />
        </a>
        <a
          href="#popular"
          class="inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm text-white font-semibold px-7 py-3.5 rounded-xl border border-white/20 hover:bg-white/15 hover:border-white/30 transition-all duration-200"
        >
          See Popular Tools
          <ToolIcon name="chevron-down" size={18} />
        </a>
      </div>

      {/* Trust indicators */}
      <div class="mt-12 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-sm text-primary-300/80">
        <div class="flex items-center gap-2">
          <ToolIcon name="lock" size={16} />
          <span>Runs in your browser</span>
        </div>
        <div class="flex items-center gap-2">
          <ToolIcon name="eye" size={16} />
          <span>No data harvesting</span>
        </div>
        <div class="flex items-center gap-2">
          <ToolIcon name="zap" size={16} />
          <span>Instant results</span>
        </div>
      </div>
    </div>
  </section>

  {/* ===== SCROLLING TICKER ===== */}
  <div class="ticker-strip relative overflow-hidden bg-primary-900 py-3 border-y border-white/5">
    <div class="ticker-track flex whitespace-nowrap" aria-hidden="true">
      {[...tickerItems, ...tickerItems].map((item) => (
        <a
          href={`/tools/${item.category}/${item.slug}`}
          tabindex="-1"
          class="ticker-item inline-flex items-center gap-2 mx-6 text-sm text-primary-300/70 hover:text-primary-200 transition-colors duration-150"
        >
          <span class="w-1 h-1 rounded-full bg-primary-500/50 shrink-0" aria-hidden="true"></span>
          {item.label}
        </a>
      ))}
    </div>
  </div>

  {/* ===== ANIMATED STATS BAR ===== */}
  <section class="py-10 sm:py-12 bg-white border-b border-neutral-100">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-16 lg:gap-20">
        <div class="stat-counter text-center" data-target="18">
          <div class="text-3xl sm:text-4xl font-bold text-primary-600 tabular-nums">
            <span class="stat-number">0</span>
          </div>
          <div class="text-sm text-neutral-500 mt-1 font-medium">Free Tools</div>
        </div>
        <div class="hidden sm:block w-px h-10 bg-gradient-to-b from-transparent via-neutral-200 to-transparent" aria-hidden="true"></div>
        <div class="stat-counter text-center" data-target="5">
          <div class="text-3xl sm:text-4xl font-bold text-primary-600 tabular-nums">
            <span class="stat-number">0</span>
          </div>
          <div class="text-sm text-neutral-500 mt-1 font-medium">Categories</div>
        </div>
        <div class="hidden sm:block w-px h-10 bg-gradient-to-b from-transparent via-neutral-200 to-transparent" aria-hidden="true"></div>
        <div class="stat-counter text-center" data-target="0">
          <div class="text-3xl sm:text-4xl font-bold text-accent-600 tabular-nums">
            <span class="stat-number">0</span>
          </div>
          <div class="text-sm text-neutral-500 mt-1 font-medium">Ads</div>
        </div>
        <div class="hidden sm:block w-px h-10 bg-gradient-to-b from-transparent via-neutral-200 to-transparent" aria-hidden="true"></div>
        <div class="stat-counter text-center" data-target="100" data-suffix="%">
          <div class="text-3xl sm:text-4xl font-bold text-accent-600 tabular-nums">
            <span class="stat-number">0</span><span class="stat-suffix"></span>
          </div>
          <div class="text-sm text-neutral-500 mt-1 font-medium">Client-Side</div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== POPULAR CALCULATORS ===== */}
  <section id="popular" class="py-16 sm:py-20 lg:py-24">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900">Popular Calculators</h2>
          <p class="text-neutral-500 mt-2">The tools people use most to plan their finances.</p>
        </div>
        <a href="/tools" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 hover:text-primary-700 transition-colors duration-150">
          View all
          <ToolIcon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {popularTools.map((tool) => (
          <a
            href={getToolPath(tool)}
            class="tool-card-popular group relative bg-white border border-neutral-200/80 rounded-2xl p-6 shadow-card hover:shadow-card-hover transition-all duration-200 hover:-translate-y-1"
          >
            <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-primary-50 text-primary-600 group-hover:bg-primary-500 group-hover:text-white transition-all duration-200 mb-4">
              <ToolIcon name={tool.icon} size={22} />
            </div>
            <h3 class="text-lg font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-150 mb-1.5">
              {tool.name}
            </h3>
            <p class="text-sm text-neutral-500 leading-relaxed">{tool.description}</p>
            <div class="absolute bottom-0 left-4 right-4 h-0.5 bg-gradient-to-r from-primary-500 to-accent-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
          </a>
        ))}
      </div>

      <a href="/tools" class="sm:hidden mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600">
        View all tools <ToolIcon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  {/* ===== HOW IT WORKS — 3-step process ===== */}
  <section class="py-16 sm:py-20 bg-neutral-50 relative overflow-hidden">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-3">How It Works</h2>
        <p class="text-neutral-500 max-w-[480px] mx-auto">Three steps. No account. No waiting.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6 relative">
        {/* Connecting line — desktop only */}
        <div class="hidden sm:block absolute top-7 left-[calc(16.67%+28px)] right-[calc(16.67%+28px)] h-px bg-gradient-to-r from-primary-300 via-primary-400 to-accent-400" aria-hidden="true"></div>

        <div class="text-center relative">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary-500 text-white shadow-lg shadow-primary-500/25 mb-5 relative z-10">
            <ToolIcon name="layout-grid" size={22} />
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Pick a calculator</h3>
          <p class="text-sm text-neutral-500 leading-relaxed max-w-[260px] mx-auto">Choose from 18 free financial and utility tools — no signup required.</p>
        </div>

        <div class="text-center relative">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-primary-500 text-white shadow-lg shadow-primary-500/25 mb-5 relative z-10">
            <ToolIcon name="sliders-horizontal" size={22} />
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Adjust your numbers</h3>
          <p class="text-sm text-neutral-500 leading-relaxed max-w-[260px] mx-auto">Drag sliders or type values. Everything updates as you go.</p>
        </div>

        <div class="text-center relative">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-accent-600 text-white shadow-lg shadow-accent-600/25 mb-5 relative z-10">
            <ToolIcon name="line-chart" size={22} />
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">See results instantly</h3>
          <p class="text-sm text-neutral-500 leading-relaxed max-w-[260px] mx-auto">Charts, breakdowns, and plain-English explanations — in real time.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Gradient divider */}
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="h-px bg-gradient-to-r from-transparent via-primary-300/40 to-transparent"></div>
  </div>

  {/* ===== WHO IS THIS FOR? — persona cards ===== */}
  <section class="py-16 sm:py-20 lg:py-24">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-3">Who Is This For?</h2>
        <p class="text-neutral-500 max-w-[520px] mx-auto">Real questions. Real tools to answer them.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {personas.map((persona) => (
          <div class="group bg-white rounded-2xl border border-neutral-200/80 p-6 shadow-card hover:shadow-card-hover transition-all duration-200 hover:-translate-y-0.5 relative overflow-hidden">
            <div class="flex items-start gap-4">
              <div class={`inline-flex items-center justify-center w-12 h-12 rounded-xl ${persona.color} ${persona.hoverBg} transition-all duration-200 shrink-0`}>
                <ToolIcon name={persona.icon} size={24} />
              </div>
              <div class="min-w-0">
                <h3 class="text-lg font-semibold text-neutral-900 mb-1">{persona.hook}</h3>
                <p class="text-sm text-neutral-500 leading-relaxed mb-3">{persona.description}</p>
                <div class="flex flex-wrap gap-2">
                  {persona.tools.map((tool) => (
                    <a
                      href={`/tools/${tool.category}/${tool.slug}`}
                      class="inline-flex items-center gap-1 text-xs font-medium text-primary-600 bg-primary-50 hover:bg-primary-100 px-2.5 py-1 rounded-full transition-colors duration-150"
                    >
                      {tool.name}
                      <ToolIcon name="arrow-right" size={12} />
                    </a>
                  ))}
                </div>
              </div>
            </div>
            <div class="absolute bottom-0 left-4 right-4 h-0.5 bg-gradient-to-r from-primary-500 to-accent-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== WHY CALCRUN — value proposition with comparison table ===== */}
  <section class="py-16 sm:py-20 bg-neutral-50">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-3">Why CalcRun?</h2>
        <p class="text-neutral-500 max-w-[480px] mx-auto">Built different from the calculator sites you're used to.</p>
      </div>

      {/* Feature cards */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-12">
        <div class="group bg-white rounded-2xl border border-neutral-200/80 p-6 shadow-card hover:shadow-card-hover transition-all duration-200 hover:-translate-y-0.5 text-center relative overflow-hidden">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-accent-50 text-accent-600 group-hover:bg-accent-600 group-hover:text-white transition-all duration-200 mb-4">
            <ToolIcon name="sparkles" size={24} />
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Zero Ads</h3>
          <p class="text-sm text-neutral-500 leading-relaxed">No pop-ups, no banners, no sponsored placements. Your screen is 100% calculator.</p>
          <div class="absolute bottom-0 left-4 right-4 h-0.5 bg-gradient-to-r from-accent-500 to-primary-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
        </div>

        <div class="group bg-white rounded-2xl border border-neutral-200/80 p-6 shadow-card hover:shadow-card-hover transition-all duration-200 hover:-translate-y-0.5 text-center relative overflow-hidden">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary-50 text-primary-600 group-hover:bg-primary-600 group-hover:text-white transition-all duration-200 mb-4">
            <ToolIcon name="shield-check" size={24} />
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Your Data Stays Yours</h3>
          <p class="text-sm text-neutral-500 leading-relaxed">Every calculation runs in your browser. We never see, store, or sell your numbers.</p>
          <div class="absolute bottom-0 left-4 right-4 h-0.5 bg-gradient-to-r from-primary-500 to-accent-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
        </div>

        <div class="group bg-white rounded-2xl border border-neutral-200/80 p-6 shadow-card hover:shadow-card-hover transition-all duration-200 hover:-translate-y-0.5 text-center relative overflow-hidden">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-warning-50 text-warning-600 group-hover:bg-warning-600 group-hover:text-white transition-all duration-200 mb-4">
            <ToolIcon name="zap" size={24} />
          </div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-2">Real-Time Results</h3>
          <p class="text-sm text-neutral-500 leading-relaxed">No submit buttons, no page reloads. Results update instantly as you adjust inputs.</p>
          <div class="absolute bottom-0 left-4 right-4 h-0.5 bg-gradient-to-r from-warning-500 to-accent-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
        </div>
      </div>

      {/* Comparison table */}
      <div class="bg-white rounded-2xl border border-neutral-200/80 shadow-card overflow-hidden">
        <div class="px-6 py-4 bg-neutral-50 border-b border-neutral-200/80">
          <h3 class="text-base font-semibold text-neutral-900">How we compare</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-neutral-100">
                <th class="text-left font-medium text-neutral-500 px-6 py-3 w-[200px]">Feature</th>
                <th class="text-center font-medium text-neutral-400 px-4 py-3">Calculator.net</th>
                <th class="text-center font-medium text-neutral-400 px-4 py-3">Bankrate</th>
                <th class="text-center font-semibold text-primary-600 px-4 py-3 bg-primary-50/50">CalcRun</th>
              </tr>
            </thead>
