---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';
import { UK_TAX_YEAR } from '@lib/uk-rates';
import { US_TAX_YEAR } from '@lib/us-rates';
---

<BaseLayout
  title="About CalcRun"
  description="CalcRun builds financial calculators with cited sources, current tax rates, and no signup. Learn how our tools work and how we're funded."
>
  {/* Page header */}
  <section class="border-b border-neutral-200/80 bg-bg">
    <div class="max-w-[768px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-neutral-900 tracking-[-0.02em]">About CalcRun</h1>
      <p class="mt-2 text-lg text-neutral-600 max-w-[640px]">
        Financial calculators that show their working.
      </p>
    </div>
  </section>

  <div class="max-w-[768px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {/* Who built this */}
    <section class="mb-12">
      <div class="flex items-start gap-4 mb-4">
        <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-primary-100 text-primary-700 shrink-0">
          <ToolIcon name="user" size={20} />
        </div>
        <div>
          <h2 class="text-xl font-bold text-neutral-900 mb-2">Who built this</h2>
          <p class="text-neutral-700 leading-relaxed mb-3">
            CalcRun is built by Jonathan, an ACA-qualified accountant with experience across
            UK, US, and Australian tax systems. The site exists because most online calculators
            are either ad-heavy, outdated, or won't show their working. This one does.
          </p>
          <p class="text-neutral-700 leading-relaxed">
            Every formula is documented, every tax rate is sourced from official data (HMRC, IRS, SSA),
            and every calculation runs in your browser — nothing is sent to a server.
            If you find an error, <a href="mailto:hello@calcrun.com" class="text-primary-600 hover:text-primary-700 underline transition-colors duration-150">email me</a> and I'll fix it.
          </p>
        </div>
      </div>
    </section>

    {/* Divider */}
    <div class="h-px bg-neutral-200/80 mb-12"></div>

    {/* What we build */}
    <section class="mb-12">
      <h2 class="text-xl font-bold text-neutral-900 mb-4">What we build</h2>
      <p class="text-neutral-700 leading-relaxed mb-4">
        CalcRun offers 44 tools across six categories: savings and growth calculators,
        debt and loan tools, income and tax planning, economic indicators, developer utilities,
        and file converters. Every financial calculator includes interactive charts, a year-by-year
        breakdown table, and educational content explaining the underlying formulas.
      </p>
      <p class="text-neutral-700 leading-relaxed">
        UK tax calculators use {UK_TAX_YEAR} HMRC rates. US tax calculators use {US_TAX_YEAR} IRS brackets.
        Rate-dependent tools display their data sources and the date we last verified them.
      </p>
    </section>

    {/* Divider */}
    <div class="h-px bg-neutral-200/80 mb-12"></div>

    {/* How privacy works */}
    <section class="mb-12">
      <div class="flex items-start gap-4 mb-4">
        <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-primary-50 text-primary-600 shrink-0">
          <ToolIcon name="lock" size={20} />
        </div>
        <div>
          <h2 class="text-xl font-bold text-neutral-900 mb-2">How privacy works</h2>
          <p class="text-neutral-700 leading-relaxed">
            All calculations run client-side in your browser. The numbers you type into a calculator
            never leave your device — we cannot see them. We use Google Analytics for aggregate
            traffic data (page views, country). We do not sell data or run tracking pixels for ad networks.
            Read our <a href="/privacy/" class="text-primary-600 hover:text-primary-700 underline transition-colors duration-150">privacy policy</a> for full details.
          </p>
        </div>
      </div>
    </section>

    {/* How it's funded */}
    <section class="mb-12">
      <div class="flex items-start gap-4 mb-4">
        <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-neutral-100 text-neutral-600 shrink-0">
          <ToolIcon name="scale" size={20} />
        </div>
        <div>
          <h2 class="text-xl font-bold text-neutral-900 mb-2">How it's funded</h2>
          <p class="text-neutral-700 leading-relaxed">
            Some calculator pages include affiliate links to financial products. If you click through
            and open an account, we may earn a commission at no extra cost to you. Calculator results
            are never affected by affiliate partnerships — the same formula runs regardless of which
            links appear on the page. See our
            <a href="/disclosure/" class="text-primary-600 hover:text-primary-700 underline transition-colors duration-150">
              affiliate disclosure
            </a>
            for the full list of partners.
          </p>
        </div>
      </div>
    </section>

    {/* Divider */}
    <div class="h-px bg-neutral-200/80 mb-12"></div>

    {/* Editorial standards */}
    <section class="bg-neutral-50 border border-neutral-200/80 rounded-lg p-6 sm:p-8 mb-12">
      <div class="flex items-start gap-4">
        <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-primary-100 text-primary-700 shrink-0">
          <ToolIcon name="book-open" size={20} />
        </div>
        <div>
          <h2 class="text-xl font-bold text-neutral-900 mb-3">Editorial standards</h2>
          <ul class="space-y-2.5 text-neutral-700 text-sm leading-relaxed">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" /></svg>
              <span><strong>Cited sources.</strong> Tax rates, thresholds, and pension figures link to the official government source (GOV.UK, IRS, SSA).</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" /></svg>
              <span><strong>Last-checked dates.</strong> Every rate-dependent calculator shows when we last verified its data against official sources.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" /></svg>
              <span><strong>Formula transparency.</strong> Each calculator identifies its calculation method so you can verify the maths independently.</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 text-primary-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" /></svg>
              <span><strong>Corrections.</strong> If you find an error, email <a href="mailto:hello@calcrun.com" class="text-primary-600 hover:text-primary-700 underline">hello@calcrun.com</a> and we'll fix it within 24 hours.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    {/* Disclaimer — visually distinct from editorial standards card above */}
    <section class="border-l-4 border-neutral-300 pl-5 sm:pl-6 py-1">
      <h2 class="text-lg font-bold text-neutral-900 mb-2">Not financial advice</h2>
      <p class="text-neutral-600 leading-relaxed text-sm">
        CalcRun provides educational tools, not personalised financial advice. Calculators use
        general formulas and published tax rates — they cannot account for your complete financial
        situation. For decisions about investing, tax planning, or pensions, consult a qualified
        financial adviser.
      </p>
    </section>
  </div>
</BaseLayout>
