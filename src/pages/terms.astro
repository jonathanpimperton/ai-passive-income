---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';

const sections = [
  {
    icon: 'target',
    title: 'Calculator Accuracy',
    content: 'Results are estimates based on the inputs you provide and standard financial formulas. Actual results may vary based on factors not captured by the calculator (fees, taxes, market conditions, etc.). We test our math rigorously but cannot guarantee accuracy for your specific situation.',
  },
  {
    icon: 'info',
    title: 'Not Financial Advice',
    content: 'CalcRun is an educational tool, not a financial advisor. We don\'t know your full financial picture, risk tolerance, or personal circumstances. Our calculators help you understand financial concepts and run scenarios — they do not constitute personalized financial advice. For decisions about investments, loans, retirement planning, or other financial matters, consult a qualified financial advisor.',
  },
  {
    icon: 'shield-check',
    title: 'Use at Your Own Risk',
    content: 'CalcRun provides its tools "as is" without warranties of any kind. We are not liable for any decisions made or actions taken based on calculator results. You are solely responsible for verifying the accuracy of any calculations before making financial decisions.',
  },
  {
    icon: 'lock',
    title: 'Intellectual Property',
    content: 'Calculator code, educational content, and design are copyrighted \u00a9 2026 CalcRun. Embeddable calculator widgets are provided for use on third-party sites with required attribution ("Powered by CalcRun" with a link back to calcrun.com).',
  },
  {
    icon: 'external-link',
    title: 'Third-Party Links',
    content: 'CalcRun contains links to third-party websites and financial products. We are not responsible for the content, privacy policies, or practices of these external sites. See our <a href="/disclosure/" class="text-primary-600 hover:text-primary-700 underline transition-colors duration-150">affiliate disclosure</a> for details about our affiliate relationships.',
  },
  {
    icon: 'globe',
    title: 'Governing Law',
    content: 'CalcRun is operated as a sole trader business based in the United Kingdom. These terms are governed by and construed in accordance with the laws of England and Wales. Nothing in these terms affects your statutory rights as a consumer.',
  },
  {
    icon: 'file-text',
    title: 'Changes to Terms',
    content: 'We may update these terms from time to time. The "last updated" date at the top reflects the most recent revision. Continued use of CalcRun after changes constitutes acceptance of the updated terms.',
  },
];
---

<BaseLayout
  title="Terms of Use | CalcRun"
  description="CalcRun terms of use. Our calculators provide estimates, not financial advice. Use at your own risk."
>
  {/* Page header */}
  <section class="bg-[#0F1B2D] py-10 sm:py-14">
    <div class="max-w-[768px] mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-1">Terms of Use</h1>
      <p class="text-sm text-primary-300">Last updated: February 2026</p>
    </div>
  </section>

  <div class="max-w-[768px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="space-y-6">
      {sections.map((section) => (
        <section class="bg-white border border-neutral-200/80 rounded-xl p-5 sm:p-6 shadow-card">
          <div class="flex items-start gap-3.5">
            <div class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-primary-50 text-primary-600 shrink-0 mt-0.5">
              <ToolIcon name={section.icon} size={18} />
            </div>
            <div>
              <h2 class="text-base font-bold text-neutral-900 mb-2">{section.title}</h2>
              <p class="text-sm text-neutral-700 leading-relaxed" set:html={section.content} />
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
