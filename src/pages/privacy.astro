---
import BaseLayout from '@layouts/BaseLayout.astro';
import ToolIcon from '@components/ui/ToolIcon.astro';

const sections = [
  {
    icon: 'mail',
    title: 'Data We Collect',
    content: '<strong>Email address only</strong> — and only if you choose to receive your calculator results via email. We never require an account, password, or any personal financial data.',
  },
  {
    icon: 'calculator',
    title: 'Calculator Data',
    content: 'All calculations run client-side in your browser. We never see, store, or transmit the numbers you enter into our calculators. Your financial data stays on your device.',
  },
  {
    icon: 'chart-line',
    title: 'Analytics',
    content: 'We use Google Analytics with anonymized IP addresses to understand how people use the site. We track page views, traffic sources, and device types. We do not track individual users, financial data, or personal information.',
  },
  {
    icon: 'cookie',
    title: 'Cookies',
    content: 'We use analytics cookies only when you consent. No advertising cookies, no tracking pixels, no third-party data sharing. You can decline cookies and the site works exactly the same — we just won\'t have analytics data for your visit.',
  },
  {
    icon: 'lock',
    title: 'Email Usage',
    content: 'If you provide your email to receive calculator results, we use it solely for sending your requested calculator results and occasional educational content. Your email is never sold, shared, or given to third parties. Every email includes an unsubscribe link. We use MailerLite as our email provider.',
  },
  {
    icon: 'external-link',
    title: 'Affiliate Links',
    content: 'We link to third-party financial products on some pages. When you click an affiliate link, that company\'s privacy policy applies. We do not share your data with affiliate partners.',
  },
  {
    icon: 'shield-check',
    title: 'Your Rights (GDPR/CCPA)',
    content: 'You have the right to request deletion of your data, access the data we have about you, opt out of email communications at any time, and decline analytics cookies. For any privacy-related requests, contact us at privacy@calcrun.com.',
  },
  {
    icon: 'users',
    title: 'Children\'s Privacy',
    content: 'CalcRun is not directed at children under 13. We do not knowingly collect information from children under 13.',
  },
];
---

<BaseLayout
  title="Privacy Policy | CalcRun"
  description="CalcRun privacy policy. All calculations run in your browser. We never see, store, or transmit the numbers you enter."
>
  {/* Page header */}
  <section class="bg-[linear-gradient(135deg,#0A2540_0%,#1A3A5C_50%,#0A2540_100%)] py-10 sm:py-14">
    <div class="max-w-[768px] mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-1">Privacy Policy</h1>
      <p class="text-sm text-primary-300">Last updated: February 2026</p>
    </div>
  </section>

  <div class="max-w-[768px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="space-y-6">
      {sections.map((section) => (
        <section class="bg-white border border-neutral-200/80 rounded-xl p-5 sm:p-6 shadow-card">
          <div class="flex items-start gap-3.5">
            <div class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-primary-50 text-primary-600 shrink-0 mt-0.5">
              <ToolIcon name={section.icon} size={18} />
            </div>
            <div>
              <h2 class="text-base font-bold text-neutral-900 mb-2">{section.title}</h2>
              <p class="text-sm text-neutral-700 leading-relaxed" set:html={section.content} />
            </div>
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
