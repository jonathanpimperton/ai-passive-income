# MailerLite API key for email subscriptions (newsletter + drip)
# Set this in Cloudflare Workers: Settings → Variables and Secrets
MAILERLITE_API_KEY=your_api_key_here

# MailerSend API key for transactional emails ("Email my results")
# Free tier: 500 emails/month. Set in Cloudflare Workers: Settings → Variables and Secrets
MAILERSEND_API_KEY=your_api_key_here
